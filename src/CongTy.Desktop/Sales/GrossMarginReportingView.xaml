<UserControl x:Class="CongTy.Desktop.Sales.GrossMarginReportingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             PreviewKeyDown="GrossMarginReportingView_OnPreviewKeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="GrossMarginCellTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="GrossMarginNumericTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="0,0,4,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="12" Style="{StaticResource OfficeCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Từ ngày" FontWeight="SemiBold" />
                            <DatePicker Margin="0,5,0,0"
                                        SelectedDate="{Binding FromDate, Mode=TwoWay}"
                                        IsEnabled="{Binding CanApply}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Đến ngày" FontWeight="SemiBold" />
                            <DatePicker Margin="0,5,0,0"
                                        SelectedDate="{Binding ToDate, Mode=TwoWay}"
                                        IsEnabled="{Binding CanApply}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="10,0,0,0">
                            <TextBlock Text="Kho" FontWeight="SemiBold" />
                            <ComboBox Margin="0,5,0,0"
                                      ItemsSource="{Binding Warehouses}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding SelectedWarehouseId, Mode=TwoWay}"
                                      IsEnabled="{Binding CanApply}" />
                        </StackPanel>

                        <Button Grid.Column="3"
                                Margin="12,18,0,0"
                                Style="{StaticResource OfficePrimaryButtonStyle}"
                                IsEnabled="{Binding CanApply}"
                                Click="Apply_OnClick"
                                Content="{Binding ApplyText}" />

                        <Button Grid.Column="4"
                                Margin="8,18,0,0"
                                Style="{StaticResource OfficeSecondaryButtonStyle}"
                                IsEnabled="{Binding CanApply}"
                                Click="Reset_OnClick"
                                Content="Đặt lại" />
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                    <TextBlock Text="{Binding ReportError}"
                               Foreground="{DynamicResource DangerBrush}"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasReportError, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="Đang tải lãi gộp…"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Visibility="{Binding ShowInitialLoading, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <Grid Grid.Row="2"
                      Margin="0,10,0,0"
                      Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Margin="0,0,6,0" Padding="12" Style="{StaticResource OfficeCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Doanh thu thuần so sánh được" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding NetRevenueText}" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Margin="0,3,0,0" Text="Không gồm VAT; đã trừ chiết khấu và đảo hàng khách trả." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Margin="6,0" Padding="12" Style="{StaticResource OfficeCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Giá vốn" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding CogsText}" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Margin="0,3,0,0" Text="Theo đúng dòng xuất/nhập kho đã ghi nhận giá vốn." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Margin="6,0" Padding="12" Style="{StaticResource OfficeCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Lãi gộp" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding GrossMarginText}" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Margin="0,3,0,0" Text="Doanh thu thuần − Giá vốn hàng bán." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Margin="6,0,0,0" Padding="12" Style="{StaticResource OfficeCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Biên lãi gộp" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding GrossMarginPercentText}" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Margin="0,3,0,0" Text="Chỉ tính các dòng VND có dữ liệu giá vốn hợp lệ." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.ColumnSpan="4" Margin="0,8,0,0" Padding="10" Style="{StaticResource OfficeCardStyle}">
                        <TextBlock Text="{Binding ReconciliationText}" TextWrapping="Wrap" />
                    </Border>
                </Grid>

                <TabControl Grid.Row="3"
                            Margin="0,10,0,0"
                            Style="{StaticResource OfficeTabControlStyle}"
                            SelectedIndex="{Binding ActiveTabIndex, Mode=TwoWay}"
                            Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}">
                    <TabItem Header="Theo khách hàng">
                        <Border Margin="0,8,0,0" Padding="12" Style="{StaticResource OfficeCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Theo khách hàng" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Margin="0,3,0,8" Text="Nhóm theo mã khách hàng ổn định; tên và mã chỉ dùng để hiển thị." Foreground="{DynamicResource TextSecondaryBrush}" />
                                <DataGrid Height="360"
                                          Style="{StaticResource OfficeDataGridStyle}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          RowHeight="42"
                                          ItemsSource="{Binding CustomerRows}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="46" ElementStyle="{StaticResource GrossMarginNumericTextStyle}" />
                                        <DataGridTemplateColumn Header="Khách hàng" Width="1.7*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Primary}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Secondary}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Doanh thu" Binding="{Binding Revenue}" Width="1.1*" ElementStyle="{StaticResource GrossMarginNumericTextStyle}" />
                                        <DataGridTextColumn Header="Giá vốn hàng bán" Binding="{Binding Cogs}" Width="1.1*" ElementStyle="{StaticResource GrossMarginNumericTextStyle}" />
                                        <DataGridTextColumn Header="Lãi gộp" Binding="{Binding GrossMargin}" Width="1.1*" ElementStyle="{StaticResource GrossMarginNumericTextStyle}" />
                                        <DataGridTextColumn Header="Biên" Binding="{Binding MarginPercent}" Width="0.8*" ElementStyle="{StaticResource GrossMarginNumericTextStyle}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Margin="0,7,0,0" Text="{Binding CustomerEmptyText}" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </TabItem>

                    <TabItem Header="Theo SKU">
                        <Border Margin="0,8,0,0" Padding="12" Style="{StaticResource OfficeCardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Theo SKU" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Margin="0,3,0,0" Text="Nhóm theo mã SKU chuẩn để không tách sai khi tên hàng thay đổi." Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Style="{StaticResource OfficeSecondaryButtonStyle}"
                                            Click="Costing_OnClick"
                                            Content="Mở giá vốn" />
                                </Grid>
                                <DataGrid Margin="0,8,0,0"
                                          Height="360"
                                          Style="{StaticResource OfficeDataGridStyle}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          RowHeight="38"
                                          ItemsSource="{Binding SkuRows}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="46" ElementStyle="{StaticResource GrossMarginNumericTextStyle}" />
                                        <DataGridTextColumn Header="SKU" Binding="{Binding Primary}" Width="1.7*" ElementStyle="{StaticResource GrossMarginCellTextStyle}" />
                                        <DataGridTextColumn Header="Doanh thu" Binding="{Binding Revenue}" Width="1.1*" ElementStyle="{StaticResource GrossMarginNumericTextStyle}" />
                                        <DataGridTextColumn Header="Giá vốn hàng bán" Binding="{Binding Cogs}" Width="1.1*" ElementStyle="{StaticResource GrossMarginNumericTextStyle}" />
                                        <DataGridTextColumn Header="Lãi gộp" Binding="{Binding GrossMargin}" Width="1.1*" ElementStyle="{StaticResource GrossMarginNumericTextStyle}" />
                                        <DataGridTextColumn Header="Biên" Binding="{Binding MarginPercent}" Width="0.8*" ElementStyle="{StaticResource GrossMarginNumericTextStyle}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Margin="0,7,0,0" Text="{Binding SkuEmptyText}" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </TabItem>

                    <TabItem Header="Ngoại lệ">
                        <Border Margin="0,8,0,0" Padding="12" Style="{StaticResource OfficeCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Dòng chưa đủ điều kiện tính lãi gộp" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Margin="0,3,0,8" Text="Không tự suy đoán giá vốn hoặc quy đổi tiền tệ; các dòng này chưa tính vào chỉ tiêu tổng hợp và hiện rõ nguyên nhân." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <DataGrid Height="360"
                                          Style="{StaticResource OfficeDataGridStyle}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          RowHeight="38"
                                          ItemsSource="{Binding ExceptionRows}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="46" ElementStyle="{StaticResource GrossMarginNumericTextStyle}" />
                                        <DataGridTextColumn Header="Ngày" Binding="{Binding Date}" Width="0.8*" ElementStyle="{StaticResource GrossMarginCellTextStyle}" />
                                        <DataGridTextColumn Header="Chứng từ" Binding="{Binding Document}" Width="1.2*" ElementStyle="{StaticResource GrossMarginCellTextStyle}" />
                                        <DataGridTextColumn Header="Kho" Binding="{Binding Warehouse}" Width="0.8*" ElementStyle="{StaticResource GrossMarginCellTextStyle}" />
                                        <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="1*" ElementStyle="{StaticResource GrossMarginCellTextStyle}" />
                                        <DataGridTextColumn Header="Khách hàng" Binding="{Binding Customer}" Width="1*" ElementStyle="{StaticResource GrossMarginCellTextStyle}" />
                                        <DataGridTextColumn Header="Nguyên nhân" Binding="{Binding Reason}" Width="1.5*" ElementStyle="{StaticResource GrossMarginCellTextStyle}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Margin="0,7,0,0" Text="{Binding ExceptionEmptyText}" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </TabItem>
                </TabControl>

                <TextBlock Grid.Row="4"
                           Margin="0,10,0,0"
                           Text="F5: tải lại"
                           HorizontalAlignment="Right"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </ScrollViewer>

        <Border Background="#88000000"
                Visibility="{Binding IsExportOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Width="720"
                    MaxHeight="680"
                    Padding="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Xuất báo cáo lãi gộp" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="Chọn nội dung và cột cần xuất" FontSize="20" FontWeight="SemiBold" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Style="{StaticResource OfficeSecondaryButtonStyle}"
                                IsEnabled="{Binding CanCloseExport}"
                                Click="CloseExport_OnClick"
                                Content="Đóng" />
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Margin="0,8,0,0"
                               Text="Xuất theo kỳ và kho đang áp dụng. Dữ liệu lãi gộp được đối soát với cùng nguồn đang hiển thị trên màn hình."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" />

                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Nội dung" FontWeight="SemiBold" />
                            <ComboBox Margin="0,5,8,0"
                                      ItemsSource="{Binding ExportDimensions}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Key"
                                      SelectedValue="{Binding SelectedExportDimension, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Định dạng" FontWeight="SemiBold" />
                            <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                                <RadioButton x:Name="ExportXlsxRadio" Content="Excel (.xlsx)" IsChecked="True" Checked="ExportXlsx_OnChecked" />
                                <RadioButton Margin="18,0,0,0" Content="CSV (.csv)" Checked="ExportCsv_OnChecked" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding SelectedExportCountText}" FontWeight="SemiBold" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource OfficeSecondaryButtonStyle}" Click="SelectAllColumns_OnClick" Content="Chọn tất cả" />
                                <Button Margin="6,0,0,0" Style="{StaticResource OfficeSecondaryButtonStyle}" Click="ClearColumns_OnClick" Content="Bỏ chọn" />
                                <Button Margin="6,0,0,0" Style="{StaticResource OfficeSecondaryButtonStyle}" Click="DefaultColumns_OnClick" Content="Mặc định" />
                            </StackPanel>
                        </Grid>
                        <ScrollViewer Grid.Row="1" Margin="0,10,0,0" MaxHeight="300" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ExportColumns}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Width="210"
                                                  Margin="0,0,8,8"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Content="{Binding Label}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <TextBlock Grid.Row="4"
                               Margin="0,8,0,0"
                               Text="{Binding ExportError}"
                               Foreground="{DynamicResource DangerBrush}"
                               TextWrapping="Wrap" />

                    <StackPanel Grid.Row="5" Margin="0,14,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource OfficeSecondaryButtonStyle}"
                                IsEnabled="{Binding CanCloseExport}"
                                Click="CloseExport_OnClick"
                                Content="Hủy" />
                        <Button Margin="8,0,0,0"
                                Style="{StaticResource OfficePrimaryButtonStyle}"
                                IsEnabled="{Binding CanSubmitExport}"
                                Click="Export_OnClick"
                                Content="{Binding ExportButtonText}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
