<UserControl x:Class="CongTy.Desktop.Sales.SalesOperationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             PreviewKeyDown="SalesOperationsView_OnPreviewKeyDown">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="12,10"
                    Background="{DynamicResource SurfaceMutedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <TextBlock Text="Đây là trung tâm điều hành bán hàng chung. Mọi nguồn đơn đi vào cùng một hàng đợi để bộ phận bán hàng, chăm sóc khách hàng và kế toán xử lý; chỉ ngoại lệ vượt quyền mới chuyển lên quản lý phụ trách bằng Phiếu Đề xuất."
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </Border>

            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Margin="0,0,5,0" Style="{StaticResource OfficeSummaryCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Chi nhánh đang hoạt động" Style="{StaticResource OfficeSummaryLabelStyle}" />
                        <TextBlock Text="{Binding ActiveBranches}" Style="{StaticResource OfficeSummaryValueStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Margin="5,0" Style="{StaticResource OfficeSummaryCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Kho đang hoạt động" Style="{StaticResource OfficeSummaryLabelStyle}" />
                        <TextBlock Text="{Binding ActiveWarehouses}" Style="{StaticResource OfficeSummaryValueStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Margin="5,0" Style="{StaticResource OfficeSummaryCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Vị trí kho đang hoạt động" Style="{StaticResource OfficeSummaryLabelStyle}" />
                        <TextBlock Text="{Binding ActiveLocations}" Style="{StaticResource OfficeSummaryValueStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Margin="5,0,0,0" Style="{StaticResource OfficeSummaryCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Việc bán hàng đang chờ" Style="{StaticResource OfficeSummaryLabelStyle}" />
                        <TextBlock Text="{Binding PendingWork}" Style="{StaticResource OfficeSummaryValueStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Grid.Row="2" Margin="0,8,0,0">
                <TextBlock Text="{Binding OrganizationError}"
                           Foreground="{DynamicResource DangerBrush}"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasOrganizationError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding LoadingText}"
                           Margin="0,2,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>

            <Grid Grid.Row="3" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource OfficeCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Đơn chờ xác nhận" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="Các đơn nháp từ những nguồn tiếp nhận cần kiểm tra và xác nhận thành đơn bán hàng chính thức."
                                           Margin="0,3,0,0"
                                           FontSize="10.5"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    VerticalAlignment="Top"
                                    Style="{StaticResource OfficeMiniButtonStyle}"
                                    IsEnabled="{Binding CanReadOrders}"
                                    Click="OpenSalesOrders_OnClick"
                                    Content="Mở màn xác nhận" />
                        </Grid>
                        <TextBlock Grid.Row="1"
                                   Margin="0,8,0,0"
                                   Text="{Binding OrdersError}"
                                   Foreground="{DynamicResource DangerBrush}"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasOrdersError}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl Grid.Row="2" Margin="0,4,0,0" ItemsSource="{Binding DraftOrders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="0,9"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="0,0,0,1">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock FontWeight="SemiBold" TextWrapping="Wrap">
                                                    <Run Text="{Binding Number}" /><Run Text=". " /><Run Text="{Binding CustomerName}" />
                                                </TextBlock>
                                                <Border Grid.Column="1"
                                                        Margin="8,0,0,0"
                                                        Padding="7,2"
                                                        CornerRadius="10"
                                                        Background="{DynamicResource SurfaceMutedBrush}"
                                                        BorderBrush="{DynamicResource WarningBrush}"
                                                        BorderThickness="1">
                                                    <TextBlock Text="{Binding Status}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource WarningBrush}" />
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding Meta}"
                                                       Margin="0,3,0,0"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding UpdatedAt}"
                                                       Margin="0,2,0,0"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Grid.Row="3"
                                   Text="{Binding OrdersEmptyText}"
                                   Margin="0,12,0,2"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource OfficeCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Đề nghị mở hoặc liên kết mã khách" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="Các điểm bán đã phát sinh nhu cầu mua và cần xử lý thành khách hàng chính thức."
                                           Margin="0,3,0,0"
                                           FontSize="10.5"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    VerticalAlignment="Top"
                                    Style="{StaticResource OfficeMiniButtonStyle}"
                                    IsEnabled="False"
                                    ToolTip="Màn xử lý mã khách sẽ được nối ở lô nghiệp vụ riêng."
                                    Content="Mở màn xử lý" />
                        </Grid>
                        <TextBlock Grid.Row="1"
                                   Margin="0,8,0,0"
                                   Text="{Binding OnboardingError}"
                                   Foreground="{DynamicResource DangerBrush}"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasOnboardingError}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl Grid.Row="2" Margin="0,4,0,0" ItemsSource="{Binding OnboardingQueue}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="0,9"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="0,0,0,1">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock FontWeight="SemiBold" TextWrapping="Wrap">
                                                    <Run Text="{Binding Number}" /><Run Text=". " /><Run Text="{Binding CustomerName}" />
                                                </TextBlock>
                                                <Border Grid.Column="1"
                                                        Margin="8,0,0,0"
                                                        Padding="7,2"
                                                        CornerRadius="10"
                                                        Background="{DynamicResource SurfaceMutedBrush}"
                                                        BorderBrush="{DynamicResource WarningBrush}"
                                                        BorderThickness="1">
                                                    <TextBlock Text="{Binding Status}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource WarningBrush}" />
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding Meta}"
                                                       Margin="0,3,0,0"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding UpdatedAt}"
                                                       Margin="0,2,0,0"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Grid.Row="3"
                                   Text="{Binding OnboardingEmptyText}"
                                   Margin="0,12,0,2"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Grid>
                </Border>
            </Grid>

            <TextBlock Grid.Row="4"
                       Margin="0,8,0,0"
                       HorizontalAlignment="Right"
                       FontSize="10"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="F5 · Cập nhật dữ liệu" />
        </Grid>
    </ScrollViewer>
</UserControl>
