<UserControl x:Class="CongTy.Desktop.Sales.CustomerOnboardingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="View_OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Mở/liên kết mã khách"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Margin="0,4,0,0"
                           Text="Xem thông tin điểm bán và quyết định tạo mã mới, liên kết khách có sẵn hoặc yêu cầu bổ sung."
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}">
                    <Run Text="Đang chờ: " /><Run Text="{Binding PendingCount, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>
                <Button Padding="14,8"
                        IsEnabled="{Binding IsNotBusy}"
                        Click="Refresh_OnClick"
                        Content="Cập nhật dữ liệu" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,0,0,12"
                Padding="10"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding HasMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="2">
            <Border Padding="24"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Hiện không có đề nghị nào đang chờ xử lý."
                               FontSize="16"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Margin="0,6,0,0"
                               Text="Khi MCP Field hoặc khách đặt hàng gửi đề nghị mới, công việc sẽ xuất hiện tại đây."
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding HasRows, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,12"
                                    Padding="14"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding CustomerName}" FontSize="17" FontWeight="SemiBold" />
                                            <TextBlock Margin="0,3,0,0" Text="{Binding Phone}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                Padding="10,5"
                                                Background="{DynamicResource SurfaceMutedBrush}"
                                                CornerRadius="12">
                                            <TextBlock Text="{Binding StatusLabel}" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>

                                    <UniformGrid Margin="0,12,0,0" Columns="3">
                                        <StackPanel Margin="0,0,12,8"><TextBlock Text="Địa chỉ" FontWeight="SemiBold" /><TextBlock Text="{Binding Address}" TextWrapping="Wrap" /></StackPanel>
                                        <StackPanel Margin="0,0,12,8"><TextBlock Text="Nguồn" FontWeight="SemiBold" /><TextBlock Text="{Binding SourceLabel}" /></StackPanel>
                                        <StackPanel Margin="0,0,12,8"><TextBlock Text="Người đưa về" FontWeight="SemiBold" /><TextBlock Text="{Binding BroughtByLabel}" TextWrapping="Wrap" /></StackPanel>
                                        <StackPanel Margin="0,0,12,8"><TextBlock Text="Điểm bán" FontWeight="SemiBold" /><TextBlock Text="{Binding OutletLabel}" TextWrapping="Wrap" /></StackPanel>
                                        <StackPanel Margin="0,0,12,8"><TextBlock Text="Lý do gửi" FontWeight="SemiBold" /><TextBlock Text="{Binding ReasonLabel}" TextWrapping="Wrap" /></StackPanel>
                                        <StackPanel Margin="0,0,12,8"><TextBlock Text="Cập nhật" FontWeight="SemiBold" /><TextBlock Text="{Binding UpdatedAt}" /></StackPanel>
                                    </UniformGrid>

                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="{Binding BusinessType, StringFormat=Mô hình quán: {0}}" />
                                        <TextBlock Text="{Binding ReviewReason, StringFormat=Lý do gần nhất: {0}}" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Button Margin="0,4,0,0"
                                            Padding="12,7"
                                            HorizontalAlignment="Left"
                                            IsEnabled="{Binding CanReview}"
                                            Visibility="{Binding IsSubmittedOrNeedMoreInfo, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Click="StartReview_OnClick"
                                            Content="Bắt đầu xem xét" />

                                    <StackPanel Margin="0,10,0,0"
                                                Visibility="{Binding IsUnderReview, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Border Margin="0,0,0,10"
                                                Padding="12"
                                                Background="{DynamicResource SurfaceMutedBrush}"
                                                CornerRadius="8"
                                                Visibility="{Binding IsPortal, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel>
                                                <TextBlock Text="Kích hoạt quyền đặt hàng" FontWeight="SemiBold" FontSize="15" />
                                                <Grid Margin="0,10,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="Kho mặc định" FontWeight="SemiBold" />
                                                        <ComboBox Margin="0,5,0,0"
                                                                  ItemsSource="{Binding WarehouseOptions}"
                                                                  DisplayMemberPath="Label"
                                                                  SelectedValuePath="Id"
                                                                  SelectedValue="{Binding SelectedWarehouseId, Mode=TwoWay}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Kênh bán" FontWeight="SemiBold" />
                                                        <ComboBox Margin="0,5,0,0"
                                                                  ItemsSource="{Binding SalesChannelOptions}"
                                                                  DisplayMemberPath="Label"
                                                                  SelectedValuePath="Id"
                                                                  SelectedValue="{Binding SelectedSalesChannelId, Mode=TwoWay}" />
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Margin="0,8,0,0" Text="Chính sách thu mặc định: thu khi giao hàng." Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </Border>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Padding="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                                                <StackPanel>
                                                    <TextBlock Text="Tạo khách mới từ đăng ký" FontWeight="SemiBold" FontSize="15" />
                                                    <TextBlock Margin="0,6,0,0" Text="Tên khách sẽ tạo:" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding CustomerName}" FontWeight="SemiBold" />
                                                    <TextBlock Margin="0,8,0,0" Text="Mã khách hàng" FontWeight="SemiBold" />
                                                    <TextBox Margin="0,5,0,8" MaxLength="64" Text="{Binding CustomerCode, UpdateSourceTrigger=PropertyChanged}" />
                                                    <Button Padding="12,7" HorizontalAlignment="Left" IsEnabled="{Binding CanApprove}" Click="Approve_OnClick" Content="Tạo khách mới &amp; kích hoạt" />
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="2" Padding="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                                                <StackPanel>
                                                    <TextBlock Text="Liên kết khách đã có" FontWeight="SemiBold" FontSize="15" />
                                                    <TextBlock Margin="0,6,0,8" Text="Chỉ dùng khi điểm bán đã có mã khách Công Ty." Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Text="Khách hàng" FontWeight="SemiBold" />
                                                    <ComboBox Margin="0,5,0,8"
                                                              ItemsSource="{Binding CustomerOptions}"
                                                              DisplayMemberPath="Label"
                                                              SelectedValuePath="Id"
                                                              SelectedValue="{Binding SelectedCustomerId, Mode=TwoWay}"
                                                              SelectionChanged="CustomerSelection_OnChanged" />
                                                    <TextBlock Text="Địa chỉ" FontWeight="SemiBold" />
                                                    <ComboBox Margin="0,5,0,8"
                                                              ItemsSource="{Binding AddressOptions}"
                                                              DisplayMemberPath="Label"
                                                              SelectedValuePath="Id"
                                                              SelectedValue="{Binding SelectedAddressId, Mode=TwoWay}" />
                                                    <Button Padding="12,7" HorizontalAlignment="Left" IsEnabled="{Binding CanLinkExisting}" Click="LinkExisting_OnClick" Content="Liên kết khách đã có" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <Border Margin="0,10,0,0" Padding="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                                            <StackPanel>
                                                <TextBlock Text="Yêu cầu bổ sung hoặc từ chối" FontWeight="SemiBold" FontSize="15" />
                                                <TextBlock Margin="0,8,0,0" Text="Lý do" FontWeight="SemiBold" />
                                                <TextBox Margin="0,5,0,8"
                                                         MinHeight="68"
                                                         MaxLength="2000"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         VerticalScrollBarVisibility="Auto"
                                                         Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" />
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Margin="0,0,8,0" Padding="12,7" IsEnabled="{Binding CanReview}" Click="NeedMoreInfo_OnClick" Content="Yêu cầu bổ sung" />
                                                    <Button Padding="12,7" IsEnabled="{Binding CanReject}" Click="Reject_OnClick" Content="Từ chối" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
