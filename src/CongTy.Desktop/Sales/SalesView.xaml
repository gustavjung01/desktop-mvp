                                            </DockPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.2*" />
                                                    <ColumnDefinition Width="145" />
                                                    <ColumnDefinition Width="1.25*" />
                                                    <ColumnDefinition Width="1.25*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,6,0">
                                                    <TextBlock Text="Ghi chú" FontSize="10" />
                                                    <TextBox Style="{StaticResource CompactFieldTextBoxStyle}" Text="{Binding DraftNote}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="6,0">
                                                    <TextBlock Text="CK toàn đơn" FontSize="10" />
