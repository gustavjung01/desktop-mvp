                            <StackPanel>
                                <TextBlock Text="{Binding InventoryHistorySummary}" FontWeight="SemiBold" />
                                <TextBlock Margin="0,3,0,0" Text="Lịch sử được lọc đúng SKU và kho đang xuất; dữ liệu đơn đang nhập vẫn được giữ nguyên." FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <DataGrid Grid.Row="2" Style="{StaticResource ListGridStyle}" ItemsSource="{Binding InventoryHistoryRows}" IsReadOnly="True" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Thời gian" Binding="{Binding Time}" Width="145" />
                                <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Biến động" Binding="{Binding Movement}" Width="155" />
                                <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Chứng từ" Binding="{Binding Document}" Width="120" />
                                <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="SL X/N" Binding="{Binding Quantity}" Width="100" />
                                <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Tồn sau" Binding="{Binding StockAfter}" Width="100" />
                                <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Vị trí / Lô" Binding="{Binding LocationLot}" Width="*" />
                                <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Người thực hiện" Binding="{Binding User}" Width="145" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
