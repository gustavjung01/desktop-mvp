                                <CheckBox Visibility="{Binding IsCreateEditor, Converter={StaticResource BooleanToVisibilityConverter}}" IsChecked="{Binding RememberWarehouseDefault}" Content="Nhớ kho" />
                                <CheckBox Margin="0,3,0,0" Visibility="{Binding IsCreateEditor, Converter={StaticResource BooleanToVisibilityConverter}}" IsChecked="{Binding RememberDeliveryDefault}" Content="Nhớ giao" />
                            </StackPanel>
                            <Grid Grid.Row="1" Grid.Column="6" Margin="6,5,0,0">
