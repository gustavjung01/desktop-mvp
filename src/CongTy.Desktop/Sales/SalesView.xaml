                                                        <TextBox Style="{StaticResource CompactFieldTextBoxStyle}" IsEnabled="{Binding CanDiscountOverride}"
                                                                 Text="{Binding DraftDocumentDiscountValue, UpdateSourceTrigger=PropertyChanged}" />
