                                                <StackPanel Grid.Column="2" Margin="5,0,0,0"><TextBlock Text="Số điện thoại" FontSize="10" /><TextBox Style="{StaticResource CompactFieldTextBoxStyle}" Text="{Binding QuickCustomerPhone}" /></StackPanel>
