                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource OfficeCardStyle}" Padding="8" Margin="0,0,0,6">
