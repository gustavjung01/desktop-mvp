<UserControl x:Class="CongTy.Desktop.Sales.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="900" MinHeight="560">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="PanelStyle" TargetType="Border" BasedOn="{StaticResource OfficeCardStyle}" />
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource OfficePrimaryButtonStyle}"><Setter Property="Margin" Value="3,0" /></Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource OfficeSecondaryButtonStyle}"><Setter Property="Margin" Value="3,0" /></Style>
        <Style x:Key="FieldTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource OfficeTextBoxStyle}"><Setter Property="Margin" Value="0,3,0,8" /></Style>
        <Style x:Key="FieldComboStyle" TargetType="ComboBox" BasedOn="{StaticResource OfficeComboBoxStyle}"><Setter Property="Margin" Value="0,3,0,8" /></Style>
        <Style x:Key="CompactFieldTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource OfficeTextBoxStyle}"><Setter Property="Margin" Value="0,2,0,0" /><Setter Property="Padding" Value="7,4" /></Style>
        <Style x:Key="CompactFieldComboStyle" TargetType="ComboBox" BasedOn="{StaticResource OfficeComboBoxStyle}"><Setter Property="Margin" Value="0,2,0,0" /><Setter Property="Padding" Value="5,3" /></Style>
        <Style x:Key="InlineEditorTextBoxStyle" TargetType="TextBox">
            <Setter Property="MinHeight" Value="28" /><Setter Property="Margin" Value="2,0" /><Setter Property="Padding" Value="3,2" /><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="BorderThickness" Value="0,0,0,1" /><Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Underline" Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" /></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Underline" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="InlineEditorComboStyle" TargetType="ComboBox" BasedOn="{StaticResource OfficeComboBoxStyle}"><Setter Property="MinHeight" Value="28" /><Setter Property="Margin" Value="2,0" /><Setter Property="Padding" Value="3,2" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0,0,0,1" /></Style>
        <Style x:Key="InlineStepButtonStyle" TargetType="Button"><Setter Property="MinWidth" Value="22" /><Setter Property="MinHeight" Value="24" /><Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Cursor" Value="Hand" /></Style>
        <Style x:Key="InlineLinkButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /><Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Cursor" Value="Hand" /><Setter Property="FontSize" Value="10" /><Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="TextBlock.TextDecorations" Value="Underline" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="TextBlock.TextDecorations" Value="Underline" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SearchResultCardButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="MinHeight" Value="48" /><Setter Property="Padding" Value="10,6" /><Setter Property="Margin" Value="0,2" /><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource RowHoverBrush}" /><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SearchResultListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style x:Key="SearchResultListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource RowHoverBrush}" /><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource AccentSoftBrush}" /><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Card" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SkuSearchResultListBoxItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource SearchResultListBoxItemStyle}">
            <Setter Property="IsEnabled" Value="{Binding Selectable}" />
        </Style>
        <Style x:Key="OrderLineRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource OfficeDataGridRowStyle}">
            <Setter Property="Height" Value="Auto" />
            <Setter Property="MinHeight" Value="64" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="ListGridStyle" TargetType="DataGrid" BasedOn="{StaticResource OfficeDataGridStyle}" />
        <Style x:Key="OrderLaneTextStyle" TargetType="TextBlock" BasedOn="{StaticResource OfficeGridTextStyle}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding LaneKey}" Value="counter"><Setter Property="Foreground" Value="#806A48" /></DataTrigger>
                <DataTrigger Binding="{Binding LaneKey}" Value="manual"><Setter Property="Foreground" Value="#4B7189" /></DataTrigger>
                <DataTrigger Binding="{Binding LaneKey}" Value="trip"><Setter Property="Foreground" Value="#58745F" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OrderStageTextStyle" TargetType="TextBlock" BasedOn="{StaticResource OfficeGridTextStyle}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StageKey}" Value="active"><Setter Property="Foreground" Value="#4B7189" /></DataTrigger>
                <DataTrigger Binding="{Binding StageKey}" Value="preparing"><Setter Property="Foreground" Value="#8A6D3F" /></DataTrigger>
                <DataTrigger Binding="{Binding StageKey}" Value="waiting_delivery"><Setter Property="Foreground" Value="#656B8C" /></DataTrigger>
                <DataTrigger Binding="{Binding StageKey}" Value="completed"><Setter Property="Foreground" Value="#58745F" /></DataTrigger>
                <DataTrigger Binding="{Binding StageKey}" Value="cancelled"><Setter Property="Foreground" Value="#985C5C" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MessageBorderStyle" TargetType="Border" BasedOn="{StaticResource OfficeCardStyle}">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Padding" Value="8" />
            <Style.Triggers><DataTrigger Binding="{Binding MessageIsError}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" /></DataTrigger></Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

        <UniformGrid Grid.Row="0" Columns="5" Margin="0,0,0,8">
            <Border Style="{StaticResource OfficeSummaryCardStyle}" Margin="0,0,4,0">
                <DockPanel LastChildFill="False"><StackPanel DockPanel.Dock="Left"><TextBlock Text="Tổng số đơn" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Text="Trong phạm vi được cấp" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" /></StackPanel><TextBlock DockPanel.Dock="Right" Text="{Binding TotalCount}" Margin="10,0,0,0" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel>
            </Border>
            <Border Style="{StaticResource OfficeSummaryCardStyle}" Margin="2,0">
                <DockPanel LastChildFill="False"><StackPanel DockPanel.Dock="Left"><TextBlock Text="Đang xử lý" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Text="Đặt hàng / cần xử lý" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" /></StackPanel><TextBlock DockPanel.Dock="Right" Text="{Binding ActiveCount}" Margin="10,0,0,0" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel>
            </Border>
            <Border Style="{StaticResource OfficeSummaryCardStyle}" Margin="2,0">
                <DockPanel LastChildFill="False"><StackPanel DockPanel.Dock="Left"><TextBlock Text="Đang chuẩn bị" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Text="Đã giữ / đang chuẩn bị" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" /></StackPanel><TextBlock DockPanel.Dock="Right" Text="{Binding PreparingCount}" Margin="10,0,0,0" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel>
            </Border>
            <Border Style="{StaticResource OfficeSummaryCardStyle}" Margin="2,0">
                <DockPanel LastChildFill="False"><StackPanel DockPanel.Dock="Left"><TextBlock Text="Chờ giao" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Text="Đã xuất / đang giao" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" /></StackPanel><TextBlock DockPanel.Dock="Right" Text="{Binding WaitingDeliveryCount}" Margin="10,0,0,0" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel>
            </Border>
            <Border Style="{StaticResource OfficeSummaryCardStyle}" Margin="4,0,0,0">
                <DockPanel LastChildFill="False"><StackPanel DockPanel.Dock="Left"><TextBlock Text="Đã hoàn thành" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Text="Đã đóng / đã giao" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" /></StackPanel><TextBlock DockPanel.Dock="Right" Text="{Binding CompletedCount}" Margin="10,0,0,0" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="1" Style="{StaticResource PanelStyle}" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="165" /><ColumnDefinition Width="170" /><ColumnDefinition Width="170" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,10,0"><TextBlock Text="Tìm đơn" FontWeight="SemiBold" /><TextBox Style="{StaticResource FieldTextBoxStyle}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Số đơn, khách hàng, kho hoặc kênh bán" /></StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Hình thức giao" FontWeight="SemiBold" /><ComboBox Style="{StaticResource FieldComboStyle}" ItemsSource="{Binding LaneOptions}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding LaneFilter}" /></StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Text="Trạng thái giao" FontWeight="SemiBold" /><ComboBox Style="{StaticResource FieldComboStyle}" ItemsSource="{Binding StageOptions}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding StageFilter}" /></StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,10,0"><TextBlock Text="Nguồn" FontWeight="SemiBold" /><ComboBox Style="{StaticResource FieldComboStyle}" ItemsSource="{Binding SourceOptions}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding SourceFilter}" /></StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8">
                    <Button Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding IsNotBusy}" Click="Refresh_OnClick" Content="Làm mới" />
                    <Button Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding CanCreate}" Click="Create_OnClick" Content="Tạo đơn bán hàng" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="1.15*" /></Grid.ColumnDefinitions>
            <DataGrid Grid.Column="0" Style="{StaticResource ListGridStyle}" ItemsSource="{Binding OrderRows}">
                <DataGrid.Columns>
                    <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="STT" Binding="{Binding Stt}" Width="48" />
                    <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Số đơn" Binding="{Binding Number}" Width="88" />
                    <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Khách hàng" Binding="{Binding Customer}" Width="2*" />
                    <DataGridTemplateColumn Header="Luồng" Width="105"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock VerticalAlignment="Center" Style="{StaticResource OrderLaneTextStyle}" Text="{Binding Lane}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Trạng thái" Width="118"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock VerticalAlignment="Center" Style="{StaticResource OrderStageTextStyle}" Text="{Binding Stage}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Tổng tiền" Binding="{Binding Total}" Width="112" />
                    <DataGridTemplateColumn Header="" Width="64"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button VerticalAlignment="Center" Style="{StaticResource OfficeRowActionButtonStyle}" Tag="{Binding Id}" Click="OpenOrder_OnClick" Content="Xem" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="2" Style="{StaticResource PanelStyle}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                    <Grid Visibility="{Binding HasSelectedOrder, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left"><TextBlock Text="{Binding SelectedNumber}" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="{Binding SelectedCustomer}" Margin="0,2,0,0" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Text="{Binding SelectedWarehouse}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" /></StackPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedTotal}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <UniformGrid Grid.Row="1" Columns="4" Margin="0,9,0,0">
                            <StackPanel><TextBlock Text="Đơn hàng" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Text="{Binding SelectedOrderStatus}" FontWeight="SemiBold" /></StackPanel>
                            <StackPanel><TextBlock Text="Chuẩn bị hàng" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Text="{Binding SelectedFulfillmentStatus}" FontWeight="SemiBold" /></StackPanel>
                            <StackPanel><TextBlock Text="Giao hàng" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Text="{Binding SelectedDeliveryStatus}" FontWeight="SemiBold" /></StackPanel>
                            <StackPanel><TextBlock Text="Thanh toán" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Text="{Binding SelectedSettlementStatus}" FontWeight="SemiBold" /></StackPanel>
                        </UniformGrid>
                    </Grid>

                    <Border Grid.Row="1" Margin="0,10,0,8" Background="{DynamicResource AccentSoftBrush}" CornerRadius="7" Padding="8"
                            Visibility="{Binding HasSelectedOrder, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Hình thức giao" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Text="{Binding SelectedLane}" /></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="Thu tiền" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Text="{Binding SelectedCollection}" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Còn phải thu" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Text="{Binding SelectedReceivable}" /></StackPanel>
                        </Grid>
                    </Border>

                    <TabControl Grid.Row="2" Style="{StaticResource OfficeTabControlStyle}" Margin="0,0,0,6">
                        <TabItem Header="Dòng hàng">
                            <DataGrid Margin="0,7,0,0" Style="{StaticResource ListGridStyle}" ItemsSource="{Binding DetailLineRows}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="STT" Binding="{Binding LineNumber}" Width="52" />
                                    <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="SKU" Binding="{Binding Sku}" Width="105" />
                                    <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Sản phẩm" Binding="{Binding Item}" Width="*" />
                                    <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="SL" Binding="{Binding Quantity}" Width="95" />
                                    <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Tồn thực tế" Binding="{Binding OnHand}" Width="105" />
                                    <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Đơn khác đang giữ" Binding="{Binding HeldByOthers}" Width="125" />
                                    <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Khả dụng cho đơn này" Binding="{Binding Available}" Width="135" />
                                    <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Đơn giá" Binding="{Binding UnitPrice}" Width="105" />
                                    <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Thành tiền" Binding="{Binding Total}" Width="115" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="Lịch sử phiên bản">
                            <DataGrid Margin="0,7,0,0" Style="{StaticResource ListGridStyle}" ItemsSource="{Binding VersionRows}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Phiên bản" Binding="{Binding Version}" Width="80" />
                                    <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Trạng thái" Binding="{Binding Status}" Width="110" />
                                    <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Lý do" Binding="{Binding Reason}" Width="*" />
                                    <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Tổng tiền" Binding="{Binding Total}" Width="120" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>

                    <StackPanel Grid.Row="3" Visibility="{Binding HasSelectedOrder, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <WrapPanel HorizontalAlignment="Right">
                            <Button Style="{StaticResource SecondaryButtonStyle}" Visibility="{Binding CanCopySelected, Converter={StaticResource BooleanToVisibilityConverter}}" Click="CopyOrder_OnClick" Content="Sao chép đơn" />
                            <Button Style="{StaticResource SecondaryButtonStyle}" Visibility="{Binding CanPrintSelected, Converter={StaticResource BooleanToVisibilityConverter}}" Click="PrintOrder_OnClick" Content="In đơn" />
                            <Button Style="{StaticResource SecondaryButtonStyle}" Visibility="{Binding CanEditSelectedDraft, Converter={StaticResource BooleanToVisibilityConverter}}" Click="EditDraft_OnClick" Content="Sửa đơn nháp" />
                            <Button Style="{StaticResource PrimaryButtonStyle}" Visibility="{Binding CanConfirmSelected, Converter={StaticResource BooleanToVisibilityConverter}}" Click="Confirm_OnClick" Content="Xác nhận &amp; cấp số" />
                            <Button Style="{StaticResource SecondaryButtonStyle}" Visibility="{Binding CanEditManual, Converter={StaticResource BooleanToVisibilityConverter}}" Click="EditManual_OnClick" Content="Sửa đơn" />
                            <Button Style="{StaticResource PrimaryButtonStyle}" Visibility="{Binding CanIssueSelectedStock, Converter={StaticResource BooleanToVisibilityConverter}}" Click="IssueStock_OnClick" Content="Xuất kho" />
                            <Button Style="{StaticResource SecondaryButtonStyle}" Visibility="{Binding CanEditAmendment, Converter={StaticResource BooleanToVisibilityConverter}}" Click="EditAmendment_OnClick" Content="Sửa bản điều chỉnh" />
                            <Button Style="{StaticResource PrimaryButtonStyle}" Visibility="{Binding CanConfirmAmendment, Converter={StaticResource BooleanToVisibilityConverter}}" Click="ConfirmAmendment_OnClick" Content="Xác nhận điều chỉnh" />
                        </WrapPanel>

                        <Grid Margin="0,6,0,0" Visibility="{Binding CanCreateAmendment, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource FieldTextBoxStyle}" Text="{Binding AmendmentReason}" ToolTip="Lý do điều chỉnh" />
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Top" Click="CreateAmendment_OnClick" Content="Tạo bản điều chỉnh" />
                        </Grid>

                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource FieldTextBoxStyle}" Text="{Binding CancellationReason}" ToolTip="Lý do hủy hoặc kết thúc phần chưa giao" />
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Visibility="{Binding CanCloseExecution, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Top" Click="CloseExecution_OnClick" Content="Kết thúc phần chưa giao" />
                            <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Visibility="{Binding CanCancelSelected, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Top" Click="CancelOrder_OnClick" Content="Hủy đơn" />
                        </Grid>

                        <Border Style="{StaticResource OfficeCardStyle}" Margin="0,4,0,0" Visibility="{Binding ShowDirectSettlement, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Hoàn thành đơn và Nộp tiền / Nợ" FontWeight="SemiBold" />
                                <TextBlock Text="Xuất kho đã xong. Hoàn thành đơn ghi nhận doanh số và khoản phải thu; tiền thu hoặc nợ được xử lý riêng." FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                <WrapPanel Margin="0,6,0,0"><Button Style="{StaticResource PrimaryButtonStyle}" Visibility="{Binding CanCompleteDirect, Converter={StaticResource BooleanToVisibilityConverter}}" Click="CompleteDirect_OnClick" Content="Hoàn thành đơn" /></WrapPanel>
                                <Grid Margin="0,6,0,0" Visibility="{Binding CanSettleDirect, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0"><TextBlock Text="Số tiền thực nộp / đã thu" FontWeight="SemiBold" /><TextBox Style="{StaticResource FieldTextBoxStyle}" Text="{Binding PaidAmount}" /></StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Hình thức nhận tiền" FontWeight="SemiBold" /><ComboBox Style="{StaticResource FieldComboStyle}" ItemsSource="{Binding PaymentMethodOptions}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding PaymentMethod}" /></StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom" Margin="0,0,0,8" Click="FillRemaining_OnClick" Content="Nộp đủ" />
                                    <Button Grid.Column="3" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom" Margin="3,0,0,8" Click="SettleDirect_OnClick" Content="Nộp tiền / Nợ" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.RowSpan="4" Panel.ZIndex="20" Background="#88000000" Visibility="{Binding IsEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}" PreviewKeyDown="EditorOverlay_OnPreviewKeyDown">
            <Border Margin="14" MaxWidth="1380" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Style="{StaticResource PanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding EditorTitle}" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
