                                <ComboBox Style="{StaticResource CompactFieldComboStyle}" IsEnabled="{Binding IsExistingCustomer}" ItemsSource="{Binding AddressOptions}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding DraftAddressId}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Margin="6,5,0,0">
