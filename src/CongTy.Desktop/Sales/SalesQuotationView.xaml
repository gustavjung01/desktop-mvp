<UserControl x:Class="CongTy.Desktop.Sales.SalesQuotationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="SalesQuotationView_OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16">
            <Border Style="{StaticResource OfficeCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Báo giá" />
                        <TextBlock Margin="0,5,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="Chọn khách hàng, phạm vi hàng hóa và điều kiện bán; hệ thống tính mức giá đang có hiệu lực. Giá chỉnh trên báo giá chỉ áp dụng cho file báo giá này, không thay đổi bảng giá Công Ty." />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Margin="16,0,0,0"
                            VerticalAlignment="Top"
                            Style="{StaticResource OfficeSecondaryButtonStyle}"
                            Click="OpenSalesOrders_OnClick"
                            Content="Đơn bán hàng" />
                </Grid>
            </Border>

            <Border Margin="0,12,0,0"
                    Padding="12"
                    Background="{DynamicResource AccentSoftBrush}"
                    CornerRadius="8"
                    Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                    <Setter Property="Foreground" Value="Firebrick" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource OfficeCardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" Background="{DynamicResource AccentSoftBrush}" CornerRadius="15">
                                <TextBlock Text="1" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="Khách hàng và điều kiện bán" />
                                <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                                           Text="Có thể để trống khách hàng để xem mức giá chung đang áp dụng." />
                            </StackPanel>
                        </Grid>

                        <TextBlock Margin="0,14,0,4" FontWeight="SemiBold" Text="Tìm khách hàng" />
                        <TextBox Text="{Binding CustomerSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Nhập mã hoặc tên khách hàng" />
                        <Border Margin="0,4,0,0"
                                Padding="6"
                                BorderBrush="LightGray"
                                BorderThickness="1"
                                CornerRadius="6"
                                Visibility="{Binding IsCustomerSearchActive, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding CustomerResults}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2,2">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Code}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Padding="10,4" Tag="{Binding}" Click="SelectCustomer_OnClick"
                                                        Style="{StaticResource OfficeSecondaryButtonStyle}" Content="Chọn" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Margin="4" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Visibility="{Binding CustomerSearchEmpty, Converter={StaticResource BoolToVisibility}}"
                                           Text="Không tìm thấy khách hàng phù hợp." />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,8,0,0"
                                Padding="10"
                                Background="{DynamicResource WindowBackgroundBrush}"
                                CornerRadius="8"
                                Visibility="{Binding HasSelectedCustomer, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding SelectedCustomerDisplay}" />
                                    <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="Khách hàng đang áp dụng cho báo giá" />
                                </StackPanel>
                                <Button Grid.Column="1" Padding="10,4" Style="{StaticResource OfficeSecondaryButtonStyle}"
                                        Click="ClearCustomer_OnClick" Content="Bỏ chọn" />
                            </Grid>
                        </Border>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="Kênh bán" />
                                <ComboBox ItemsSource="{Binding Channels}" DisplayMemberPath="Display" SelectedValuePath="Id"
                                          SelectedValue="{Binding ChannelId, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="Nhóm khách" />
                                <ComboBox IsEnabled="{Binding CustomerGroupEnabled}" ItemsSource="{Binding CustomerGroups}"
                                          DisplayMemberPath="Display" SelectedValuePath="Id"
                                          SelectedValue="{Binding CustomerGroupId, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Margin="0,12,0,4" FontWeight="SemiBold" Text="Số lượng áp dụng cho mỗi mã hàng" />
                        <TextBox Width="180" HorizontalAlignment="Left"
                                 Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource OfficeCardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" Background="{DynamicResource AccentSoftBrush}" CornerRadius="15">
                                <TextBlock Text="2" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="Hàng hóa cần báo giá" />
                                <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                                           Text="Chọn phạm vi đủ hẹp để báo giá dễ kiểm tra và gửi cho khách." />
                            </StackPanel>
                        </Grid>

                        <TextBlock Margin="0,14,0,4" FontWeight="SemiBold" Text="Phạm vi hàng hóa" />
                        <WrapPanel>
                            <RadioButton Margin="0,0,14,6" Content="Tất cả" IsChecked="{Binding IsAllScope, Mode=TwoWay}" />
                            <RadioButton Margin="0,0,14,6" Content="Theo nhóm" IsChecked="{Binding IsCategoryScope, Mode=TwoWay}" />
                            <RadioButton Margin="0,0,0,6" Content="Theo mã hàng" IsChecked="{Binding IsSkuScope, Mode=TwoWay}" />
                        </WrapPanel>

                        <StackPanel Margin="0,10,0,0"
                                    Visibility="{Binding IsCategoryScope, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="Ngành hoặc nhóm sản phẩm" />
                            <ComboBox ItemsSource="{Binding Categories}" DisplayMemberPath="Display" SelectedValuePath="Id"
                                      SelectedValue="{Binding CategoryId, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Margin="0,10,0,0"
                                    Visibility="{Binding IsSkuScope, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="Tìm sản phẩm / mã hàng" />
                            <TextBox Text="{Binding SkuSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewKeyDown="SkuSearch_OnPreviewKeyDown"
                                     ToolTip="Tên sản phẩm, mã hàng, SKU hoặc barcode" />
                            <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding SkuSearchStatus}" />
                            <Border Margin="0,5,0,0" Padding="6" BorderBrush="LightGray" BorderThickness="1" CornerRadius="6"
                                    Visibility="{Binding IsSkuSearchActive, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl ItemsSource="{Binding SkuResults}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2,3">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Display}" TextWrapping="Wrap" />
                                                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Detail}" TextWrapping="Wrap" />
                                                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding EligibilityMessage}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Padding="10,4" Tag="{Binding}" Click="AddSku_OnClick"
                                                        IsEnabled="{Binding Selectable}" Style="{StaticResource OfficeSecondaryButtonStyle}" Content="Thêm" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding SelectedSkus}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,5" Padding="8" Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="7">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Display}" />
                                                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding UnitCode}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Padding="9,3" Tag="{Binding Id}" Click="RemoveSku_OnClick"
                                                        Style="{StaticResource OfficeSecondaryButtonStyle}" Content="Bỏ" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Border Margin="0,12,0,0" Padding="10" Background="{DynamicResource AccentSoftBrush}" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="Phạm vi hiện tại" />
                                <TextBlock Margin="0,3,0,0" FontWeight="SemiBold" Text="{Binding ScopeDescription}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Margin="0,12,0,0" Style="{StaticResource OfficeCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="{Binding StatusText}" />
                        <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                                   Text="Giá hệ thống là giá đề xuất ban đầu. Có thể chỉnh trực tiếp từng dòng trên báo giá mà không thay đổi bảng giá Công Ty." />
                    </StackPanel>
                    <WrapPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <Button Margin="4,0" Style="{StaticResource OfficePrimaryButtonStyle}" IsEnabled="{Binding CanBuild}"
                                Click="BuildQuotation_OnClick" Content="Tính báo giá" />
                        <Button Margin="4,0" Style="{StaticResource OfficeSecondaryButtonStyle}" IsEnabled="{Binding CanExport}"
                                Click="ExportXlsx_OnClick" Content="Xuất Excel" />
                        <Button Margin="4,0" Style="{StaticResource OfficeSecondaryButtonStyle}" IsEnabled="{Binding CanExport}"
                                Click="ExportCsv_OnClick" Content="Xuất CSV" />
                    </WrapPanel>
                </Grid>
            </Border>

            <Border Margin="0,12,0,0" Style="{StaticResource OfficeCardStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="KẾT QUẢ" FontWeight="SemiBold" />
                            <TextBlock Margin="0,2,0,0" FontSize="16" FontWeight="SemiBold" Text="Bảng giá áp dụng" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold"
                                   Text="{Binding ResultContext}" Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>

                    <Grid Margin="0,12,0,10" Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Padding="10" Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="8">
                            <StackPanel><TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="Mã hàng" /><TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding RowCountText}" /></StackPanel>
                        </Border>
                        <Border Grid.Column="2" Padding="10" Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="8">
                            <StackPanel><TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="Đã có giá" /><TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding PricedCountText}" /></StackPanel>
                        </Border>
                        <Border Grid.Column="4" Padding="10" Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="8">
                            <StackPanel><TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="Tổng giá trị" /><TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding TotalValueText}" /></StackPanel>
                        </Border>
                    </Grid>

                    <DataGrid Height="390"
                              ItemsSource="{Binding Rows}"
                              Style="{StaticResource OfficeDataGridStyle}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="False"
                              Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibility}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã hàng" Width="1*" Binding="{Binding Sku}" IsReadOnly="True" />
                            <DataGridTextColumn Header="Sản phẩm / quy cách" Width="2*" Binding="{Binding ProductDisplay}" IsReadOnly="True" />
                            <DataGridTextColumn Header="Số lượng" Width="0.8*" Binding="{Binding Quantity}" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="Đơn giá" Width="1.3*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBox Text="{Binding UnitPriceInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     HorizontalContentAlignment="Right" />
                                            <Button Margin="0,3,0,0" Padding="6,2" HorizontalAlignment="Right"
                                                    Tag="{Binding}" Click="UseSystemPrice_OnClick"
                                                    Style="{StaticResource OfficeSecondaryButtonStyle}"
                                                    Visibility="{Binding HasManualPrice, Converter={StaticResource BoolToVisibility}}"
                                                    Content="Giá hệ thống" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Thành tiền" Width="1.2*" Binding="{Binding LineTotalDisplay}" IsReadOnly="True" />
                            <DataGridTextColumn Header="Nguồn giá" Width="1.4*" Binding="{Binding PriceSource}" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Padding="18" Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="8"
                            Visibility="{Binding NoRows, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock FontSize="24" HorizontalAlignment="Center" Text="₫" />
                            <TextBlock Margin="0,5,0,0" FontWeight="SemiBold" HorizontalAlignment="Center" Text="Chưa có kết quả báo giá" />
                            <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center"
                                       Text="Chọn điều kiện bán và phạm vi hàng hóa, sau đó bấm “Tính báo giá”." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
