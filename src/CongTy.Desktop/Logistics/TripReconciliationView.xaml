<UserControl x:Class="CongTy.Desktop.Logistics.TripReconciliationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             Loaded="TripReconciliationView_OnLoaded"
             PreviewKeyDown="TripReconciliationView_OnPreviewKeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="ReconciliationTripListItemStyle"
               TargetType="ListBoxItem"
               BasedOn="{StaticResource OfficeListBoxItemStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="10" Margin="0,0,0,8">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource OfficeCardStyle}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasMessage}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource OfficeCardStyle}" Padding="9">
                <StackPanel><TextBlock Text="1 · Chọn chuyến" FontWeight="SemiBold" /><TextBlock Margin="0,3,0,0" Text="{Binding StepOneState}" Foreground="{DynamicResource TextSecondaryBrush}" /></StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource OfficeCardStyle}" Padding="9">
                <StackPanel><TextBlock Text="2 · Kiểm tra chênh lệch" FontWeight="SemiBold" /><TextBlock Margin="0,3,0,0" Text="{Binding StepTwoState}" Foreground="{DynamicResource TextSecondaryBrush}" /></StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource OfficeCardStyle}" Padding="9">
                <StackPanel><TextBlock Text="3 · Nhận hàng trả về" FontWeight="SemiBold" /><TextBlock Margin="0,3,0,0" Text="{Binding StepThreeState}" Foreground="{DynamicResource TextSecondaryBrush}" /></StackPanel>
            </Border>
            <Border Grid.Column="6" Style="{StaticResource OfficeCardStyle}" Padding="9">
                <StackPanel><TextBlock Text="4 · Đóng chuyến" FontWeight="SemiBold" /><TextBlock Margin="0,3,0,0" Text="{Binding StepFourState}" Foreground="{DynamicResource TextSecondaryBrush}" /></StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource OfficeCardStyle}">
                <DockPanel LastChildFill="True">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="BƯỚC 1" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Margin="0,3,0,0" Text="Chọn chuyến" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Margin="0,3,0,0" Text="Ưu tiên chuyến cần đối soát; chuyến đủ điều kiện có thể đóng ngay." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource OfficeMiniButtonStyle}" IsEnabled="{Binding IsNotBusy}" Click="Refresh_OnClick" Content="{Binding RefreshButtonText}" />
                    </Grid>

                    <ListBox ItemsSource="{Binding Trips}"
                             SelectedItem="{Binding SelectedTripRow, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource ReconciliationTripListItemStyle}"
                             BorderThickness="0"
                             Background="Transparent"
                             IsEnabled="{Binding IsNotBusy}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6" Padding="9" Style="{StaticResource OfficeCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Number}" FontWeight="SemiBold" />
                                        <TextBlock Margin="0,3,0,0" Text="{Binding WarehouseDriver}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,2,0,0" Text="{Binding VehicleStatus}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" Text="Chưa có chuyến cần đối soát." Foreground="{DynamicResource TextSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers><DataTrigger Binding="{Binding HasTrips}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource OfficeCardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="BƯỚC 2–4" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Margin="0,3,0,0" Text="{Binding DetailNumber}" FontSize="17" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Margin="0,0,8,0" Style="{StaticResource OfficeMiniButtonStyle}" Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" IsEnabled="{Binding CanPrint}" Click="Print_OnClick" Content="In đối soát" />
                                <TextBlock Text="{Binding DetailStatus}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource OfficeSummaryCardStyle}">
                                    <StackPanel><TextBlock Style="{StaticResource OfficeSummaryLabelStyle}" Text="Kho" /><TextBlock Style="{StaticResource OfficeSummaryValueStyle}" Text="{Binding WarehouseText}" /></StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource OfficeSummaryCardStyle}">
                                    <StackPanel><TextBlock Style="{StaticResource OfficeSummaryLabelStyle}" Text="Tài xế" /><TextBlock Style="{StaticResource OfficeSummaryValueStyle}" Text="{Binding DriverText}" TextWrapping="Wrap" /></StackPanel>
                                </Border>
                                <Border Grid.Column="4" Style="{StaticResource OfficeSummaryCardStyle}">
                                    <StackPanel><TextBlock Style="{StaticResource OfficeSummaryLabelStyle}" Text="Xe" /><TextBlock Style="{StaticResource OfficeSummaryValueStyle}" Text="{Binding VehicleText}" /></StackPanel>
                                </Border>
                            </Grid>

                            <Border Margin="0,0,0,9" Padding="10" Style="{StaticResource OfficeCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="160" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="VIỆC TIẾP THEO" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Margin="0,3,0,0" Text="{Binding NextActionTitle}" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Margin="0,3,0,0" Text="{Binding NextActionDescription}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                        <Button Margin="0,8,0,0" HorizontalAlignment="Left" Style="{StaticResource OfficeSecondaryButtonStyle}" Visibility="{Binding HasMissingResults, Converter={StaticResource BoolToVisibility}}" Click="DeliveryAttempts_OnClick" Content="Mở kết quả lần giao" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding OutstandingCount}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        <TextBlock Text="Dòng còn trên xe" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Margin="0,8,0,0" Text="{Binding MissingResultCount}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        <TextBlock Text="Dòng chưa có kết quả" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Text="BƯỚC 2 · KIỂM TRA CHÊNH LỆCH" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Grid Margin="0,5,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.3*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="0.8*" /><ColumnDefinition Width="0.8*" /><ColumnDefinition Width="0.8*" /><ColumnDefinition Width="0.8*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Phiếu / hàng" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="Kết quả" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" Text="Xuất" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="Đã giao" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="Đã về" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="5" Text="Còn xe" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Lines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,4" Padding="8" Style="{StaticResource OfficeCardStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2.3*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="0.8*" /><ColumnDefinition Width="0.8*" /><ColumnDefinition Width="0.8*" /><ColumnDefinition Width="0.8*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel><TextBlock Text="{Binding NumberItem}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Margin="0,2,0,0" Text="{Binding SourceText}" Foreground="{DynamicResource TextSecondaryBrush}" /></StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding ResultText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="2" Text="{Binding Issued}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{Binding Delivered}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                <TextBlock Grid.Column="4" Text="{Binding Returned}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                <TextBlock Grid.Column="5" Text="{Binding Outstanding}" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Margin="0,8,0,0" Padding="10" Style="{StaticResource OfficeCardStyle}" Visibility="{Binding IsDispatched, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="BƯỚC 3" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Margin="0,3,0,0" Text="Nhận hàng trả về" FontSize="15" FontWeight="SemiBold" /></StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding OutstandingSummary}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Grid>
                                    <StackPanel Margin="0,8,0,0" Visibility="{Binding HasOutstanding, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Nhập số lượng kho thực nhận. Chỉ khi hàng còn trên xe về 0 mới có thể đóng chuyến." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                        <ItemsControl Margin="0,7,0,0" ItemsSource="{Binding Lines}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,5">
                                                        <Grid.Style>
                                                            <Style TargetType="Grid">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers><DataTrigger Binding="{Binding HasOutstanding}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                            </Style>
                                                        </Grid.Style>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Data.Sku, StringFormat={}{0} · số còn trên xe}" VerticalAlignment="Center" />
                                                        <TextBox Grid.Column="1" Style="{StaticResource OfficeTextBoxStyle}" Text="{Binding ReturnQuantity, UpdateSourceTrigger=PropertyChanged}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Grid Margin="0,5,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="Thời điểm kho nhận" FontWeight="SemiBold" /><TextBox Margin="0,3,0,0" Style="{StaticResource OfficeTextBoxStyle}" ToolTip="yyyy-MM-dd HH:mm" Text="{Binding ReceivedAtText, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock Text="Ghi chú" FontWeight="SemiBold" /><TextBox Margin="0,3,0,0" Style="{StaticResource OfficeTextBoxStyle}" MaxLength="2000" Text="{Binding ReceiptNote, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                        </Grid>
                                        <Button Margin="0,8,0,0" HorizontalAlignment="Left" Style="{StaticResource OfficePrimaryButtonStyle}" Visibility="{Binding CanReceive, Converter={StaticResource BoolToVisibility}}" IsEnabled="{Binding CanReceiveAction}" Click="Receive_OnClick" Content="{Binding ReceiveButtonText}" />
                                    </StackPanel>
                                    <TextBlock Margin="0,7,0,0" Text="Không còn hàng trên xe cần kho nhận lại." Foreground="{DynamicResource TextSecondaryBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasOutstanding}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,8,0,0" Padding="10" Style="{StaticResource OfficeCardStyle}" Visibility="{Binding IsDispatched, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="BƯỚC 4" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Margin="0,3,0,0" Text="Chốt đối soát &amp; đóng chuyến" FontSize="15" FontWeight="SemiBold" /></StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding StepFourState}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Margin="0,7,0,0" Text="Chỉ chốt khi mọi phiếu đã có kết quả và toàn bộ số lượng đã giao hoặc đã về kho." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,6,0,0" Text="{Binding CloseBlockedReason}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Visibility="{Binding HasCloseBlockedReason, Converter={StaticResource BoolToVisibility}}" />
                                    <Grid Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="Thời điểm đóng" FontWeight="SemiBold" /><TextBox Margin="0,3,0,0" Style="{StaticResource OfficeTextBoxStyle}" ToolTip="yyyy-MM-dd HH:mm" Text="{Binding ClosedAtText, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="Ghi chú" FontWeight="SemiBold" /><TextBox Margin="0,3,0,0" Style="{StaticResource OfficeTextBoxStyle}" MaxLength="2000" Text="{Binding CloseNote, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                    </Grid>
                                    <Button Margin="0,8,0,0" HorizontalAlignment="Left" Style="{StaticResource OfficePrimaryButtonStyle}" Visibility="{Binding CanClose, Converter={StaticResource BoolToVisibility}}" IsEnabled="{Binding CanCloseAction}" Click="Close_OnClick" Content="{Binding CloseButtonText}" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,8,0,0" Padding="10" Style="{StaticResource OfficeCardStyle}" Visibility="{Binding IsClosed, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel><TextBlock Text="ĐÃ ĐÓNG CHUYẾN" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Margin="0,3,0,0" Text="Đối soát đã hoàn tất; dữ liệu chuyến chỉ đọc." FontWeight="SemiBold" /></StackPanel>
                            </Border>

                            <Border Margin="0,8,0,0" Padding="10" Style="{StaticResource OfficeCardStyle}" Visibility="{Binding HasReceipts, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="LỊCH SỬ KHO NHẬN LẠI" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <ItemsControl Margin="0,7,0,0" ItemsSource="{Binding Receipts}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding ReceivedAt}" FontWeight="SemiBold" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="Mã nhập kho" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        <TextBlock Margin="0,2,0,0" Text="{Binding Movement}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding Summary}" TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock Margin="0,16,0,0" HorizontalAlignment="Center" Text="Chưa chọn chuyến. Chọn một chuyến bên trái để xem việc cần xử lý." Foreground="{DynamicResource TextSecondaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasDetail}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
