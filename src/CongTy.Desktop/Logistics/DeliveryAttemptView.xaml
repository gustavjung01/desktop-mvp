<UserControl x:Class="CongTy.Desktop.Logistics.DeliveryAttemptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             Loaded="DeliveryAttemptView_OnLoaded"
             PreviewKeyDown="DeliveryAttemptView_OnPreviewKeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="AttemptTripListItemStyle"
               TargetType="ListBoxItem"
               BasedOn="{StaticResource OfficeListBoxItemStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="10" Margin="0,0,0,8">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource OfficeCardStyle}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasMessage}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource OfficeCardStyle}">
                <DockPanel LastChildFill="True">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="CHUYẾN ĐÃ XUẤT PHÁT"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Margin="0,3,0,0"
                                       Text="Chọn chuyến cần theo dõi"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Style="{StaticResource OfficeMiniButtonStyle}"
                                IsEnabled="{Binding IsNotBusy}"
                                Click="Refresh_OnClick"
                                Content="{Binding RefreshButtonText}" />
                    </Grid>

                    <ListBox ItemsSource="{Binding Trips}"
                             SelectedItem="{Binding SelectedTripRow, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource AttemptTripListItemStyle}"
                             BorderThickness="0"
                             Background="Transparent"
                             IsEnabled="{Binding IsNotBusy}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6" Padding="9" Style="{StaticResource OfficeCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Number}" FontWeight="SemiBold" />
                                        <TextBlock Margin="0,3,0,0"
                                                   Text="{Binding WarehouseDriver}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,2,0,0"
                                                   Text="{Binding VehicleWorkload}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Margin="0,10,0,0"
                               HorizontalAlignment="Center"
                               Text="Chưa có chuyến đã xuất phát."
                               Foreground="{DynamicResource TextSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasTrips}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource OfficeCardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="KẾT QUẢ CHỈ ĐỌC"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="{Binding SelectedTripNumber}"
                                           FontSize="17"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ProgressText}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Attempts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Padding="10" Style="{StaticResource OfficeCardStyle}">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Point}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               Text="{Binding Number}"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               Text="{Binding Customer}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Result}"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Top" />
                                            </Grid>

                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="Thời điểm" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AttemptedAt}" />

                                                <TextBlock Grid.Row="1" Margin="0,4,0,0" Text="Lý do" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" Text="{Binding Reason}" TextWrapping="Wrap" />

                                                <TextBlock Grid.Row="2" Margin="0,4,0,0" Text="Giao lại" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,4,0,0" Text="{Binding RescheduledFor}" />

                                                <TextBlock Grid.Row="3" Margin="0,4,0,0" Text="Ghi chú" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,4,0,0" Text="{Binding Note}" TextWrapping="Wrap" />
                                            </Grid>

                                            <Button Margin="0,9,0,0"
                                                    HorizontalAlignment="Left"
                                                    Style="{StaticResource OfficeSecondaryButtonStyle}"
                                                    Visibility="{Binding DataContext.CanReadProofs, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Converter={StaticResource BoolToVisibility}}"
                                                    IsEnabled="{Binding CanToggleProof}"
                                                    CommandParameter="{Binding}"
                                                    Click="ToggleProofs_OnClick"
                                                    Content="{Binding ProofButtonText}" />

                                            <ItemsControl Margin="0,8,0,0"
                                                          ItemsSource="{Binding Proofs}"
                                                          Visibility="{Binding IsProofExpanded, Converter={StaticResource BoolToVisibility}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,0,6" Padding="8" Style="{StaticResource OfficeCardStyle}">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Type}" FontWeight="SemiBold" />
                                                                <TextBlock Margin="0,2,0,0" Text="{Binding CapturedAt}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                <TextBlock Margin="0,3,0,0" Text="{Binding Receiver}" TextWrapping="Wrap" />
                                                                <TextBlock Margin="0,2,0,0" Text="{Binding Reference}" TextWrapping="Wrap" />
                                                                <TextBlock Margin="0,2,0,0" Text="{Binding Note}" TextWrapping="Wrap" />
                                                                <TextBlock Margin="0,2,0,0" Text="{Binding FileNotice}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                                                <Button Margin="0,6,0,0"
                                                                        HorizontalAlignment="Left"
                                                                        Style="{StaticResource OfficeMiniButtonStyle}"
                                                                        Visibility="{Binding HasDownloadUrl, Converter={StaticResource BoolToVisibility}}"
                                                                        CommandParameter="{Binding}"
                                                                        Click="OpenProofFile_OnClick"
                                                                        Content="Xem ảnh" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Margin="0,7,0,0"
                                                       Text="Không có bằng chứng đính kèm; kết quả giao vẫn hợp lệ."
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Visibility="{Binding ShowNoProof, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Margin="0,14,0,0"
                                   HorizontalAlignment="Center"
                                   Text="Chọn chuyến bên trái để xem lần giao đã ghi."
                                   Foreground="{DynamicResource TextSecondaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSelectedTrip}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Margin="0,14,0,0"
                                   HorizontalAlignment="Center"
                                   Text="Tài xế chưa ghi kết quả cho phiếu nào trong chuyến này."
                                   Foreground="{DynamicResource TextSecondaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasSelectedTrip}" Value="True" />
                                                <Condition Binding="{Binding HasAttempts}" Value="False" />
                                                <Condition Binding="{Binding IsBusy}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Border Margin="0,12,0,0"
                                Padding="9"
                                Style="{StaticResource OfficeCardStyle}"
                                Visibility="{Binding HasSelectedTrip, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Phiếu chưa giao đủ vẫn là hàng đang theo xe; màn này không tự nhập hàng về kho."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
