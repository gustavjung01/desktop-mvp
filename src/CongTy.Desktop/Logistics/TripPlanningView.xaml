<UserControl x:Class="CongTy.Desktop.Logistics.TripPlanningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             Loaded="TripPlanningView_OnLoaded"
             PreviewKeyDown="TripPlanningView_OnPreviewKeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="TripListItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource OfficeListBoxItemStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16">
            <Border Padding="10" Margin="0,0,0,8">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource OfficeCardStyle}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasMessage}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <TabControl Style="{StaticResource OfficeTabControlStyle}"
                        SelectedIndex="{Binding ActiveTabIndex, Mode=TwoWay}">
                <TabItem Header="Lập chuyến">
                    <TabControl Margin="0,8,0,0"
                                Style="{StaticResource OfficeTabControlStyle}"
                                SelectedIndex="{Binding PlanningTabIndex, Mode=TwoWay}">
                        <TabItem Header="Tạo &amp; danh sách">
                            <StackPanel Margin="0,8,0,0">
                                <Border Margin="0,0,0,8" Style="{StaticResource OfficeCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="DANH MỤC ĐIỀU PHỐI"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Margin="0,3,0,8"
                                                   Text="Tuyến, xe và tài xế"
                                                   FontSize="17"
                                                   FontWeight="SemiBold" />

                                        <Grid IsEnabled="{Binding IsNotBusy}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Style="{StaticResource OfficeCardStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="Tuyến giao" FontSize="15" FontWeight="SemiBold" />
                                                    <TextBlock Margin="0,8,0,3" Text="Mã tuyến" FontWeight="SemiBold" />
                                                    <TextBox Style="{StaticResource OfficeTextBoxStyle}"
                                                             MaxLength="64"
                                                             Text="{Binding RouteCode, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Margin="0,7,0,3" Text="Tên tuyến" FontWeight="SemiBold" />
                                                    <TextBox Style="{StaticResource OfficeTextBoxStyle}"
                                                             MaxLength="256"
                                                             Text="{Binding RouteName, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Margin="0,7,0,3" Text="Mô tả" FontWeight="SemiBold" />
                                                    <TextBox Style="{StaticResource OfficeTextBoxStyle}"
                                                             Text="{Binding RouteDescription, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Margin="0,7,0,3" Text="Kho áp dụng" FontWeight="SemiBold" />
                                                    <ComboBox Style="{StaticResource OfficeComboBoxStyle}"
                                                              ItemsSource="{Binding RouteWarehouseOptions}"
                                                              DisplayMemberPath="Label"
                                                              SelectedValuePath="Id"
                                                              SelectedValue="{Binding RouteWarehouseId, Mode=TwoWay}" />
                                                    <Button Margin="0,8,0,0"
                                                            HorizontalAlignment="Left"
                                                            Style="{StaticResource OfficeSecondaryButtonStyle}"
                                                            Visibility="{Binding CanManageRoutes, Converter={StaticResource BoolToVisibility}}"
                                                            IsEnabled="{Binding CanCreateRoute}"
                                                            Click="CreateRoute_OnClick"
                                                            Content="Thêm tuyến giao" />
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="2" Style="{StaticResource OfficeCardStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="Phương tiện" FontSize="15" FontWeight="SemiBold" />
                                                    <TextBlock Margin="0,8,0,3" Text="Mã xe" FontWeight="SemiBold" />
                                                    <TextBox Style="{StaticResource OfficeTextBoxStyle}"
                                                             MaxLength="64"
                                                             Text="{Binding VehicleCode, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Margin="0,7,0,3" Text="Biển số" FontWeight="SemiBold" />
                                                    <TextBox Style="{StaticResource OfficeTextBoxStyle}"
                                                             MaxLength="32"
                                                             Text="{Binding VehiclePlate, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Margin="0,7,0,3" Text="Loại xe" FontWeight="SemiBold" />
                                                    <TextBox Style="{StaticResource OfficeTextBoxStyle}"
                                                             MaxLength="80"
                                                             Text="{Binding VehicleType, UpdateSourceTrigger=PropertyChanged}" />
                                                    <Button Margin="0,8,0,0"
                                                            HorizontalAlignment="Left"
                                                            Style="{StaticResource OfficeSecondaryButtonStyle}"
                                                            Visibility="{Binding CanManageVehicles, Converter={StaticResource BoolToVisibility}}"
                                                            IsEnabled="{Binding CanCreateVehicle}"
                                                            Click="CreateVehicle_OnClick"
                                                            Content="Thêm phương tiện" />
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="4" Style="{StaticResource OfficeCardStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="Tài xế" FontSize="15" FontWeight="SemiBold" />
                                                    <TextBlock Margin="0,8,0,3" Text="Nhân sự tài xế" FontWeight="SemiBold" />
                                                    <ComboBox x:Name="DriverEmployeeCombo"
                                                              Style="{StaticResource OfficeComboBoxStyle}"
                                                              ItemsSource="{Binding DriverEmployeeOptions}"
                                                              DisplayMemberPath="Label"
                                                              SelectedValuePath="Id"
                                                              SelectedValue="{Binding DriverEmployeeId, Mode=TwoWay}"
                                                              IsEnabled="{Binding CanManageDrivers}"
                                                              DropDownOpened="DriverEmployeeCombo_OnDropDownOpened" />
                                                    <TextBlock Margin="0,5,0,0"
                                                               Text="{Binding SelectedDriverEmployeeSummary}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Margin="0,7,0,3" Text="Thông tin bằng lái" FontWeight="SemiBold" />
                                                    <TextBox Style="{StaticResource OfficeTextBoxStyle}"
                                                             MaxLength="128"
                                                             Text="{Binding DriverLicenseReference, UpdateSourceTrigger=PropertyChanged}" />
                                                    <Button Margin="0,8,0,0"
                                                            HorizontalAlignment="Left"
                                                            Style="{StaticResource OfficeSecondaryButtonStyle}"
                                                            Visibility="{Binding CanManageDrivers, Converter={StaticResource BoolToVisibility}}"
                                                            IsEnabled="{Binding CanCreateDriver}"
                                                            Click="CreateDriver_OnClick"
                                                            Content="Thêm tài xế" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,0,0,8" Style="{StaticResource OfficeCardStyle}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="KẾ HOẠCH CHUYẾN"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Margin="0,3,0,0"
                                                           Text="Tạo chuyến giao"
                                                           FontSize="17"
                                                           FontWeight="SemiBold" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource OfficePrimaryButtonStyle}"
                                                    Visibility="{Binding CanCreateTrip, Converter={StaticResource BoolToVisibility}}"
                                                    IsEnabled="{Binding CanCreateTripNow}"
                                                    Click="CreateTrip_OnClick"
                                                    Content="Tạo chuyến" />
                                        </Grid>
                                        <Grid IsEnabled="{Binding IsNotBusy}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Margin="0,0,0,3" Text="Kho xuất phát" FontWeight="SemiBold" />
                                                <ComboBox Style="{StaticResource OfficeComboBoxStyle}"
                                                          ItemsSource="{Binding WarehouseOptions}"
                                                          DisplayMemberPath="Label"
                                                          SelectedValuePath="Id"
                                                          SelectedValue="{Binding TripWarehouseId, Mode=TwoWay}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Margin="0,0,0,3" Text="Tuyến giao" FontWeight="SemiBold" />
                                                <ComboBox Style="{StaticResource OfficeComboBoxStyle}"
                                                          ItemsSource="{Binding TripRouteOptions}"
                                                          DisplayMemberPath="Label"
                                                          SelectedValuePath="Id"
                                                          SelectedValue="{Binding TripRouteId, Mode=TwoWay}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Margin="0,0,0,3" Text="Phương tiện" FontWeight="SemiBold" />
                                                <ComboBox Style="{StaticResource OfficeComboBoxStyle}"
                                                          ItemsSource="{Binding VehicleOptions}"
                                                          DisplayMemberPath="Label"
                                                          SelectedValuePath="Id"
                                                          SelectedValue="{Binding TripVehicleId, Mode=TwoWay}" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="0">
                                                <TextBlock Margin="0,0,0,3" Text="Tài xế chính" FontWeight="SemiBold" />
                                                <ComboBox Style="{StaticResource OfficeComboBoxStyle}"
                                                          ItemsSource="{Binding DriverOptions}"
                                                          DisplayMemberPath="Label"
                                                          SelectedValuePath="Id"
                                                          SelectedValue="{Binding TripDriverId, Mode=TwoWay}" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="2">
                                                <TextBlock Margin="0,0,0,3" Text="Giờ dự kiến" FontWeight="SemiBold" />
                                                <TextBox Style="{StaticResource OfficeTextBoxStyle}"
                                                         ToolTip="yyyy-MM-dd HH:mm"
                                                         Text="{Binding PlannedStartText, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="4">
                                                <TextBlock Margin="0,0,0,3" Text="Ghi chú" FontWeight="SemiBold" />
                                                <TextBox Style="{StaticResource OfficeTextBoxStyle}"
                                                         MaxLength="4000"
                                                         Text="{Binding TripNote, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource OfficeCardStyle}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="DANH SÁCH"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Margin="0,3,0,0"
                                                           Text="Các chuyến giao"
                                                           FontSize="17"
                                                           FontWeight="SemiBold" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource OfficeSecondaryButtonStyle}"
                                                    IsEnabled="{Binding IsNotBusy}"
                                                    Click="Refresh_OnClick"
                                                    Content="{Binding RefreshButtonText}" />
                                        </Grid>
                                        <ListBox ItemsSource="{Binding Trips}"
                                                 SelectedItem="{Binding SelectedTripRow, Mode=TwoWay}"
                                                 ItemContainerStyle="{StaticResource TripListItemStyle}"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 MaxHeight="360"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,5" Padding="9" Style="{StaticResource OfficeCardStyle}">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Number}" FontWeight="SemiBold" />
                                                            <TextBlock Margin="0,3,0,0" Text="{Binding RouteWarehouse}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            <TextBlock Margin="0,2,0,0" Text="{Binding Summary}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock Margin="0,10,0,0"
                                                   HorizontalAlignment="Center"
                                                   Text="Chưa có chuyến giao."
                                                   Foreground="{DynamicResource TextSecondaryBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasTrips}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </TabItem>

                        <TabItem Header="Chi tiết chuyến">
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="330" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource OfficeCardStyle}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="CHI TIẾT"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Margin="0,3,0,0"
                                                           Text="{Binding SelectedTripNumber}"
                                                           FontSize="17"
                                                           FontWeight="SemiBold" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding SelectedTripStatus}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Top" />
                                        </Grid>

                                        <StackPanel Visibility="{Binding HasSelectedTrip, Converter={StaticResource BoolToVisibility}}">
                                            <Grid IsEnabled="{Binding CanSaveSelected}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="8" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Margin="0,0,0,3" Text="Kho xuất phát" FontWeight="SemiBold" />
                                                    <ComboBox Style="{StaticResource OfficeComboBoxStyle}"
                                                              ItemsSource="{Binding WarehouseOptions}"
                                                              DisplayMemberPath="Label"
                                                              SelectedValuePath="Id"
                                                              SelectedValue="{Binding TripWarehouseId, Mode=TwoWay}"
                                                              IsEnabled="False" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Margin="0,0,0,3" Text="Tuyến giao" FontWeight="SemiBold" />
                                                    <ComboBox Style="{StaticResource OfficeComboBoxStyle}"
                                                              ItemsSource="{Binding TripRouteOptions}"
                                                              DisplayMemberPath="Label"
                                                              SelectedValuePath="Id"
                                                              SelectedValue="{Binding TripRouteId, Mode=TwoWay}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="4">
                                                    <TextBlock Margin="0,0,0,3" Text="Phương tiện" FontWeight="SemiBold" />
                                                    <ComboBox Style="{StaticResource OfficeComboBoxStyle}"
                                                              ItemsSource="{Binding VehicleOptions}"
                                                              DisplayMemberPath="Label"
                                                              SelectedValuePath="Id"
                                                              SelectedValue="{Binding TripVehicleId, Mode=TwoWay}" />
                                                </StackPanel>
                                                <StackPanel Grid.Row="2" Grid.Column="0">
                                                    <TextBlock Margin="0,0,0,3" Text="Tài xế chính" FontWeight="SemiBold" />
                                                    <ComboBox Style="{StaticResource OfficeComboBoxStyle}"
                                                              ItemsSource="{Binding DriverOptions}"
                                                              DisplayMemberPath="Label"
                                                              SelectedValuePath="Id"
                                                              SelectedValue="{Binding TripDriverId, Mode=TwoWay}" />
                                                </StackPanel>
                                                <StackPanel Grid.Row="2" Grid.Column="2">
                                                    <TextBlock Margin="0,0,0,3" Text="Giờ dự kiến" FontWeight="SemiBold" />
                                                    <TextBox Style="{StaticResource OfficeTextBoxStyle}"
                                                             ToolTip="yyyy-MM-dd HH:mm"
                                                             Text="{Binding PlannedStartText, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <StackPanel Grid.Row="2" Grid.Column="4">
                                                    <TextBlock Margin="0,0,0,3" Text="Ghi chú" FontWeight="SemiBold" />
                                                    <TextBox Style="{StaticResource OfficeTextBoxStyle}"
                                                             MaxLength="4000"
                                                             Text="{Binding TripNote, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                            </Grid>

                                            <WrapPanel Margin="0,8,0,0">
                                                <Button Margin="0,0,6,6"
                                                        Style="{StaticResource OfficeSecondaryButtonStyle}"
                                                        Visibility="{Binding ShowSaveAction, Converter={StaticResource BoolToVisibility}}"
                                                        IsEnabled="{Binding CanSaveSelected}"
                                                        Click="UpdateTrip_OnClick"
                                                        Content="Lưu kế hoạch" />
                                                <Button Margin="0,0,6,6"
                                                        Style="{StaticResource OfficePrimaryButtonStyle}"
                                                        Visibility="{Binding ShowPlanAction, Converter={StaticResource BoolToVisibility}}"
                                                        IsEnabled="{Binding CanPlanSelected}"
                                                        Click="PlanTrip_OnClick"
                                                        Content="Chuyển sang đã lập kế hoạch" />
                                                <Button Margin="0,0,6,6"
                                                        Style="{StaticResource OfficeSecondaryButtonStyle}"
                                                        Visibility="{Binding ShowReopenAction, Converter={StaticResource BoolToVisibility}}"
                                                        IsEnabled="{Binding CanReopenSelected}"
                                                        Click="ReopenTrip_OnClick"
                                                        Content="Mở lại chỉnh sửa" />
                                                <Button Margin="0,0,6,6"
                                                        Style="{StaticResource OfficeDangerButtonStyle}"
                                                        Visibility="{Binding ShowLockAction, Converter={StaticResource BoolToVisibility}}"
                                                        IsEnabled="{Binding CanLockSelected}"
                                                        Click="LockTrip_OnClick"
                                                        Content="Khóa kế hoạch" />
                                            </WrapPanel>

                                            <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Stops}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,0,7" Padding="9" Style="{StaticResource OfficeCardStyle}">
                                                            <StackPanel>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                                        <TextBlock Margin="0,3,0,0"
                                                                                   Text="{Binding Address}"
                                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                                   TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="1"
                                                                                Orientation="Horizontal"
                                                                                Visibility="{Binding DataContext.ShowAssignmentEditActions, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Converter={StaticResource BoolToVisibility}}">
                                                                        <Button Width="32"
                                                                                Height="28"
                                                                                Margin="0,0,4,0"
                                                                                Style="{StaticResource OfficeMiniButtonStyle}"
                                                                                IsEnabled="{Binding CanMoveUp}"
                                                                                CommandParameter="{Binding}"
                                                                                Click="MoveStopUp_OnClick"
                                                                                Content="↑" />
                                                                        <Button Width="32"
                                                                                Height="28"
                                                                                Style="{StaticResource OfficeMiniButtonStyle}"
                                                                                IsEnabled="{Binding CanMoveDown}"
                                                                                CommandParameter="{Binding}"
                                                                                Click="MoveStopDown_OnClick"
                                                                                Content="↓" />
                                                                    </StackPanel>
                                                                </Grid>

                                                                <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Assignments}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Grid Margin="0,3,0,0">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*" />
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <StackPanel>
                                                                                    <TextBlock Text="{Binding Number}" FontWeight="SemiBold" />
                                                                                    <TextBlock Margin="0,2,0,0"
                                                                                               Text="{Binding Customer}"
                                                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                                </StackPanel>
                                                                                <Button Grid.Column="1"
                                                                                        Style="{StaticResource OfficeMiniButtonStyle}"
                                                                                        Visibility="{Binding DataContext.ShowAssignmentEditActions, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Converter={StaticResource BoolToVisibility}}"
                                                                                        IsEnabled="{Binding DataContext.CanEditAssignments, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                                                                                        CommandParameter="{Binding}"
                                                                                        Click="Unassign_OnClick"
                                                                                        Content="Bỏ khỏi chuyến" />
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Margin="0,10,0,0"
                                                       HorizontalAlignment="Center"
                                                       Text="Chưa có điểm giao."
                                                       Foreground="{DynamicResource TextSecondaryBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasStops}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <Border Margin="0,8,0,0"
                                                    Padding="9"
                                                    Style="{StaticResource OfficeCardStyle}"
                                                    Visibility="{Binding ShowReadOnlyNotice, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding SelectedTripReadOnlyNotice}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Margin="0,12,0,0"
                                                   HorizontalAlignment="Center"
                                                   Text="Chọn chuyến trong danh sách để lập kế hoạch."
                                                   Foreground="{DynamicResource TextSecondaryBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasSelectedTrip}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource OfficeCardStyle}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="DANH SÁCH"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Margin="0,3,0,0"
                                                           Text="Các chuyến giao"
                                                           FontSize="16"
                                                           FontWeight="SemiBold" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource OfficeMiniButtonStyle}"
                                                    IsEnabled="{Binding IsNotBusy}"
                                                    Click="Refresh_OnClick"
                                                    Content="Tải lại" />
                                        </Grid>
                                        <ListBox ItemsSource="{Binding Trips}"
                                                 SelectedItem="{Binding SelectedTripRow, Mode=TwoWay}"
                                                 ItemContainerStyle="{StaticResource TripListItemStyle}"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 MaxHeight="620"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,5" Padding="8" Style="{StaticResource OfficeCardStyle}">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Number}" FontWeight="SemiBold" />
                                                            <TextBlock Margin="0,3,0,0" Text="{Binding RouteWarehouse}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                                            <TextBlock Margin="0,2,0,0" Text="{Binding Summary}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </TabItem>

                <TabItem Header="Gán chuyến">
                    <Border Margin="0,8,0,0" Style="{StaticResource OfficeCardStyle}">
                        <StackPanel>
                            <TextBlock Text="GÁN CHUYẾN"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Margin="0,3,0,8"
                                       Text="Tuyến → Chuyến → Phiếu giao"
                                       FontSize="17"
                                       FontWeight="SemiBold" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Margin="0,0,0,3" Text="Tuyến giao" FontWeight="SemiBold" />
                                    <ComboBox Style="{StaticResource OfficeComboBoxStyle}"
                                              ItemsSource="{Binding AssignmentRouteOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding AssignmentRouteId, Mode=TwoWay}"
                                              IsEnabled="{Binding IsNotBusy}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Margin="0,0,0,3" Text="Chuyến giao" FontWeight="SemiBold" />
                                    <ComboBox Style="{StaticResource OfficeComboBoxStyle}"
                                              ItemsSource="{Binding AssignmentTripOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding AssignmentTripId, Mode=TwoWay}"
                                              IsEnabled="{Binding CanChooseAssignmentTrip}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,10,0,0"
                                        Visibility="{Binding HasAssignmentTrip, Converter={StaticResource BoolToVisibility}}">
                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding AssignmentTripNumber}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Margin="0,3,0,0"
                                                   Text="Phiếu sẵn sàng cùng kho"
                                                   FontSize="15"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Style="{StaticResource OfficePrimaryButtonStyle}"
                                            IsEnabled="{Binding CanAssignSelected}"
                                            Click="AssignSelected_OnClick"
                                            Content="{Binding AssignButtonText}" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding EligibleOrders}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,6" Padding="9" Style="{StaticResource OfficeCardStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Number}" FontWeight="SemiBold" />
                                                        <TextBlock Margin="0,3,0,0" Text="{Binding Customer}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        <TextBlock Margin="0,2,0,0" Text="{Binding Summary}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="1"
                                                              VerticalAlignment="Center"
                                                              IsEnabled="{Binding CanSelect}"
                                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              Click="EligibleOrder_OnClick" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Margin="0,10,0,0"
                                           HorizontalAlignment="Center"
                                           Text="Không còn phiếu giao đủ điều kiện trong kho của chuyến này."
                                           Foreground="{DynamicResource TextSecondaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasEligibleOrders}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <TextBlock Margin="0,12,0,0"
                                       HorizontalAlignment="Center"
                                       Text="Chọn tuyến trước, sau đó chọn chuyến để tích nhiều phiếu giao."
                                       Foreground="{DynamicResource TextSecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasAssignmentTrip}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </TabItem>
            </TabControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
