<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>Assets\Brand\logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CongTy.ApiClient\CongTy.ApiClient.csproj" />
    <ProjectReference Include="..\CongTy.Contracts\CongTy.Contracts.csproj" />
    <ProjectReference Include="..\CongTy.Windows\CongTy.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\nguyen-lieu-mi-cay.png">
      <Link>Assets\Login\nguyen-lieu-mi-cay.png</Link>
    </Resource>
    <Resource Include="..\..\logo.jpg">
      <Link>Assets\Brand\logo.jpg</Link>
    </Resource>
  </ItemGroup>

  <Target Name="GenerateBrandIcon" BeforeTargets="CoreCompile">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\create-brand-icon.ps1&quot; -Source &quot;$(MSBuildProjectDirectory)\..\..\logo.jpg&quot; -Destination &quot;$(MSBuildProjectDirectory)\Assets\Brand\logo.ico&quot;" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="SkiaSharp" Version="4.152.0" />
  </ItemGroup>
</Project>
