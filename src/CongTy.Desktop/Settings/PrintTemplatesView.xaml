<UserControl x:Class="CongTy.Desktop.Settings.PrintTemplatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="PrintTemplatesView_OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="SettingsTabStyle" TargetType="Button" BasedOn="{StaticResource OfficeSecondaryButtonStyle}">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="120" />
        </Style>
        <Style x:Key="PrintMessageStyle" TargetType="Border" BasedOn="{StaticResource OfficeCardStyle}">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource PrintMessageStyle}"
                Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding Message, Mode=OneWay}" TextWrapping="Wrap" />
        </Border>

        <StackPanel Grid.Row="1" Margin="0,12,0,0" Orientation="Horizontal">
            <Button Style="{StaticResource SettingsTabStyle}" Click="DataBackup_OnClick" Content="Dữ liệu &amp; sao lưu" />
            <Button Style="{StaticResource SettingsTabStyle}" IsEnabled="False" Content="Mẫu in" />
            <Button Style="{StaticResource SettingsTabStyle}" Click="DesktopApp_OnClick" Content="Ứng dụng máy tính" />
            <Button Style="{StaticResource SettingsTabStyle}" Click="Appearance_OnClick" Content="Giao diện" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource OfficeCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="10" FontWeight="Bold" Text="MẪU IN" />
                            <TextBlock Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold" Text="Cấu hình mẫu in dùng chung" />
                            <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                                       Text="Chọn từng loại phiếu, khổ giấy và các thông tin cần in. Cấu hình được dùng chung khi mở chứng từ tương ứng." />
                        </StackPanel>
                        <Border Grid.Column="1" Padding="10,6" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top">
                            <TextBlock FontWeight="SemiBold" Text="{Binding TemplateStatus, Mode=OneWay}" />
                        </Border>
                    </Grid>
                </Border>

                <Border Margin="0,12,0,0" Style="{StaticResource OfficeCardStyle}">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Loại chứng từ / mẫu in" />
                        <ComboBox Margin="0,5,0,0" MinWidth="360" HorizontalAlignment="Left"
                                  ItemsSource="{Binding Templates}"
                                  SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}"
                                  DisplayMemberPath="Name" />
                    </StackPanel>
                </Border>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="0.85*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <Border Style="{StaticResource OfficeCardStyle}">
                            <StackPanel>
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="Phần đầu phiếu" />
                                <TextBlock Margin="0,4,0,10" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                                           Text="Chỉ tùy chỉnh Tên Công Ty và vị trí hai phần đầu phiếu." />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Padding="12" Style="{StaticResource OfficeCardStyle}">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock FontWeight="SemiBold" Text="Tên Công Ty" />
                                                <CheckBox HorizontalAlignment="Right" Content="Hiển thị"
                                                          IsChecked="{Binding HeadingVisible, Mode=TwoWay}"
                                                          IsEnabled="{Binding CanManage}" />
                                            </Grid>
                                            <TextBlock Margin="0,10,0,3" Text="Nội dung" />
                                            <TextBox Text="{Binding Heading, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="160" IsEnabled="{Binding CanManage}" />
                                            <TextBlock Margin="0,10,0,3" Text="Vị trí" />
                                            <ComboBox ItemsSource="{Binding AlignmentOptions}" SelectedItem="{Binding HeadingAlign, Mode=TwoWay}" IsEnabled="{Binding CanManage}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Padding="12" Style="{StaticResource OfficeCardStyle}">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="Loại đơn" />
                                            <TextBlock Margin="0,6,0,0" FontSize="15" FontWeight="SemiBold" Text="{Binding PreviewTitle, Mode=OneWay}" TextAlignment="{Binding TitleTextAlignment, Mode=OneWay}" TextWrapping="Wrap" />
                                            <TextBlock Margin="0,10,0,3" Text="Vị trí" />
                                            <ComboBox ItemsSource="{Binding AlignmentOptions}" SelectedItem="{Binding TitleAlign, Mode=TwoWay}" IsEnabled="{Binding CanManage}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0" Style="{StaticResource OfficeCardStyle}">
                            <StackPanel>
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="Thông tin được in" />
                                <TextBlock Margin="0,4,0,10" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                                           Text="Bỏ chọn mục không cần xuất hiện. Mục ghi “Luôn in” là thông tin bắt buộc của chứng từ." />
                                <ItemsControl ItemsSource="{Binding Fields}" IsEnabled="{Binding CanManage}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Width="230" Margin="0,0,10,8"
                                                      Content="{Binding DisplayLabel}"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      IsEnabled="{Binding CanToggle}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Grid.Column="2" Style="{StaticResource OfficeCardStyle}">
                        <StackPanel>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Xem trước" />
                            <Border Margin="0,10,0,0" Padding="18" MinHeight="420" Background="White" BorderBrush="#D8D8D8" BorderThickness="1" CornerRadius="4">
                                <StackPanel>
                                    <TextBlock Foreground="#242424" FontSize="15" FontWeight="Bold"
                                               Text="{Binding PreviewHeading, Mode=OneWay}"
                                               TextAlignment="{Binding HeadingTextAlignment, Mode=OneWay}"
                                               Visibility="{Binding PreviewHeadingVisible, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Margin="0,12,0,0" Foreground="#1F1F1F" FontSize="20" FontWeight="Bold" Text="{Binding PreviewTitle, Mode=OneWay}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,5,0,0" Foreground="#555555" Text="Số: CT-2026-000001" />
                                    <Separator Margin="0,16,0,14" />
                                    <TextBlock Foreground="#333333" FontWeight="SemiBold" Text="Các thông tin sẽ in" />
                                    <TextBlock Margin="0,8,0,0" Foreground="#555555" TextWrapping="Wrap" LineHeight="24" Text="{Binding PreviewFields, Mode=OneWay}" />
                                    <Border Margin="0,18,0,0" Padding="10" BorderBrush="#D5D5D5" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <TextBlock Foreground="#555555" Text="Sản phẩm mẫu" />
                                            <TextBlock Grid.Column="1" Foreground="#555555" HorizontalAlignment="Center" Text="2 Thùng" />
                                            <TextBlock Grid.Column="2" Foreground="#555555" HorizontalAlignment="Right" Text="250.000 ₫" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <TextBlock Margin="0,12,0,3" FontWeight="SemiBold" Text="Khổ giấy" />
                            <ComboBox ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize, Mode=TwoWay}" IsEnabled="{Binding CanManage}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel Margin="0,12,0,16" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Margin="0,0,8,0" Style="{StaticResource OfficePrimaryButtonStyle}" IsEnabled="{Binding CanSave}" Click="Save_OnClick" Content="LƯU CẤU HÌNH" />
                    <Button Style="{StaticResource OfficeSecondaryButtonStyle}" IsEnabled="{Binding CanReset}" Click="Reset_OnClick" Content="KHÔI PHỤC MẶC ĐỊNH" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
