<UserControl x:Class="CongTy.Desktop.Settings.CustomerOrderingContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="CustomerOrderingContentView_OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16">
            <Border Style="{StaticResource OfficeCardStyle}"
                    MaxWidth="920"
                    HorizontalAlignment="Stretch">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="TRANG CHỦ KHÁCH HÀNG"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Margin="0,4,0,0"
                                       Text="Sự kiện / thông báo"
                                       FontSize="19"
                                       FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,0"
                                       Text="Tiêu đề, nội dung chương trình và ảnh bên dưới dùng chung cho các kênh đặt hàng."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <CheckBox Grid.Column="1"
                                  Margin="24,4,0,0"
                                  VerticalAlignment="Top"
                                  IsEnabled="{Binding CanWrite}"
                                  IsChecked="{Binding Visible, Mode=TwoWay}"
                                  Content="Hiển thị" />
                    </Grid>

                    <StackPanel Margin="0,18,0,0">
                        <TextBlock Text="Tiêu đề mục"
                                   FontWeight="SemiBold" />
                        <TextBox Margin="0,6,0,0"
                                 Style="{StaticResource OfficeTextBoxStyle}"
                                 MaxLength="80"
                                 IsEnabled="{Binding CanWrite}"
                                 Text="{Binding SectionTitle, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Từ 1 đến 80 ký tự" />
                    </StackPanel>

                    <StackPanel Margin="0,14,0,0">
                        <TextBlock Text="Nội dung chương trình"
                                   FontWeight="SemiBold" />
                        <TextBox Margin="0,6,0,0"
                                 MinHeight="150"
                                 Style="{StaticResource OfficeTextBoxStyle}"
                                 MaxLength="4000"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 IsEnabled="{Binding CanWrite}"
                                 Text="{Binding ProgramContent, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Tối đa 4.000 ký tự" />
                        <TextBlock Margin="0,5,0,0"
                                   Text="Nội dung này hiển thị khi khách mở banner Sự kiện trên ứng dụng đặt hàng."
                                   FontSize="10.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Margin="0,16,0,0">
                        <TextBlock Text="Ảnh banner"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,4,0,0"
                                   Text="JPG, PNG hoặc WebP. Desktop tự chuyển sang WebP trước khi tải lên."
                                   FontSize="10.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />

                        <Border Margin="0,8,0,0"
                                MinHeight="120"
                                MaxHeight="260"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Background="{DynamicResource SurfaceMutedBrush}">
                            <Grid>
                                <Image Source="{Binding BannerUrl}"
                                       Stretch="UniformToFill"
                                       Visibility="{Binding HasBanner, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="Chưa có ảnh banner"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasBanner}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <StackPanel Margin="0,10,0,0"
                                    Orientation="Horizontal">
                            <Button Style="{StaticResource OfficeSecondaryButtonStyle}"
                                    IsEnabled="{Binding CanUpload}"
                                    Click="ChooseBanner_OnClick"
                                    Content="{Binding BannerActionText}" />
                            <Button Margin="8,0,0,0"
                                    Style="{StaticResource OfficePrimaryButtonStyle}"
                                    IsEnabled="{Binding CanSave}"
                                    Click="Save_OnClick"
                                    Content="Lưu thiết lập" />
                            <Button Margin="8,0,0,0"
                                    Style="{StaticResource OfficeSecondaryButtonStyle}"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Click="Refresh_OnClick"
                                    Content="Tải lại" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Margin="0,12,0,0"
                               FontSize="10.5"
                               Foreground="{DynamicResource TextSecondaryBrush}">
                        <Run Text="Cập nhật gần nhất: " />
                        <Run Text="{Binding UpdatedAtText, Mode=OneWay}" />
                    </TextBlock>

                    <Border Margin="0,12,0,0"
                            Padding="10"
                            CornerRadius="6"
                            Background="{DynamicResource SurfaceMutedBrush}"
                            Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding Message}"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
