<UserControl x:Class="CongTy.Desktop.Settings.McpRouteSettingsBoundaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16">
            <Border Style="{StaticResource OfficeCardStyle}"
                    MaxWidth="860"
                    HorizontalAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="THIẾT LẬP TUYẾN MCP"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Margin="0,5,0,0"
                               Text="Chưa khả dụng trên Desktop"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,8,0,0"
                               Text="Công Ty Web hiện thực hiện tạo, sửa, tạm dừng và xóa tuyến qua một cổng máy chủ riêng của MCP. Desktop không lưu hoặc sử dụng thông tin truy cập máy chủ riêng, nên các thao tác này được khóa thay vì đi đường kết nối không an toàn."
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" />

                    <Border Margin="0,16,0,0"
                            Padding="12"
                            CornerRadius="7"
                            Background="{DynamicResource SurfaceMutedBrush}">
                        <StackPanel>
                            <TextBlock Text="Phạm vi hiện tại"
                                       FontWeight="SemiBold" />
                            <TextBlock Margin="0,6,0,0"
                                       Text="• Tạo / sửa / tạm dừng / xóa tuyến: thực hiện trên Công Ty Web."
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,4,0,0"
                                       Text="• Báo cáo Hiệu suất nhân viên thị trường đã được tách khỏi màn này và nằm trong nhóm Nhân sự."
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,4,0,0"
                                       Text="• Desktop chỉ mở mutation tuyến khi backend cung cấp một contract dành cho workforce client, không yêu cầu bí mật máy chủ."
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
