<UserControl x:Class="CongTy.Desktop.Purchasing.PurchaseOrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="PurchaseOrderCellText" TargetType="TextBlock" BasedOn="{StaticResource OfficeGridTextStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="PurchaseOrderNumericText" TargetType="TextBlock" BasedOn="{StaticResource OfficeGridTextStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <Style x:Key="PurchaseOrderStatusText" TargetType="TextBlock" BasedOn="{StaticResource OfficeGridTextStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Message}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Margin="0,0,8,0"
                                Style="{StaticResource OfficeSecondaryButtonStyle}"
                                IsEnabled="{Binding CanRead}"
                                Click="Refresh_OnClick"
                                Content="{Binding RefreshButtonText}" />
                        <Button Style="{StaticResource OfficePrimaryButtonStyle}"
                                IsEnabled="{Binding CanCreate}"
                                Click="Create_OnClick"
                                Content="{Binding CreateButtonText}" />
                    </StackPanel>
                </Grid>

                <WrapPanel Margin="0,0,0,8">
                    <Border Width="180" Margin="0,0,8,4" Style="{StaticResource OfficeSummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Tổng đơn" Style="{StaticResource OfficeSummaryLabelStyle}" />
                            <TextBlock Text="{Binding TotalCount}" Style="{StaticResource OfficeSummaryValueStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Width="180" Margin="0,0,8,4" Style="{StaticResource OfficeSummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Đơn nháp" Style="{StaticResource OfficeSummaryLabelStyle}" />
                            <TextBlock Text="{Binding DraftCount}" Style="{StaticResource OfficeSummaryValueStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Width="180" Margin="0,0,8,4" Style="{StaticResource OfficeSummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Chờ duyệt" Style="{StaticResource OfficeSummaryLabelStyle}" />
                            <TextBlock Text="{Binding PendingCount}" Style="{StaticResource OfficeSummaryValueStyle}" />
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <Border Margin="0,0,0,8" Style="{StaticResource OfficeCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Tìm kiếm" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource OfficeTextBoxStyle}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Số đơn, nhà cung cấp, kho nhận hoặc tham chiếu nhà cung cấp" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Trạng thái" Margin="0,0,0,4" />
                            <ComboBox MinHeight="30"
                                      ItemsSource="{Binding StatusOptions}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding SelectedStatus, Mode=TwoWay}" />
                        </StackPanel>
                        <TextBlock Grid.Column="3"
                                   Margin="16,20,0,0"
                                   Text="{Binding VisibleCountText}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource OfficeCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Danh sách mua hàng"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="Đơn mua hàng nhà cung cấp"
                                           Margin="0,2,0,0"
                                           FontSize="16"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                        <DataGrid Grid.Row="1"
                                  x:Name="OrdersGrid"
                                  Style="{StaticResource OfficeDataGridStyle}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  RowHeight="42"
                                  ItemsSource="{Binding Rows}"
                                  HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="STT" Binding="{Binding Stt}" Width="48" ElementStyle="{StaticResource PurchaseOrderNumericText}" />
                                <DataGridTextColumn Header="Số đơn" Binding="{Binding Number}" Width="120" ElementStyle="{StaticResource PurchaseOrderCellText}" />
                                <DataGridTextColumn Header="Ngày đặt" Binding="{Binding OrderDate}" Width="92" ElementStyle="{StaticResource PurchaseOrderCellText}" />
                                <DataGridTextColumn Header="Nhà cung cấp" Binding="{Binding Supplier}" Width="1.3*" ElementStyle="{StaticResource PurchaseOrderCellText}" />
                                <DataGridTextColumn Header="Kho nhận" Binding="{Binding Warehouse}" Width="1.1*" ElementStyle="{StaticResource PurchaseOrderCellText}" />
                                <DataGridTextColumn Header="Số dòng" Binding="{Binding LineCount}" Width="70" ElementStyle="{StaticResource PurchaseOrderNumericText}" />
                                <DataGridTextColumn Header="Tổng giá trị" Binding="{Binding Total}" Width="120" ElementStyle="{StaticResource PurchaseOrderNumericText}" />
                                <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="115" ElementStyle="{StaticResource PurchaseOrderStatusText}" />
                                <DataGridTextColumn Header="Cập nhật" Binding="{Binding UpdatedAt}" Width="92" ElementStyle="{StaticResource PurchaseOrderCellText}" />
                                <DataGridTemplateColumn Header="Thao tác" Width="310">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <WrapPanel VerticalAlignment="Center">
                                                <Button Margin="0,0,4,0"
                                                        Style="{StaticResource OfficeMiniButtonStyle}"
                                                        Visibility="{Binding CanView, Converter={StaticResource BoolToVisibility}}"
                                                        Tag="{Binding}"
                                                        Click="View_OnClick"
                                                        Content="Xem" />
                                                <Button Margin="0,0,4,0"
                                                        Style="{StaticResource OfficeMiniButtonStyle}"
                                                        Visibility="{Binding CanPrint, Converter={StaticResource BoolToVisibility}}"
                                                        Tag="{Binding}"
                                                        Click="Print_OnClick"
                                                        Content="In" />
                                                <Button Margin="0,0,4,0"
                                                        Style="{StaticResource OfficeMiniButtonStyle}"
                                                        Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}"
                                                        Tag="{Binding}"
                                                        Click="Edit_OnClick"
                                                        Content="Sửa" />
                                                <Button Margin="0,0,4,0"
                                                        Style="{StaticResource OfficeMiniButtonStyle}"
                                                        Visibility="{Binding CanSubmit, Converter={StaticResource BoolToVisibility}}"
                                                        Tag="{Binding}"
                                                        Click="Submit_OnClick"
                                                        Content="Gửi duyệt" />
                                                <Button Margin="0,0,4,0"
                                                        Style="{StaticResource OfficeMiniButtonStyle}"
                                                        Visibility="{Binding CanApprove, Converter={StaticResource BoolToVisibility}}"
                                                        Tag="{Binding}"
                                                        Click="Approve_OnClick"
                                                        Content="Duyệt" />
                                                <Button Style="{StaticResource OfficeMiniButtonStyle}"
                                                        Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}"
                                                        Tag="{Binding}"
                                                        Click="Cancel_OnClick"
                                                        Content="Hủy" />
                                            </WrapPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibility}}"
              Background="#99000000">
            <Border Margin="30"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    MaxWidth="1450"
                    MaxHeight="900"
                    Style="{StaticResource OfficeCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding EditorModeText}"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding EditorTitle}"
                                       Margin="0,2,0,0"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Style="{StaticResource OfficeSecondaryButtonStyle}"
                                Click="CloseEditor_OnClick"
                                Content="Đóng" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Margin="0,0,0,8" Style="{StaticResource OfficeCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.3*" />
                                        <ColumnDefinition Width="1.3*" />
                                        <ColumnDefinition Width="0.9*" />
                                        <ColumnDefinition Width="0.9*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Margin="0,0,8,8">
                                        <TextBlock Text="Nhà cung cấp" Margin="0,0,0,4" />
                                        <ComboBox MinHeight="30"
                                                  ItemsSource="{Binding Suppliers}"
                                                  DisplayMemberPath="Display"
                                                  SelectedValuePath="Id"
                                                  SelectedValue="{Binding SelectedSupplierId, Mode=TwoWay}"
                                                  SelectionChanged="Supplier_OnSelectionChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,8,8">
                                        <TextBlock Text="Kho nhận" Margin="0,0,0,4" />
                                        <ComboBox MinHeight="30"
                                                  ItemsSource="{Binding Warehouses}"
                                                  DisplayMemberPath="Display"
                                                  SelectedValuePath="Id"
                                                  SelectedValue="{Binding SelectedWarehouseId, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="0,0,8,8">
                                        <TextBlock Text="Ngày đặt" Margin="0,0,0,4" />
                                        <DatePicker SelectedDate="{Binding OrderDate, Mode=TwoWay}"
                                                    SelectedDateChanged="OrderDate_OnChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Margin="0,0,0,8">
                                        <TextBlock Text="Dự kiến nhận" Margin="0,0,0,4" />
                                        <DatePicker SelectedDate="{Binding ExpectedDate, Mode=TwoWay}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,8,0">
                                        <TextBlock Text="Tham chiếu nhà cung cấp" Margin="0,0,0,4" />
                                        <TextBox Style="{StaticResource OfficeTextBoxStyle}"
                                                 MaxLength="256"
                                                 Text="{Binding SupplierReference, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2">
                                        <TextBlock Text="Ghi chú đơn" Margin="0,0,0,4" />
                                        <TextBox Style="{StaticResource OfficeTextBoxStyle}"
                                                 MaxLength="4000"
                                                 Text="{Binding EditorNote, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Margin="0,0,0,8" Style="{StaticResource OfficeCardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Thêm SKU"
                                                       FontSize="16"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="Dùng giá mua nhà cung cấp; không dùng giá bán làm nguồn."
                                                       Margin="0,2,0,0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Style="{StaticResource OfficeSecondaryButtonStyle}"
                                                IsEnabled="{Binding CanSearchSku}"
                                                Click="BrowseSku_OnClick"
                                                Content="Chọn từ danh mục" />
                                    </Grid>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="SkuSearchBox"
                                                 Style="{StaticResource OfficeTextBoxStyle}"
                                                 Text="{Binding SkuSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 KeyDown="SkuSearch_OnKeyDown"
                                                 ToolTip="Nhập mã hàng, tên sản phẩm hoặc SKU" />
                                        <Button Grid.Column="1"
                                                Margin="8,0,0,0"
                                                Style="{StaticResource OfficeSecondaryButtonStyle}"
                                                IsEnabled="{Binding CanSearchSku}"
                                                Click="SearchSku_OnClick"
                                                Content="Tìm" />
                                        <Button Grid.Column="2"
                                                Margin="8,0,0,0"
                                                Style="{StaticResource OfficeSecondaryButtonStyle}"
                                                IsEnabled="{Binding CanSearchSku}"
                                                Click="RefreshPrices_OnClick"
                                                Content="Cập nhật giá mua" />
                                    </Grid>

                                    <DataGrid Margin="0,6,0,0"
                                              Height="150"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              ItemsSource="{Binding SkuResults}"
                                              Style="{StaticResource OfficeDataGridStyle}"
                                              MouseDoubleClick="SkuResults_OnDoubleClick">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="130" ElementStyle="{StaticResource PurchaseOrderCellText}" />
                                            <DataGridTextColumn Header="Sản phẩm" Binding="{Binding Name}" Width="2*" ElementStyle="{StaticResource PurchaseOrderCellText}" />
                                            <DataGridTextColumn Header="Đơn vị" Binding="{Binding Unit}" Width="90" ElementStyle="{StaticResource PurchaseOrderCellText}" />
                                            <DataGridTextColumn Header="Khả dụng" Binding="{Binding Eligibility}" Width="1.3*" ElementStyle="{StaticResource PurchaseOrderCellText}" />
                                            <DataGridTemplateColumn Header="" Width="72">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource OfficeMiniButtonStyle}"
                                                                IsEnabled="{Binding Selectable}"
                                                                Tag="{Binding}"
                                                                Click="AddSku_OnClick"
                                                                Content="Thêm" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Expander Margin="0,8,0,0" Header="Nhập nhiều dòng">
                                        <StackPanel Margin="0,6,0,0">
                                            <TextBlock Text="Dán dữ liệu theo cột SKU, số lượng, đơn giá thủ công, kiểu chiết khấu, giá trị chiết khấu, thuế suất và ghi chú; hoặc chọn tệp XLSX."
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBox Margin="0,6,0,0"
                                                     Height="80"
                                                     AcceptsReturn="True"
                                                     VerticalScrollBarVisibility="Auto"
                                                     Text="{Binding BulkText, UpdateSourceTrigger=PropertyChanged}" />
                                            <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                                <Button Style="{StaticResource OfficeSecondaryButtonStyle}"
                                                        Click="DownloadBulkTemplate_OnClick"
                                                        Content="Tải tệp mẫu XLSX" />
                                                <Button Margin="8,0,0,0"
                                                        Style="{StaticResource OfficeSecondaryButtonStyle}"
                                                        Click="ChooseBulkFile_OnClick"
                                                        Content="Chọn tệp" />
                                                <Button Margin="8,0,0,0"
                                                        Style="{StaticResource OfficePrimaryButtonStyle}"
                                                        Click="ImportBulkText_OnClick"
                                                        Content="Kiểm tra và thêm" />
                                            </StackPanel>
                                            <StackPanel Margin="0,6,0,0">
                                                <TextBlock Text="Lý do dùng giá thủ công cho dữ liệu nhập nhiều dòng" Margin="0,0,0,4" />
                                                <TextBox Style="{StaticResource OfficeTextBoxStyle}"
                                                         MaxLength="1000"
                                                         Text="{Binding BulkOverrideReason, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="Chỉ bắt buộc khi tệp/dữ liệu có đơn giá thủ công" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource OfficeCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Dòng mua hàng"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <DataGrid x:Name="EditorLinesGrid"
                                              Margin="0,8,0,0"
                                              Height="270"
                                              AutoGenerateColumns="False"
                                              ItemsSource="{Binding EditorLines}"
                                              Style="{StaticResource OfficeDataGridStyle}"
                                              CellEditEnding="EditorLines_OnCellEditEnding"
                                              HorizontalScrollBarVisibility="Auto">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" IsReadOnly="True" Width="120" ElementStyle="{StaticResource PurchaseOrderCellText}" />
                                            <DataGridTextColumn Header="Tên hàng" Binding="{Binding ItemName}" IsReadOnly="True" Width="1.5*" ElementStyle="{StaticResource PurchaseOrderCellText}" />
                                            <DataGridTextColumn Header="ĐVT" Binding="{Binding UnitCode}" IsReadOnly="True" Width="70" ElementStyle="{StaticResource PurchaseOrderCellText}" />
                                            <DataGridTextColumn Header="Số lượng" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="85" />
                                            <DataGridTextColumn Header="Tình trạng giá" Binding="{Binding PriceStatusText}" IsReadOnly="True" Width="115" ElementStyle="{StaticResource PurchaseOrderCellText}" />
                                            <DataGridTemplateColumn Header="Giá thủ công" Width="90">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  IsChecked="{Binding ManualPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  IsEnabled="{Binding DataContext.CanOverridePrice, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Đơn giá" Binding="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}" Width="105" />
                                            <DataGridTemplateColumn Header="Chiết khấu" Width="120">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox SelectedValue="{Binding DiscountMode, Mode=TwoWay}"
                                                                  SelectedValuePath="Tag">
                                                            <ComboBoxItem Tag="TOTAL_AMOUNT" Content="Giảm tổng dòng" />
                                                            <ComboBoxItem Tag="PER_UNIT" Content="Giảm mỗi đơn vị" />
                                                            <ComboBoxItem Tag="PERCENT" Content="% tiền hàng" />
                                                        </ComboBox>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Giá trị CK" Binding="{Binding DiscountValue, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                                            <DataGridTextColumn Header="Thuế %" Binding="{Binding TaxRate, UpdateSourceTrigger=PropertyChanged}" Width="75" />
                                            <DataGridTextColumn Header="Lý do giá thủ công" Binding="{Binding OverrideReason, UpdateSourceTrigger=PropertyChanged}" Width="180" />
                                            <DataGridTextColumn Header="Ghi chú" Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Width="160" />
                                            <DataGridTextColumn Header="Thành tiền dự kiến" Binding="{Binding LineTotalPreview}" IsReadOnly="True" Width="135" ElementStyle="{StaticResource PurchaseOrderNumericText}" />
                                            <DataGridTemplateColumn Header="" Width="64">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource OfficeMiniButtonStyle}"
                                                                Tag="{Binding}"
                                                                Click="RemoveLine_OnClick"
                                                                Content="Xóa" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2"
                                Margin="0,8,0,0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Style="{StaticResource OfficeSecondaryButtonStyle}"
                                Click="CloseEditor_OnClick"
                                Content="Hủy thao tác" />
                        <Button Margin="8,0,0,0"
                                Style="{StaticResource OfficePrimaryButtonStyle}"
                                IsEnabled="{Binding CanSaveDraft}"
                                Click="Save_OnClick"
                                Content="{Binding SaveButtonText}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVisibility}}"
              Background="#99000000">
            <Border Margin="36"
                    MaxWidth="1450"
                    MaxHeight="880"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Style="{StaticResource OfficeCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="CHI TIẾT ĐƠN MUA HÀNG"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding DetailTitle}"
                                       Margin="0,2,0,0"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Style="{StaticResource OfficeSecondaryButtonStyle}"
                                Click="CloseDetail_OnClick"
                                Content="Đóng" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <WrapPanel Margin="0,0,0,8">
                                <Border Width="210" Margin="0,0,8,4" Style="{StaticResource OfficeSummaryCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Trạng thái" Style="{StaticResource OfficeSummaryLabelStyle}" />
                                        <TextBlock Text="{Binding DetailStatus}" Style="{StaticResource OfficeSummaryValueStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Width="330" Margin="0,0,8,4" Style="{StaticResource OfficeCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Nhà cung cấp" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding DetailSupplier}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Width="300" Margin="0,0,8,4" Style="{StaticResource OfficeCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Kho nhận" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding DetailWarehouse}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Width="250" Margin="0,0,8,4" Style="{StaticResource OfficeCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Ngày đặt → dự kiến nhận" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding DetailDates}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Width="280" Margin="0,0,8,4" Style="{StaticResource OfficeCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Tham chiếu nhà cung cấp" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding DetailReference}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <Border Margin="0,0,0,8" Style="{StaticResource OfficeCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Lịch sử nhận hàng"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding DetailReceiptSummary}"
                                               Margin="0,2,0,6"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <DataGrid Height="150"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              ItemsSource="{Binding DetailReceipts}"
                                              Style="{StaticResource OfficeDataGridStyle}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Số phiếu" Binding="{Binding Number}" Width="120" ElementStyle="{StaticResource PurchaseOrderCellText}" />
                                            <DataGridTextColumn Header="Ngày nhận" Binding="{Binding Date}" Width="95" ElementStyle="{StaticResource PurchaseOrderCellText}" />
                                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="120" ElementStyle="{StaticResource PurchaseOrderCellText}" />
                                            <DataGridTextColumn Header="Tham chiếu NCC" Binding="{Binding SupplierReference}" Width="*" ElementStyle="{StaticResource PurchaseOrderCellText}" />
                                            <DataGridTextColumn Header="Số lượng nhận" Binding="{Binding Quantity}" Width="110" ElementStyle="{StaticResource PurchaseOrderNumericText}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,0,0,8" Style="{StaticResource OfficeCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Dòng mua hàng"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <DataGrid Margin="0,6,0,0"
                                              Height="260"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              ItemsSource="{Binding DetailLines}"
                                              Style="{StaticResource OfficeDataGridStyle}"
                                              HorizontalScrollBarVisibility="Auto">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="110" ElementStyle="{StaticResource PurchaseOrderCellText}" />
                                            <DataGridTextColumn Header="Tên hàng" Binding="{Binding Name}" Width="1.4*" ElementStyle="{StaticResource PurchaseOrderCellText}" />
                                            <DataGridTextColumn Header="SL" Binding="{Binding Quantity}" Width="75" ElementStyle="{StaticResource PurchaseOrderNumericText}" />
                                            <DataGridTextColumn Header="Thực nhận" Binding="{Binding Received}" Width="80" ElementStyle="{StaticResource PurchaseOrderNumericText}" />
                                            <DataGridTextColumn Header="Chấp nhận" Binding="{Binding Accepted}" Width="80" ElementStyle="{StaticResource PurchaseOrderNumericText}" />
                                            <DataGridTextColumn Header="Loại" Binding="{Binding Rejected}" Width="70" ElementStyle="{StaticResource PurchaseOrderNumericText}" />
                                            <DataGridTextColumn Header="Chốt thiếu" Binding="{Binding ShortageClosed}" Width="85" ElementStyle="{StaticResource PurchaseOrderNumericText}" />
                                            <DataGridTextColumn Header="Còn lại" Binding="{Binding Remaining}" Width="75" ElementStyle="{StaticResource PurchaseOrderNumericText}" />
                                            <DataGridTextColumn Header="ĐVT" Binding="{Binding Unit}" Width="65" ElementStyle="{StaticResource PurchaseOrderCellText}" />
                                            <DataGridTextColumn Header="Quy đổi" Binding="{Binding Conversion}" Width="75" ElementStyle="{StaticResource PurchaseOrderNumericText}" />
                                            <DataGridTextColumn Header="Đơn giá" Binding="{Binding UnitPrice}" Width="105" ElementStyle="{StaticResource PurchaseOrderNumericText}" />
                                            <DataGridTextColumn Header="Chiết khấu" Binding="{Binding Discount}" Width="105" ElementStyle="{StaticResource PurchaseOrderNumericText}" />
                                            <DataGridTextColumn Header="Thuế" Binding="{Binding Tax}" Width="95" ElementStyle="{StaticResource PurchaseOrderNumericText}" />
                                            <DataGridTextColumn Header="Thành tiền" Binding="{Binding Total}" Width="115" ElementStyle="{StaticResource PurchaseOrderNumericText}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <WrapPanel HorizontalAlignment="Right">
                                <Border Width="180" Margin="0,0,8,4" Style="{StaticResource OfficeSummaryCardStyle}">
                                    <StackPanel><TextBlock Text="Tiền hàng" Style="{StaticResource OfficeSummaryLabelStyle}" /><TextBlock Text="{Binding DetailSubtotal}" Style="{StaticResource OfficeSummaryValueStyle}" /></StackPanel>
                                </Border>
                                <Border Width="180" Margin="0,0,8,4" Style="{StaticResource OfficeSummaryCardStyle}">
                                    <StackPanel><TextBlock Text="Chiết khấu" Style="{StaticResource OfficeSummaryLabelStyle}" /><TextBlock Text="{Binding DetailDiscount}" Style="{StaticResource OfficeSummaryValueStyle}" /></StackPanel>
                                </Border>
                                <Border Width="180" Margin="0,0,8,4" Style="{StaticResource OfficeSummaryCardStyle}">
                                    <StackPanel><TextBlock Text="Thuế" Style="{StaticResource OfficeSummaryLabelStyle}" /><TextBlock Text="{Binding DetailTax}" Style="{StaticResource OfficeSummaryValueStyle}" /></StackPanel>
                                </Border>
                                <Border Width="200" Margin="0,0,0,4" Style="{StaticResource OfficeSummaryCardStyle}">
                                    <StackPanel><TextBlock Text="Tổng cộng" Style="{StaticResource OfficeSummaryLabelStyle}" /><TextBlock Text="{Binding DetailTotal}" Style="{StaticResource OfficeSummaryValueStyle}" /></StackPanel>
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Button Grid.Row="2"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Right"
                            Style="{StaticResource OfficeSecondaryButtonStyle}"
                            Click="CloseDetail_OnClick"
                            Content="Đóng chi tiết" />
                </Grid>
            </Border>
        </Grid>

        <Grid Visibility="{Binding IsCancelOpen, Converter={StaticResource BoolToVisibility}}"
              Background="#99000000">
            <Border Width="520"
                    Padding="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource OfficeCardStyle}">
                <StackPanel>
                    <TextBlock Text="Hủy đơn mua hàng"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,8"
                               Text="Lịch sử đơn vẫn được giữ lại để đối soát."
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="Lý do hủy" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource OfficeTextBoxStyle}"
                             MaxLength="1000"
                             Text="{Binding CancelReason, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Margin="0,12,0,0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Style="{StaticResource OfficeSecondaryButtonStyle}"
                                Click="CloseCancel_OnClick"
                                Content="Quay lại" />
                        <Button Margin="8,0,0,0"
                                Style="{StaticResource OfficePrimaryButtonStyle}"
                                Click="ConfirmCancel_OnClick"
                                Content="Hủy đơn" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
