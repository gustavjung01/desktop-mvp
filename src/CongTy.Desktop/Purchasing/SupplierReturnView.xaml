<UserControl x:Class="CongTy.Desktop.Purchasing.SupplierReturnView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="SupplierReturnCellText" TargetType="TextBlock" BasedOn="{StaticResource OfficeGridTextStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SupplierReturnNumericText" TargetType="TextBlock" BasedOn="{StaticResource OfficeGridTextStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Message}" VerticalAlignment="Center" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Margin="0,0,8,0"
                                Style="{StaticResource OfficeSecondaryButtonStyle}"
                                IsEnabled="{Binding CanRead}"
                                Click="ExportXlsx_OnClick"
                                Content="Xuất Excel" />
                        <Button Margin="0,0,8,0"
                                Style="{StaticResource OfficeSecondaryButtonStyle}"
                                IsEnabled="{Binding CanRead}"
                                Click="ExportCsv_OnClick"
                                Content="Xuất CSV" />
                        <Button Margin="0,0,8,0"
                                Style="{StaticResource OfficeSecondaryButtonStyle}"
                                IsEnabled="{Binding CanRead}"
                                Click="Refresh_OnClick"
                                Content="{Binding RefreshButtonText}" />
                        <Button Style="{StaticResource OfficePrimaryButtonStyle}"
                                IsEnabled="{Binding CanCreateReturn}"
                                Click="Create_OnClick"
                                Content="Tạo phiếu trả" />
                    </StackPanel>
                </Grid>

                <WrapPanel Margin="0,0,0,8">
                    <Border Width="170" Margin="0,0,8,4" Style="{StaticResource OfficeSummaryCardStyle}">
                        <StackPanel><TextBlock Text="Tổng phiếu" Style="{StaticResource OfficeSummaryLabelStyle}" /><TextBlock Text="{Binding TotalCount}" Style="{StaticResource OfficeSummaryValueStyle}" /></StackPanel>
                    </Border>
                    <Border Width="170" Margin="0,0,8,4" Style="{StaticResource OfficeSummaryCardStyle}">
                        <StackPanel><TextBlock Text="Nháp" Style="{StaticResource OfficeSummaryLabelStyle}" /><TextBlock Text="{Binding DraftCount}" Style="{StaticResource OfficeSummaryValueStyle}" /></StackPanel>
                    </Border>
                    <Border Width="170" Margin="0,0,8,4" Style="{StaticResource OfficeSummaryCardStyle}">
                        <StackPanel><TextBlock Text="Chờ duyệt" Style="{StaticResource OfficeSummaryLabelStyle}" /><TextBlock Text="{Binding PendingCount}" Style="{StaticResource OfficeSummaryValueStyle}" /></StackPanel>
                    </Border>
                    <Border Width="170" Margin="0,0,8,4" Style="{StaticResource OfficeSummaryCardStyle}">
                        <StackPanel><TextBlock Text="Đã ghi sổ" Style="{StaticResource OfficeSummaryLabelStyle}" /><TextBlock Text="{Binding PostedCount}" Style="{StaticResource OfficeSummaryValueStyle}" /></StackPanel>
                    </Border>
                </WrapPanel>

                <Border Margin="0,0,0,8" Style="{StaticResource OfficeCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Tìm kiếm" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource OfficeTextBoxStyle}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Số phiếu, nhà cung cấp, kho, phiếu nhận, SKU hoặc mã lý do" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Trạng thái" Margin="0,0,0,4" />
                            <ComboBox MinHeight="30"
                                      ItemsSource="{Binding StatusOptions}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding SelectedStatus, Mode=TwoWay}" />
                        </StackPanel>
                        <TextBlock Grid.Column="3"
                                   Margin="16,20,0,0"
                                   Text="{Binding VisibleCountText}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource OfficeCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Danh sách phiếu trả"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="Trả hàng đã nhận về nhà cung cấp"
                                   Margin="0,2,0,8"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <DataGrid AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  RowHeight="42"
                                  ItemsSource="{Binding Rows}"
                                  Style="{StaticResource OfficeDataGridStyle}"
                                  HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="STT" Binding="{Binding Stt}" Width="48" ElementStyle="{StaticResource SupplierReturnNumericText}" />
                                <DataGridTextColumn Header="Số phiếu" Binding="{Binding Number}" Width="120" ElementStyle="{StaticResource SupplierReturnCellText}" />
                                <DataGridTextColumn Header="Nhà cung cấp" Binding="{Binding Supplier}" Width="1.2*" ElementStyle="{StaticResource SupplierReturnCellText}" />
                                <DataGridTextColumn Header="Kho" Binding="{Binding Warehouse}" Width="1*" ElementStyle="{StaticResource SupplierReturnCellText}" />
                                <DataGridTextColumn Header="Ngày trả" Binding="{Binding ReturnDate}" Width="92" ElementStyle="{StaticResource SupplierReturnCellText}" />
                                <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="105" ElementStyle="{StaticResource SupplierReturnCellText}" />
                                <DataGridTextColumn Header="Số dòng" Binding="{Binding LineCount}" Width="70" ElementStyle="{StaticResource SupplierReturnNumericText}" />
                                <DataGridTextColumn Header="Tổng SL" Binding="{Binding Quantity}" Width="85" ElementStyle="{StaticResource SupplierReturnNumericText}" />
                                <DataGridTemplateColumn Header="Thao tác" Width="390">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <WrapPanel VerticalAlignment="Center">
                                                <Button Margin="0,0,4,0" Style="{StaticResource OfficeMiniButtonStyle}" Visibility="{Binding CanView, Converter={StaticResource BoolToVisibility}}" Tag="{Binding}" Click="View_OnClick" Content="Xem" />
                                                <Button Margin="0,0,4,0" Style="{StaticResource OfficeMiniButtonStyle}" Visibility="{Binding CanPrint, Converter={StaticResource BoolToVisibility}}" Tag="{Binding}" Click="Print_OnClick" Content="In / PDF" />
                                                <Button Margin="0,0,4,0" Style="{StaticResource OfficeMiniButtonStyle}" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" Tag="{Binding}" Click="Edit_OnClick" Content="Sửa" />
                                                <Button Margin="0,0,4,0" Style="{StaticResource OfficeMiniButtonStyle}" Visibility="{Binding CanSubmit, Converter={StaticResource BoolToVisibility}}" Tag="{Binding}" Click="Submit_OnClick" Content="Gửi duyệt" />
                                                <Button Margin="0,0,4,0" Style="{StaticResource OfficeMiniButtonStyle}" Visibility="{Binding CanApprove, Converter={StaticResource BoolToVisibility}}" Tag="{Binding}" Click="Approve_OnClick" Content="Duyệt" />
                                                <Button Margin="0,0,4,0" Style="{StaticResource OfficeMiniButtonStyle}" Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}" Tag="{Binding}" Click="Cancel_OnClick" Content="Hủy" />
                                                <Button Margin="0,0,4,0" Style="{StaticResource OfficeMiniButtonStyle}" Visibility="{Binding CanPost, Converter={StaticResource BoolToVisibility}}" Tag="{Binding}" Click="Post_OnClick" Content="Ghi sổ" />
                                                <Button Style="{StaticResource OfficeMiniButtonStyle}" Visibility="{Binding CanReverse, Converter={StaticResource BoolToVisibility}}" Tag="{Binding}" Click="Reverse_OnClick" Content="Đảo" />
                                            </WrapPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibility}}" Background="#99000000">
            <Border Margin="30" MaxWidth="1450" MaxHeight="900" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Style="{StaticResource OfficeCardStyle}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding EditorModeText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding EditorTitle}" Margin="0,2,0,0" FontSize="18" FontWeight="SemiBold" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource OfficeSecondaryButtonStyle}" Click="CloseEditor_OnClick" Content="Đóng" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border Margin="0,0,0,8" Style="{StaticResource OfficeCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.6*" />
                                        <ColumnDefinition Width="0.7*" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="1.1*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                                    <StackPanel Margin="0,0,8,8">
                                        <TextBlock Text="Phiếu nhận hàng nguồn" Margin="0,0,0,4" />
                                        <ComboBox MinHeight="30"
                                                  ItemsSource="{Binding EligibleReceipts}"
                                                  DisplayMemberPath="Display"
                                                  SelectedValuePath="Id"
                                                  SelectedValue="{Binding SelectedGoodsReceiptId, Mode=TwoWay}"
                                                  SelectionChanged="SourceReceipt_OnSelectionChanged">
                                            <ComboBox.Style>
                                                <Style TargetType="ComboBox">
                                                    <Setter Property="IsEnabled" Value="True" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EditorModeText}" Value="SỬA PHIẾU TRẢ NHÀ CUNG CẤP NHÁP">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ComboBox.Style>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,8,8">
                                        <TextBlock Text="Ngày trả" Margin="0,0,0,4" />
                                        <DatePicker SelectedDate="{Binding ReturnDate, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="0,0,8,8">
                                        <TextBlock Text="Nhà cung cấp" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding EditorSupplier, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Margin="0,0,0,8">
                                        <TextBlock Text="Kho xuất trả" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding EditorWarehouse, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="4">
                                        <TextBlock Text="Ghi chú" Margin="0,0,0,4" />
                                        <TextBox Style="{StaticResource OfficeTextBoxStyle}" MaxLength="2000" Text="{Binding EditorNote, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource OfficeCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Dòng hàng có thể trả" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,2,0,6"
                                               Text="Chỉ nhập số lượng ở các dòng cần trả. Số lượng trả không được vượt phần còn có thể trả."
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <DataGrid Height="390"
                                              AutoGenerateColumns="False"
                                              ItemsSource="{Binding EditorLines}"
                                              Style="{StaticResource OfficeDataGridStyle}"
                                              HorizontalScrollBarVisibility="Auto">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Phiếu nhận" Binding="{Binding SourceGoodsReceiptNumber}" IsReadOnly="True" Width="110" ElementStyle="{StaticResource SupplierReturnCellText}" />
                                            <DataGridTextColumn Header="Dòng" Binding="{Binding SourceGoodsReceiptLineNumber}" IsReadOnly="True" Width="55" ElementStyle="{StaticResource SupplierReturnNumericText}" />
                                            <DataGridTextColumn Header="Đơn mua" Binding="{Binding SourcePurchaseOrderNumber}" IsReadOnly="True" Width="110" ElementStyle="{StaticResource SupplierReturnCellText}" />
                                            <DataGridTextColumn Header="SKU" Binding="{Binding SourceSku}" IsReadOnly="True" Width="100" ElementStyle="{StaticResource SupplierReturnCellText}" />
                                            <DataGridTextColumn Header="Tên hàng" Binding="{Binding SourceItemName}" IsReadOnly="True" Width="190" ElementStyle="{StaticResource SupplierReturnCellText}" />
                                            <DataGridTextColumn Header="ĐVT" Binding="{Binding SourceUnitCode}" IsReadOnly="True" Width="65" ElementStyle="{StaticResource SupplierReturnCellText}" />
                                            <DataGridTextColumn Header="Đã nhận" Binding="{Binding SourceAcceptedQuantity}" IsReadOnly="True" Width="75" ElementStyle="{StaticResource SupplierReturnNumericText}" />
                                            <DataGridTextColumn Header="Đã trả" Binding="{Binding PostedReturnQuantity}" IsReadOnly="True" Width="75" ElementStyle="{StaticResource SupplierReturnNumericText}" />
                                            <DataGridTextColumn Header="Còn trả" Binding="{Binding ReturnableQuantity}" IsReadOnly="True" Width="75" ElementStyle="{StaticResource SupplierReturnNumericText}" />
                                            <DataGridTextColumn Header="SL trả" Binding="{Binding ReturnQuantity, UpdateSourceTrigger=PropertyChanged}" Width="85" />
                                            <DataGridTextColumn Header="Mã lý do" Binding="{Binding ReasonCode, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                                            <DataGridTextColumn Header="Ghi chú lý do" Binding="{Binding ReasonNote, UpdateSourceTrigger=PropertyChanged}" Width="180" />
                                            <DataGridTextColumn Header="Vị trí / lô" Binding="{Binding LocationLot}" IsReadOnly="True" Width="145" ElementStyle="{StaticResource SupplierReturnCellText}" />
                                            <DataGridTextColumn Header="Ghi chú dòng" Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Width="150" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Margin="0,8,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource OfficeSecondaryButtonStyle}" Click="CloseEditor_OnClick" Content="Hủy thao tác" />
                        <Button Margin="8,0,0,0" Style="{StaticResource OfficePrimaryButtonStyle}" IsEnabled="{Binding CanSave}" Click="Save_OnClick" Content="{Binding SaveButtonText}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVisibility}}" Background="#99000000">
            <Border Margin="34" MaxWidth="1420" MaxHeight="860" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Style="{StaticResource OfficeCardStyle}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="CHI TIẾT PHIẾU TRẢ NHÀ CUNG CẤP" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding DetailTitle}" Margin="0,2,0,0" FontSize="18" FontWeight="SemiBold" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource OfficeSecondaryButtonStyle}" Click="CloseDetail_OnClick" Content="Đóng" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <WrapPanel Margin="0,0,0,8">
                                <Border Width="170" Margin="0,0,8,4" Style="{StaticResource OfficeSummaryCardStyle}"><StackPanel><TextBlock Text="Trạng thái" Style="{StaticResource OfficeSummaryLabelStyle}" /><TextBlock Text="{Binding DetailStatus}" Style="{StaticResource OfficeSummaryValueStyle}" /></StackPanel></Border>
                                <Border Width="300" Margin="0,0,8,4" Style="{StaticResource OfficeCardStyle}"><StackPanel><TextBlock Text="Nhà cung cấp" FontWeight="SemiBold" /><TextBlock Text="{Binding DetailSupplier}" Margin="0,2,0,0" /></StackPanel></Border>
                                <Border Width="280" Margin="0,0,8,4" Style="{StaticResource OfficeCardStyle}"><StackPanel><TextBlock Text="Kho" FontWeight="SemiBold" /><TextBlock Text="{Binding DetailWarehouse}" Margin="0,2,0,0" /></StackPanel></Border>
                                <Border Width="150" Margin="0,0,8,4" Style="{StaticResource OfficeCardStyle}"><StackPanel><TextBlock Text="Ngày trả" FontWeight="SemiBold" /><TextBlock Text="{Binding DetailReturnDate}" Margin="0,2,0,0" /></StackPanel></Border>
                                <Border Width="170" Margin="0,0,8,4" Style="{StaticResource OfficeSummaryCardStyle}"><StackPanel><TextBlock Text="Tổng SL trả" Style="{StaticResource OfficeSummaryLabelStyle}" /><TextBlock Text="{Binding DetailQuantity}" Style="{StaticResource OfficeSummaryValueStyle}" /></StackPanel></Border>
                            </WrapPanel>
                            <Border Style="{StaticResource OfficeCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Dòng trả hàng" FontSize="16" FontWeight="SemiBold" />
                                    <DataGrid Margin="0,6,0,0" Height="310" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding DetailLines}" Style="{StaticResource OfficeDataGridStyle}" HorizontalScrollBarVisibility="Auto">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Phiếu nhận" Binding="{Binding SourceReceipt}" Width="110" ElementStyle="{StaticResource SupplierReturnCellText}" />
                                            <DataGridTextColumn Header="Dòng" Binding="{Binding SourceLine}" Width="55" ElementStyle="{StaticResource SupplierReturnNumericText}" />
                                            <DataGridTextColumn Header="Đơn mua" Binding="{Binding PurchaseOrder}" Width="105" ElementStyle="{StaticResource SupplierReturnCellText}" />
                                            <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="95" ElementStyle="{StaticResource SupplierReturnCellText}" />
                                            <DataGridTextColumn Header="Tên hàng" Binding="{Binding Name}" Width="175" ElementStyle="{StaticResource SupplierReturnCellText}" />
                                            <DataGridTextColumn Header="ĐVT" Binding="{Binding Unit}" Width="60" ElementStyle="{StaticResource SupplierReturnCellText}" />
                                            <DataGridTextColumn Header="Đã nhận" Binding="{Binding Accepted}" Width="70" ElementStyle="{StaticResource SupplierReturnNumericText}" />
                                            <DataGridTextColumn Header="Đã trả" Binding="{Binding PostedReturn}" Width="70" ElementStyle="{StaticResource SupplierReturnNumericText}" />
                                            <DataGridTextColumn Header="Còn trả" Binding="{Binding Returnable}" Width="70" ElementStyle="{StaticResource SupplierReturnNumericText}" />
                                            <DataGridTextColumn Header="SL trả" Binding="{Binding Returned}" Width="70" ElementStyle="{StaticResource SupplierReturnNumericText}" />
                                            <DataGridTextColumn Header="Lý do" Binding="{Binding Reason}" Width="190" ElementStyle="{StaticResource SupplierReturnCellText}" />
                                            <DataGridTextColumn Header="Vị trí / lô" Binding="{Binding LocationLot}" Width="140" ElementStyle="{StaticResource SupplierReturnCellText}" />
                                            <DataGridTextColumn Header="Ghi chú" Binding="{Binding Note}" Width="150" ElementStyle="{StaticResource SupplierReturnCellText}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                            <WrapPanel Margin="0,8,0,0">
                                <Border Width="360" Margin="0,0,8,4" Style="{StaticResource OfficeCardStyle}"><StackPanel><TextBlock Text="Chứng từ kho" FontWeight="SemiBold" /><TextBlock Text="{Binding DetailMovement}" Margin="0,2,0,0" TextWrapping="Wrap" /></StackPanel></Border>
                                <Border Width="520" Margin="0,0,8,4" Style="{StaticResource OfficeCardStyle}"><StackPanel><TextBlock Text="Ghi chú / lý do trạng thái" FontWeight="SemiBold" /><TextBlock Text="{Binding DetailLifecycleNote}" Margin="0,2,0,0" TextWrapping="Wrap" /></StackPanel></Border>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <Button Grid.Row="2" Margin="0,8,0,0" HorizontalAlignment="Right" Style="{StaticResource OfficeSecondaryButtonStyle}" Click="CloseDetail_OnClick" Content="Đóng chi tiết" />
                </Grid>
            </Border>
        </Grid>

        <Grid Visibility="{Binding IsActionOpen, Converter={StaticResource BoolToVisibility}}" Background="#99000000">
            <Border Width="580" Padding="16" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource OfficeCardStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding ActionTitle}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ActionPrompt}" Margin="0,4,0,12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <StackPanel Visibility="{Binding ActionDateVisible, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Ngày chứng từ" Margin="0,0,0,4" />
                        <DatePicker SelectedDate="{Binding ActionDate, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Margin="0,10,0,0" Visibility="{Binding ActionReasonVisible, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
                            <TextBlock Text="Lý do / ghi chú" />
                            <TextBlock Text=" *"
                                       Foreground="{DynamicResource DangerBrush}"
                                       Visibility="{Binding ActionReasonRequired, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <TextBox Height="72" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" MaxLength="2000" Text="{Binding ActionReason, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource OfficeSecondaryButtonStyle}" Click="CloseAction_OnClick" Content="Quay lại" />
                        <Button Margin="8,0,0,0" Style="{StaticResource OfficePrimaryButtonStyle}" Click="ConfirmAction_OnClick" Content="Xác nhận" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
