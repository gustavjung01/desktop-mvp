<UserControl x:Class="CongTy.Desktop.Purchasing.PurchasingReportingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             PreviewKeyDown="PurchasingReportingView_OnPreviewKeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="ReportCellTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource OfficeGridTextStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ReportNumericTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource OfficeGridTextStyle}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource OfficeCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="1.55*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Kỳ báo cáo"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="Ngày nghiệp vụ"
                                   Margin="0,2,0,0"
                                   FontSize="17"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding PeriodText}"
                                   Margin="0,3,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <Grid Grid.Column="1" Margin="18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Từ ngày" Margin="0,0,0,4" />
                            <DatePicker x:Name="FromDatePicker"
                                        MinHeight="30"
                                        SelectedDate="{Binding FromDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Đến ngày" Margin="0,0,0,4" />
                            <DatePicker MinHeight="30"
                                        SelectedDate="{Binding ToDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Bottom">
                        <Button Margin="0,0,8,0"
                                Style="{StaticResource OfficeSecondaryButtonStyle}"
                                IsEnabled="{Binding CanApply}"
                                Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}"
                                Click="ExportXlsx_OnClick"
                                Content="Xuất Excel" />
                        <Button Style="{StaticResource OfficeSecondaryButtonStyle}"
                                IsEnabled="{Binding CanApply}"
                                Click="Reset_OnClick"
                                Content="Đặt lại" />
                        <Button Margin="8,0,0,0"
                                Style="{StaticResource OfficePrimaryButtonStyle}"
                                IsEnabled="{Binding CanApply}"
                                Click="Apply_OnClick"
                                Content="{Binding ApplyText}" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="0,8,0,0">
                <TextBlock Text="{Binding ReportError}"
                           Foreground="{DynamicResource DangerBrush}"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasReportError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding GeneratedAtText}"
                           Margin="0,3,0,0"
                           HorizontalAlignment="Right"
                           FontSize="10.5"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>

            <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                <Border Width="190"
                        Margin="0,0,8,4"
                        Style="{StaticResource OfficeSummaryCardStyle}"
                        ToolTip="Theo ngày đặt hàng; gồm mọi trạng thái của đơn mua trong kỳ.">
                    <StackPanel>
                        <TextBlock Text="Tổng đơn mua trong kỳ" Style="{StaticResource OfficeSummaryLabelStyle}" />
                        <TextBlock Text="{Binding AllOrderCount}" Style="{StaticResource OfficeSummaryValueStyle}" />
                    </StackPanel>
                </Border>
                <Border Width="190"
                        Margin="0,0,8,4"
                        Style="{StaticResource OfficeSummaryCardStyle}"
                        ToolTip="{Binding EffectiveStatesText}">
                    <StackPanel>
                        <TextBlock Text="Đơn mua có hiệu lực" Style="{StaticResource OfficeSummaryLabelStyle}" />
                        <TextBlock Text="{Binding EffectiveOrderCount}" Style="{StaticResource OfficeSummaryValueStyle}" />
                    </StackPanel>
                </Border>
                <Border Width="170"
                        Margin="0,0,8,4"
                        Style="{StaticResource OfficeSummaryCardStyle}"
                        ToolTip="Không cộng vào giá trị có hiệu lực.">
                    <StackPanel>
                        <TextBlock Text="Đã hủy" Style="{StaticResource OfficeSummaryLabelStyle}" />
                        <TextBlock Text="{Binding CancelledOrderCount}" Style="{StaticResource OfficeSummaryValueStyle}" />
                    </StackPanel>
                </Border>
                <Border Width="170"
                        Margin="0,0,8,4"
                        Style="{StaticResource OfficeSummaryCardStyle}"
                        ToolTip="Đơn mua chưa vào giá trị có hiệu lực.">
                    <StackPanel>
                        <TextBlock Text="Chờ duyệt" Style="{StaticResource OfficeSummaryLabelStyle}" />
                        <TextBlock Text="{Binding PendingApprovalCount}" Style="{StaticResource OfficeSummaryValueStyle}" />
                    </StackPanel>
                </Border>
                <Border Width="190"
                        Margin="0,0,8,4"
                        Style="{StaticResource OfficeSummaryCardStyle}"
                        ToolTip="Theo ngày nhận hàng trong cùng kỳ.">
                    <StackPanel>
                        <TextBlock Text="Phiếu nhận đã ghi sổ" Style="{StaticResource OfficeSummaryLabelStyle}" />
                        <TextBlock Text="{Binding PostedReceiptCount}" Style="{StaticResource OfficeSummaryValueStyle}" />
                    </StackPanel>
                </Border>
                <Border Width="190"
                        Margin="0,0,8,4"
                        Style="{StaticResource OfficeSummaryCardStyle}"
                        ToolTip="Giữ riêng khỏi phiếu nhận đang hiệu lực.">
                    <StackPanel>
                        <TextBlock Text="Phiếu nhận đã đảo" Style="{StaticResource OfficeSummaryLabelStyle}" />
                        <TextBlock Text="{Binding ReversedReceiptCount}" Style="{StaticResource OfficeSummaryValueStyle}" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <Grid Grid.Row="3" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*" />
                    <ColumnDefinition Width="0.75*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Margin="0,0,5,0" Style="{StaticResource OfficeCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Giá trị theo tiền tệ"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="Không gộp các loại tiền tệ"
                                           Margin="0,2,0,0"
                                           FontSize="16"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CurrencyCountText}"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Grid>
                        <DataGrid Grid.Row="1"
                                  Margin="0,8,0,0"
                                  Height="210"
                                  Style="{StaticResource OfficeDataGridStyle}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  RowHeight="36"
                                  ItemsSource="{Binding CurrencyRows}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="STT" Binding="{Binding Stt}" Width="48" HeaderStyle="{StaticResource OfficeDataGridNumericHeaderStyle}" ElementStyle="{StaticResource ReportNumericTextStyle}" />
                                <DataGridTextColumn Header="Tiền tệ" Binding="{Binding CurrencyCode}" Width="*" ElementStyle="{StaticResource ReportCellTextStyle}" />
                                <DataGridTextColumn Header="Chứng từ hiệu lực" Binding="{Binding DocumentCount}" Width="1.2*" HeaderStyle="{StaticResource OfficeDataGridNumericHeaderStyle}" ElementStyle="{StaticResource ReportNumericTextStyle}" />
                                <DataGridTextColumn Header="Giá trị" Binding="{Binding Value}" Width="1.25*" HeaderStyle="{StaticResource OfficeDataGridNumericHeaderStyle}" ElementStyle="{StaticResource ReportNumericTextStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="2"
                                   Text="{Binding CurrencyEmptyText}"
                                   Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="5,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource OfficeCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Trạng thái"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="Trạng thái đơn mua"
                                       Margin="0,2,0,8"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding PurchaseOrderStatuses}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding DocumentCount}" FontWeight="SemiBold" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding PurchaseStatusEmptyText}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource OfficeCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Trạng thái"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="Phiếu nhận hàng"
                                       Margin="0,2,0,8"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding GoodsReceiptStatuses}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding DocumentCount}" FontWeight="SemiBold" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding ReceiptStatusEmptyText}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Border Grid.Row="4" Margin="0,10,0,0" Style="{StaticResource OfficeCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Xu hướng theo ngày"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="Giá trị chứng từ có hiệu lực"
                                       Margin="0,2,0,0"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="Mốc ngày theo giờ Việt Nam"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Grid>
                    <DataGrid Grid.Row="1"
                              Margin="0,8,0,0"
                              Height="230"
                              Style="{StaticResource OfficeDataGridStyle}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              RowHeight="36"
                              ItemsSource="{Binding TrendRows}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STT" Binding="{Binding Stt}" Width="48" HeaderStyle="{StaticResource OfficeDataGridNumericHeaderStyle}" ElementStyle="{StaticResource ReportNumericTextStyle}" />
                            <DataGridTextColumn Header="Ngày" Binding="{Binding Date}" Width="*" ElementStyle="{StaticResource ReportCellTextStyle}" />
                            <DataGridTextColumn Header="Tiền tệ" Binding="{Binding CurrencyCode}" Width="*" ElementStyle="{StaticResource ReportCellTextStyle}" />
                            <DataGridTextColumn Header="Số chứng từ" Binding="{Binding DocumentCount}" Width="*" HeaderStyle="{StaticResource OfficeDataGridNumericHeaderStyle}" ElementStyle="{StaticResource ReportNumericTextStyle}" />
                            <DataGridTextColumn Header="Giá trị" Binding="{Binding Value}" Width="1.25*" HeaderStyle="{StaticResource OfficeDataGridNumericHeaderStyle}" ElementStyle="{StaticResource ReportNumericTextStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2"
                               Text="{Binding TrendEmptyText}"
                               Margin="0,6,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </Grid>
            </Border>

            <Grid Grid.Row="5" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Margin="0,0,5,0" Style="{StaticResource OfficeCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Nhà cung cấp nổi bật"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="Theo giá trị hiệu lực"
                                       Margin="0,2,0,0"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                        <DataGrid Grid.Row="1"
                                  Margin="0,8,0,0"
                                  Height="250"
                                  Style="{StaticResource OfficeDataGridStyle}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  RowHeight="48"
                                  ItemsSource="{Binding SupplierRows}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="STT" Binding="{Binding Stt}" Width="45" HeaderStyle="{StaticResource OfficeDataGridNumericHeaderStyle}" ElementStyle="{StaticResource ReportNumericTextStyle}" />
                                <DataGridTemplateColumn Header="Nhà cung cấp" Width="1.6*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Code}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Name}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Tiền tệ" Binding="{Binding CurrencyCode}" Width="0.75*" ElementStyle="{StaticResource ReportCellTextStyle}" />
                                <DataGridTextColumn Header="Chứng từ" Binding="{Binding DocumentCount}" Width="0.75*" HeaderStyle="{StaticResource OfficeDataGridNumericHeaderStyle}" ElementStyle="{StaticResource ReportNumericTextStyle}" />
                                <DataGridTextColumn Header="Giá trị" Binding="{Binding Value}" Width="1.05*" HeaderStyle="{StaticResource OfficeDataGridNumericHeaderStyle}" ElementStyle="{StaticResource ReportNumericTextStyle}" />
                                <DataGridTemplateColumn Header="Chi tiết" Width="82" HeaderStyle="{StaticResource OfficeDataGridActionHeaderStyle}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button VerticalAlignment="Center"
                                                    Style="{StaticResource OfficeMiniButtonStyle}"
                                                    IsEnabled="{Binding DataContext.CanOpenPurchaseOrders, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                    Tag="{Binding}"
                                                    Click="OpenSupplierOrders_OnClick"
                                                    Content="Xem đơn" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="2"
                                   Text="{Binding SupplierEmptyText}"
                                   Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Grid>
                </Border>

                <Border Grid.Column="1" Margin="5,0,0,0" Style="{StaticResource OfficeCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="SKU nổi bật"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="Theo giá trị hiệu lực"
                                       Margin="0,2,0,0"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                        <DataGrid Grid.Row="1"
                                  Margin="0,8,0,0"
                                  Height="250"
                                  Style="{StaticResource OfficeDataGridStyle}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  RowHeight="48"
                                  ItemsSource="{Binding SkuRows}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="STT" Binding="{Binding Stt}" Width="45" HeaderStyle="{StaticResource OfficeDataGridNumericHeaderStyle}" ElementStyle="{StaticResource ReportNumericTextStyle}" />
                                <DataGridTemplateColumn Header="SKU" Width="1.55*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Sku}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding NameAndCurrency}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="SL cơ sở" Binding="{Binding BaseQuantity}" Width="0.8*" HeaderStyle="{StaticResource OfficeDataGridNumericHeaderStyle}" ElementStyle="{StaticResource ReportNumericTextStyle}" />
                                <DataGridTextColumn Header="Giá trị" Binding="{Binding Value}" Width="1.05*" HeaderStyle="{StaticResource OfficeDataGridNumericHeaderStyle}" ElementStyle="{StaticResource ReportNumericTextStyle}" />
                                <DataGridTextColumn Header="Nguồn" Binding="{Binding SourceDocument}" Width="0.95*" ElementStyle="{StaticResource ReportCellTextStyle}" />
                                <DataGridTemplateColumn Header="Chi tiết" Width="82" HeaderStyle="{StaticResource OfficeDataGridActionHeaderStyle}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button VerticalAlignment="Center"
                                                    Style="{StaticResource OfficeMiniButtonStyle}"
                                                    IsEnabled="{Binding DataContext.CanOpenPurchaseOrders, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                    Tag="{Binding}"
                                                    Click="OpenSkuOrders_OnClick"
                                                    Content="Xem đơn" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="2"
                                   Text="{Binding SkuEmptyText}"
                                   Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="6"
                    Margin="0,10,0,0"
                    Style="{StaticResource OfficeCardStyle}">
                <TextBlock Text="{Binding LineageText}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
