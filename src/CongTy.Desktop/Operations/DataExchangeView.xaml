<UserControl x:Class="CongTy.Desktop.Operations.DataExchangeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="DataExchangeView_OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="DataExchangeMessageStyle" TargetType="Border" BasedOn="{StaticResource OfficeCardStyle}">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DataExchangeSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style x:Key="DataExchangeHintStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="16,12,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource DataExchangeMessageStyle}"
                    Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource OfficeSecondaryButtonStyle}"
                        IsEnabled="False"
                        ToolTip="Lịch sử nhập/xuất chưa có trên bản máy tính."
                        Content="Lịch sử nhập/xuất" />
                <Button Margin="8,0,0,0"
                        Style="{StaticResource OfficeSecondaryButtonStyle}"
                        IsEnabled="{Binding CanOpen}"
                        Click="Refresh_OnClick"
                        Content="Làm mới" />
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="1"
                    Margin="16,12,16,16"
                    Style="{StaticResource OfficeTabControlStyle}"
                    SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <TabItem Header="Sản phẩm và SKU">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,8,0,0">
                        <Border Style="{StaticResource OfficeCardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource DataExchangeSectionTitleStyle}" Text="Sản phẩm và SKU" />
                                        <TextBlock Style="{StaticResource DataExchangeHintStyle}"
                                                   Text="Nhập hoặc xuất nhiều sản phẩm và SKU cùng lúc. Sau khi chọn tệp, xem trước và chọn đơn vị, lô, hạn sử dụng và vị trí kho trước khi ghi dữ liệu." />
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1" Margin="12,0,0,0" HorizontalAlignment="Right">
                                        <Button Margin="4,0" Style="{StaticResource OfficePrimaryButtonStyle}" IsEnabled="{Binding CanUseProductImport}" Click="ProductImport_OnClick" Content="Chọn tệp để nhập" />
                                        <Button Margin="4,0" Style="{StaticResource OfficeSecondaryButtonStyle}" Click="ProductTemplateXlsx_OnClick" Content="Tải mẫu Excel" />
                                        <Button Margin="4,0" Style="{StaticResource OfficeSecondaryButtonStyle}" Click="ProductTemplateCsv_OnClick" Content="Tải mẫu CSV" />
                                        <Button Margin="4,0" Style="{StaticResource OfficeSecondaryButtonStyle}" IsEnabled="{Binding CanUseProductExport}" Click="ProductExportXlsx_OnClick" Content="Xuất Excel" />
                                        <Button Margin="4,0" Style="{StaticResource OfficeSecondaryButtonStyle}" IsEnabled="{Binding CanUseProductExport}" Click="ProductExportCsv_OnClick" Content="Xuất CSV" />
                                    </WrapPanel>
                                </Grid>

                                <Expander Margin="0,12,0,0" Header="Chọn thông tin muốn xuất">
                                    <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding ProductExportColumns}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Margin="0,0,18,8" Content="{Binding Display}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>

                                <Border Margin="0,12,0,0" Padding="12" Background="{DynamicResource AccentSoftBrush}" CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="Cách khai báo SKU" />
                                        <TextBlock Style="{StaticResource DataExchangeHintStyle}"
                                                   Text="Mỗi SKU chọn đơn vị tính và hệ số quy đổi. SKU dùng làm đơn vị tồn chuẩn có hệ số = 1; tại SKU này chọn thêm Có/Không quản lý theo lô, cách quản lý hạn sử dụng và có bắt buộc vị trí kho hay không." />
                                    </StackPanel>
                                </Border>
                                <TextBlock Style="{StaticResource DataExchangeHintStyle}"
                                           Text="Khi cập nhật sản phẩm đã có, tệp cần chứa đầy đủ các SKU đang sử dụng của sản phẩm đó để tránh bỏ sót quy cách." />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0"
                                Style="{StaticResource OfficeCardStyle}"
                                Visibility="{Binding ShowProductPreview, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="Xem trước trước khi nhập" />
                                        <TextBlock Style="{StaticResource DataExchangeHintStyle}">
                                            <Run Text="{Binding PendingFileName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding PendingRows.Count, Mode=OneWay}" /><Run Text=" dòng." />
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Margin="4,0" Style="{StaticResource OfficeSecondaryButtonStyle}" Click="CancelImport_OnClick" Content="Bỏ file" />
                                        <Button Margin="4,0" Style="{StaticResource OfficePrimaryButtonStyle}" IsEnabled="{Binding CanConfirmImport}" Click="ConfirmImport_OnClick" Content="Xác nhận nhập" />
                                    </StackPanel>
                                </Grid>

                                <Border Margin="0,12,0,0" Padding="10" Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="8">
                                    <StackPanel>
                                        <WrapPanel>
                                            <TextBlock Margin="0,4,12,0" FontWeight="SemiBold" Text="Thiết lập hàng loạt" />
                                            <TextBlock Margin="0,4,12,0"><Run Text="{Binding SelectedPendingCount, Mode=OneWay}" /><Run Text=" dòng đã chọn" /></TextBlock>
                                            <Button Margin="0,0,6,0" Style="{StaticResource OfficeSecondaryButtonStyle}" Click="SelectAllPending_OnClick" Content="Tất cả" />
                                            <Button Margin="0,0,6,0" Style="{StaticResource OfficeSecondaryButtonStyle}" Click="SelectBasePending_OnClick" Content="Đơn vị lẻ" />
                                            <Button Margin="0,0,6,0" Style="{StaticResource OfficeSecondaryButtonStyle}" Click="SelectCartonPending_OnClick" Content="Thùng" />
                                            <Button Margin="0,0,6,0" Style="{StaticResource OfficeSecondaryButtonStyle}" Click="ExpandSameProduct_OnClick" Content="Mở rộng cùng Mã SP" />
                                            <Button Style="{StaticResource OfficeSecondaryButtonStyle}" Click="ClearPendingSelection_OnClick" Content="Bỏ chọn" />
                                        </WrapPanel>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Margin="0,0,8,0" ItemsSource="{Binding BulkFields}" DisplayMemberPath="Display" SelectedValuePath="Id" SelectedValue="{Binding BulkField, Mode=TwoWay}" />
                                            <TextBox Grid.Column="1" Margin="0,0,8,0" Text="{Binding BulkValue, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Grid.Column="2" Style="{StaticResource OfficePrimaryButtonStyle}" Click="ApplyBulk_OnClick" Content="Áp dụng cho dòng đã chọn" />
                                        </Grid>
                                        <TextBlock Style="{StaticResource DataExchangeHintStyle}" Text="Trường cấp sản phẩm tự đồng bộ khi kiểm tra dữ liệu. Chính sách lô, hạn sử dụng và vị trí chỉ áp dụng cho SKU tồn chuẩn." />
                                    </StackPanel>
                                </Border>

                                <DataGrid Margin="0,12,0,0"
                                          Height="420"
                                          ItemsSource="{Binding PendingRows}"
                                          Style="{StaticResource OfficeDataGridStyle}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          FrozenColumnCount="5">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="Chọn" Width="55" Binding="{Binding IsSelected, Mode=TwoWay}" />
                                        <DataGridTextColumn Header="Mã SP" Width="110" Binding="{Binding ProductCode, UpdateSourceTrigger=PropertyChanged}" />
                                        <DataGridTextColumn Header="Tên sản phẩm" Width="190" Binding="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}" />
                                        <DataGridTextColumn Header="SKU" Width="120" Binding="{Binding Sku, UpdateSourceTrigger=PropertyChanged}" />
                                        <DataGridTextColumn Header="Tên SKU / quy cách" Width="180" Binding="{Binding SkuName, UpdateSourceTrigger=PropertyChanged}" />
                                        <DataGridTextColumn Header="Loại SP" Width="110" Binding="{Binding CategoryCode, UpdateSourceTrigger=PropertyChanged}" />
                                        <DataGridTextColumn Header="Nhãn hàng" Width="110" Binding="{Binding BrandCode, UpdateSourceTrigger=PropertyChanged}" />
                                        <DataGridTemplateColumn Header="Loại SKU" Width="125">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding DataContext.VariantChoices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              DisplayMemberPath="Display" SelectedValuePath="Id"
                                                              SelectedValue="{Binding VariantKind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Đơn vị tính" Width="145">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding DataContext.Units, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              DisplayMemberPath="Display" SelectedValuePath="Id"
                                                              SelectedValue="{Binding UnitCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Hệ số quy đổi" Width="120" Binding="{Binding ConversionToBase, UpdateSourceTrigger=PropertyChanged}" />
                                        <DataGridTemplateColumn Header="Tồn chuẩn" Width="105">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding DataContext.BooleanChoices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              DisplayMemberPath="Display" SelectedValuePath="Id"
                                                              SelectedValue="{Binding IsInventoryBase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Quản lý lô" Width="110">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding DataContext.LotChoices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              DisplayMemberPath="Display" SelectedValuePath="Id"
                                                              SelectedValue="{Binding LotTrackingMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Hạn sử dụng" Width="140">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding DataContext.ExpiryChoices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              DisplayMemberPath="Display" SelectedValuePath="Id"
                                                              SelectedValue="{Binding ExpiryTrackingMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Vị trí kho" Width="120">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding DataContext.BooleanChoices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              DisplayMemberPath="Display" SelectedValuePath="Id"
                                                              SelectedValue="{Binding LocationRequired, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Hiển thị SP" Width="110">
                                            <DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.BooleanChoices, RelativeSource={RelativeSource AncestorType=UserControl}}" DisplayMemberPath="Display" SelectedValuePath="Id" SelectedValue="{Binding ProductIsCatalogVisible, Mode=TwoWay}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Cho đặt hàng" Width="110">
                                            <DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.BooleanChoices, RelativeSource={RelativeSource AncestorType=UserControl}}" DisplayMemberPath="Display" SelectedValuePath="Id" SelectedValue="{Binding ProductIsOrderable, Mode=TwoWay}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="SP sử dụng" Width="105">
                                            <DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.BooleanChoices, RelativeSource={RelativeSource AncestorType=UserControl}}" DisplayMemberPath="Display" SelectedValuePath="Id" SelectedValue="{Binding ProductIsActive, Mode=TwoWay}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Cho bán SKU" Width="105">
                                            <DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.BooleanChoices, RelativeSource={RelativeSource AncestorType=UserControl}}" DisplayMemberPath="Display" SelectedValuePath="Id" SelectedValue="{Binding IsSellable, Mode=TwoWay}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Hiển thị SKU" Width="105">
                                            <DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.BooleanChoices, RelativeSource={RelativeSource AncestorType=UserControl}}" DisplayMemberPath="Display" SelectedValuePath="Id" SelectedValue="{Binding IsCatalogVisible, Mode=TwoWay}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="SKU sử dụng" Width="105">
                                            <DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.BooleanChoices, RelativeSource={RelativeSource AncestorType=UserControl}}" DisplayMemberPath="Display" SelectedValuePath="Id" SelectedValue="{Binding IsActive, Mode=TwoWay}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Giá bán">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,8,0,0">
                        <Border Style="{StaticResource OfficeCardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource DataExchangeSectionTitleStyle}" Text="Cập nhật giá bán theo SKU" />
                                        <TextBlock Style="{StaticResource DataExchangeHintStyle}" Text="Chọn một bảng giá hoặc chương trình đang hoạt động. Tệp chỉ cần SKU và Giá bán (VND). SKU đã có giá sẽ được cập nhật; SKU chưa có giá sẽ được thêm mới." />
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1" Margin="12,0,0,0">
                                        <Button Margin="4,0" Style="{StaticResource OfficePrimaryButtonStyle}" IsEnabled="{Binding CanUsePricingImport}" Click="PricingImport_OnClick" Content="Chọn tệp giá" />
                                        <Button Margin="4,0" Style="{StaticResource OfficeSecondaryButtonStyle}" Click="PricingTemplateXlsx_OnClick" Content="Tải mẫu Excel" />
                                        <Button Margin="4,0" Style="{StaticResource OfficeSecondaryButtonStyle}" Click="PricingTemplateCsv_OnClick" Content="Tải mẫu CSV" />
                                        <Button Margin="4,0" Style="{StaticResource OfficeSecondaryButtonStyle}" IsEnabled="{Binding CanUsePricingExport}" Click="PricingExportXlsx_OnClick" Content="Xuất giá hiện tại Excel" />
                                        <Button Margin="4,0" Style="{StaticResource OfficeSecondaryButtonStyle}" IsEnabled="{Binding CanUsePricingExport}" Click="PricingExportCsv_OnClick" Content="Xuất giá hiện tại CSV" />
                                    </WrapPanel>
                                </Grid>
                                <TextBlock Margin="0,14,0,4" FontWeight="SemiBold" Text="Bảng giá hoặc chương trình cần cập nhật" />
                                <ComboBox Width="420" HorizontalAlignment="Left" ItemsSource="{Binding PriceLists}" DisplayMemberPath="Display" SelectedValuePath="Id" SelectedValue="{Binding SelectedPriceListId, Mode=TwoWay}" />
                                <Border Margin="0,12,0,0" Padding="12" Background="{DynamicResource AccentSoftBrush}" CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="Mẫu nhập luôn có tiêu đề SKU và Giá bán (VND)." />
                                        <TextBlock Style="{StaticResource DataExchangeHintStyle}" Text="Hỗ trợ Excel .xlsx và CSV .csv. Nếu dùng tệp Excel .xls cũ, hãy lưu lại thành .xlsx trước khi nhập." />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Margin="0,12,0,0" Style="{StaticResource OfficeCardStyle}" Visibility="{Binding ShowPricingPreview, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock FontWeight="SemiBold"><Run Text="Xem trước trước khi nhập · " /><Run Text="{Binding PendingFileName, Mode=OneWay}" /></TextBlock>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Margin="4,0" Style="{StaticResource OfficeSecondaryButtonStyle}" Click="CancelImport_OnClick" Content="Bỏ file" />
                                        <Button Margin="4,0" Style="{StaticResource OfficePrimaryButtonStyle}" IsEnabled="{Binding CanConfirmImport}" Click="ConfirmImport_OnClick" Content="Xác nhận nhập" />
                                    </StackPanel>
                                </Grid>
                                <DataGrid Margin="0,10,0,0" Height="330" ItemsSource="{Binding PendingRows}" Style="{StaticResource OfficeDataGridStyle}" AutoGenerateColumns="False" CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="SKU" Width="*" Binding="{Binding Sku, UpdateSourceTrigger=PropertyChanged}" />
                                        <DataGridTextColumn Header="Giá bán (VND)" Width="*" Binding="{Binding AmountMinor, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Kiểm kê">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,8,0,0">
                        <Border Style="{StaticResource OfficeCardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource DataExchangeSectionTitleStyle}" Text="Nhập số kiểm kê thực tế" />
                                        <TextBlock Style="{StaticResource DataExchangeHintStyle}" Text="Chọn kho, tải tệp kiểm kê, điền số đếm thực tế rồi nhập lại. Hệ thống chỉ tạo phiếu kiểm kê nháp; tồn kho chưa thay đổi cho đến khi phiếu được duyệt và ghi sổ." />
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1" Margin="12,0,0,0">
                                        <Button Margin="4,0" Style="{StaticResource OfficePrimaryButtonStyle}" IsEnabled="{Binding CanUseStocktakeImport}" Click="StocktakeImport_OnClick" Content="Chọn tệp số đếm" />
                                        <Button Margin="4,0" Style="{StaticResource OfficeSecondaryButtonStyle}" IsEnabled="{Binding CanUseStocktakeExport}" Click="StocktakeExportXlsx_OnClick" Content="Tải mẫu Excel" />
                                        <Button Margin="4,0" Style="{StaticResource OfficeSecondaryButtonStyle}" IsEnabled="{Binding CanUseStocktakeExport}" Click="StocktakeExportCsv_OnClick" Content="Tải mẫu CSV" />
                                    </WrapPanel>
                                </Grid>
                                <TextBlock Margin="0,14,0,4" FontWeight="SemiBold" Text="Kho kiểm kê" />
                                <ComboBox Width="420" HorizontalAlignment="Left" ItemsSource="{Binding Warehouses}" DisplayMemberPath="Display" SelectedValuePath="Id" SelectedValue="{Binding SelectedWarehouseId, Mode=TwoWay}" />
                                <Border Margin="0,12,0,0" Padding="12" Background="{DynamicResource AccentSoftBrush}" CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="Kiểm kê không thay đổi tồn ngay." />
                                            <TextBlock Style="{StaticResource DataExchangeHintStyle}" Text="Số đếm thực tế → tạo phiếu kiểm kê nháp → gửi duyệt → duyệt → ghi sổ chênh lệch. Chưa gửi duyệt, chưa ghi sổ tồn." />
                                        </StackPanel>
                                        <Button Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource OfficeSecondaryButtonStyle}" Click="OpenStocktake_OnClick" Content="Mở màn Kiểm kê kho" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Margin="0,12,0,0" Style="{StaticResource OfficeCardStyle}" Visibility="{Binding ShowStocktakePreview, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock FontWeight="SemiBold"><Run Text="Xem trước trước khi nhập · " /><Run Text="{Binding PendingFileName, Mode=OneWay}" /></TextBlock>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Margin="4,0" Style="{StaticResource OfficeSecondaryButtonStyle}" Click="CancelImport_OnClick" Content="Bỏ file" />
                                        <Button Margin="4,0" Style="{StaticResource OfficePrimaryButtonStyle}" IsEnabled="{Binding CanConfirmImport}" Click="ConfirmImport_OnClick" Content="Xác nhận nhập" />
                                    </StackPanel>
                                </Grid>
                                <DataGrid Margin="0,10,0,0" Height="330" ItemsSource="{Binding PendingRows}" Style="{StaticResource OfficeDataGridStyle}" AutoGenerateColumns="False" CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Mã kho" Width="*" Binding="{Binding WarehouseCode}" />
                                        <DataGridTextColumn Header="Mã vị trí" Width="*" Binding="{Binding LocationCode}" />
                                        <DataGridTextColumn Header="SKU" Width="*" Binding="{Binding Sku}" />
                                        <DataGridTextColumn Header="Mã lô" Width="*" Binding="{Binding LotCode}" />
                                        <DataGridTextColumn Header="Số đếm thực tế" Width="*" Binding="{Binding ActualCount, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Báo giá">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,8,0,0">
                        <Border Style="{StaticResource OfficeCardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource DataExchangeSectionTitleStyle}" Text="Báo giá" />
                                        <TextBlock Style="{StaticResource DataExchangeHintStyle}" Text="Chọn phạm vi hàng hóa và khách hàng; hệ thống tự tìm mức giá đang áp dụng cho từng SKU." />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Margin="4,0" Style="{StaticResource OfficePrimaryButtonStyle}" IsEnabled="{Binding CanUseQuotation}" Click="BuildQuotation_OnClick" Content="Tính báo giá" />
                                        <Button Margin="4,0" Style="{StaticResource OfficeSecondaryButtonStyle}" IsEnabled="{Binding CanUseQuotationExport}" Click="QuotationExportXlsx_OnClick" Content="Xuất Excel" />
                                        <Button Margin="4,0" Style="{StaticResource OfficeSecondaryButtonStyle}" IsEnabled="{Binding CanUseQuotationExport}" Click="QuotationExportCsv_OnClick" Content="Xuất CSV" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,4" FontWeight="SemiBold" Text="Phạm vi" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Margin="4,0,8,4" FontWeight="SemiBold" Text="Kênh bán" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Margin="4,0,0,4" FontWeight="SemiBold" Text="Số lượng" />
                                    <ComboBox Grid.Row="1" Grid.Column="0" Margin="0,0,8,10" ItemsSource="{Binding QuotationScopes}" DisplayMemberPath="Display" SelectedValuePath="Id" SelectedValue="{Binding QuotationScope, Mode=TwoWay}" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="4,0,8,10" ItemsSource="{Binding Channels}" DisplayMemberPath="Display" SelectedValuePath="Id" SelectedValue="{Binding QuotationChannelId, Mode=TwoWay}" />
                                    <TextBox Grid.Row="1" Grid.Column="2" Margin="4,0,0,10" Text="{Binding QuotationQuantity, UpdateSourceTrigger=PropertyChanged}" />
                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,0" Visibility="{Binding IsQuotationCategoryScope, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="Ngành hoặc nhóm" />
                                        <ComboBox ItemsSource="{Binding Categories}" DisplayMemberPath="Display" SelectedValuePath="Id" SelectedValue="{Binding QuotationCategoryId, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,10" Visibility="{Binding IsQuotationSkuScope, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="SKU" />
                                        <TextBox Text="{Binding QuotationSkus, UpdateSourceTrigger=PropertyChanged}" ToolTip="Ví dụ: SP001-LE, SP002-THUNG" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,10,8,0">
                                        <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="Nhóm khách" />
                                        <ComboBox ItemsSource="{Binding CustomerGroups}" DisplayMemberPath="Display" SelectedValuePath="Id" SelectedValue="{Binding QuotationCustomerGroupId, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="4,10,0,0">
                                        <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="Khách hàng" />
                                        <ComboBox ItemsSource="{Binding Customers}" DisplayMemberPath="Display" SelectedValuePath="Id" SelectedValue="{Binding QuotationCustomerId, Mode=TwoWay}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Margin="0,12,0,0" Style="{StaticResource OfficeCardStyle}">
                            <DataGrid Height="390" ItemsSource="{Binding QuotationRows}" Style="{StaticResource OfficeDataGridStyle}" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="SKU" Width="1.2*" Binding="{Binding Sku}" />
                                    <DataGridTextColumn Header="Tên SKU / quy cách" Width="1.8*" Binding="{Binding SkuName}" />
                                    <DataGridTextColumn Header="Sản phẩm" Width="2*" Binding="{Binding ProductName}" />
                                    <DataGridTextColumn Header="SL" Width="0.8*" Binding="{Binding Quantity}" />
                                    <DataGridTextColumn Header="Giá áp dụng" Width="1.1*" Binding="{Binding UnitPrice}" />
                                    <DataGridTextColumn Header="Thành tiền" Width="1.2*" Binding="{Binding LineTotal}" />
                                    <DataGridTextColumn Header="Bảng giá" Width="1*" Binding="{Binding PriceListCode}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Biến động kho">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,8,0,0">
                        <Border Style="{StaticResource OfficeCardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource DataExchangeSectionTitleStyle}" Text="Biến động tồn kho theo SKU" />
                                        <TextBlock Style="{StaticResource DataExchangeHintStyle}" Text="Chọn một dòng tồn để xem từng lần nhập, xuất hoặc điều chỉnh và số tồn sau mỗi lần. Danh sách có thể tải tiếp; file xuất lấy đầy đủ trong phạm vi đã chọn." />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Margin="4,0" Style="{StaticResource OfficePrimaryButtonStyle}" IsEnabled="{Binding CanUseMovements}" Click="LoadMovements_OnClick" Content="Xem biến động" />
                                        <Button Margin="4,0" Style="{StaticResource OfficeSecondaryButtonStyle}" IsEnabled="{Binding CanUseMovements}" Click="MovementExportXlsx_OnClick" Content="Xuất Excel" />
                                        <Button Margin="4,0" Style="{StaticResource OfficeSecondaryButtonStyle}" IsEnabled="{Binding CanUseMovements}" Click="MovementExportCsv_OnClick" Content="Xuất CSV" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Margin="0,14,0,4" FontWeight="SemiBold" Text="Dòng tồn" />
                                <ComboBox ItemsSource="{Binding BalanceChoices}" DisplayMemberPath="Display" SelectedItem="{Binding SelectedBalance, Mode=TwoWay}" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Margin="0,0,6,0" Padding="10" Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="8">
                                        <StackPanel><TextBlock Text="Tồn hiện tại" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Margin="0,3,0,0" FontWeight="SemiBold" Text="{Binding SelectedOnHand}" /></StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Margin="6,0" Padding="10" Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="8">
                                        <StackPanel><TextBlock Text="Đang giữ" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Margin="0,3,0,0" FontWeight="SemiBold" Text="{Binding SelectedReserved}" /></StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Margin="6,0,0,0" Padding="10" Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="8">
                                        <StackPanel><TextBlock Text="Khả dụng" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Margin="0,3,0,0" FontWeight="SemiBold" Text="{Binding SelectedAvailable}" /></StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Margin="0,12,0,0" Style="{StaticResource OfficeCardStyle}">
                            <StackPanel>
                                <DataGrid Height="390" ItemsSource="{Binding MovementRows}" Style="{StaticResource OfficeDataGridStyle}" AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Thời gian" Width="1.2*" Binding="{Binding PostedAt}" />
                                        <DataGridTextColumn Header="Chứng từ" Width="1.5*" Binding="{Binding Document}" />
                                        <DataGridTextColumn Header="Loại nghiệp vụ" Width="1.6*" Binding="{Binding MovementType}" />
                                        <DataGridTextColumn Header="Biến động" Width="1*" Binding="{Binding QuantityDelta}" />
                                        <DataGridTextColumn Header="Tồn sau" Width="1*" Binding="{Binding StockAfter}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Button Margin="0,10,0,0" HorizontalAlignment="Center" Style="{StaticResource OfficeSecondaryButtonStyle}" IsEnabled="{Binding CanLoadMoreMovements}" Click="LoadMoreMovements_OnClick" Content="Xem thêm" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
