<UserControl x:Class="CongTy.Desktop.Workforce.WorkPolicyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="WorkPolicyView_OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="PolicyMessageBorderStyle" TargetType="Border" BasedOn="{StaticResource OfficeCardStyle}">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Style>
        <Style x:Key="PolicyCellTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="PolicyFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,4,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="NHÂN SỰ" FontSize="10" FontWeight="Bold" />
                        <TextBlock Margin="0,3,0,0"
                                   Text="Thiết lập giờ làm, ngày làm việc, phương thức chấm công và lịch sử thay đổi theo thời gian."
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Top">
                        <Button Margin="0,0,8,0"
                                Style="{StaticResource OfficeSecondaryButtonStyle}"
                                IsEnabled="{Binding CanRefresh}"
                                Click="Refresh_OnClick"
                                Content="LÀM MỚI" />
                        <Button Style="{StaticResource OfficePrimaryButtonStyle}"
                                IsEnabled="{Binding CanOpenEditor}"
                                Click="NewPolicy_OnClick"
                                Content="THÊM CHÍNH SÁCH" />
                    </StackPanel>
                </Grid>

                <Border Margin="0,10,0,0"
                        Style="{StaticResource PolicyMessageBorderStyle}"
                        Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <TextBlock Margin="0,14,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="Đang tải chính sách làm việc…"
                           Visibility="{Binding ShowLoading, Converter={StaticResource BoolToVisibility}}" />

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Padding="12" Style="{StaticResource OfficeCardStyle}">
                        <StackPanel>
                            <TextBlock Text="CHÍNH SÁCH" FontSize="10" FontWeight="Bold" />
                            <TextBlock Margin="0,4,0,0"
                                       Text="{Binding PolicyCountText}"
                                       FontSize="24"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Mã chính sách đang được quản lý"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Padding="12" Style="{StaticResource OfficeCardStyle}">
                        <StackPanel>
                            <TextBlock Text="LỊCH SỬ PHIÊN BẢN" FontSize="10" FontWeight="Bold" />
                            <TextBlock Margin="0,4,0,0"
                                       Text="{Binding VersionCountText}"
                                       FontSize="24"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Phiên bản cũ vẫn giữ theo ngày hiệu lực"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TabControl Margin="0,12,0,0">
                    <TabItem Header="Chính sách hiện hành">
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.45*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <Border Padding="12" Style="{StaticResource OfficeCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="DANH SÁCH CHÍNH SÁCH"
                                               FontSize="10"
                                               FontWeight="Bold" />
                                    <TextBlock Margin="0,3,0,10"
                                               Text="Mỗi mã hiển thị phiên bản mới nhất; cập nhật sẽ tạo phiên bản mới thay vì sửa lịch sử."
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                    <DataGrid AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              RowHeight="62"
                                              Style="{StaticResource OfficeDataGridStyle}"
                                              ItemsSource="{Binding CurrentPolicies}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Mã" Binding="{Binding CodeText}" Width="0.7*" ElementStyle="{StaticResource PolicyCellTextStyle}" />
                                            <DataGridTextColumn Header="Tên" Binding="{Binding NameText}" Width="1.2*" ElementStyle="{StaticResource PolicyCellTextStyle}" />
                                            <DataGridTextColumn Header="Phiên bản" Binding="{Binding VersionText}" Width="0.55*" ElementStyle="{StaticResource PolicyCellTextStyle}" />
                                            <DataGridTextColumn Header="Kiểu thời gian" Binding="{Binding TimeModeText}" Width="1*" ElementStyle="{StaticResource PolicyCellTextStyle}" />
                                            <DataGridTextColumn Header="Giờ làm" Binding="{Binding HoursText}" Width="1.3*" ElementStyle="{StaticResource PolicyCellTextStyle}" />
                                            <DataGridTextColumn Header="Chấm công" Binding="{Binding AttendanceText}" Width="1.45*" ElementStyle="{StaticResource PolicyCellTextStyle}" />
                                            <DataGridTextColumn Header="Hiệu lực" Binding="{Binding EffectiveText}" Width="1.15*" ElementStyle="{StaticResource PolicyCellTextStyle}" />
                                            <DataGridTemplateColumn Header="Thao tác" Width="0.8*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Padding="7,3"
                                                                Tag="{Binding}"
                                                                IsEnabled="{Binding CanEdit}"
                                                                Click="EditPolicy_OnClick"
                                                                Content="Cập nhật" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Margin="0,12,0,0"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="Chưa có chính sách làm việc."
                                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    Padding="12"
                                    Style="{StaticResource OfficeCardStyle}">
                                <Grid>
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="Chọn “Thêm chính sách” hoặc “Cập nhật” để mở biểu mẫu."
                                               TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditorOpen}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <StackPanel Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibility}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding EditorTitle}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold" />
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource OfficeSecondaryButtonStyle}"
                                                    Click="CloseEditor_OnClick"
                                                    Content="ĐÓNG" />
                                        </Grid>

                                        <Border Margin="0,10,0,0"
                                                Style="{StaticResource PolicyMessageBorderStyle}"
                                                Visibility="{Binding HasEditorMessage, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{Binding EditorMessage}" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EditorMessageIsError}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource PolicyFieldLabelStyle}" Text="Mã chính sách" />
                                                <TextBox MaxLength="64"
                                                         IsReadOnly="{Binding IsCodeReadOnly}"
                                                         Text="{Binding DraftCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource PolicyFieldLabelStyle}" Text="Tên chính sách" />
                                                <TextBox MaxLength="256"
                                                         Text="{Binding DraftName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Margin="0,10,0,4" FontWeight="SemiBold" Text="Tính chất công việc" />
                                        <TextBox MaxLength="128"
                                                 Text="{Binding DraftWorkNature, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <TextBlock Margin="0,10,0,4" FontWeight="SemiBold" Text="Kiểu thời gian" />
                                        <ComboBox ItemsSource="{Binding TimeModes}"
                                                  SelectedValuePath="Key"
                                                  DisplayMemberPath="Label"
                                                  SelectedValue="{Binding DraftTimeMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <Grid Margin="0,10,0,0"
                                              Visibility="{Binding ShowFixedHours, Converter={StaticResource BoolToVisibility}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource PolicyFieldLabelStyle}" Text="Giờ bắt đầu" />
                                                <TextBox Text="{Binding DraftStartTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource PolicyFieldLabelStyle}" Text="Giờ kết thúc" />
                                                <TextBox Text="{Binding DraftEndTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Margin="0,10,0,4" FontWeight="SemiBold" Text="Ngày làm việc trong tuần" />
                                        <WrapPanel>
                                            <CheckBox Margin="0,0,10,6" IsChecked="{Binding Monday}" Content="Thứ 2" />
                                            <CheckBox Margin="0,0,10,6" IsChecked="{Binding Tuesday}" Content="Thứ 3" />
                                            <CheckBox Margin="0,0,10,6" IsChecked="{Binding Wednesday}" Content="Thứ 4" />
                                            <CheckBox Margin="0,0,10,6" IsChecked="{Binding Thursday}" Content="Thứ 5" />
                                            <CheckBox Margin="0,0,10,6" IsChecked="{Binding Friday}" Content="Thứ 6" />
                                            <CheckBox Margin="0,0,10,6" IsChecked="{Binding Saturday}" Content="Thứ 7" />
                                            <CheckBox Margin="0,0,10,6" IsChecked="{Binding Sunday}" Content="Chủ nhật" />
                                        </WrapPanel>

                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource PolicyFieldLabelStyle}" Text="Nghỉ giữa ca (phút)" />
                                                <TextBox Text="{Binding DraftBreakMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource PolicyFieldLabelStyle}" Text="Ngưỡng đi trễ" />
                                                <TextBox Text="{Binding DraftLateGraceMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Style="{StaticResource PolicyFieldLabelStyle}" Text="Ngưỡng về sớm" />
                                                <TextBox Text="{Binding DraftEarlyLeaveGraceMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Margin="0,10,0,0"
                                                    Visibility="{Binding ShowAttendanceSettings, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock FontWeight="SemiBold" Text="Phương thức chấm công" />
                                            <WrapPanel Margin="0,5,0,0">
                                                <CheckBox Margin="0,0,12,5" IsChecked="{Binding AttendanceQr}" Content="Mã QR" />
                                                <CheckBox Margin="0,0,12,5" IsChecked="{Binding AttendanceFace}" Content="Quét khuôn mặt" />
                                                <CheckBox Margin="0,0,12,5" IsChecked="{Binding AttendanceManual}" Content="Chấm công trực tiếp" />
                                            </WrapPanel>
                                            <TextBlock Margin="0,4,0,4" FontWeight="SemiBold" Text="Cách ghi nhận công" />
                                            <ComboBox ItemsSource="{Binding AttendanceBases}"
                                                      SelectedValuePath="Key"
                                                      DisplayMemberPath="Label"
                                                      SelectedValue="{Binding DraftAttendanceBasis, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>

                                        <WrapPanel Margin="0,10,0,0">
                                            <CheckBox Margin="0,0,14,5"
                                                      IsChecked="{Binding DraftOvertimeEnabled}"
                                                      Content="Có áp dụng tăng ca" />
                                            <CheckBox IsChecked="{Binding DraftOvertimeRequiresApproval}"
                                                      Content="Tăng ca cần duyệt" />
                                        </WrapPanel>

                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource PolicyFieldLabelStyle}" Text="Múi giờ" />
                                                <TextBox MaxLength="64"
                                                         Text="{Binding DraftTimezone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource PolicyFieldLabelStyle}" Text="Làm tròn (phút)" />
                                                <TextBox Text="{Binding DraftRoundingMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource PolicyFieldLabelStyle}" Text="Tối thiểu đủ ngày (phút)" />
                                                <TextBox Text="{Binding DraftMinimumFullDayMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource PolicyFieldLabelStyle}" Text="Tối thiểu nửa ngày (phút)" />
                                                <TextBox Text="{Binding DraftMinimumHalfDayMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Margin="0,10,0,4" FontWeight="SemiBold" Text="Thời điểm áp dụng" />
                                        <StackPanel>
                                            <RadioButton GroupName="PolicyEffectiveMode"
                                                         IsChecked="{Binding ApplyNow, Mode=TwoWay}"
                                                         Content="Áp dụng ngay — có hiệu lực từ hôm nay" />
                                            <RadioButton Margin="0,5,0,0"
                                                         GroupName="PolicyEffectiveMode"
                                                         IsChecked="{Binding ApplyByDate, Mode=TwoWay}"
                                                         Content="Chọn ngày áp dụng" />
                                        </StackPanel>
                                        <DatePicker Margin="0,6,0,0"
                                                    SelectedDate="{Binding DraftEffectiveFrom, Mode=TwoWay}"
                                                    Visibility="{Binding ShowEffectiveDate, Converter={StaticResource BoolToVisibility}}" />

                                        <TextBlock Margin="0,8,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="Cập nhật trong cùng ngày vẫn tạo phiên bản chính sách mới; phiên bản trước được giữ trong lịch sử."
                                                   TextWrapping="Wrap" />

                                        <StackPanel Margin="0,12,0,0"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right">
                                            <Button Margin="0,0,8,0"
                                                    Style="{StaticResource OfficeSecondaryButtonStyle}"
                                                    Click="CloseEditor_OnClick"
                                                    Content="HỦY" />
                                            <Button Style="{StaticResource OfficePrimaryButtonStyle}"
                                                    IsEnabled="{Binding CanSave}"
                                                    Click="SavePolicy_OnClick"
                                                    Content="LƯU CHÍNH SÁCH" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Lịch sử thay đổi">
                        <Border Margin="0,10,0,0" Padding="12" Style="{StaticResource OfficeCardStyle}">
                            <StackPanel>
                                <TextBlock Text="LỊCH SỬ PHIÊN BẢN" FontSize="10" FontWeight="Bold" />
                                <TextBlock Margin="0,3,0,10"
                                           Text="Lịch sử theo ngày hiệu lực là dữ liệu đối chiếu; không sửa đè phiên bản cũ."
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <DataGrid AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          RowHeight="58"
                                          Style="{StaticResource OfficeDataGridStyle}"
                                          ItemsSource="{Binding HistoryPolicies}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Mã" Binding="{Binding CodeText}" Width="0.7*" ElementStyle="{StaticResource PolicyCellTextStyle}" />
                                        <DataGridTextColumn Header="Tên" Binding="{Binding NameText}" Width="1.3*" ElementStyle="{StaticResource PolicyCellTextStyle}" />
                                        <DataGridTextColumn Header="Phiên bản" Binding="{Binding VersionText}" Width="0.65*" ElementStyle="{StaticResource PolicyCellTextStyle}" />
                                        <DataGridTextColumn Header="Kiểu thời gian" Binding="{Binding TimeModeText}" Width="1*" ElementStyle="{StaticResource PolicyCellTextStyle}" />
                                        <DataGridTextColumn Header="Ngày làm việc" Binding="{Binding WorkingDaysText}" Width="1*" ElementStyle="{StaticResource PolicyCellTextStyle}" />
                                        <DataGridTextColumn Header="Chấm công" Binding="{Binding AttendanceText}" Width="1.5*" ElementStyle="{StaticResource PolicyCellTextStyle}" />
                                        <DataGridTextColumn Header="Hiệu lực" Binding="{Binding EffectiveText}" Width="1.2*" ElementStyle="{StaticResource PolicyCellTextStyle}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </TabItem>
                </TabControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
