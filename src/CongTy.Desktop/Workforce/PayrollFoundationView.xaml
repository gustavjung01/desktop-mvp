<UserControl x:Class="CongTy.Desktop.Workforce.PayrollFoundationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="PayrollFoundationView_OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="PayrollMessageBorderStyle" TargetType="Border" BasedOn="{StaticResource OfficeCardStyle}">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Style>
        <Style x:Key="PayrollCellTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="PayrollLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,4,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="NHÂN SỰ" FontSize="10" FontWeight="Bold" />
                    <TextBlock Margin="0,3,0,0"
                               Text="Thiết lập dữ liệu nền tính lương theo kỳ, theo nhân sự và theo ngày áp dụng."
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1"
                        Style="{StaticResource OfficeSecondaryButtonStyle}"
                        IsEnabled="{Binding CanRefresh}"
                        Click="Refresh_OnClick"
                        Content="LÀM MỚI" />
            </Grid>

            <Border Margin="0,10,0,0"
                    Style="{StaticResource PayrollMessageBorderStyle}"
                    Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <TextBlock Margin="0,14,0,0"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="Đang tải dữ liệu tính lương…"
                       Visibility="{Binding ShowLoading, Converter={StaticResource BoolToVisibility}}" />

            <UniformGrid Margin="0,12,0,0" Columns="4">
                <Border Margin="0,0,6,0" Style="{StaticResource OfficeCardStyle}">
                    <StackPanel>
                        <TextBlock Text="KỲ LƯƠNG" FontSize="10" FontWeight="Bold" />
                        <TextBlock Margin="0,5,0,0" Text="{Binding PeriodCountText}" FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Margin="2,0,4,0" Style="{StaticResource OfficeCardStyle}">
                    <StackPanel>
                        <TextBlock Text="KỲ CÔNG ĐÃ CHỐT" FontSize="10" FontWeight="Bold" />
                        <TextBlock Margin="0,5,0,0" Text="{Binding AttendanceSourceCountText}" FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Margin="4,0,2,0" Style="{StaticResource OfficeCardStyle}">
                    <StackPanel>
                        <TextBlock Text="NHÂN SỰ" FontSize="10" FontWeight="Bold" />
                        <TextBlock Margin="0,5,0,0" Text="{Binding EmployeeCountText}" FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Margin="6,0,0,0" Style="{StaticResource OfficeCardStyle}">
                    <StackPanel>
                        <TextBlock Text="LOẠI KHOẢN" FontSize="10" FontWeight="Bold" />
                        <TextBlock Margin="0,5,0,0" Text="{Binding ComponentCountText}" FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TabControl x:Name="PayrollTabs" Margin="0,10,0,0">
                <TabItem Header="Bảng lương">
                    <StackPanel Margin="0,10,0,0">
                        <Border Style="{StaticResource OfficeCardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="KỲ LƯƠNG" FontSize="10" FontWeight="Bold" />
                                        <TextBlock Margin="0,3,0,0" Text="Bảng lương kỳ hiện tại" FontSize="16" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                               Text="{Binding SelectedPeriodStatusText}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Grid>

                                <Border Margin="0,10,0,0" Padding="10" CornerRadius="8"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="Tạo kỳ lương từ kỳ công đã chốt" FontWeight="SemiBold" />
                                        <ComboBox Margin="0,7,0,0"
                                                  ItemsSource="{Binding AttendanceSources}"
                                                  SelectedItem="{Binding SelectedAttendanceSource, Mode=TwoWay}" />
                                        <Button Margin="0,8,0,0" HorizontalAlignment="Right"
                                                Style="{StaticResource OfficePrimaryButtonStyle}"
                                                IsEnabled="{Binding CanCreatePeriod}"
                                                Click="CreatePeriod_OnClick"
                                                Content="TẠO KỲ LƯƠNG" />
                                    </StackPanel>
                                </Border>

                                <DataGrid Margin="0,10,0,0" AutoGenerateColumns="False" IsReadOnly="True"
                                          RowHeight="60" Style="{StaticResource OfficeDataGridStyle}"
                                          ItemsSource="{Binding PeriodRows}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Kỳ lương" Binding="{Binding PeriodText}" Width="1.7*" ElementStyle="{StaticResource PayrollCellTextStyle}" />
                                        <DataGridTextColumn Header="Nguồn bảng công" Binding="{Binding SourceText}" Width="1.1*" ElementStyle="{StaticResource PayrollCellTextStyle}" />
                                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusText}" Width="0.95*" ElementStyle="{StaticResource PayrollCellTextStyle}" />
                                        <DataGridTextColumn Header="Tiền tệ" Binding="{Binding CurrencyText}" Width="0.65*" ElementStyle="{StaticResource PayrollCellTextStyle}" />
                                        <DataGridTemplateColumn Header="Xử lý" Width="0.75*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Padding="8,3" Tag="{Binding}" Click="OpenPeriod_OnClick" Content="Xem kỳ" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="Chưa có kỳ lương. Hãy chọn một kỳ công đã chốt để bắt đầu."
                                           Visibility="{Binding IsPeriodEmpty, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,10,0,0" Style="{StaticResource OfficeCardStyle}"
                                Visibility="{Binding HasSelectedPeriod, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="KỲ ĐANG XEM" FontSize="10" FontWeight="Bold" />
                                        <TextBlock Margin="0,4,0,0" Text="{Binding SelectedPeriodTitle}" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Margin="0,3,0,0" Text="{Binding SelectedPeriodSourceText}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Padding="12,6" VerticalAlignment="Center"
                                            Style="{StaticResource OfficePrimaryButtonStyle}"
                                            Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}"
                                            IsEnabled="{Binding CanAggregate}"
                                            Click="AggregatePayroll_OnClick"
                                            Content="TỔNG HỢP LƯƠNG" />
                                </Grid>
                                <TextBlock Margin="0,8,0,0"
                                           Text="Tổng lương, thực nhận và các khoản bên dưới lấy nguyên từ bản tổng hợp canonical của backend; Desktop không tự tính lại."
                                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />

                                <StackPanel Margin="0,12,0,0"
                                            Visibility="{Binding ShowNoCalculation, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Chưa có bản tổng hợp lương cho kỳ này." FontWeight="SemiBold" />
                                    <TextBlock Margin="0,3,0,0"
                                               Text="Hãy tổng hợp để lấy dữ liệu công đã chốt, OT/phép và các khoản lương đã thiết lập."
                                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Margin="0,12,0,0"
                                            Visibility="{Binding HasCalculation, Converter={StaticResource BoolToVisibility}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding CalculationRevisionText}" FontWeight="SemiBold" />
                                        <Button Grid.Column="1" Padding="10,4"
                                                IsEnabled="{Binding CanAggregate}"
                                                Click="AggregatePayroll_OnClick"
                                                Content="Tổng hợp lại" />
                                    </Grid>

                                    <UniformGrid Margin="0,10,0,0" Columns="4">
                                        <Border Margin="0,0,5,0" Padding="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                                            <StackPanel>
                                                <TextBlock Text="TỔNG THU NHẬP" FontSize="10" FontWeight="Bold" />
                                                <TextBlock Margin="0,4,0,0" Text="{Binding GrossIncomeText}" FontSize="17" FontWeight="SemiBold" />
                                                <TextBlock Margin="0,2,0,0" Text="{Binding CalculationEmployeeCountText}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Margin="5,0" Padding="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                                            <StackPanel>
                                                <TextBlock Text="HOÀN CHI PHÍ" FontSize="10" FontWeight="Bold" />
                                                <TextBlock Margin="0,4,0,0" Text="{Binding ReimbursementTotalText}" FontSize="17" FontWeight="SemiBold" />
                                                <TextBlock Margin="0,2,0,0" Text="Tách riêng tiền lương" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Margin="5,0" Padding="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                                            <StackPanel>
                                                <TextBlock Text="KHẤU TRỪ" FontSize="10" FontWeight="Bold" />
                                                <TextBlock Margin="0,4,0,0" Text="{Binding DeductionTotalText}" FontSize="17" FontWeight="SemiBold" />
                                                <TextBlock Margin="0,2,0,0" Text="Theo khoản đã thiết lập" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Margin="5,0,0,0" Padding="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                                            <StackPanel>
                                                <TextBlock Text="THỰC NHẬN" FontSize="10" FontWeight="Bold" />
                                                <TextBlock Margin="0,4,0,0" Text="{Binding NetPayText}" FontSize="17" FontWeight="SemiBold" />
                                                <TextBlock Margin="0,2,0,0" Text="Trước bước chốt kỳ" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <Border Margin="0,10,0,0" Padding="10"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7"
                                            Visibility="{Binding HasBoardIssues, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel>
                                            <TextBlock Text="Kỳ lương còn nội dung cần xử lý / kiểm tra" FontWeight="SemiBold" />
                                            <ItemsControl Margin="0,5,0,0" ItemsSource="{Binding BoardIssueRows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Margin="0,2,0,0" Text="{Binding DisplayText}" TextWrapping="Wrap" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <DataGrid Margin="0,10,0,0" AutoGenerateColumns="False" IsReadOnly="True"
                                              SelectionMode="Single" MaxHeight="440" RowHeight="58"
                                              Style="{StaticResource OfficeDataGridStyle}"
                                              ItemsSource="{Binding CalculationRows}"
                                              SelectedItem="{Binding SelectedCalculationRow, Mode=TwoWay}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Nhân sự" Binding="{Binding EmployeeText}" Width="1.55*" ElementStyle="{StaticResource PayrollCellTextStyle}" />
                                            <DataGridTextColumn Header="Lương theo công" Binding="{Binding SalaryAmountText}" Width="1*" ElementStyle="{StaticResource PayrollCellTextStyle}" />
                                            <DataGridTextColumn Header="Công / OT" Binding="{Binding WorkOvertimeText}" Width="1.2*" ElementStyle="{StaticResource PayrollCellTextStyle}" />
                                            <DataGridTextColumn Header="Thu nhập thêm" Binding="{Binding IncomeTotalText}" Width="1*" ElementStyle="{StaticResource PayrollCellTextStyle}" />
                                            <DataGridTextColumn Header="Hoàn chi" Binding="{Binding ReimbursementTotalText}" Width="0.9*" ElementStyle="{StaticResource PayrollCellTextStyle}" />
                                            <DataGridTextColumn Header="Khấu trừ" Binding="{Binding DeductionTotalText}" Width="0.9*" ElementStyle="{StaticResource PayrollCellTextStyle}" />
                                            <DataGridTextColumn Header="Thực nhận" Binding="{Binding NetPayText}" Width="1*" ElementStyle="{StaticResource PayrollCellTextStyle}" />
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Border Margin="0,10,0,0" Padding="12"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                                            Visibility="{Binding HasSelectedCalculationRow, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel DataContext="{Binding SelectedCalculationRow}">
                                            <TextBlock Text="CHI TIẾT LƯƠNG" FontSize="10" FontWeight="Bold" />
                                            <TextBlock Margin="0,4,0,0" Text="{Binding EmployeeText}" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Margin="0,3,0,10" Text="{Binding BranchText}" Foreground="{DynamicResource TextSecondaryBrush}" />

                                            <UniformGrid Columns="2">
                                                <Border Margin="0,0,5,5" Padding="9" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                                    <StackPanel>
                                                        <TextBlock Text="Lương cố định" FontWeight="SemiBold" />
                                                        <TextBlock Margin="0,3,0,0" Text="{Binding MonthlySalaryText}" />
                                                        <TextBlock Margin="0,2,0,0" Text="{Binding SalaryAmountDetailText}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Margin="5,0,0,5" Padding="9" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                                    <StackPanel>
                                                        <TextBlock Text="Theo công &amp; OT" FontWeight="SemiBold" />
                                                        <TextBlock Margin="0,3,0,0" Text="{Binding WorkdayDetailText}" />
                                                        <TextBlock Margin="0,2,0,0" Text="{Binding LeaveOvertimeDetailText}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </StackPanel>
                                                </Border>
                                            </UniformGrid>

                                            <TextBlock Margin="0,6,0,2" Text="Thưởng &amp; phụ cấp" FontWeight="SemiBold" />
                                            <ItemsControl ItemsSource="{Binding IncomeComponents}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate><TextBlock Margin="0,1" Text="{Binding DisplayText}" /></DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Margin="0,8,0,2" Text="Công tác phí &amp; hoàn chi phí" FontWeight="SemiBold" />
                                            <ItemsControl ItemsSource="{Binding ReimbursementComponents}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate><TextBlock Margin="0,1" Text="{Binding DisplayText}" /></DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Margin="0,8,0,2" Text="Khấu trừ" FontWeight="SemiBold" />
                                            <ItemsControl ItemsSource="{Binding DeductionComponents}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate><TextBlock Margin="0,1" Text="{Binding DisplayText}" /></DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Margin="0,10,0,2" Text="Thực nhận" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding NetBreakdownText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,10,0,0"
                                Style="{StaticResource OfficeCardStyle}"
                                Visibility="{Binding HasSelectedPeriod, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="HOÀN TẤT KỲ" FontSize="10" FontWeight="Bold" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="Chốt kỳ lương"
                                           FontSize="16"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,6,0,0"
                                           Text="{Binding CloseoutStatusText}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                                <Button Margin="0,10,0,0"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource OfficePrimaryButtonStyle}"
                                        Visibility="{Binding CanShowCloseButton, Converter={StaticResource BoolToVisibility}}"
                                        IsEnabled="{Binding CanClosePayroll}"
                                        Click="ClosePayroll_OnClick"
                                        Content="CHỐT LƯƠNG" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Đối soát">
                    <Border Margin="0,10,0,0" Style="{StaticResource OfficeCardStyle}">
                        <StackPanel>
                            <TextBlock Text="ĐỐI SOÁT" FontSize="10" FontWeight="Bold" />
                            <TextBlock Margin="0,4,0,0" Text="Kiểm tra kỳ lương" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Margin="0,8,0,0" Text="{Binding SelectedPeriodTitle}" FontWeight="SemiBold" />
                            <TextBlock Margin="0,3,0,0"
                                       Text="Đối soát dùng đúng bản tổng hợp hiện tại. Kỳ còn dữ liệu bắt buộc phải xử lý sẽ không thể xác nhận."
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />

                            <TextBlock Margin="0,12,0,0"
                                       Text="Chưa có bản tổng hợp lương cho kỳ đang chọn."
                                       FontWeight="SemiBold"
                                       Visibility="{Binding ShowNoCalculation, Converter={StaticResource BoolToVisibility}}" />

                            <Border Margin="0,12,0,0" Padding="10"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7"
                                    Visibility="{Binding HasBlockers, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="Cần xử lý trước khi đối soát" FontWeight="SemiBold" />
                                    <ItemsControl Margin="0,5,0,0" ItemsSource="{Binding BlockerRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate><TextBlock Margin="0,2" Text="{Binding DisplayText}" TextWrapping="Wrap" /></DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,10,0,0" Padding="10"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7"
                                    Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="Cần kiểm tra" FontWeight="SemiBold" />
                                    <ItemsControl Margin="0,5,0,0" ItemsSource="{Binding WarningRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate><TextBlock Margin="0,2" Text="{Binding DisplayText}" TextWrapping="Wrap" /></DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <TextBlock Margin="0,12,0,0"
                                       Text="Số liệu tổng hợp không còn cảnh báo cần xử lý."
                                       FontWeight="SemiBold"
                                       Visibility="{Binding NoReconciliationIssues, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Margin="0,12,0,0"
                                       Text="Kỳ lương đã được đối soát trên bản tổng hợp hiện tại."
                                       FontWeight="SemiBold"
                                       Visibility="{Binding IsReconciled, Converter={StaticResource BoolToVisibility}}" />

                            <StackPanel Margin="0,12,0,0"
                                        Visibility="{Binding CanShowReconcileForm, Converter={StaticResource BoolToVisibility}}">
                                <CheckBox Content="Tôi đã kiểm tra các cảnh báo trên và xác nhận số liệu phù hợp để đối soát."
                                          IsChecked="{Binding ReconcileWarningsAcknowledged, Mode=TwoWay}"
                                          Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Margin="0,9,0,3" Text="Ghi chú đối soát" FontWeight="SemiBold" />
                                <TextBox MinHeight="68" MaxLength="1000" AcceptsReturn="True" TextWrapping="Wrap"
                                         Text="{Binding ReconcileNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Margin="0,10,0,0" HorizontalAlignment="Right"
                                        Style="{StaticResource OfficePrimaryButtonStyle}"
                                        IsEnabled="{Binding CanReconcile}"
                                        Click="ReconcilePayroll_OnClick"
                                        Content="XÁC NHẬN ĐỐI SOÁT" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </TabItem>

                <TabItem Header="Thiết lập lương">
                    <StackPanel Margin="0,10,0,0">
                        <Border Style="{StaticResource OfficeCardStyle}">
                            <StackPanel>
                                <TextBlock Text="MỨC LƯƠNG" FontSize="10" FontWeight="Bold" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="Mức lương theo ngày áp dụng"
                                           FontSize="16"
                                           FontWeight="SemiBold" />

                                <WrapPanel Margin="0,10,0,0"
                                           Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Width="235" Margin="0,0,10,8">
                                        <TextBlock Style="{StaticResource PayrollLabelStyle}" Text="Nhân sự" />
                                        <ComboBox ItemsSource="{Binding Employees}"
                                                  SelectedItem="{Binding SalaryEmployee, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Width="180" Margin="0,0,10,8">
                                        <TextBlock Style="{StaticResource PayrollLabelStyle}" Text="Mức lương tháng" />
                                        <TextBox Text="{Binding SalaryAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Width="165" Margin="0,0,10,8">
                                        <TextBlock Style="{StaticResource PayrollLabelStyle}" Text="Ngày áp dụng" />
                                        <DatePicker SelectedDate="{Binding SalaryEffectiveDate, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Width="260" Margin="0,0,10,8">
                                        <TextBlock Style="{StaticResource PayrollLabelStyle}" Text="Ghi chú" />
                                        <TextBox Text="{Binding SalaryNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <Button Margin="0,19,0,8"
                                            VerticalAlignment="Top"
                                            Style="{StaticResource OfficePrimaryButtonStyle}"
                                            IsEnabled="{Binding CanSaveSalary}"
                                            Click="SaveSalary_OnClick"
                                            Content="LƯU MỨC LƯƠNG" />
                                </WrapPanel>

                                <DataGrid AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          RowHeight="58"
                                          Style="{StaticResource OfficeDataGridStyle}"
                                          ItemsSource="{Binding SalaryRows}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Nhân sự" Binding="{Binding EmployeeText}" Width="1.4*" ElementStyle="{StaticResource PayrollCellTextStyle}" />
                                        <DataGridTextColumn Header="Chi nhánh" Binding="{Binding BranchText}" Width="1*" ElementStyle="{StaticResource PayrollCellTextStyle}" />
                                        <DataGridTextColumn Header="Mức lương" Binding="{Binding AmountText}" Width="1*" ElementStyle="{StaticResource PayrollCellTextStyle}" />
                                        <DataGridTextColumn Header="Hiệu lực" Binding="{Binding EffectiveText}" Width="1.2*" ElementStyle="{StaticResource PayrollCellTextStyle}" />
                                        <DataGridTextColumn Header="Ghi chú" Binding="{Binding NoteText}" Width="1.2*" ElementStyle="{StaticResource PayrollCellTextStyle}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Margin="0,12,0,0"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="Chưa thiết lập mức lương cho nhân sự trong phạm vi đang xem."
                                           Visibility="{Binding IsSalaryEmpty, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,10,0,0" Style="{StaticResource OfficeCardStyle}">
                            <StackPanel>
                                <TextBlock Text="KHOẢN CỐ ĐỊNH" FontSize="10" FontWeight="Bold" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="Khoản áp dụng định kỳ theo nhân sự"
                                           FontSize="16"
                                           FontWeight="SemiBold" />

                                <WrapPanel Margin="0,10,0,0"
                                           Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Width="220" Margin="0,0,10,8">
                                        <TextBlock Style="{StaticResource PayrollLabelStyle}" Text="Nhân sự" />
                                        <ComboBox ItemsSource="{Binding Employees}" SelectedItem="{Binding FixedEmployee, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Width="245" Margin="0,0,10,8">
                                        <TextBlock Style="{StaticResource PayrollLabelStyle}" Text="Khoản cố định" />
                                        <ComboBox ItemsSource="{Binding FixedComponentOptions}" SelectedItem="{Binding FixedComponent, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Width="165" Margin="0,0,10,8">
                                        <TextBlock Style="{StaticResource PayrollLabelStyle}" Text="Số tiền" />
                                        <TextBox Text="{Binding FixedAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Width="165" Margin="0,0,10,8">
                                        <TextBlock Style="{StaticResource PayrollLabelStyle}" Text="Ngày áp dụng" />
                                        <DatePicker SelectedDate="{Binding FixedEffectiveDate, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Width="230" Margin="0,0,10,8">
                                        <TextBlock Style="{StaticResource PayrollLabelStyle}" Text="Ghi chú" />
                                        <TextBox Text="{Binding FixedNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <Button Margin="0,19,0,8"
                                            VerticalAlignment="Top"
                                            Style="{StaticResource OfficePrimaryButtonStyle}"
                                            IsEnabled="{Binding CanSaveFixed}"
                                            Click="SaveFixed_OnClick"
                                            Content="LƯU KHOẢN CỐ ĐỊNH" />
                                </WrapPanel>

                                <DataGrid AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          RowHeight="58"
                                          Style="{StaticResource OfficeDataGridStyle}"
                                          ItemsSource="{Binding FixedRows}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Nhân sự" Binding="{Binding EmployeeText}" Width="1.4*" ElementStyle="{StaticResource PayrollCellTextStyle}" />
                                        <DataGridTextColumn Header="Khoản" Binding="{Binding ComponentText}" Width="1.1*" ElementStyle="{StaticResource PayrollCellTextStyle}" />
                                        <DataGridTextColumn Header="Nhóm" Binding="{Binding CategoryText}" Width="1*" ElementStyle="{StaticResource PayrollCellTextStyle}" />
                                        <DataGridTextColumn Header="Số tiền" Binding="{Binding AmountText}" Width="0.9*" ElementStyle="{StaticResource PayrollCellTextStyle}" />
                                        <DataGridTextColumn Header="Hiệu lực" Binding="{Binding EffectiveText}" Width="1.2*" ElementStyle="{StaticResource PayrollCellTextStyle}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Margin="0,12,0,0"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="Chưa có khoản cố định theo nhân sự."
                                           Visibility="{Binding IsFixedEmpty, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Khoản thu &amp; khấu trừ">
                    <StackPanel Margin="0,10,0,0">
                        <Border Style="{StaticResource OfficeCardStyle}">
                            <StackPanel>
                                <TextBlock Text="DANH MỤC KHOẢN" FontSize="10" FontWeight="Bold" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="Thu nhập lương · Khấu trừ · Hoàn chi phí"
                                           FontSize="16"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="Hoàn chi phí được quản lý riêng với thu nhập lương."
                                           Foreground="{DynamicResource TextSecondaryBrush}" />

                                <WrapPanel Margin="0,10,0,0"
                                           Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Width="150" Margin="0,0,10,8">
                                        <TextBlock Style="{StaticResource PayrollLabelStyle}" Text="Mã khoản" />
                                        <TextBox Text="{Binding ComponentCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Width="220" Margin="0,0,10,8">
                                        <TextBlock Style="{StaticResource PayrollLabelStyle}" Text="Tên khoản" />
                                        <TextBox Text="{Binding ComponentName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Width="170" Margin="0,0,10,8">
                                        <TextBlock Style="{StaticResource PayrollLabelStyle}" Text="Nhóm" />
                                        <ComboBox ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding ComponentCategory, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Width="145" Margin="0,0,10,8">
                                        <TextBlock Style="{StaticResource PayrollLabelStyle}" Text="Áp dụng" />
                                        <ComboBox ItemsSource="{Binding RecurrenceOptions}" SelectedItem="{Binding ComponentRecurrence, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Width="145" Margin="0,0,10,8">
                                        <TextBlock Style="{StaticResource PayrollLabelStyle}" Text="Ghi nhận" />
                                        <ComboBox ItemsSource="{Binding InputModeOptions}" SelectedItem="{Binding ComponentInputMode, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Width="165" Margin="0,0,10,8">
                                        <TextBlock Style="{StaticResource PayrollLabelStyle}" Text="Ngày áp dụng" />
                                        <DatePicker SelectedDate="{Binding ComponentEffectiveDate, Mode=TwoWay}" />
                                    </StackPanel>
                                </WrapPanel>
                                <WrapPanel Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}">
                                    <CheckBox Margin="0,0,16,8" IsChecked="{Binding ComponentProrate, Mode=TwoWay}" Content="Tính theo ngày công" />
                                    <CheckBox Margin="0,0,16,8" IsChecked="{Binding ComponentIncludeGross, Mode=TwoWay}" Content="Vào tổng thu nhập" />
                                    <CheckBox Margin="0,0,16,8" IsChecked="{Binding ComponentIncludeNet, Mode=TwoWay}" Content="Vào thực nhận" />
                                    <Button Margin="6,0,0,8"
                                            Style="{StaticResource OfficePrimaryButtonStyle}"
                                            IsEnabled="{Binding CanCreateComponent}"
                                            Click="CreateComponent_OnClick"
                                            Content="THÊM LOẠI KHOẢN" />
                                </WrapPanel>

                                <DataGrid AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          RowHeight="62"
                                          Style="{StaticResource OfficeDataGridStyle}"
                                          ItemsSource="{Binding ComponentTypeRows}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Khoản" Binding="{Binding NameText}" Width="1.35*" ElementStyle="{StaticResource PayrollCellTextStyle}" />
                                        <DataGridTextColumn Header="Nhóm" Binding="{Binding CategoryText}" Width="1*" ElementStyle="{StaticResource PayrollCellTextStyle}" />
                                        <DataGridTextColumn Header="Áp dụng" Binding="{Binding RecurrenceText}" Width="1*" ElementStyle="{StaticResource PayrollCellTextStyle}" />
                                        <DataGridTextColumn Header="Ghi nhận" Binding="{Binding InputText}" Width="0.9*" ElementStyle="{StaticResource PayrollCellTextStyle}" />
                                        <DataGridTextColumn Header="Tính vào" Binding="{Binding IncludedText}" Width="1.2*" ElementStyle="{StaticResource PayrollCellTextStyle}" />
                                        <DataGridTextColumn Header="Hiệu lực" Binding="{Binding EffectiveText}" Width="1.1*" ElementStyle="{StaticResource PayrollCellTextStyle}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Margin="0,12,0,0"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="Chưa có khoản thu nhập, khấu trừ hoặc hoàn chi phí."
                                           Visibility="{Binding IsComponentTypeEmpty, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,10,0,0" Style="{StaticResource OfficeCardStyle}">
                            <StackPanel>
                                <TextBlock Text="KHOẢN PHÁT SINH" FontSize="10" FontWeight="Bold" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="Khoản linh động theo kỳ"
                                           FontSize="16"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="{Binding SelectedPeriodTitle}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />

                                <WrapPanel Margin="0,10,0,0"
                                           Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Width="220" Margin="0,0,10,8">
                                        <TextBlock Style="{StaticResource PayrollLabelStyle}" Text="Nhân sự" />
                                        <ComboBox ItemsSource="{Binding PeriodEmployees}" SelectedItem="{Binding PeriodEmployee, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Width="245" Margin="0,0,10,8">
                                        <TextBlock Style="{StaticResource PayrollLabelStyle}" Text="Khoản phát sinh" />
                                        <ComboBox ItemsSource="{Binding PeriodComponentOptions}" SelectedItem="{Binding PeriodComponent, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Width="165" Margin="0,0,10,8">
                                        <TextBlock Style="{StaticResource PayrollLabelStyle}" Text="Số tiền" />
                                        <TextBox Text="{Binding PeriodAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Width="290" Margin="0,0,10,8">
                                        <TextBlock Style="{StaticResource PayrollLabelStyle}" Text="Lý do / ghi chú" />
                                        <TextBox Text="{Binding PeriodNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <Button Margin="0,19,0,8"
                                            VerticalAlignment="Top"
                                            Style="{StaticResource OfficePrimaryButtonStyle}"
                                            IsEnabled="{Binding CanAddPeriodComponent}"
                                            Click="AddPeriodComponent_OnClick"
                                            Content="GHI KHOẢN PHÁT SINH" />
                                </WrapPanel>

                                <DataGrid AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          RowHeight="58"
                                          Style="{StaticResource OfficeDataGridStyle}"
                                          ItemsSource="{Binding PeriodComponentRows}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Nhân sự" Binding="{Binding EmployeeText}" Width="1.4*" ElementStyle="{StaticResource PayrollCellTextStyle}" />
                                        <DataGridTextColumn Header="Khoản" Binding="{Binding ComponentText}" Width="1.2*" ElementStyle="{StaticResource PayrollCellTextStyle}" />
                                        <DataGridTextColumn Header="Nhóm" Binding="{Binding CategoryText}" Width="1*" ElementStyle="{StaticResource PayrollCellTextStyle}" />
                                        <DataGridTextColumn Header="Số tiền" Binding="{Binding AmountText}" Width="0.9*" ElementStyle="{StaticResource PayrollCellTextStyle}" />
                                        <DataGridTextColumn Header="Lý do / ghi chú" Binding="{Binding NoteText}" Width="1.5*" ElementStyle="{StaticResource PayrollCellTextStyle}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Margin="0,12,0,0"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="Chưa có khoản linh động trong kỳ đang xem."
                                           Visibility="{Binding IsPeriodComponentEmpty, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Phiếu lương">
                    <StackPanel Margin="0,10,0,0">
                        <Border Style="{StaticResource OfficeCardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="PHIẾU LƯƠNG" FontSize="10" FontWeight="Bold" />
                                        <TextBlock Margin="0,4,0,0" Text="Phiếu lương nhân sự" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="{Binding PayslipAvailabilityText}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Padding="10,5"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource OfficePrimaryButtonStyle}"
                                            Visibility="{Binding CanExportPayroll, Converter={StaticResource BoolToVisibility}}"
                                            Click="ExportPayrollExcel_OnClick"
                                            Content="XUẤT EXCEL" />
                                </Grid>

                                <DataGrid Margin="0,10,0,0"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          RowHeight="58"
                                          MaxHeight="430"
                                          Style="{StaticResource OfficeDataGridStyle}"
                                          Visibility="{Binding HasPayslips, Converter={StaticResource BoolToVisibility}}"
                                          ItemsSource="{Binding PayslipRows}"
                                          SelectedItem="{Binding SelectedPayslipRow, Mode=TwoWay}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Nhân sự" Binding="{Binding EmployeeText}" Width="1.5*" ElementStyle="{StaticResource PayrollCellTextStyle}" />
                                        <DataGridTextColumn Header="Thu nhập" Binding="{Binding GrossIncomeText}" Width="1*" ElementStyle="{StaticResource PayrollCellTextStyle}" />
                                        <DataGridTextColumn Header="Hoàn chi" Binding="{Binding ReimbursementText}" Width="0.9*" ElementStyle="{StaticResource PayrollCellTextStyle}" />
                                        <DataGridTextColumn Header="Khấu trừ" Binding="{Binding DeductionText}" Width="0.9*" ElementStyle="{StaticResource PayrollCellTextStyle}" />
                                        <DataGridTextColumn Header="Thực nhận" Binding="{Binding NetPayText}" Width="1*" ElementStyle="{StaticResource PayrollCellTextStyle}" />
                                        <DataGridTextColumn Header="Phiên bản" Binding="{Binding RevisionText}" Width="0.7*" ElementStyle="{StaticResource PayrollCellTextStyle}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,10,0,0"
                                Style="{StaticResource OfficeCardStyle}"
                                Visibility="{Binding HasSelectedPayslip, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="CHI TIẾT PHIẾU LƯƠNG" FontSize="10" FontWeight="Bold" />
                                        <TextBlock Margin="0,4,0,0" Text="{Binding SelectedPayslipTitle}" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Margin="0,3,0,0" Text="{Binding SelectedPayslipPeriodText}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Padding="10,5"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource OfficePrimaryButtonStyle}"
                                            Visibility="{Binding CanExportPayroll, Converter={StaticResource BoolToVisibility}}"
                                            Click="ExportPayslipPdf_OnClick"
                                            Content="XUẤT PDF" />
                                </Grid>

                                <UniformGrid Margin="0,10,0,0" Columns="2">
                                    <Border Margin="0,0,5,5" Padding="9" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                        <StackPanel>
                                            <TextBlock Text="Công &amp; lương" FontWeight="SemiBold" />
                                            <TextBlock Margin="0,3,0,0" Text="{Binding SelectedPayslipWorkText}" />
                                            <TextBlock Margin="0,2,0,0" Text="{Binding SelectedPayslipSalaryText}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Margin="5,0,0,5" Padding="9" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                        <StackPanel>
                                            <TextBlock Text="Thực nhận" FontWeight="SemiBold" />
                                            <TextBlock Margin="0,3,0,0" Text="{Binding SelectedPayslipNetText}" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Margin="0,2,0,0" Text="Đọc từ phiếu lương bất biến của kỳ" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <TextBlock Margin="0,10,0,4" Text="Lịch sử phiếu lương" FontWeight="SemiBold" />
                                <DataGrid AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          RowHeight="46"
                                          MaxHeight="220"
                                          Style="{StaticResource OfficeDataGridStyle}"
                                          ItemsSource="{Binding SelectedPayslipRevisionRows}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Phiên bản" Binding="{Binding RevisionText}" Width="0.7*" ElementStyle="{StaticResource PayrollCellTextStyle}" />
                                        <DataGridTextColumn Header="Nguồn" Binding="{Binding SourceText}" Width="1*" ElementStyle="{StaticResource PayrollCellTextStyle}" />
                                        <DataGridTextColumn Header="Thực nhận" Binding="{Binding NetPayText}" Width="1*" ElementStyle="{StaticResource PayrollCellTextStyle}" />
                                        <DataGridTextColumn Header="Thời điểm" Binding="{Binding CreatedText}" Width="1.1*" ElementStyle="{StaticResource PayrollCellTextStyle}" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <StackPanel Margin="0,10,0,0"
                                            Visibility="{Binding HasSelectedPayslipAdjustments, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Các điều chỉnh đã ghi" FontWeight="SemiBold" />
                                    <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding SelectedPayslipAdjustmentRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Margin="0,2,0,0"
                                                           Text="{Binding DisplayText}"
                                                           TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <Border Margin="0,12,0,0"
                                        Padding="10"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Visibility="{Binding CanAdjustPayroll, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="Điều chỉnh lương sau chốt" FontWeight="SemiBold" />
                                        <TextBlock Margin="0,3,0,0"
                                                   Text="Mỗi điều chỉnh tạo phiên bản phiếu lương mới; phiếu cũ vẫn được giữ nguyên."
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                        <WrapPanel Margin="0,9,0,0">
                                            <StackPanel Width="250" Margin="0,0,10,8">
                                                <TextBlock Style="{StaticResource PayrollLabelStyle}" Text="Khoản điều chỉnh" />
                                                <ComboBox ItemsSource="{Binding AdjustmentComponentOptions}"
                                                          SelectedItem="{Binding AdjustmentComponent, Mode=TwoWay}" />
                                            </StackPanel>
                                            <StackPanel Width="190" Margin="0,0,10,8">
                                                <TextBlock Style="{StaticResource PayrollLabelStyle}" Text="Cách điều chỉnh" />
                                                <ComboBox ItemsSource="{Binding AdjustmentDirectionOptions}"
                                                          SelectedItem="{Binding AdjustmentDirection, Mode=TwoWay}" />
                                            </StackPanel>
                                            <StackPanel Width="170" Margin="0,0,10,8">
                                                <TextBlock Style="{StaticResource PayrollLabelStyle}" Text="Số tiền" />
                                                <TextBox Text="{Binding AdjustmentAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Width="300" Margin="0,0,10,8">
                                                <TextBlock Style="{StaticResource PayrollLabelStyle}" Text="Lý do" />
                                                <TextBox MaxLength="1000"
                                                         Text="{Binding AdjustmentReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <Button Margin="0,19,0,8"
                                                    VerticalAlignment="Top"
                                                    Style="{StaticResource OfficePrimaryButtonStyle}"
                                                    IsEnabled="{Binding CanRecordAdjustment}"
                                                    Click="RecordPayrollAdjustment_OnClick"
                                                    Content="GHI ĐIỀU CHỈNH" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Lịch sử kỳ lương">
                    <Border Margin="0,10,0,0" Style="{StaticResource OfficeCardStyle}">
                        <StackPanel>
                            <TextBlock Text="LỊCH SỬ" FontSize="10" FontWeight="Bold" />
                            <TextBlock Margin="0,3,0,0" Text="Kỳ lương đã chốt" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,8"
                                       Text="Đọc từ hồ sơ kỳ đã chốt; lịch sử không thay đổi theo hồ sơ lương hiện tại."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                            <DataGrid AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      RowHeight="58"
                                      MaxHeight="470"
                                      Style="{StaticResource OfficeDataGridStyle}"
                                      ItemsSource="{Binding CloseHistoryRows}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Kỳ" Binding="{Binding PeriodText}" Width="1.4*" ElementStyle="{StaticResource PayrollCellTextStyle}" />
                                    <DataGridTextColumn Header="Nhân sự" Binding="{Binding EmployeeCountText}" Width="0.8*" ElementStyle="{StaticResource PayrollCellTextStyle}" />
                                    <DataGridTextColumn Header="Tổng thu nhập" Binding="{Binding GrossIncomeText}" Width="1*" ElementStyle="{StaticResource PayrollCellTextStyle}" />
                                    <DataGridTextColumn Header="Khấu trừ" Binding="{Binding DeductionText}" Width="0.9*" ElementStyle="{StaticResource PayrollCellTextStyle}" />
                                    <DataGridTextColumn Header="Thực nhận" Binding="{Binding NetPayText}" Width="1*" ElementStyle="{StaticResource PayrollCellTextStyle}" />
                                    <DataGridTemplateColumn Header="Xử lý" Width="0.7*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Padding="8,3" Tag="{Binding}" Click="OpenCloseHistory_OnClick" Content="Mở kỳ" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Margin="0,12,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="Chưa có kỳ lương đã chốt."
                                       Visibility="{Binding ShowNoCloseHistory, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Border>
                </TabItem>
            </TabControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
