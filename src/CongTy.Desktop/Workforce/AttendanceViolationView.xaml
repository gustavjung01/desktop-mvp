<UserControl x:Class="CongTy.Desktop.Workforce.AttendanceViolationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="AttendanceViolationView_OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="ViolationCellTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="ViolationSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="ViolationMessageStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,0,4,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="NHÂN SỰ" FontSize="10" FontWeight="Bold" />
                <TextBlock Margin="0,3,0,0"
                           Text="Giải trình, xem xét và kết luận các sai lệch đã được Bảng công ghi nhận."
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1"
                    Style="{StaticResource OfficePrimaryButtonStyle}"
                    IsEnabled="{Binding CanRefresh}"
                    Click="Refresh_OnClick"
                    Content="CẬP NHẬT HỒ SƠ" />
        </Grid>

        <Border Grid.Row="1"
                Margin="0,9,0,0"
                Padding="9"
                Style="{StaticResource OfficeCardStyle}"
                Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource ViolationMessageStyle}" Text="{Binding Message}" />
        </Border>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Padding="10" Style="{StaticResource OfficeCardStyle}">
                <StackPanel>
                    <TextBlock Text="VI PHẠM ĐANG GHI NHẬN" Style="{StaticResource ViolationSectionTitleStyle}" />
                    <TextBlock Margin="0,3,0,0" Text="{Binding CurrentCountText}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Theo Bảng công trong trang" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Padding="10" Style="{StaticResource OfficeCardStyle}">
                <StackPanel>
                    <TextBlock Text="CHỜ XEM XÉT" Style="{StaticResource ViolationSectionTitleStyle}" />
                    <TextBlock Margin="0,3,0,0" Text="{Binding WaitingCountText}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Nhân viên đã gửi giải trình" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Padding="10" Style="{StaticResource OfficeCardStyle}">
                <StackPanel>
                    <TextBlock Text="ĐANG XEM XÉT" Style="{StaticResource ViolationSectionTitleStyle}" />
                    <TextBlock Margin="0,3,0,0" Text="{Binding ReviewingCountText}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Quản lý đang xử lý hồ sơ" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Grid.Column="6" Padding="10" Style="{StaticResource OfficeCardStyle}">
                <StackPanel>
                    <TextBlock Text="ĐÃ KẾT LUẬN" Style="{StaticResource ViolationSectionTitleStyle}" />
                    <TextBlock Margin="0,3,0,0" Text="{Binding ResolvedCountText}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Không sửa dữ liệu chấm công gốc" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Margin="0,10,0,0" Padding="10" Style="{StaticResource OfficeCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <WrapPanel VerticalAlignment="Bottom">
                    <StackPanel Width="135" Margin="0,0,8,0">
                        <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="Từ ngày" />
                        <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Width="135" Margin="0,0,8,0">
                        <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="Đến ngày" />
                        <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Width="200"
                                Margin="0,0,8,0"
                                Visibility="{Binding CanFilterScoped, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="Nhân sự" />
                        <TextBox Text="{Binding EmployeeQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="80"
                                 ToolTip="Mã hoặc tên nhân sự" />
                    </StackPanel>

                    <StackPanel Width="220"
                                Margin="0,0,8,0"
                                Visibility="{Binding HasBranchFilter, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="Chi nhánh" />
                        <ComboBox ItemsSource="{Binding BranchOptions}"
                                  SelectedItem="{Binding SelectedBranch, Mode=TwoWay}"
                                  DisplayMemberPath="Label" />
                    </StackPanel>
                </WrapPanel>

                <Button Grid.Column="1"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource OfficeSecondaryButtonStyle}"
                        IsEnabled="{Binding CanRefresh}"
                        Click="ApplyFilters_OnClick"
                        Content="XEM HỒ SƠ" />
            </Grid>
        </Border>

        <Border Grid.Row="4"
                Margin="0,10,0,10"
                Padding="9"
                Background="{DynamicResource AccentSoftBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Vi phạm được đánh giá từ Bảng công hiện tại. Hồ sơ này chỉ lưu giải trình và kết luận xử lý; không sửa sự kiện chấm công và không tự điều chỉnh thu nhập."
                           TextWrapping="Wrap" />
                <TextBlock Grid.Column="1"
                           Margin="14,0,0,0"
                           VerticalAlignment="Center"
                           Text="{Binding ScopeText, StringFormat='Phạm vi: {0}'}"
                           FontWeight="SemiBold" />
            </Grid>
        </Border>

        <Border Grid.Row="5" Padding="10" Style="{StaticResource OfficeCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="THEO DÕI XỬ LÝ" Style="{StaticResource ViolationSectionTitleStyle}" />
                        <TextBlock Margin="0,3,0,0" Text="Vi phạm và giải trình" FontSize="17" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               Text="{Binding PeriodText}"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <DataGrid AutoGenerateColumns="False"
                              IsReadOnly="True"
                              RowHeight="72"
                              Style="{StaticResource OfficeDataGridStyle}"
                              ItemsSource="{Binding Rows}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ngày" Binding="{Binding DateText}" Width="0.7*" />

                            <DataGridTemplateColumn Header="Nhân sự" Width="1.15*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="3">
                                            <TextBlock Text="{Binding EmployeeText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding BranchText}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Vi phạm" Width="1.15*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="3">
                                            <TextBlock Text="{Binding ViolationText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding MetricText}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Ghi nhận" Binding="{Binding FactText}" Width="1.55*" ElementStyle="{StaticResource ViolationCellTextStyle}" />

                            <DataGridTemplateColumn Header="Trạng thái xử lý" Width="1.1*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="3">
                                            <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding VersionText}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Giải trình và kết luận" Width="1.65*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="3">
                                            <TextBlock Text="{Binding ExplanationText, StringFormat='Giải trình: {0}'}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding ConclusionText, StringFormat='Kết luận: {0}'}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Thao tác" Width="1.1*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <WrapPanel Margin="2">
                                            <Button Margin="0,0,4,4"
                                                    Style="{StaticResource OfficeSecondaryButtonStyle}"
                                                    Tag="{Binding}"
                                                    Visibility="{Binding CanExplain, Converter={StaticResource BoolToVisibility}}"
                                                    Click="OpenExplanation_OnClick"
                                                    Content="GIẢI TRÌNH" />
                                            <Button Margin="0,0,4,4"
                                                    Style="{StaticResource OfficeSecondaryButtonStyle}"
                                                    Tag="{Binding}"
                                                    Visibility="{Binding CanStartReview, Converter={StaticResource BoolToVisibility}}"
                                                    Click="StartReview_OnClick"
                                                    Content="XEM XÉT" />
                                            <Button Margin="0,0,4,4"
                                                    Style="{StaticResource OfficePrimaryButtonStyle}"
                                                    Tag="{Binding}"
                                                    Visibility="{Binding CanConclude, Converter={StaticResource BoolToVisibility}}"
                                                    Click="OpenConclusion_OnClick"
                                                    Content="KẾT LUẬN" />
                                            <TextBlock Margin="3"
                                                       VerticalAlignment="Center"
                                                       Text="Chỉ xem"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Visibility="{Binding ReadOnly, Converter={StaticResource BoolToVisibility}}" />
                                        </WrapPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Text="Không có vi phạm hoặc hồ sơ xử lý trong phạm vi đã chọn."
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Visibility="{Binding NoRows, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Text="Đang tải hồ sơ xử lý vi phạm…"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Panel.ZIndex="10"
                               Visibility="{Binding ShowLoading, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="6" Margin="0,9,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button HorizontalAlignment="Left"
                    Style="{StaticResource OfficeSecondaryButtonStyle}"
                    IsEnabled="{Binding CanPagePrevious}"
                    Click="PreviousPage_OnClick"
                    Content="TRANG TRƯỚC" />
            <TextBlock Grid.Column="1"
                       Margin="12,0"
                       VerticalAlignment="Center"
                       Text="{Binding PaginationText}"
                       FontWeight="SemiBold" />
            <Button Grid.Column="2"
                    HorizontalAlignment="Right"
                    Style="{StaticResource OfficeSecondaryButtonStyle}"
                    IsEnabled="{Binding CanPageNext}"
                    Click="NextPage_OnClick"
                    Content="TRANG SAU" />
        </Grid>

        <Border Grid.RowSpan="7"
                Margin="70"
                Padding="14"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Panel.ZIndex="30"
                Visibility="{Binding HasExplainModal, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="GIẢI TRÌNH" Style="{StaticResource ViolationSectionTitleStyle}" />
                        <TextBlock Margin="0,3,0,0" Text="{Binding ExplainTitle}" FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Style="{StaticResource OfficeSecondaryButtonStyle}"
                            Click="CloseExplanation_OnClick"
                            Content="ĐÓNG" />
                </Grid>

                <Border Grid.Row="1" Margin="0,12,0,10" Padding="10" Style="{StaticResource OfficeCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Ghi nhận trên Bảng công" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Margin="0,3,0,0" Text="{Binding ExplainFact}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="2">
                    <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="Nội dung giải trình" />
                    <TextBox MinHeight="150"
                             MaxLength="2000"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding Explanation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Trình bày lý do và thông tin cần quản lý xem xét" />
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="0,12,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Margin="0,0,8,0"
                            Style="{StaticResource OfficeSecondaryButtonStyle}"
                            Click="CloseExplanation_OnClick"
                            Content="HỦY" />
                    <Button Style="{StaticResource OfficePrimaryButtonStyle}"
                            IsEnabled="{Binding CanSubmitExplanation}"
                            Click="SubmitExplanation_OnClick"
                            Content="GỬI GIẢI TRÌNH" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.RowSpan="7"
                Margin="60"
                Padding="14"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Panel.ZIndex="40"
                Visibility="{Binding HasReviewModal, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="KẾT LUẬN HỒ SƠ" Style="{StaticResource ViolationSectionTitleStyle}" />
                        <TextBlock Margin="0,3,0,0" Text="{Binding ReviewTitle}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ReviewEmployee}" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Style="{StaticResource OfficeSecondaryButtonStyle}"
                            Click="CloseConclusion_OnClick"
                            Content="ĐÓNG" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,12,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Padding="10" Style="{StaticResource OfficeCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Giải trình của nhân viên" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Margin="0,3,0,0" Text="{Binding ReviewExplanation}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Padding="10" Style="{StaticResource OfficeCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Ghi nhận ban đầu" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Margin="0,3,0,0" Text="{Binding ReviewSnapshot}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel Grid.Row="2">
                    <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="Kết luận" />
                    <ComboBox ItemsSource="{Binding OutcomeOptions}"
                              SelectedItem="{Binding SelectedOutcome, Mode=TwoWay}"
                              DisplayMemberPath="Label" />
                    <TextBlock Margin="0,5,0,0"
                               Text="“Xác nhận vi phạm” chỉ thành công nếu vi phạm vẫn còn trên Bảng công hiện tại."
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="0,12,0,0">
                    <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="Kết luận xử lý" />
                    <TextBox MinHeight="130"
                             MaxLength="2000"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding ReviewNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Ghi rõ căn cứ và kết luận quản lý" />
                    <Border Margin="0,10,0,0"
                            Padding="9"
                            Background="{DynamicResource AccentSoftBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">
                        <TextBlock Text="Kết luận này là hồ sơ quản lý. Mọi ảnh hưởng thu nhập nếu có trong tương lai phải đi qua quy trình riêng."
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="4" Margin="0,12,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Margin="0,0,8,0"
                            Style="{StaticResource OfficeSecondaryButtonStyle}"
                            Click="CloseConclusion_OnClick"
                            Content="HỦY" />
                    <Button Style="{StaticResource OfficePrimaryButtonStyle}"
                            IsEnabled="{Binding CanSubmitConclusion}"
                            Click="SubmitConclusion_OnClick"
                            Content="LƯU KẾT LUẬN" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
