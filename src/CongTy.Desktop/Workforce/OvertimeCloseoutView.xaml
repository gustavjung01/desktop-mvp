<UserControl x:Class="CongTy.Desktop.Workforce.OvertimeCloseoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OvertimeCloseoutView_OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="Lot5MessageBorderStyle" TargetType="Border" BasedOn="{StaticResource OfficeCardStyle}">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Style>
        <Style x:Key="Lot5CellTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Lot5LabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,4,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="NHÂN SỰ" FontSize="10" FontWeight="Bold" />
                        <TextBlock Margin="0,3,0,0"
                                   Text="Quản lý tăng ca theo phê duyệt và chốt kỳ công thành đầu vào sạch cho tính lương."
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Margin="0,0,8,0"
                                Style="{StaticResource OfficeSecondaryButtonStyle}"
                                IsEnabled="{Binding CanRefresh}"
                                Click="ExportOvertime_OnClick"
                                Content="XUẤT EXCEL" />
                        <Button Style="{StaticResource OfficeSecondaryButtonStyle}"
                                IsEnabled="{Binding CanRefresh}"
                                Click="Refresh_OnClick"
                                Content="LÀM MỚI" />
                    </StackPanel>
                </Grid>

                <Border Margin="0,10,0,0"
                        Style="{StaticResource Lot5MessageBorderStyle}"
                        Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <TextBlock Margin="0,14,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="Đang tải tăng ca và kỳ công…"
                           Visibility="{Binding ShowLoading, Converter={StaticResource BoolToVisibility}}" />

                <UniformGrid Margin="0,12,0,0" Columns="4">
                    <Border Margin="0,0,6,0" Style="{StaticResource OfficeCardStyle}">
                        <StackPanel>
                            <TextBlock Text="HỒ SƠ TĂNG CA" FontSize="10" FontWeight="Bold" />
                            <TextBlock Margin="0,5,0,0" Text="{Binding OvertimeCountText}" FontSize="18" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Margin="2,0,4,0" Style="{StaticResource OfficeCardStyle}">
                        <StackPanel>
                            <TextBlock Text="CHỜ DUYỆT" FontSize="10" FontWeight="Bold" />
                            <TextBlock Margin="0,5,0,0" Text="{Binding PendingCountText}" FontSize="18" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Margin="4,0,2,0" Style="{StaticResource OfficeCardStyle}">
                        <StackPanel>
                            <TextBlock Text="GIỜ OT ĐÃ XÁC NHẬN" FontSize="10" FontWeight="Bold" />
                            <TextBlock Margin="0,5,0,0" Text="{Binding ConfirmedHoursText}" FontSize="18" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Margin="6,0,0,0" Style="{StaticResource OfficeCardStyle}">
                        <StackPanel>
                            <TextBlock Text="KỲ ĐÃ CHỐT" FontSize="10" FontWeight="Bold" />
                            <TextBlock Margin="0,5,0,0" Text="{Binding ClosedPeriodCountText}" FontSize="18" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Margin="0,10,0,0" Style="{StaticResource OfficeCardStyle}">
                    <StackPanel>
                        <TextBlock Text="BỘ LỌC" FontSize="10" FontWeight="Bold" />
                        <WrapPanel Margin="0,9,0,0">
                            <StackPanel Width="155" Margin="0,0,10,8">
                                <TextBlock Style="{StaticResource Lot5LabelStyle}" Text="Từ ngày" />
                                <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Width="155" Margin="0,0,10,8">
                                <TextBlock Style="{StaticResource Lot5LabelStyle}" Text="Đến ngày" />
                                <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Width="250"
                                        Margin="0,0,10,8"
                                        Visibility="{Binding ShowBranchFilter, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource Lot5LabelStyle}" Text="Chi nhánh" />
                                <ComboBox ItemsSource="{Binding BranchOptions}"
                                          DisplayMemberPath="Label"
                                          SelectedItem="{Binding SelectedBranch, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Width="210" Margin="0,0,10,8">
                                <TextBlock Style="{StaticResource Lot5LabelStyle}" Text="Trạng thái tăng ca" />
                                <ComboBox ItemsSource="{Binding StatusOptions}"
                                          DisplayMemberPath="Label"
                                          SelectedItem="{Binding SelectedStatus, Mode=TwoWay}" />
                            </StackPanel>
                            <Button MinWidth="115"
                                    Margin="0,19,0,8"
                                    VerticalAlignment="Top"
                                    Style="{StaticResource OfficeSecondaryButtonStyle}"
                                    IsEnabled="{Binding CanRefresh}"
                                    Click="Refresh_OnClick"
                                    Content="XEM DỮ LIỆU" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <TabControl Margin="0,10,0,0">
                    <TabItem Header="Tăng ca">
                        <StackPanel Margin="0,10,0,0">
                            <Border Style="{StaticResource OfficeCardStyle}"
                                    Visibility="{Binding CanSubmitOwn, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="ĐĂNG KÝ TĂNG CA" FontSize="10" FontWeight="Bold" />
                                    <TextBlock Margin="0,3,0,0"
                                               Text="Gửi đề nghị theo chính sách làm việc hiệu lực"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <WrapPanel Margin="0,9,0,0">
                                        <StackPanel Width="170" Margin="0,0,10,8">
                                            <TextBlock Style="{StaticResource Lot5LabelStyle}" Text="Ngày tăng ca" />
                                            <DatePicker SelectedDate="{Binding RequestWorkDate, Mode=TwoWay}" />
                                        </StackPanel>
                                        <StackPanel Width="170" Margin="0,0,10,8">
                                            <TextBlock Style="{StaticResource Lot5LabelStyle}" Text="Số giờ đăng ký" />
                                            <TextBox Text="{Binding RequestHours, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource Lot5LabelStyle}" Text="Lý do" />
                                    <TextBox MinHeight="56"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             Text="{Binding RequestReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Margin="0,10,0,0"
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource OfficePrimaryButtonStyle}"
                                            IsEnabled="{Binding CanSubmitRequest}"
                                            Click="SubmitOvertime_OnClick"
                                            Content="GỬI ĐĂNG KÝ" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,10,0,0" Style="{StaticResource OfficeCardStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="TĂNG CA" FontSize="10" FontWeight="Bold" />
                                            <TextBlock Margin="0,3,0,0"
                                                       Text="Đăng ký → duyệt → thực tế → xác nhận giờ tính"
                                                       FontSize="16"
                                                       FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding OvertimeCountText}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Grid>

                                    <DataGrid AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              RowHeight="62"
                                              Style="{StaticResource OfficeDataGridStyle}"
                                              ItemsSource="{Binding OvertimeRows}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Ngày" Binding="{Binding DateText}" Width="0.75*" ElementStyle="{StaticResource Lot5CellTextStyle}" />
                                            <DataGridTextColumn Header="Nhân sự" Binding="{Binding EmployeeText}" Width="1.3*" ElementStyle="{StaticResource Lot5CellTextStyle}" />
                                            <DataGridTextColumn Header="Chi nhánh" Binding="{Binding BranchText}" Width="1.1*" ElementStyle="{StaticResource Lot5CellTextStyle}" />
                                            <DataGridTextColumn Header="Đăng ký" Binding="{Binding RequestedText}" Width="0.8*" ElementStyle="{StaticResource Lot5CellTextStyle}" />
                                            <DataGridTextColumn Header="Thực tế" Binding="{Binding ActualText}" Width="0.8*" ElementStyle="{StaticResource Lot5CellTextStyle}" />
                                            <DataGridTextColumn Header="Được tính" Binding="{Binding ConfirmedText}" Width="0.85*" ElementStyle="{StaticResource Lot5CellTextStyle}" />
                                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusText}" Width="1.15*" ElementStyle="{StaticResource Lot5CellTextStyle}" />
                                            <DataGridTemplateColumn Header="Xử lý" Width="0.8*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Padding="8,3"
                                                                Tag="{Binding}"
                                                                IsEnabled="{Binding CanProcess}"
                                                                Click="OpenOvertime_OnClick"
                                                                Content="Xử lý" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <TextBlock Margin="0,12,0,0"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="Chưa có hồ sơ tăng ca trong khoảng đang xem."
                                               Visibility="{Binding IsOvertimeEmpty, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,10,0,0"
                                    Style="{StaticResource OfficeCardStyle}"
                                    Visibility="{Binding IsOvertimeActionOpen, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="XỬ LÝ TĂNG CA" FontSize="10" FontWeight="Bold" />
                                    <TextBlock Margin="0,4,0,0"
                                               Text="{Binding SelectedOvertime.EmployeeText}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,2,0,8"
                                               Text="{Binding SelectedOvertime.StatusText}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Style="{StaticResource Lot5LabelStyle}" Text="{Binding ActionHoursLabel}" />
                                        <TextBox Text="{Binding ActionHours, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Lot5LabelStyle}" Text="Ghi chú / ý kiến xử lý" />
                                    <TextBox MinHeight="54"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             Text="{Binding ActionNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Margin="0,0,6,0"
                                                Style="{StaticResource OfficeSecondaryButtonStyle}"
                                                Click="CloseOvertime_OnClick"
                                                Content="ĐÓNG" />
                                        <Button Margin="0,0,6,0"
                                                Style="{StaticResource OfficeSecondaryButtonStyle}"
                                                IsEnabled="{Binding CanReviewSelected}"
                                                Click="RejectOvertime_OnClick"
                                                Content="TỪ CHỐI" />
                                        <Button Margin="0,0,6,0"
                                                Style="{StaticResource OfficePrimaryButtonStyle}"
                                                IsEnabled="{Binding CanReviewSelected}"
                                                Click="ApproveOvertime_OnClick"
                                                Content="DUYỆT" />
                                        <Button Margin="0,0,6,0"
                                                Style="{StaticResource OfficePrimaryButtonStyle}"
                                                IsEnabled="{Binding CanRecordActualSelected}"
                                                Click="RecordActual_OnClick"
                                                Content="GHI NHẬN THỰC TẾ" />
                                        <Button Style="{StaticResource OfficePrimaryButtonStyle}"
                                                IsEnabled="{Binding CanConfirmSelected}"
                                                Click="ConfirmHours_OnClick"
                                                Content="XÁC NHẬN GIỜ TÍNH" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="Chốt công">
                        <StackPanel Margin="0,10,0,0">
                            <Border Style="{StaticResource OfficeCardStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="KỲ CÔNG" FontSize="10" FontWeight="Bold" />
                                            <TextBlock Margin="0,3,0,0"
                                                       Text="Đang tổng hợp → Cần xử lý → Đã đối soát → Đã chốt"
                                                       FontSize="16"
                                                       FontWeight="SemiBold" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Style="{StaticResource OfficePrimaryButtonStyle}"
                                                IsEnabled="{Binding CanReconcile}"
                                                Click="RefreshRange_OnClick"
                                                Content="TỔNG HỢP KỲ ĐANG CHỌN" />
                                    </Grid>

                                    <DataGrid AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              RowHeight="60"
                                              Style="{StaticResource OfficeDataGridStyle}"
                                              ItemsSource="{Binding PeriodRows}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Kỳ" Binding="{Binding PeriodText}" Width="1.35*" ElementStyle="{StaticResource Lot5CellTextStyle}" />
                                            <DataGridTextColumn Header="Phạm vi" Binding="{Binding ScopeText}" Width="1.2*" ElementStyle="{StaticResource Lot5CellTextStyle}" />
                                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusText}" Width="1*" ElementStyle="{StaticResource Lot5CellTextStyle}" />
                                            <DataGridTextColumn Header="Việc cần xử lý" Binding="{Binding BlockerText}" Width="0.9*" ElementStyle="{StaticResource Lot5CellTextStyle}" />
                                            <DataGridTextColumn Header="Cảnh báo" Binding="{Binding WarningText}" Width="0.8*" ElementStyle="{StaticResource Lot5CellTextStyle}" />
                                            <DataGridTextColumn Header="Lần chốt" Binding="{Binding RevisionText}" Width="0.7*" ElementStyle="{StaticResource Lot5CellTextStyle}" />
                                            <DataGridTemplateColumn Header="Xử lý" Width="1.2*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Margin="0,0,5,0"
                                                                    Padding="8,3"
                                                                    Tag="{Binding}"
                                                                    Click="OpenPeriod_OnClick"
                                                                    Content="Mở" />
                                                            <Button Padding="8,3"
                                                                    Tag="{Binding}"
                                                                    IsEnabled="{Binding CanOpenPayroll}"
                                                                    Click="ViewPayrollRow_OnClick"
                                                                    Content="Đầu vào lương" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <TextBlock Margin="0,12,0,0"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="Chưa có kỳ công nghiệp vụ. Bấm “Tổng hợp kỳ đang chọn” để bắt đầu."
                                               Visibility="{Binding IsPeriodEmpty, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,10,0,0"
                                    Style="{StaticResource OfficeCardStyle}"
                                    Visibility="{Binding IsPeriodActionOpen, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="ĐỐI SOÁT / CHỐT KỲ" FontSize="10" FontWeight="Bold" />
                                    <TextBlock Margin="0,4,0,0"
                                               Text="{Binding SelectedPeriod.PeriodText}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,2,0,8"
                                               Text="{Binding SelectedPeriod.StatusText}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />

                                    <UniformGrid Columns="2">
                                        <Border Margin="0,0,5,0"
                                                Padding="10"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <StackPanel>
                                                <TextBlock Text="Việc cần xử lý trước đối soát" FontWeight="SemiBold" />
                                                <TextBlock Margin="0,5,0,0" Text="{Binding SelectedPeriod.Source.IssueSummary.Blockers.ConfigurationIssueDays, StringFormat='Thiếu cấu hình: {0}'}" />
                                                <TextBlock Text="{Binding SelectedPeriod.Source.IssueSummary.Blockers.PendingAdjustmentDays, StringFormat='Điều chỉnh đang chờ: {0}'}" />
                                                <TextBlock Text="{Binding SelectedPeriod.Source.IssueSummary.Blockers.PendingLeaveDays, StringFormat='Đơn nghỉ đang chờ: {0}'}" />
                                                <TextBlock Text="{Binding SelectedPeriod.Source.IssueSummary.Blockers.OutstandingOvertimeRequests, StringFormat='Tăng ca chưa xác nhận: {0}'}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Margin="5,0,0,0"
                                                Padding="10"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <StackPanel>
                                                <TextBlock Text="Cảnh báo cần kiểm tra" FontWeight="SemiBold" />
                                                <TextBlock Margin="0,5,0,0" Text="{Binding SelectedPeriod.Source.IssueSummary.Warnings.IncompleteDays, StringFormat='Ngày công chưa đủ: {0}'}" />
                                                <TextBlock Text="{Binding SelectedPeriod.Source.IssueSummary.Warnings.UnexcusedAbsenceDays, StringFormat='Vắng không phép: {0}'}" />
                                                <TextBlock Text="{Binding SelectedPeriod.Source.IssueSummary.Warnings.ViolationDays, StringFormat='Ngày có vi phạm: {0}'}" />
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <TextBlock Margin="0,10,0,4" FontWeight="SemiBold" Text="Ghi chú đối soát" />
                                    <TextBox MinHeight="54"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             Text="{Binding PeriodNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox Margin="0,8,0,0"
                                              IsChecked="{Binding AcknowledgeWarnings, Mode=TwoWay}"
                                              Content="Tôi đã kiểm tra các cảnh báo còn lại trong kỳ" />
                                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Margin="0,0,6,0"
                                                Style="{StaticResource OfficeSecondaryButtonStyle}"
                                                Click="ClosePeriod_OnClick"
                                                Content="ĐÓNG" />
                                        <Button Margin="0,0,6,0"
                                                Style="{StaticResource OfficeSecondaryButtonStyle}"
                                                IsEnabled="{Binding CanReconcile}"
                                                Click="RefreshPeriod_OnClick"
                                                Content="TỔNG HỢP LẠI" />
                                        <Button Margin="0,0,6,0"
                                                Style="{StaticResource OfficePrimaryButtonStyle}"
                                                IsEnabled="{Binding CanReconcileSelected}"
                                                Click="ReconcilePeriod_OnClick"
                                                Content="XÁC NHẬN ĐÃ ĐỐI SOÁT" />
                                        <Button Margin="0,0,6,0"
                                                Style="{StaticResource OfficePrimaryButtonStyle}"
                                                IsEnabled="{Binding CanCloseSelected}"
                                                Click="CloseAttendancePeriod_OnClick"
                                                Content="CHỐT KỲ CÔNG" />
                                        <Button Style="{StaticResource OfficeSecondaryButtonStyle}"
                                                IsEnabled="{Binding CanViewSelectedPayroll}"
                                                Click="ViewPayrollSelected_OnClick"
                                                Content="XEM ĐẦU VÀO LƯƠNG" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,10,0,0"
                                    Style="{StaticResource OfficeCardStyle}"
                                    Visibility="{Binding HasPayrollInput, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="ĐẦU VÀO TÍNH LƯƠNG" FontSize="10" FontWeight="Bold" />
                                            <TextBlock Margin="0,3,0,0"
                                                       Text="{Binding PayrollTitle}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold" />
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                Padding="9,5"
                                                VerticalAlignment="Center"
                                                CornerRadius="12"
                                                Background="{DynamicResource AccentSoftBrush}">
                                            <TextBlock Text="Chỉ đọc" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>

                                    <DataGrid AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              RowHeight="58"
                                              Style="{StaticResource OfficeDataGridStyle}"
                                              ItemsSource="{Binding PayrollRows}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Nhân sự" Binding="{Binding EmployeeText}" Width="1.5*" ElementStyle="{StaticResource Lot5CellTextStyle}" />
                                            <DataGridTextColumn Header="Chi nhánh" Binding="{Binding BranchText}" Width="1.1*" ElementStyle="{StaticResource Lot5CellTextStyle}" />
                                            <DataGridTextColumn Header="Ngày công" Binding="{Binding WorkDaysText}" Width="0.8*" ElementStyle="{StaticResource Lot5CellTextStyle}" />
                                            <DataGridTextColumn Header="Giờ được tính" Binding="{Binding CountedHoursText}" Width="0.95*" ElementStyle="{StaticResource Lot5CellTextStyle}" />
                                            <DataGridTextColumn Header="Giờ nghỉ ghi nhận" Binding="{Binding LeaveHoursText}" Width="1*" ElementStyle="{StaticResource Lot5CellTextStyle}" />
                                            <DataGridTextColumn Header="Giờ tăng ca đã xác nhận" Binding="{Binding ConfirmedOvertimeText}" Width="1.2*" ElementStyle="{StaticResource Lot5CellTextStyle}" />
                                            <DataGridTextColumn Header="Cảnh báo lịch sử" Binding="{Binding WarningText}" Width="0.9*" ElementStyle="{StaticResource Lot5CellTextStyle}" />
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <TextBlock Margin="0,12,0,0"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="Bản chốt không có dòng nhân sự."
                                               Visibility="{Binding IsPayrollEmpty, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
