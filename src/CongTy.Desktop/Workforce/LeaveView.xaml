<UserControl x:Class="CongTy.Desktop.Workforce.LeaveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="LeaveView_OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="LeaveMessageBorderStyle" TargetType="Border" BasedOn="{StaticResource OfficeCardStyle}">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Style>
        <Style x:Key="LeaveCellTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="LeaveFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,4,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="NHÂN SỰ" FontSize="10" FontWeight="Bold" />
                        <TextBlock Margin="0,3,0,0"
                                   Text="Gửi, duyệt và theo dõi nghỉ phép theo đúng chế độ nghỉ và phạm vi được cấp."
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Margin="0,0,8,0"
                                Style="{StaticResource OfficeSecondaryButtonStyle}"
                                IsEnabled="{Binding CanRefresh}"
                                Click="ExportLeave_OnClick"
                                Content="XUẤT EXCEL" />
                        <Button Style="{StaticResource OfficeSecondaryButtonStyle}"
                                IsEnabled="{Binding CanRefresh}"
                                Click="Refresh_OnClick"
                                Content="LÀM MỚI" />
                    </StackPanel>
                </Grid>

                <Border Margin="0,10,0,0"
                        Style="{StaticResource LeaveMessageBorderStyle}"
                        Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <TextBlock Margin="0,14,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="Đang tải nghỉ và đơn nghỉ…"
                           Visibility="{Binding ShowLoading, Converter={StaticResource BoolToVisibility}}" />

                <TextBlock Margin="0,14,0,0"
                           Padding="12"
                           Text="Tài khoản chưa được cấp quyền xem Nghỉ và đơn nghỉ. Quyền truy cập được quyết định bởi hệ thống."
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanViewLeave}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TabControl Margin="0,12,0,0">
                    <TabItem Header="Đơn nghỉ">
                        <StackPanel Margin="0,10,0,0">
                            <UniformGrid Columns="3">
                                <Border Margin="0,0,8,0" Style="{StaticResource OfficeCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="ĐƠN TRONG KỲ" FontSize="10" FontWeight="Bold" />
                                        <TextBlock Margin="0,5,0,0" Text="{Binding RequestCountText}" FontSize="18" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="4,0" Style="{StaticResource OfficeCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="CHỜ DUYỆT" FontSize="10" FontWeight="Bold" />
                                        <TextBlock Margin="0,5,0,0" Text="{Binding PendingCountText}" FontSize="18" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="8,0,0,0" Style="{StaticResource OfficeCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="CHẾ ĐỘ NGHỈ" FontSize="10" FontWeight="Bold" />
                                        <TextBlock Margin="0,5,0,0" Text="{Binding ActiveTypeCountText}" FontSize="18" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Margin="0,10,0,0" Style="{StaticResource OfficeCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="BỘ LỌC ĐƠN NGHỈ" FontSize="10" FontWeight="Bold" />
                                    <WrapPanel Margin="0,9,0,0">
                                        <StackPanel Width="155" Margin="0,0,10,8">
                                            <TextBlock Style="{StaticResource LeaveFieldLabelStyle}" Text="Từ ngày" />
                                            <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}" />
                                        </StackPanel>
                                        <StackPanel Width="155" Margin="0,0,10,8">
                                            <TextBlock Style="{StaticResource LeaveFieldLabelStyle}" Text="Đến ngày" />
                                            <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}" />
                                        </StackPanel>
                                        <StackPanel Width="170" Margin="0,0,10,8">
                                            <TextBlock Style="{StaticResource LeaveFieldLabelStyle}" Text="Trạng thái" />
                                            <ComboBox ItemsSource="{Binding StatusOptions}"
                                                      DisplayMemberPath="Label"
                                                      SelectedItem="{Binding SelectedStatus, Mode=TwoWay}" />
                                        </StackPanel>
                                        <StackPanel Width="220"
                                                    Margin="0,0,10,8"
                                                    Visibility="{Binding ShowScopedFilters, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Style="{StaticResource LeaveFieldLabelStyle}" Text="Nhân sự" />
                                            <TextBox Text="{Binding EmployeeQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Mã hoặc tên nhân sự" />
                                        </StackPanel>
                                        <StackPanel Width="240"
                                                    Margin="0,0,10,8"
                                                    Visibility="{Binding ShowScopedFilters, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Style="{StaticResource LeaveFieldLabelStyle}" Text="Chi nhánh" />
                                            <ComboBox ItemsSource="{Binding BranchOptions}"
                                                      DisplayMemberPath="Label"
                                                      SelectedItem="{Binding SelectedBranch, Mode=TwoWay}" />
                                        </StackPanel>
                                        <Button MinWidth="115"
                                                Margin="0,19,0,8"
                                                VerticalAlignment="Top"
                                                Style="{StaticResource OfficeSecondaryButtonStyle}"
                                                IsEnabled="{Binding CanRefresh}"
                                                Click="ApplyFilters_OnClick"
                                                Content="XEM DỮ LIỆU" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,10,0,0"
                                    Style="{StaticResource OfficeCardStyle}"
                                    Visibility="{Binding ShowManualPanel, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="GHI NHẬN PHIẾU NGHỈ GIẤY" FontSize="10" FontWeight="Bold" />
                                    <TextBlock Margin="0,3,0,0"
                                               Text="Quản lý / HR ghi nhận phiếu giấy cho đúng nhân sự và đúng trạng thái đã duyệt."
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />

                                    <WrapPanel Margin="0,9,0,0">
                                        <StackPanel Width="280" Margin="0,0,10,8">
                                            <TextBlock Style="{StaticResource LeaveFieldLabelStyle}" Text="Nhân sự" />
                                            <ComboBox ItemsSource="{Binding ManualEmployeeOptions}"
                                                      DisplayMemberPath="Label"
                                                      SelectedItem="{Binding SelectedManualEmployee, Mode=TwoWay}" />
                                        </StackPanel>
                                        <StackPanel Width="280" Margin="0,0,10,8">
                                            <TextBlock Style="{StaticResource LeaveFieldLabelStyle}" Text="Chế độ nghỉ" />
                                            <ComboBox ItemsSource="{Binding RequestLeaveTypeOptions}"
                                                      DisplayMemberPath="Label"
                                                      SelectedItem="{Binding SelectedManualLeaveType, Mode=TwoWay}" />
                                            <TextBlock Margin="0,3,0,0"
                                                       Text="{Binding ManualTypeHint}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Width="145" Margin="0,0,10,8">
                                            <TextBlock Style="{StaticResource LeaveFieldLabelStyle}" Text="Từ ngày" />
                                            <DatePicker SelectedDate="{Binding ManualFromDate, Mode=TwoWay}" />
                                        </StackPanel>
                                        <StackPanel Width="145" Margin="0,0,10,8">
                                            <TextBlock Style="{StaticResource LeaveFieldLabelStyle}" Text="Đến ngày" />
                                            <DatePicker SelectedDate="{Binding ManualToDate, Mode=TwoWay}" />
                                        </StackPanel>
                                        <StackPanel Width="170" Margin="0,0,10,8">
                                            <TextBlock Style="{StaticResource LeaveFieldLabelStyle}" Text="Phần ngày" />
                                            <ComboBox ItemsSource="{Binding DayPartOptions}"
                                                      DisplayMemberPath="Label"
                                                      SelectedItem="{Binding SelectedManualDayPart, Mode=TwoWay}" />
                                        </StackPanel>
                                    </WrapPanel>

                                    <TextBlock Style="{StaticResource LeaveFieldLabelStyle}" Text="Lý do nghỉ" />
                                    <TextBox MinHeight="58"
                                             MaxLength="1000"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             Text="{Binding ManualReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource OfficeSecondaryButtonStyle}"
                                                Click="SelectManualAttachment_OnClick"
                                                Content="CHỌN ẢNH / PDF" />
                                        <TextBlock Grid.Column="1"
                                                   Margin="10,0"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding ManualAttachmentDisplay}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="2"
                                                Style="{StaticResource OfficeSecondaryButtonStyle}"
                                                Visibility="{Binding HasManualAttachment, Converter={StaticResource BoolToVisibility}}"
                                                Click="ClearManualAttachment_OnClick"
                                                Content="BỎ CHỨNG TỪ" />
                                    </Grid>
                                    <TextBlock Margin="0,4,0,0"
                                               Text="JPG, PNG, WebP hoặc PDF; tối đa 10 MB. Chế độ yêu cầu chứng từ sẽ không cho gửi nếu chưa chọn file."
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" />

                                    <CheckBox Margin="0,10,0,0"
                                              IsChecked="{Binding PaperApproved, Mode=TwoWay}"
                                              Content="Phiếu giấy đã được duyệt" />

                                    <WrapPanel Margin="0,8,0,0"
                                               Visibility="{Binding PaperApproved, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Width="280" Margin="0,0,10,8">
                                            <TextBlock Style="{StaticResource LeaveFieldLabelStyle}" Text="Người duyệt" />
                                            <TextBox MaxLength="150"
                                                     Text="{Binding ManualApproverName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Width="170" Margin="0,0,10,8">
                                            <TextBlock Style="{StaticResource LeaveFieldLabelStyle}" Text="Ngày duyệt" />
                                            <DatePicker SelectedDate="{Binding ManualApprovedDate, Mode=TwoWay}" />
                                        </StackPanel>
                                    </WrapPanel>

                                    <Button Margin="0,10,0,0"
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource OfficePrimaryButtonStyle}"
                                            IsEnabled="{Binding CanSubmitManualRequest}"
                                            Click="SubmitManualLeave_OnClick"
                                            Content="GHI NHẬN PHIẾU GIẤY" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,10,0,0"
                                    Style="{StaticResource OfficeCardStyle}"
                                    Visibility="{Binding CanSubmitOwn, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="TẠO ĐƠN NGHỈ" FontSize="10" FontWeight="Bold" />
                                    <TextBlock Margin="0,3,0,0"
                                               Text="Đơn của chính bạn"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <WrapPanel Margin="0,9,0,0">
                                        <StackPanel Width="260" Margin="0,0,10,8">
                                            <TextBlock Style="{StaticResource LeaveFieldLabelStyle}" Text="Chế độ nghỉ" />
                                            <ComboBox ItemsSource="{Binding RequestLeaveTypeOptions}"
                                                      DisplayMemberPath="Label"
                                                      SelectedItem="{Binding SelectedRequestType, Mode=TwoWay}" />
                                            <TextBlock Margin="0,3,0,0"
                                                       Text="{Binding RequestTypeHint}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Width="145" Margin="0,0,10,8">
                                            <TextBlock Style="{StaticResource LeaveFieldLabelStyle}" Text="Từ ngày" />
                                            <DatePicker SelectedDate="{Binding RequestFromDate, Mode=TwoWay}" />
                                        </StackPanel>
                                        <StackPanel Width="145" Margin="0,0,10,8">
                                            <TextBlock Style="{StaticResource LeaveFieldLabelStyle}" Text="Đến ngày" />
                                            <DatePicker SelectedDate="{Binding RequestToDate, Mode=TwoWay}" />
                                        </StackPanel>
                                        <StackPanel Width="170" Margin="0,0,10,8">
                                            <TextBlock Style="{StaticResource LeaveFieldLabelStyle}" Text="Phần ngày nghỉ" />
                                            <ComboBox ItemsSource="{Binding DayPartOptions}"
                                                      DisplayMemberPath="Label"
                                                      SelectedItem="{Binding SelectedDayPart, Mode=TwoWay}" />
                                        </StackPanel>
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource LeaveFieldLabelStyle}" Text="Lý do nghỉ" />
                                    <TextBox MinHeight="58"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             Text="{Binding RequestReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <StackPanel Margin="0,8,0,0"
                                                Visibility="{Binding ShowAttachmentField, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Style="{StaticResource LeaveFieldLabelStyle}" Text="Thông tin chứng từ" />
                                        <TextBox Text="{Binding AttachmentReference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <Button Margin="0,10,0,0"
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource OfficePrimaryButtonStyle}"
                                            IsEnabled="{Binding CanSubmitRequest}"
                                            Click="SubmitRequest_OnClick"
                                            Content="GỬI ĐƠN" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,10,0,0" Style="{StaticResource OfficeCardStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="DANH SÁCH ĐƠN" FontSize="10" FontWeight="Bold" />
                                            <TextBlock Margin="0,3,0,0"
                                                       Text="Theo dõi trạng thái và xử lý theo quyền được cấp"
                                                       FontSize="16"
                                                       FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding PageText}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Grid>

                                    <DataGrid AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              RowHeight="66"
                                              Style="{StaticResource OfficeDataGridStyle}"
                                              ItemsSource="{Binding RequestRows}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Nhân sự" Binding="{Binding EmployeeText}" Width="1.35*" ElementStyle="{StaticResource LeaveCellTextStyle}" />
                                            <DataGridTextColumn Header="Chế độ nghỉ" Binding="{Binding LeaveTypeText}" Width="1.25*" ElementStyle="{StaticResource LeaveCellTextStyle}" />
                                            <DataGridTextColumn Header="Thời gian" Binding="{Binding PeriodText}" Width="1.1*" ElementStyle="{StaticResource LeaveCellTextStyle}" />
                                            <DataGridTextColumn Header="Phần ngày" Binding="{Binding DayPartText}" Width="0.9*" ElementStyle="{StaticResource LeaveCellTextStyle}" />
                                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusText}" Width="0.85*" ElementStyle="{StaticResource LeaveCellTextStyle}" />
                                            <DataGridTextColumn Header="Lý do / nguồn" Binding="{Binding ReasonText}" Width="1.65*" ElementStyle="{StaticResource LeaveCellTextStyle}" />
                                            <DataGridTextColumn Header="Ý kiến / hủy" Binding="{Binding ReviewText}" Width="1.15*" ElementStyle="{StaticResource LeaveCellTextStyle}" />
                                            <DataGridTemplateColumn Header="Thao tác" Width="1.55*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <WrapPanel VerticalAlignment="Center">
                                                            <Button Margin="0,0,5,0"
                                                                    Padding="7,3"
                                                                    Tag="{Binding}"
                                                                    Visibility="{Binding HasAttachment, Converter={StaticResource BoolToVisibility}}"
                                                                    Click="OpenAttachment_OnClick"
                                                                    Content="Chứng từ" />
                                                            <Button Margin="0,0,5,0"
                                                                    Padding="7,3"
                                                                    Tag="{Binding}"
                                                                    IsEnabled="{Binding CanReview}"
                                                                    Click="ReviewRequest_OnClick"
                                                                    Content="Duyệt" />
                                                            <Button Padding="7,3"
                                                                    Tag="{Binding}"
                                                                    IsEnabled="{Binding CanCancel}"
                                                                    Click="OpenCancel_OnClick"
                                                                    Content="Hủy" />
                                                        </WrapPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <TextBlock Margin="0,12,0,0"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="Chưa có đơn nghỉ trong khoảng đã chọn."
                                               Visibility="{Binding IsRequestEmpty, Converter={StaticResource BoolToVisibility}}" />

                                    <StackPanel Margin="0,10,0,0"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right">
                                        <Button Margin="0,0,6,0"
                                                Style="{StaticResource OfficeSecondaryButtonStyle}"
                                                IsEnabled="{Binding CanPrevious}"
                                                Click="PreviousPage_OnClick"
                                                Content="TRANG TRƯỚC" />
                                        <Button Style="{StaticResource OfficeSecondaryButtonStyle}"
                                                IsEnabled="{Binding CanNext}"
                                                Click="NextPage_OnClick"
                                                Content="TRANG SAU" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,10,0,0"
                                    Style="{StaticResource OfficeCardStyle}"
                                    Visibility="{Binding IsReviewOpen, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="DUYỆT / TỪ CHỐI" FontSize="10" FontWeight="Bold" />
                                    <TextBlock Margin="0,4,0,0"
                                               Text="{Binding ReviewTarget.EmployeeText}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,2,0,8"
                                               Text="{Binding ReviewTarget.PeriodText}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Style="{StaticResource LeaveFieldLabelStyle}" Text="Ý kiến xử lý" />
                                    <TextBox MinHeight="54"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             Text="{Binding ReviewReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Margin="0,0,6,0"
                                                Style="{StaticResource OfficeSecondaryButtonStyle}"
                                                Click="CloseReview_OnClick"
                                                Content="ĐÓNG" />
                                        <Button Margin="0,0,6,0"
                                                Style="{StaticResource OfficeSecondaryButtonStyle}"
                                                Click="Reject_OnClick"
                                                Content="TỪ CHỐI" />
                                        <Button Style="{StaticResource OfficePrimaryButtonStyle}"
                                                Click="Approve_OnClick"
                                                Content="DUYỆT" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,10,0,0"
                                    Style="{StaticResource OfficeCardStyle}"
                                    Visibility="{Binding IsCancelOpen, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="HỦY ĐƠN NGHỈ" FontSize="10" FontWeight="Bold" />
                                    <TextBlock Margin="0,4,0,0"
                                               Text="{Binding CancelTarget.EmployeeText}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,2,0,8"
                                               Text="{Binding CancelTarget.PeriodText}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Style="{StaticResource LeaveFieldLabelStyle}" Text="Lý do hủy" />
                                    <TextBox MinHeight="54"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             Text="{Binding CancelReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Margin="0,7,0,0"
                                               Text="Hủy đơn đã duyệt sẽ để backend tạo bút toán hoàn phép; lịch sử sổ phép cũ không bị sửa hoặc xóa."
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Margin="0,0,6,0"
                                                Style="{StaticResource OfficeSecondaryButtonStyle}"
                                                Click="CloseCancel_OnClick"
                                                Content="ĐÓNG" />
                                        <Button Style="{StaticResource OfficePrimaryButtonStyle}"
                                                Click="ConfirmCancel_OnClick"
                                                Content="XÁC NHẬN HỦY" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="Số dư / Sổ phép">
                        <StackPanel Margin="0,10,0,0">
                            <Border Style="{StaticResource OfficeCardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="SỐ DƯ / SỔ PHÉP" FontSize="10" FontWeight="Bold" />
                                            <TextBlock Margin="0,3,0,0"
                                                       Text="Số dư theo ngày và lịch sử phát sinh"
                                                       FontSize="16"
                                                       FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Tính đến " Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding BalanceAsOfText}" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Grid>

                                    <DataGrid Margin="0,10,0,0"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              RowHeight="58"
                                              Style="{StaticResource OfficeDataGridStyle}"
                                              ItemsSource="{Binding BalanceRows}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Nhân sự" Binding="{Binding EmployeeText}" Width="1.5*" ElementStyle="{StaticResource LeaveCellTextStyle}" />
                                            <DataGridTextColumn Header="Chế độ nghỉ" Binding="{Binding LeaveTypeText}" Width="1.4*" ElementStyle="{StaticResource LeaveCellTextStyle}" />
                                            <DataGridTextColumn Header="Số dư" Binding="{Binding BalanceText}" Width="0.8*" ElementStyle="{StaticResource LeaveCellTextStyle}" />
                                            <DataGridTextColumn Header="Phát sinh cuối" Binding="{Binding LastActivityText}" Width="0.9*" ElementStyle="{StaticResource LeaveCellTextStyle}" />
                                            <DataGridTextColumn Header="Chính sách âm" Binding="{Binding PolicyText}" Width="1*" ElementStyle="{StaticResource LeaveCellTextStyle}" />
                                            <DataGridTemplateColumn Header="Thao tác" Width="0.75*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Padding="8,3"
                                                                Tag="{Binding}"
                                                                Click="ViewBalance_OnClick"
                                                                Content="Xem sổ" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <TextBlock Margin="0,12,0,0"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="Chưa có số dư phép trong phạm vi đang xem."
                                               Visibility="{Binding IsBalanceEmpty, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,10,0,0" Style="{StaticResource OfficeCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="LỊCH SỬ BIẾN ĐỘNG SỐ DƯ" FontSize="10" FontWeight="Bold" />
                                    <TextBlock Margin="0,4,0,8"
                                               Text="{Binding BalanceLedgerTitle}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <DataGrid AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              RowHeight="56"
                                              Style="{StaticResource OfficeDataGridStyle}"
                                              ItemsSource="{Binding BalanceEntryRows}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Ngày hiệu lực" Binding="{Binding EffectiveDateText}" Width="0.9*" ElementStyle="{StaticResource LeaveCellTextStyle}" />
                                            <DataGridTextColumn Header="Loại phát sinh" Binding="{Binding EntryTypeText}" Width="1.05*" ElementStyle="{StaticResource LeaveCellTextStyle}" />
                                            <DataGridTextColumn Header="Số ngày" Binding="{Binding QuantityText}" Width="0.75*" ElementStyle="{StaticResource LeaveCellTextStyle}" />
                                            <DataGridTextColumn Header="Lý do" Binding="{Binding ReasonText}" Width="2*" ElementStyle="{StaticResource LeaveCellTextStyle}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Margin="0,12,0,0"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="Chưa có phát sinh sổ phép cho lựa chọn này."
                                               Visibility="{Binding IsBalanceHistoryEmpty, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,10,0,0"
                                    Style="{StaticResource OfficeCardStyle}"
                                    Visibility="{Binding CanManageBalances, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="GHI SỔ PHÉP" FontSize="10" FontWeight="Bold" />
                                    <TextBlock Margin="0,3,0,0"
                                               Text="Ghi phát sinh thủ công theo loại canonical"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <WrapPanel Margin="0,9,0,0">
                                        <StackPanel Width="240" Margin="0,0,10,8">
                                            <TextBlock Style="{StaticResource LeaveFieldLabelStyle}" Text="Nhân sự" />
                                            <ComboBox ItemsSource="{Binding BalanceEmployeeOptions}"
                                                      DisplayMemberPath="Label"
                                                      SelectedItem="{Binding SelectedBalanceEmployee, Mode=TwoWay}" />
                                        </StackPanel>
                                        <StackPanel Width="240" Margin="0,0,10,8">
                                            <TextBlock Style="{StaticResource LeaveFieldLabelStyle}" Text="Chế độ nghỉ" />
                                            <ComboBox ItemsSource="{Binding BalanceLeaveTypeOptions}"
                                                      DisplayMemberPath="Label"
                                                      SelectedItem="{Binding SelectedBalanceLeaveType, Mode=TwoWay}" />
                                        </StackPanel>
                                        <StackPanel Width="180" Margin="0,0,10,8">
                                            <TextBlock Style="{StaticResource LeaveFieldLabelStyle}" Text="Loại phát sinh" />
                                            <ComboBox ItemsSource="{Binding BalanceEntryTypeOptions}"
                                                      DisplayMemberPath="Label"
                                                      SelectedItem="{Binding SelectedBalanceEntryType, Mode=TwoWay}" />
                                        </StackPanel>
                                        <StackPanel Width="145" Margin="0,0,10,8">
                                            <TextBlock Style="{StaticResource LeaveFieldLabelStyle}" Text="Số ngày" />
                                            <TextBox Text="{Binding BalanceDays, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Width="155" Margin="0,0,10,8">
                                            <TextBlock Style="{StaticResource LeaveFieldLabelStyle}" Text="Ngày hiệu lực" />
                                            <DatePicker SelectedDate="{Binding BalanceEffectiveDate, Mode=TwoWay}" />
                                        </StackPanel>
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource LeaveFieldLabelStyle}" Text="Lý do cập nhật sổ phép" />
                                    <TextBox MinHeight="54"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             Text="{Binding BalanceReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Margin="0,7,0,0"
                                               Text="Cấp đầu kỳ · Phát sinh định kỳ · Điều chỉnh · Chuyển năm · Hết hạn · Nghỉ bù. Sử dụng và Hoàn phép do backend tự ghi theo lifecycle đơn."
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                    <Button Margin="0,10,0,0"
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource OfficePrimaryButtonStyle}"
                                            IsEnabled="{Binding CanManageBalances}"
                                            Click="SaveBalanceEntry_OnClick"
                                            Content="GHI SỔ" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="Chế độ nghỉ">
                        <StackPanel Margin="0,10,0,0">
                            <Border Style="{StaticResource OfficeCardStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="CHẾ ĐỘ NGHỈ" FontSize="10" FontWeight="Bold" />
                                            <TextBlock Margin="0,3,0,0"
                                                       Text="Loại nghỉ và quy tắc áp dụng"
                                                       FontSize="16"
                                                       FontWeight="SemiBold" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Style="{StaticResource OfficePrimaryButtonStyle}"
                                                Visibility="{Binding CanManageTypes, Converter={StaticResource BoolToVisibility}}"
                                                Click="NewType_OnClick"
                                                Content="THÊM CHẾ ĐỘ" />
                                    </Grid>

                                    <DataGrid AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              RowHeight="62"
                                              Style="{StaticResource OfficeDataGridStyle}"
                                              ItemsSource="{Binding LeaveTypeRows}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Mã" Binding="{Binding Code}" Width="0.8*" ElementStyle="{StaticResource LeaveCellTextStyle}" />
                                            <DataGridTextColumn Header="Tên" Binding="{Binding Name}" Width="1.25*" ElementStyle="{StaticResource LeaveCellTextStyle}" />
                                            <DataGridTextColumn Header="Quy tắc" Binding="{Binding BadgesText}" Width="2.6*" ElementStyle="{StaticResource LeaveCellTextStyle}" />
                                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusText}" Width="0.9*" ElementStyle="{StaticResource LeaveCellTextStyle}" />
                                            <DataGridTemplateColumn Header="Thao tác" Width="0.75*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Padding="8,3"
                                                                Tag="{Binding}"
                                                                IsEnabled="{Binding CanEdit}"
                                                                Click="EditType_OnClick"
                                                                Content="Sửa" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <TextBlock Margin="0,12,0,0"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="Chưa có chế độ nghỉ khả dụng."
                                               Visibility="{Binding IsTypeEmpty, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,10,0,0"
                                    Style="{StaticResource OfficeCardStyle}"
                                    Visibility="{Binding IsTypeEditorOpen, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="CẤU HÌNH CHẾ ĐỘ NGHỈ" FontSize="10" FontWeight="Bold" />
                                    <TextBlock Margin="0,3,0,8"
                                               Text="{Binding TypeEditorTitle}"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <WrapPanel>
                                        <StackPanel Width="200" Margin="0,0,10,8">
                                            <TextBlock Style="{StaticResource LeaveFieldLabelStyle}" Text="Mã chế độ" />
                                            <TextBox IsEnabled="{Binding CanEditTypeCode}"
                                                     Text="{Binding TypeCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Width="320" Margin="0,0,10,8">
                                            <TextBlock Style="{StaticResource LeaveFieldLabelStyle}" Text="Tên chế độ" />
                                            <TextBox Text="{Binding TypeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </WrapPanel>
                                    <WrapPanel Margin="0,3,0,0">
                                        <CheckBox Margin="0,0,18,8" IsChecked="{Binding TypeIsActive, Mode=TwoWay}" Content="Đang áp dụng" />
                                        <CheckBox Margin="0,0,18,8" IsChecked="{Binding TypeIsPaid, Mode=TwoWay}" Content="Hưởng lương" />
                                        <CheckBox Margin="0,0,18,8" IsChecked="{Binding TypeCountsAsWorkday, Mode=TwoWay}" Content="Tính ngày công" />
                                        <CheckBox Margin="0,0,18,8" IsChecked="{Binding TypeRequiresApproval, Mode=TwoWay}" Content="Cần duyệt" />
                                        <CheckBox Margin="0,0,18,8" IsChecked="{Binding TypeAllowsFullDay, Mode=TwoWay}" Content="Cho phép cả ngày" />
                                        <CheckBox Margin="0,0,18,8" IsChecked="{Binding TypeAllowsHalfDay, Mode=TwoWay}" Content="Cho phép nửa ngày" />
                                        <CheckBox Margin="0,0,18,8" IsChecked="{Binding TypeRequiresAttachment, Mode=TwoWay}" Content="Yêu cầu chứng từ" />
                                        <CheckBox Margin="0,0,18,8" IsChecked="{Binding TypeTracksBalance, Mode=TwoWay}" Content="Theo dõi số dư phép" />
                                        <CheckBox Margin="0,0,18,8"
                                                  IsEnabled="{Binding TypeTracksBalance}"
                                                  IsChecked="{Binding TypeAllowNegativeBalance, Mode=TwoWay}"
                                                  Content="Cho phép số dư âm" />
                                    </WrapPanel>
                                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Margin="0,0,6,0"
                                                Style="{StaticResource OfficeSecondaryButtonStyle}"
                                                Click="CloseTypeEditor_OnClick"
                                                Content="ĐÓNG" />
                                        <Button Style="{StaticResource OfficePrimaryButtonStyle}"
                                                IsEnabled="{Binding CanSaveType}"
                                                Click="SaveType_OnClick"
                                                Content="LƯU CHẾ ĐỘ" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
