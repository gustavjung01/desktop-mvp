<UserControl x:Class="CongTy.Desktop.Accounting.PayablesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="PayablesView_OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="PayableCellTextStyle" TargetType="TextBlock" BasedOn="{StaticResource OfficeGridTextStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="PayableNumericTextStyle" TargetType="TextBlock" BasedOn="{StaticResource OfficeGridTextStyle}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16">
            <TextBlock Text="{Binding PageError}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                       Visibility="{Binding HasPageError, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Margin="0,8,0,0" Text="Đang tải công nợ nhà cung cấp…" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Visibility="{Binding ShowInitialLoading, Converter={StaticResource BoolToVisibility}}" />

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Margin="0,0,8,0" Style="{StaticResource OfficeCardStyle}">
                    <StackPanel><TextBlock Text="Số dư phải trả (VND)" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Margin="0,6,0,0" Text="{Binding TotalBalanceText}" FontSize="22" FontWeight="SemiBold"/></StackPanel>
                </Border>
                <Border Grid.Column="1" Margin="4,0" Style="{StaticResource OfficeCardStyle}">
                    <StackPanel><TextBlock Text="Đã quá hạn (VND)" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Margin="0,6,0,0" Text="{Binding TotalOverdueText}" FontSize="22" FontWeight="SemiBold"/></StackPanel>
                </Border>
                <Border Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource OfficeCardStyle}">
                    <StackPanel><TextBlock Text="Chứng từ còn mở" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Margin="0,6,0,0" Text="{Binding OpenDocumentCountText}" FontSize="22" FontWeight="SemiBold"/></StackPanel>
                </Border>
            </Grid>

            <Border Margin="0,10,0,0" Style="{StaticResource OfficeCardStyle}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Số dư theo nhà cung cấp" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Margin="0,3,0,0" Text="Theo dõi số dư, phần còn mở và khoản đã quá hạn theo từng loại tiền tệ." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Margin="0,0,8,0" Style="{StaticResource OfficeSecondaryButtonStyle}" IsEnabled="{Binding CanRefresh}" Click="ExportXlsx_OnClick" Content="Xuất Excel"/>
                            <Button Style="{StaticResource OfficeSecondaryButtonStyle}" IsEnabled="{Binding CanRefresh}" Click="Refresh_OnClick" Content="{Binding RefreshText}"/>
                        </StackPanel>
                    </Grid>
                    <DataGrid Grid.Row="1" Margin="0,8,0,0" MinHeight="190" MaxHeight="300" Style="{StaticResource OfficeDataGridStyle}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="42" ItemsSource="{Binding Balances}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STT" Binding="{Binding Sequence}" Width="55" ElementStyle="{StaticResource PayableNumericTextStyle}"/>
                            <DataGridTextColumn Header="Nhà cung cấp" Binding="{Binding Supplier}" Width="2*" ElementStyle="{StaticResource PayableCellTextStyle}"/>
                            <DataGridTextColumn Header="Tiền tệ" Binding="{Binding CurrencyCode}" Width="0.8*" ElementStyle="{StaticResource PayableCellTextStyle}"/>
                            <DataGridTextColumn Header="Số dư" Binding="{Binding Balance}" Width="1.2*" ElementStyle="{StaticResource PayableNumericTextStyle}"/>
                            <DataGridTextColumn Header="Còn mở" Binding="{Binding OpenAmount}" Width="1.2*" ElementStyle="{StaticResource PayableNumericTextStyle}"/>
                            <DataGridTextColumn Header="Quá hạn" Binding="{Binding OverdueAmount}" Width="1.2*" ElementStyle="{StaticResource PayableNumericTextStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Margin="0,6,0,0" HorizontalAlignment="Center" Text="{Binding BalanceEmptyText}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Grid>
            </Border>

            <Border Margin="0,10,0,0" Style="{StaticResource OfficeCardStyle}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Chứng từ công nợ" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,3,0,0" Text="Công nợ phát sinh tự động từ phiếu nhận hàng, phiếu trả và chứng từ thanh toán nhà cung cấp." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" Margin="0,8,0,0" MinHeight="260" MaxHeight="390" Style="{StaticResource OfficeDataGridStyle}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="46" ItemsSource="{Binding Documents}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STT" Binding="{Binding Sequence}" Width="50" ElementStyle="{StaticResource PayableNumericTextStyle}"/>
                            <DataGridTextColumn Header="Chứng từ nguồn" Binding="{Binding SourceNumber}" Width="1.15*" ElementStyle="{StaticResource PayableCellTextStyle}"/>
                            <DataGridTextColumn Header="Ngày" Binding="{Binding SourceDate}" Width="0.85*" ElementStyle="{StaticResource PayableCellTextStyle}"/>
                            <DataGridTextColumn Header="Nhà cung cấp" Binding="{Binding Supplier}" Width="1.5*" ElementStyle="{StaticResource PayableCellTextStyle}"/>
                            <DataGridTextColumn Header="Kho" Binding="{Binding Warehouse}" Width="1.25*" ElementStyle="{StaticResource PayableCellTextStyle}"/>
                            <DataGridTextColumn Header="Hạn thanh toán" Binding="{Binding DueDate}" Width="1*" ElementStyle="{StaticResource PayableCellTextStyle}"/>
                            <DataGridTextColumn Header="Điều khoản" Binding="{Binding PaymentTerms}" Width="1.2*" ElementStyle="{StaticResource PayableCellTextStyle}"/>
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="1.1*" ElementStyle="{StaticResource PayableCellTextStyle}"/>
                            <DataGridTextColumn Header="Giá trị" Binding="{Binding SignedAmount}" Width="1.1*" ElementStyle="{StaticResource PayableNumericTextStyle}"/>
                            <DataGridTemplateColumn Header="" Width="72">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><Button Padding="10,4" Style="{StaticResource OfficeSecondaryButtonStyle}" IsEnabled="{Binding DataContext.CanRefresh, RelativeSource={RelativeSource AncestorType=UserControl}}" Click="OpenDetail_OnClick" Content="Mở"/></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Margin="0,6,0,0" HorizontalAlignment="Center" Text="{Binding DocumentsEmptyText}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Grid>
            </Border>

            <TextBlock Margin="0,10,0,0" Text="{Binding DetailError}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Visibility="{Binding HasDetailError, Converter={StaticResource BoolToVisibility}}"/>
            <Border Margin="0,10,0,0" Style="{StaticResource OfficeCardStyle}" Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="{Binding DetailTitle}" FontSize="17" FontWeight="SemiBold"/><TextBlock Margin="0,3,0,0" Text="Chi tiết chứng từ công nợ phải trả" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource OfficeSecondaryButtonStyle}" Click="CloseDetail_OnClick" Content="Đóng chi tiết"/>
                    </Grid>
                    <UniformGrid Margin="0,10,0,0" Columns="3">
                        <Border Margin="0,0,8,8" Style="{StaticResource OfficeCardStyle}"><StackPanel><TextBlock Text="Nhà cung cấp" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Margin="0,4,0,0" Text="{Binding DetailSupplier}" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel></Border>
                        <Border Margin="0,0,8,8" Style="{StaticResource OfficeCardStyle}"><StackPanel><TextBlock Text="Kho" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Margin="0,4,0,0" Text="{Binding DetailWarehouse}" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel></Border>
                        <Border Margin="0,0,0,8" Style="{StaticResource OfficeCardStyle}"><StackPanel><TextBlock Text="Giá trị gốc" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Margin="0,4,0,0" Text="{Binding DetailOriginalAmount}" FontWeight="SemiBold"/></StackPanel></Border>
                        <Border Margin="0,0,8,0" Style="{StaticResource OfficeCardStyle}"><StackPanel><TextBlock Text="Còn lại" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Margin="0,4,0,0" Text="{Binding DetailRemainingAmount}" FontWeight="SemiBold"/></StackPanel></Border>
                        <Border Margin="0,0,8,0" Style="{StaticResource OfficeCardStyle}"><StackPanel><TextBlock Text="Hạn / điều khoản thanh toán" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Margin="0,4,0,0" Text="{Binding DetailDue}" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel></Border>
                        <Border Style="{StaticResource OfficeCardStyle}"><StackPanel><TextBlock Text="Trạng thái" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Margin="0,4,0,0" Text="{Binding DetailStatus}" FontWeight="SemiBold"/></StackPanel></Border>
                    </UniformGrid>

                    <TextBlock Margin="0,14,0,0" Text="Dòng chứng từ" FontSize="15" FontWeight="SemiBold"/>
                    <DataGrid Margin="0,7,0,0" MinHeight="160" MaxHeight="260" Style="{StaticResource OfficeDataGridStyle}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="40" ItemsSource="{Binding DetailLines}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STT" Binding="{Binding Sequence}" Width="50" ElementStyle="{StaticResource PayableNumericTextStyle}"/>
                            <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="1*" ElementStyle="{StaticResource PayableCellTextStyle}"/>
                            <DataGridTextColumn Header="Hàng hóa" Binding="{Binding ItemName}" Width="1.7*" ElementStyle="{StaticResource PayableCellTextStyle}"/>
                            <DataGridTextColumn Header="Số lượng" Binding="{Binding Quantity}" Width="1*" ElementStyle="{StaticResource PayableNumericTextStyle}"/>
                            <DataGridTextColumn Header="Đơn giá" Binding="{Binding UnitPrice}" Width="1*" ElementStyle="{StaticResource PayableNumericTextStyle}"/>
                            <DataGridTextColumn Header="Thành tiền" Binding="{Binding LineAmount}" Width="1*" ElementStyle="{StaticResource PayableNumericTextStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Margin="0,14,0,0" Text="Sổ chi tiết" FontSize="15" FontWeight="SemiBold"/>
                    <DataGrid Margin="0,7,0,0" MinHeight="150" MaxHeight="240" Style="{StaticResource OfficeDataGridStyle}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="40" ItemsSource="{Binding DetailLedger}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STT" Binding="{Binding Sequence}" Width="50" ElementStyle="{StaticResource PayableNumericTextStyle}"/>
                            <DataGridTextColumn Header="Thời điểm" Binding="{Binding OccurredAt}" Width="1.2*" ElementStyle="{StaticResource PayableCellTextStyle}"/>
                            <DataGridTextColumn Header="Loại bút toán" Binding="{Binding EntryType}" Width="1.2*" ElementStyle="{StaticResource PayableCellTextStyle}"/>
                            <DataGridTextColumn Header="Yêu cầu" Binding="{Binding RequestId}" Width="1.6*" ElementStyle="{StaticResource PayableCellTextStyle}"/>
                            <DataGridTextColumn Header="Số tiền" Binding="{Binding Amount}" Width="1.1*" ElementStyle="{StaticResource PayableNumericTextStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
