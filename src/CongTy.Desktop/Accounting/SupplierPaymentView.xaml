<UserControl x:Class="CongTy.Desktop.Accounting.SupplierPaymentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="SupplierPaymentView_OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="SupplierPaymentCellTextStyle" TargetType="TextBlock" BasedOn="{StaticResource OfficeGridTextStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SupplierPaymentNumericTextStyle" TargetType="TextBlock" BasedOn="{StaticResource OfficeGridTextStyle}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16">
            <Border Padding="12" Margin="0,0,0,12" Style="{StaticResource OfficeCardStyle}"
                    Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
            </Border>

            <Border Style="{StaticResource OfficeCardStyle}"
                    Visibility="{Binding CanCreate, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Ghi nhận thanh toán" FontSize="16" FontWeight="SemiBold" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1.35*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,4" Text="Nhà cung cấp" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Margin="4,0,8,4" Text="Kho" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Margin="4,0,8,4" Text="Ngày thanh toán" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="0" Grid.Column="3" Margin="4,0,0,4" Text="Phương thức" FontWeight="SemiBold" />

                        <ComboBox Grid.Row="1" Grid.Column="0" Margin="0,0,8,10"
                                  ItemsSource="{Binding Suppliers}"
                                  DisplayMemberPath="Display"
                                  SelectedItem="{Binding SelectedSupplier}" />
                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="4,0,8,10"
                                  ItemsSource="{Binding Warehouses}"
                                  DisplayMemberPath="Display"
                                  SelectedItem="{Binding SelectedWarehouse}" />
                        <TextBox Grid.Row="1" Grid.Column="2" Margin="4,0,8,10"
                                 Text="{Binding PaymentDate, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox Grid.Row="1" Grid.Column="3" Margin="4,0,0,10"
                                  ItemsSource="{Binding PaymentMethods}"
                                  DisplayMemberPath="Display"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding PaymentMethod}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,4" Text="Số tiền" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="4,0,8,4" Text="Tham chiếu ngân hàng" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Margin="4,0,0,4" Text="Ghi chú" FontWeight="SemiBold" />

                        <TextBox Grid.Row="3" Grid.Column="0" Margin="0,0,8,0"
                                 Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Grid.Row="3" Grid.Column="1" Margin="4,0,8,0" MaxLength="256"
                                 Text="{Binding ExternalReference, UpdateSourceTrigger=PropertyChanged}" />
                        <Grid Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" Margin="4,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Margin="0,0,8,0" MaxLength="4000"
                                     Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1"
                                    Style="{StaticResource OfficePrimaryButtonStyle}"
                                    IsEnabled="{Binding CanUseCreateForm}"
                                    Click="SavePayment_OnClick"
                                    Content="Ghi nhận thanh toán" />
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Margin="0,12,0,0" Style="{StaticResource OfficeCardStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Phiếu thanh toán" FontSize="16" FontWeight="SemiBold" />
                        <Button Grid.Column="1"
                                Style="{StaticResource OfficeSecondaryButtonStyle}"
                                IsEnabled="{Binding CanRead}"
                                Click="ExportXlsx_OnClick"
                                Content="Xuất Excel" />
                    </Grid>
                    <DataGrid Margin="0,10,0,0"
                              Height="260"
                              ItemsSource="{Binding Payments}"
                              SelectedItem="{Binding SelectedPaymentRow}"
                              SelectionChanged="Payments_OnSelectionChanged"
                              Style="{StaticResource OfficeDataGridStyle}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STT" Width="55" Binding="{Binding Sequence}" />
                            <DataGridTemplateColumn Header="Số phiếu" Width="1.3*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DocumentNumber}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding PaymentDate}" FontSize="10" Opacity="0.7" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Nhà cung cấp" Width="2*" Binding="{Binding Supplier}" />
                            <DataGridTemplateColumn Header="Số tiền" Width="1.35*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding OriginalAmount}" HorizontalAlignment="Right" />
                                            <TextBlock HorizontalAlignment="Right" FontSize="10" Opacity="0.7">
                                                <Run Text="Còn " />
                                                <Run Text="{Binding RemainingAmount, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Trạng thái" Width="1.25*" Binding="{Binding Status}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Margin="0,8,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Chưa có phiếu thanh toán."
                               Visibility="{Binding ShowEmptyPayments, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <Border Margin="0,12,0,16" Style="{StaticResource OfficeCardStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Chi tiết và phân bổ" FontSize="16" FontWeight="SemiBold" />
                        <Button Grid.Column="1"
                                Style="{StaticResource OfficeSecondaryButtonStyle}"
                                Visibility="{Binding HasSelectedPayment, Converter={StaticResource BoolToVisibility}}"
                                Click="Print_OnClick"
                                Content="In / PDF" />
                    </Grid>
                    <TextBlock Margin="0,10,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding DetailEmptyText}" />

                    <StackPanel Margin="0,10,0,0"
                                Visibility="{Binding HasSelectedPayment, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="1.5*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Số phiếu" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Margin="0,4,0,0" Text="{Binding SelectedDocumentNumber}" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Nhà cung cấp" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Margin="0,4,0,0" Text="{Binding SelectedSupplierText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Số tiền" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Margin="0,4,0,0" Text="{Binding SelectedOriginalText}" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Còn lại" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Margin="0,4,0,0" Text="{Binding SelectedRemainingText}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding SelectedWarehouseText}" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedPaymentDateText}" />
                            <TextBlock Grid.Column="2" Text="{Binding SelectedPaymentMethodText}" />
                            <TextBlock Grid.Column="3" Text="{Binding SelectedStatusText}" FontWeight="SemiBold" />
                        </Grid>

                        <Separator Margin="0,14" />

                        <TextBlock Text="Phân bổ vào chứng từ phải trả" FontWeight="SemiBold" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.4*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,4" Text="Chứng từ phải trả" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,8,4" Text="Ngày phân bổ" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Margin="0,0,8,4" Text="Số tiền phân bổ" FontWeight="SemiBold" />
                            <ComboBox Grid.Row="1" Grid.Column="0" Margin="0,0,8,0"
                                      ItemsSource="{Binding Targets}"
                                      DisplayMemberPath="Display"
                                      SelectedItem="{Binding SelectedTarget}"
                                      IsEnabled="{Binding CanUseAllocationForm}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,8,0"
                                     Text="{Binding AllocationDate, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding CanUseAllocationForm}" />
                            <TextBox Grid.Row="1" Grid.Column="2" Margin="0,0,8,0"
                                     Text="{Binding AllocationAmount, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding CanUseAllocationForm}" />
                            <Button Grid.Row="1" Grid.Column="3"
                                    Style="{StaticResource OfficePrimaryButtonStyle}"
                                    IsEnabled="{Binding CanUseAllocationForm}"
                                    Click="Allocate_OnClick"
                                    Content="Phân bổ" />
                        </Grid>
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding TargetEmptyText}" />

                        <Separator Margin="0,14" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Lý do đảo" FontWeight="SemiBold" />
                                <TextBox Margin="0,6,10,0"
                                         MinHeight="52"
                                         MaxLength="2000"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Text="{Binding ReversalReason, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="Bắt buộc khi đảo phân bổ hoặc phiếu" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    VerticalAlignment="Bottom"
                                    Style="{StaticResource OfficeSecondaryButtonStyle}"
                                    IsEnabled="{Binding CanUseReversePayment}"
                                    Visibility="{Binding CanReversePayment, Converter={StaticResource BoolToVisibility}}"
                                    Click="ReversePayment_OnClick"
                                    Content="Đảo phiếu thanh toán" />
                        </Grid>

                        <TextBlock Margin="0,16,0,0" Text="Lịch sử phân bổ" FontWeight="SemiBold" />
                        <DataGrid Margin="0,8,0,0"
                                  Height="220"
                                  ItemsSource="{Binding AllocationHistory}"
                                  Style="{StaticResource OfficeDataGridStyle}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Chứng từ đích" Width="2*" Binding="{Binding TargetDocumentNumber}" />
                                <DataGridTextColumn Header="Ngày" Width="1*" Binding="{Binding AllocationDate}" />
                                <DataGridTextColumn Header="Số tiền" Width="1.3*" Binding="{Binding Amount}" />
                                <DataGridTextColumn Header="Trạng thái" Width="1*" Binding="{Binding Status}" />
                                <DataGridTemplateColumn Header="" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource OfficeSecondaryButtonStyle}"
                                                    Visibility="{Binding CanReverse, Converter={StaticResource BoolToVisibility}}"
                                                    Click="ReverseAllocation_OnClick"
                                                    Content="Đảo" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Margin="0,8,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding AllocationEmptyText}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
