<UserControl x:Class="CongTy.Desktop.Accounting.SalesSettlementReconciliationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="SalesSettlementReconciliationView_OnLoaded"
             PreviewKeyDown="SalesSettlementReconciliationView_OnPreviewKeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="SettlementCellTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SettlementNumericTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SettlementCellTextStyle}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16">
            <Border Style="{StaticResource OfficeCardStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="PHẠM VI BÁO CÁO"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Margin="0,3,0,0"
                                       Text="Lọc dữ liệu đối soát"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <TextBlock Margin="0,3,0,0"
                                       Text="{Binding ActiveFilterText}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Top">
                            <Button Margin="0,0,8,0"
                                    Style="{StaticResource OfficeSecondaryButtonStyle}"
                                    IsEnabled="{Binding DataContext.CanViewReceivables, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                    Click="Receivables_OnClick"
                                    Content="Công nợ phải thu" />
                            <Button Style="{StaticResource OfficeSecondaryButtonStyle}"
                                    IsEnabled="{Binding DataContext.CanViewCodAccounting, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                    Click="CodAccounting_OnClick"
                                    Content="Đối soát COD" />
                        </StackPanel>
                    </Grid>

                    <WrapPanel Margin="0,12,0,0">
                        <StackPanel Width="165" Margin="0,0,8,8">
                            <TextBlock Text="Từ ngày" Margin="0,0,0,4" FontWeight="SemiBold" />
                            <DatePicker MinHeight="30"
                                        IsEnabled="{Binding IsNotBusy}"
                                        SelectedDate="{Binding FromDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Width="165" Margin="0,0,8,8">
                            <TextBlock Text="Đến ngày" Margin="0,0,0,4" FontWeight="SemiBold" />
                            <DatePicker MinHeight="30"
                                        IsEnabled="{Binding IsNotBusy}"
                                        SelectedDate="{Binding ToDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Width="330" Margin="0,0,8,8">
                            <TextBlock Text="Khách, chứng từ, chuyến hoặc tài xế" Margin="0,0,0,4" FontWeight="SemiBold" />
                            <TextBox MinHeight="30"
                                     MaxLength="160"
                                     IsEnabled="{Binding IsNotBusy}"
                                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Width="180" Margin="0,0,8,8">
                            <TextBlock Text="Kết quả" Margin="0,0,0,4" FontWeight="SemiBold" />
                            <ComboBox MinHeight="30"
                                      Style="{StaticResource OfficeComboBoxStyle}"
                                      IsEnabled="{Binding IsNotBusy}"
                                      ItemsSource="{Binding StatusOptions}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Key"
                                      SelectedValue="{Binding SelectedStatus, Mode=TwoWay}" />
                        </StackPanel>
                        <Button Margin="4,20,8,8"
                                Style="{StaticResource OfficeSecondaryButtonStyle}"
                                IsEnabled="{Binding CanApply}"
                                Click="Reset_OnClick"
                                Content="Đặt lại" />
                        <Button Margin="0,20,8,8"
                                Style="{StaticResource OfficeSecondaryButtonStyle}"
                                IsEnabled="{Binding CanExport}"
                                Click="ExportCsv_OnClick"
                                Content="Xuất CSV" />
                        <Button Margin="0,20,0,8"
                                Style="{StaticResource OfficePrimaryButtonStyle}"
                                IsEnabled="{Binding CanApply}"
                                Click="Apply_OnClick"
                                Content="{Binding ApplyText}" />
                    </WrapPanel>

                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Message}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1"
                                   Margin="12,0,0,0"
                                   Text="{Binding GeneratedAtText}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Margin="0,10,0,0"
                    Padding="10"
                    Style="{StaticResource OfficeCardStyle}"
                    Visibility="{Binding ShowInitialLoading, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Đang tải đối soát bán hàng &amp; COD…"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </Border>

            <Border Margin="0,10,0,0"
                    Padding="10"
                    Style="{StaticResource OfficeCardStyle}"
                    Visibility="{Binding HasReportError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ReportError}"
                           Foreground="{DynamicResource DangerBrush}"
                           TextWrapping="Wrap" />
            </Border>

            <WrapPanel Margin="0,10,0,0"
                       Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}">
                <Border Width="220" Margin="0,0,8,8" Style="{StaticResource OfficeSummaryCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource OfficeSummaryLabelStyle}" Text="Dư nợ đang mở" />
                        <TextBlock Style="{StaticResource OfficeSummaryValueStyle}" Text="{Binding DebitOutstandingText}" />
                        <TextBlock Margin="0,3,0,0" Text="{Binding CustomerGroupText}" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <Border Width="220" Margin="0,0,8,8" Style="{StaticResource OfficeSummaryCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource OfficeSummaryLabelStyle}" Text="Credit chưa dùng" />
                        <TextBlock Style="{StaticResource OfficeSummaryValueStyle}" Text="{Binding UnappliedCreditText}" />
                        <TextBlock Margin="0,3,0,0" Text="Số dư có thể phân bổ / hoàn" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <Border Width="220" Margin="0,0,8,8" Style="{StaticResource OfficeSummaryCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource OfficeSummaryLabelStyle}" Text="COD tài xế đang giữ" />
                        <TextBlock Style="{StaticResource OfficeSummaryValueStyle}" Text="{Binding CodCustodyText}" />
                        <TextBlock Margin="0,3,0,0" Text="Chưa vào bàn giao hiệu lực" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <Border Width="220" Margin="0,0,8,8" Style="{StaticResource OfficeSummaryCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource OfficeSummaryLabelStyle}" Text="COD chờ kế toán nhận" />
                        <TextBlock Style="{StaticResource OfficeSummaryValueStyle}" Text="{Binding CodPendingAcceptanceText}" />
                        <TextBlock Margin="0,3,0,0" Text="Đã bàn giao, chưa xác nhận" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <Border Width="220" Margin="0,0,8,8" Style="{StaticResource OfficeSummaryCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource OfficeSummaryLabelStyle}" Text="COD công ty đã nhận" />
                        <TextBlock Style="{StaticResource OfficeSummaryValueStyle}" Text="{Binding CodAcceptedText}" />
                        <TextBlock Margin="0,3,0,0" Text="{Binding CodVarianceText}" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <Border Width="220" Margin="0,0,8,8" Style="{StaticResource OfficeSummaryCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource OfficeSummaryLabelStyle}" Text="Bất thường cần xử lý" />
                        <TextBlock Style="{StaticResource OfficeSummaryValueStyle}" Text="{Binding AnomalyCountText}" />
                        <TextBlock Margin="0,3,0,0" Text="Không tự sửa số liệu" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <TabControl Margin="0,4,0,0"
                        Style="{StaticResource OfficeTabControlStyle}"
                        SelectedIndex="{Binding ActiveTabIndex, Mode=TwoWay}"
                        Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}">
                <TabItem Header="Khách &amp; kho">
                    <Border Margin="0,8,0,0" Style="{StaticResource OfficeCardStyle}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Số dư công nợ giải thích được" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,3,0,0" Text="Theo khách hàng và kho, đối chiếu số dư tính lại với sổ ledger." Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding CustomerCountText}" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>
                            <DataGrid Margin="0,8,0,0"
                                      Height="430"
                                      Style="{StaticResource OfficeDataGridStyle}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      ItemsSource="{Binding Customers}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Khách hàng / kho" Binding="{Binding CustomerWarehouse}" Width="1.6*" ElementStyle="{StaticResource SettlementCellTextStyle}" />
                                    <DataGridTextColumn Header="Đã ghi nợ" Binding="{Binding Posted}" Width="1*" ElementStyle="{StaticResource SettlementNumericTextStyle}" />
                                    <DataGridTextColumn Header="Còn phải thu" Binding="{Binding Outstanding}" Width="1*" ElementStyle="{StaticResource SettlementNumericTextStyle}" />
                                    <DataGridTextColumn Header="Credit chưa dùng" Binding="{Binding Credit}" Width="1*" ElementStyle="{StaticResource SettlementNumericTextStyle}" />
                                    <DataGridTextColumn Header="Số dư tính lại" Binding="{Binding Calculated}" Width="1*" ElementStyle="{StaticResource SettlementNumericTextStyle}" />
                                    <DataGridTextColumn Header="Sổ ledger" Binding="{Binding Ledger}" Width="1*" ElementStyle="{StaticResource SettlementNumericTextStyle}" />
                                    <DataGridTextColumn Header="Kết quả" Binding="{Binding Result}" Width="0.7*" ElementStyle="{StaticResource SettlementCellTextStyle}" />
                                    <DataGridTemplateColumn Header="" Width="82">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource OfficeMiniButtonStyle}"
                                                        IsEnabled="{Binding DataContext.CanViewReceivables, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                        Click="Receivables_OnClick"
                                                        Content="Mở nguồn" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" Text="{Binding CustomersEmptyText}" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </TabItem>

                <TabItem Header="Đơn bán">
                    <Border Margin="0,8,0,0" Style="{StaticResource OfficeCardStyle}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Trạng thái đơn, hàng, giao và tiền" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,3,0,0" Text="Bốn trục được đối chiếu độc lập để không suy diễn trạng thái thanh toán từ giao hàng." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding OrderCountText}" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>
                            <DataGrid Margin="0,8,0,0"
                                      Height="430"
                                      Style="{StaticResource OfficeDataGridStyle}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      ItemsSource="{Binding Orders}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Đơn / khách" Binding="{Binding OrderCustomer}" Width="1.5*" ElementStyle="{StaticResource SettlementCellTextStyle}" />
                                    <DataGridTextColumn Header="Đơn hàng" Binding="{Binding OrderStatus}" Width="0.85*" ElementStyle="{StaticResource SettlementCellTextStyle}" />
                                    <DataGridTextColumn Header="Chuẩn bị hàng" Binding="{Binding FulfillmentStatus}" Width="1*" ElementStyle="{StaticResource SettlementCellTextStyle}" />
                                    <DataGridTextColumn Header="Giao hàng" Binding="{Binding DeliveryStatus}" Width="0.9*" ElementStyle="{StaticResource SettlementCellTextStyle}" />
                                    <DataGridTextColumn Header="Thanh toán" Binding="{Binding SettlementStatus}" Width="1.15*" ElementStyle="{StaticResource SettlementCellTextStyle}" />
                                    <DataGridTextColumn Header="Còn phải thu" Binding="{Binding Outstanding}" Width="1*" ElementStyle="{StaticResource SettlementNumericTextStyle}" />
                                    <DataGridTextColumn Header="COD đang giữ" Binding="{Binding CodCustody}" Width="1*" ElementStyle="{StaticResource SettlementNumericTextStyle}" />
                                    <DataGridTextColumn Header="Kết quả" Binding="{Binding Result}" Width="0.7*" ElementStyle="{StaticResource SettlementCellTextStyle}" />
                                    <DataGridTemplateColumn Header="" Width="82">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource OfficeMiniButtonStyle}"
                                                        IsEnabled="{Binding DataContext.CanViewSales, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                        Click="SalesOrders_OnClick"
                                                        Content="Mở đơn" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" Text="{Binding OrdersEmptyText}" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </TabItem>

                <TabItem Header="Chứng từ">
                    <Border Margin="0,8,0,0" Style="{StaticResource OfficeCardStyle}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Posting, phân bổ và số dư còn lại" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,3,0,0" Text="Đối chiếu chứng từ phải thu với ledger và projection phân bổ." Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding DocumentCountText}" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>
                            <DataGrid Margin="0,8,0,0"
                                      Height="430"
                                      Style="{StaticResource OfficeDataGridStyle}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      ItemsSource="{Binding Documents}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Chứng từ / khách" Binding="{Binding DocumentCustomer}" Width="1.6*" ElementStyle="{StaticResource SettlementCellTextStyle}" />
                                    <DataGridTextColumn Header="Loại" Binding="{Binding Type}" Width="1*" ElementStyle="{StaticResource SettlementCellTextStyle}" />
                                    <DataGridTextColumn Header="Giá trị gốc" Binding="{Binding Original}" Width="1*" ElementStyle="{StaticResource SettlementNumericTextStyle}" />
                                    <DataGridTextColumn Header="Đã phân bổ" Binding="{Binding Allocated}" Width="1*" ElementStyle="{StaticResource SettlementNumericTextStyle}" />
                                    <DataGridTextColumn Header="Còn lại" Binding="{Binding Remaining}" Width="1*" ElementStyle="{StaticResource SettlementNumericTextStyle}" />
                                    <DataGridTextColumn Header="Ledger" Binding="{Binding Ledger}" Width="1.25*" ElementStyle="{StaticResource SettlementNumericTextStyle}" />
                                    <DataGridTextColumn Header="Kết quả" Binding="{Binding Result}" Width="0.7*" ElementStyle="{StaticResource SettlementCellTextStyle}" />
                                    <DataGridTemplateColumn Header="" Width="82">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource OfficeMiniButtonStyle}"
                                                        IsEnabled="{Binding DataContext.CanViewReceivables, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                        Click="Receivables_OnClick"
                                                        Content="Mở nguồn" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" Text="{Binding DocumentsEmptyText}" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </TabItem>

                <TabItem Header="COD">
                    <StackPanel Margin="0,8,0,0">
                        <Border Style="{StaticResource OfficeCardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Thu COD và bàn giao cuối chuyến" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Margin="0,3,0,0" Text="Theo dõi riêng khoản tài xế ghi nhận và bàn giao kế toán." Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding CodCountText}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Grid>

                                <TextBlock Margin="0,12,0,0" Text="Khoản tài xế đã ghi nhận" FontWeight="SemiBold" />
                                <DataGrid Margin="0,6,0,0"
                                          Height="255"
                                          Style="{StaticResource OfficeDataGridStyle}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          ItemsSource="{Binding CodCollections}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Phiếu / khách" Binding="{Binding DeliveryCustomer}" Width="1.5*" ElementStyle="{StaticResource SettlementCellTextStyle}" />
                                        <DataGridTextColumn Header="Chuyến / tài xế" Binding="{Binding TripDriver}" Width="1.3*" ElementStyle="{StaticResource SettlementCellTextStyle}" />
                                        <DataGridTextColumn Header="Phương thức" Binding="{Binding Method}" Width="1*" ElementStyle="{StaticResource SettlementCellTextStyle}" />
                                        <DataGridTextColumn Header="Đã thu" Binding="{Binding Received}" Width="0.9*" ElementStyle="{StaticResource SettlementNumericTextStyle}" />
                                        <DataGridTextColumn Header="Đã bàn giao" Binding="{Binding HandedOver}" Width="0.9*" ElementStyle="{StaticResource SettlementNumericTextStyle}" />
                                        <DataGridTextColumn Header="Còn tài xế giữ" Binding="{Binding Custody}" Width="1*" ElementStyle="{StaticResource SettlementNumericTextStyle}" />
                                        <DataGridTextColumn Header="Vòng đời" Binding="{Binding Lifecycle}" Width="1*" ElementStyle="{StaticResource SettlementCellTextStyle}" />
                                        <DataGridTemplateColumn Header="" Width="128">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Margin="0,0,4,0"
                                                                Style="{StaticResource OfficeMiniButtonStyle}"
                                                                IsEnabled="{Binding DataContext.CanViewCodAccounting, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                Click="CodAccounting_OnClick"
                                                                Content="COD" />
                                                        <Button Style="{StaticResource OfficeMiniButtonStyle}"
                                                                IsEnabled="{Binding DataContext.CanViewTripReconciliation, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                Click="TripReconciliation_OnClick"
                                                                Content="Chuyến" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" Text="{Binding CodCollectionsEmptyText}" Foreground="{DynamicResource TextSecondaryBrush}" />

                                <TextBlock Margin="0,14,0,0" Text="Bàn giao và xác nhận của kế toán" FontWeight="SemiBold" />
                                <DataGrid Margin="0,6,0,0"
                                          Height="255"
                                          Style="{StaticResource OfficeDataGridStyle}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          ItemsSource="{Binding CodHandovers}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Chuyến / tài xế" Binding="{Binding TripDriver}" Width="1.5*" ElementStyle="{StaticResource SettlementCellTextStyle}" />
                                        <DataGridTextColumn Header="Tiền khai bàn giao" Binding="{Binding Claimed}" Width="1*" ElementStyle="{StaticResource SettlementNumericTextStyle}" />
                                        <DataGridTextColumn Header="Chờ xác nhận" Binding="{Binding Pending}" Width="1*" ElementStyle="{StaticResource SettlementNumericTextStyle}" />
                                        <DataGridTextColumn Header="Công ty đã nhận" Binding="{Binding Accepted}" Width="1*" ElementStyle="{StaticResource SettlementNumericTextStyle}" />
                                        <DataGridTextColumn Header="Chênh lệch" Binding="{Binding Variance}" Width="1*" ElementStyle="{StaticResource SettlementNumericTextStyle}" />
                                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="0.9*" ElementStyle="{StaticResource SettlementCellTextStyle}" />
                                        <DataGridTextColumn Header="Kết quả" Binding="{Binding Result}" Width="0.7*" ElementStyle="{StaticResource SettlementCellTextStyle}" />
                                        <DataGridTemplateColumn Header="" Width="128">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Margin="0,0,4,0"
                                                                Style="{StaticResource OfficeMiniButtonStyle}"
                                                                IsEnabled="{Binding DataContext.CanViewCodAccounting, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                Click="CodAccounting_OnClick"
                                                                Content="COD" />
                                                        <Button Style="{StaticResource OfficeMiniButtonStyle}"
                                                                IsEnabled="{Binding DataContext.CanViewTripReconciliation, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                Click="TripReconciliation_OnClick"
                                                                Content="Chuyến" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" Text="{Binding CodHandoversEmptyText}" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Bất thường">
                    <Border Margin="0,8,0,0" Style="{StaticResource OfficeCardStyle}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Bất thường cần truy về nguồn" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,3,0,0" Text="Chỉ hiển thị chênh lệch; màn này không tự sửa số liệu nguồn." Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding AnomalyStateText}" FontWeight="SemiBold" />
                            </Grid>
                            <DataGrid Margin="0,8,0,0"
                                      Height="430"
                                      Style="{StaticResource OfficeDataGridStyle}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      ItemsSource="{Binding Anomalies}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Loại" Binding="{Binding Type}" Width="1.1*" ElementStyle="{StaticResource SettlementCellTextStyle}" />
                                    <DataGridTextColumn Header="Nguồn" Binding="{Binding Source}" Width="1*" ElementStyle="{StaticResource SettlementCellTextStyle}" />
                                    <DataGridTextColumn Header="Kết quả" Binding="{Binding Result}" Width="0.7*" ElementStyle="{StaticResource SettlementCellTextStyle}" />
                                    <DataGridTextColumn Header="Chi tiết" Binding="{Binding Details}" Width="3*" ElementStyle="{StaticResource SettlementCellTextStyle}" />
                                    <DataGridTemplateColumn Header="" Width="82">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource OfficeMiniButtonStyle}"
                                                        Tag="{Binding}"
                                                        Click="AnomalySource_OnClick"
                                                        Content="Mở nguồn" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Margin="0,6,0,0"
                                       HorizontalAlignment="Center"
                                       Text="{Binding AnomaliesEmptyText}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </TabItem>
            </TabControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
