<UserControl x:Class="CongTy.Desktop.Accounting.CustomerReturnCreditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="CustomerReturnCreditView_OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="CreditCellTextStyle" TargetType="TextBlock" BasedOn="{StaticResource OfficeGridTextStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="CreditAmountTextStyle" TargetType="TextBlock" BasedOn="{StaticResource OfficeGridTextStyle}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16">
            <Border Padding="10" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                    Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
            </Border>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Margin="0,0,6,0" Style="{StaticResource OfficeCardStyle}">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Khoản giảm công nợ từ hàng khách trả" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Margin="0,3,0,0" Text="Chọn chứng từ để phân bổ vào khoản phải thu hoặc hoàn phần chưa sử dụng." Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource OfficeSecondaryButtonStyle}" IsEnabled="{Binding CanRead}" Click="Refresh_OnClick" Content="Cập nhật dữ liệu" />
                        </Grid>
                        <TextBox Margin="0,10,0,0" ToolTip="Số chứng từ, phiếu trả hàng, khách hàng hoặc đơn bán" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                        <DataGrid Margin="0,8,0,0" MinHeight="560" MaxHeight="720" Style="{StaticResource OfficeDataGridStyle}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="46"
                                  ItemsSource="{Binding Credits}" SelectedItem="{Binding SelectedRow}" SelectionChanged="Credits_OnSelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="STT" Binding="{Binding Sequence}" Width="45" />
                                <DataGridTextColumn Header="Chứng từ" Binding="{Binding DocumentNumber}" Width="1.05*" ElementStyle="{StaticResource CreditCellTextStyle}" />
                                <DataGridTextColumn Header="Phiếu trả hàng" Binding="{Binding SourceReturn}" Width="1.05*" ElementStyle="{StaticResource CreditCellTextStyle}" />
                                <DataGridTextColumn Header="Khách hàng" Binding="{Binding Customer}" Width="1.5*" ElementStyle="{StaticResource CreditCellTextStyle}" />
                                <DataGridTextColumn Header="Đơn vị" Binding="{Binding Warehouse}" Width="1.15*" ElementStyle="{StaticResource CreditCellTextStyle}" />
                                <DataGridTextColumn Header="Ngày" Binding="{Binding PostingDate}" Width="0.8*" ElementStyle="{StaticResource CreditCellTextStyle}" />
                                <DataGridTextColumn Header="Giá trị giảm" Binding="{Binding GrossAmount}" Width="1*" ElementStyle="{StaticResource CreditAmountTextStyle}" />
                                <DataGridTextColumn Header="Còn lại" Binding="{Binding RemainingAmount}" Width="1*" ElementStyle="{StaticResource CreditAmountTextStyle}" />
                                <DataGridTextColumn Header="Kết quả" Binding="{Binding Status}" Width="1.05*" ElementStyle="{StaticResource CreditCellTextStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" Text="Chưa có khoản giảm công nợ từ hàng khách trả." Foreground="{DynamicResource TextSecondaryBrush}" Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource OfficeCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Chi tiết điều chỉnh" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Margin="0,8,0,0" Text="{Binding DetailEmptyText}" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <StackPanel Visibility="{Binding HasSelected, Converter={StaticResource BoolToVisibility}}">
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="{Binding SelectedDocument}" FontSize="19" FontWeight="Bold" />
                                    <TextBlock Margin="0,4,0,0" Text="{Binding SelectedCustomer}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,4,0,0" Text="{Binding SelectedWarehouse}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,4,0,0" Text="{Binding SelectedStatus}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Phiếu trả hàng" FontWeight="SemiBold"/><TextBlock Margin="0,2,0,0" Text="{Binding SelectedSourceReturn}"/>
                                    <TextBlock Margin="0,6,0,0" Text="Đơn bán" FontWeight="SemiBold"/><TextBlock Margin="0,2,0,0" Text="{Binding SelectedSalesOrder}"/>
                                    <TextBlock Margin="0,6,0,0" Text="Giá trị giảm / Còn lại" FontWeight="SemiBold"/>
                                    <TextBlock Margin="0,2,0,0" Text="{Binding SelectedGross}"/><TextBlock Text="{Binding SelectedRemaining}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Margin="0,14,0,0" Text="Hàng trả tạo khoản giảm" FontSize="15" FontWeight="SemiBold" />
                            <DataGrid Margin="0,7,0,0" MinHeight="110" MaxHeight="200" Style="{StaticResource OfficeDataGridStyle}" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding Lines}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="0.8*" ElementStyle="{StaticResource CreditCellTextStyle}" />
                                    <DataGridTextColumn Header="Hàng hóa" Binding="{Binding Product}" Width="1.5*" ElementStyle="{StaticResource CreditCellTextStyle}" />
                                    <DataGridTextColumn Header="Số lượng nhận" Binding="{Binding Quantity}" Width="0.8*" ElementStyle="{StaticResource CreditAmountTextStyle}" />
                                    <DataGridTextColumn Header="Giá trị giảm" Binding="{Binding CreditAmount}" Width="1*" ElementStyle="{StaticResource CreditAmountTextStyle}" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Margin="0,14,0,0" Visibility="{Binding CanUseAllocation, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Phân bổ khoản giảm công nợ còn lại" FontSize="15" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Margin="0,7,0,0"><TextBlock VerticalAlignment="Center" Text="Ngày phân bổ" FontWeight="SemiBold"/><TextBox Width="130" Margin="8,0,0,0" Text="{Binding AllocationDate, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <DataGrid Margin="0,7,0,0" MinHeight="130" MaxHeight="230" Style="{StaticResource OfficeDataGridStyle}" AutoGenerateColumns="False" RowHeight="42" ItemsSource="{Binding Targets}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Đơn hàng / Khoản phải thu" Binding="{Binding Reference}" IsReadOnly="True" Width="1.4*" ElementStyle="{StaticResource CreditCellTextStyle}" />
                                        <DataGridTextColumn Header="Đơn vị" Binding="{Binding Warehouse}" IsReadOnly="True" Width="1*" ElementStyle="{StaticResource CreditCellTextStyle}" />
                                        <DataGridTextColumn Header="Còn phải thu" Binding="{Binding RemainingAmount}" IsReadOnly="True" Width="1*" ElementStyle="{StaticResource CreditAmountTextStyle}" />
                                        <DataGridTextColumn Header="Phân bổ lần này" Binding="{Binding AmountInput, UpdateSourceTrigger=PropertyChanged}" Width="1*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Margin="0,4,0,0" Text="{Binding TargetEmptyText}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Button Margin="0,7,0,0" HorizontalAlignment="Right" Style="{StaticResource OfficePrimaryButtonStyle}" Click="Allocate_OnClick" Content="Phân bổ công nợ" />
                            </StackPanel>

                            <StackPanel Margin="0,14,0,0" Visibility="{Binding CanUseRefund, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Hoàn tiền từ phần chưa sử dụng" FontSize="15" FontWeight="SemiBold" />
                                <WrapPanel Margin="0,7,0,0">
                                    <StackPanel Width="160" Margin="0,0,10,8"><TextBlock Text="Số tiền" FontWeight="SemiBold"/><TextBox Margin="0,4,0,0" Text="{Binding RefundAmount, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                    <StackPanel Width="150" Margin="0,0,10,8"><TextBlock Text="Ngày hoàn" FontWeight="SemiBold"/><TextBox Margin="0,4,0,0" Text="{Binding RefundDate, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                    <StackPanel Width="170" Margin="0,0,10,8"><TextBlock Text="Phương thức" FontWeight="SemiBold"/><ComboBox Margin="0,4,0,0" ItemsSource="{Binding RefundMethods}" SelectedValue="{Binding RefundMethod}" SelectedValuePath="Id" DisplayMemberPath="Display"/></StackPanel>
                                </WrapPanel>
                                <TextBlock Text="Nơi nhận / tài khoản nhận" FontWeight="SemiBold"/><TextBox Margin="0,4,0,0" Text="{Binding DestinationReference, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Margin="0,7,0,0" Text="Tham chiếu giao dịch" FontWeight="SemiBold"/><TextBox Margin="0,4,0,0" Text="{Binding ExternalReference, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Margin="0,7,0,0" Text="Lý do" FontWeight="SemiBold"/><TextBox Margin="0,4,0,0" MinHeight="48" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding RefundReason, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Margin="0,7,0,0" HorizontalAlignment="Right" Style="{StaticResource OfficePrimaryButtonStyle}" Click="Refund_OnClick" Content="Ghi nhận hoàn tiền" />
                            </StackPanel>

                            <TextBlock Margin="0,14,0,0" Text="Lịch sử phân bổ" FontSize="15" FontWeight="SemiBold" />
                            <DataGrid Margin="0,7,0,0" MinHeight="110" MaxHeight="190" Style="{StaticResource OfficeDataGridStyle}" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding Allocations}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Khoản phải thu" Binding="{Binding TargetDocument}" Width="1.4*" ElementStyle="{StaticResource CreditCellTextStyle}" />
                                    <DataGridTextColumn Header="Ngày" Binding="{Binding Date}" Width="0.8*" ElementStyle="{StaticResource CreditCellTextStyle}" />
                                    <DataGridTextColumn Header="Số tiền" Binding="{Binding Amount}" Width="1*" ElementStyle="{StaticResource CreditAmountTextStyle}" />
                                    <DataGridTextColumn Header="Kết quả" Binding="{Binding Status}" Width="0.9*" ElementStyle="{StaticResource CreditCellTextStyle}" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Margin="0,4,0,0" Text="{Binding AllocationEmptyText}" Foreground="{DynamicResource TextSecondaryBrush}" />

                            <TextBlock Margin="0,14,0,0" Text="Lịch sử hoàn tiền" FontSize="15" FontWeight="SemiBold" />
                            <DataGrid Margin="0,7,0,0" MinHeight="120" MaxHeight="210" Style="{StaticResource OfficeDataGridStyle}" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding Refunds}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Phiếu hoàn" Binding="{Binding Number}" Width="1*" ElementStyle="{StaticResource CreditCellTextStyle}" />
                                    <DataGridTextColumn Header="Phương thức / nơi nhận" Binding="{Binding MethodDestination}" Width="1.5*" ElementStyle="{StaticResource CreditCellTextStyle}" />
                                    <DataGridTextColumn Header="Ngày" Binding="{Binding Date}" Width="0.8*" ElementStyle="{StaticResource CreditCellTextStyle}" />
                                    <DataGridTextColumn Header="Số tiền" Binding="{Binding Amount}" Width="1*" ElementStyle="{StaticResource CreditAmountTextStyle}" />
                                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="0.8*" ElementStyle="{StaticResource CreditCellTextStyle}" />
                                    <DataGridTemplateColumn Header="" Width="Auto"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Padding="8,4" IsEnabled="{Binding CanReverse}" Click="ReverseRefund_OnClick" Content="Đảo hoàn tiền"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Margin="0,4,0,0" Text="{Binding RefundEmptyText}" Foreground="{DynamicResource TextSecondaryBrush}" />

                            <TextBlock Margin="0,14,0,0" Text="Lý do đảo" FontWeight="SemiBold" />
                            <TextBox Margin="0,4,0,0" MinHeight="48" AcceptsReturn="True" TextWrapping="Wrap" ToolTip="Bắt buộc khi đảo khoản giảm công nợ hoặc hoàn tiền" Text="{Binding ReversalReason, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Margin="0,8,0,0" HorizontalAlignment="Right" Style="{StaticResource OfficeSecondaryButtonStyle}" IsEnabled="{Binding CanUseReverseCredit}" Click="ReverseCredit_OnClick" Content="Đảo khoản giảm công nợ hàng trả" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
