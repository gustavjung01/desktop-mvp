<UserControl x:Class="CongTy.Desktop.Accounting.CustomerReturnCreditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="CustomerReturnCreditView_OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="CreditCellTextStyle" TargetType="TextBlock" BasedOn="{StaticResource OfficeGridTextStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="CreditAmountTextStyle" TargetType="TextBlock" BasedOn="{StaticResource OfficeGridTextStyle}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16">
            <Border Padding="10" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
            </Border>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="1.35*" />
                </Grid.ColumnDefinitions>

                <Border Margin="0,0,6,0" Style="{StaticResource OfficeCardStyle}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Khoản giảm công nợ từ hàng khách trả" FontSize="17" FontWeight="SemiBold" />
                            <Button HorizontalAlignment="Right" Style="{StaticResource OfficeSecondaryButtonStyle}" IsEnabled="{Binding CanRead}" Click="Refresh_OnClick" Content="Cập nhật dữ liệu" />
                        </Grid>
                        <DataGrid Margin="0,8,0,0" MinHeight="560" MaxHeight="760" Style="{StaticResource OfficeDataGridStyle}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="48" ItemsSource="{Binding Credits}" SelectedItem="{Binding SelectedCreditRow}" SelectionChanged="Credits_OnSelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="STT" Binding="{Binding Sequence}" Width="45" />
                                <DataGridTextColumn Header="Phiếu trả" Binding="{Binding ReturnNumber}" Width="1*" ElementStyle="{StaticResource CreditCellTextStyle}" />
                                <DataGridTextColumn Header="Khách hàng" Binding="{Binding Customer}" Width="1.4*" ElementStyle="{StaticResource CreditCellTextStyle}" />
                                <DataGridTextColumn Header="Kho" Binding="{Binding Warehouse}" Width="1.2*" ElementStyle="{StaticResource CreditCellTextStyle}" />
                                <DataGridTextColumn Header="Giá trị" Binding="{Binding OriginalAmount}" Width="1*" ElementStyle="{StaticResource CreditAmountTextStyle}" />
                                <DataGridTextColumn Header="Còn dùng" Binding="{Binding RemainingAmount}" Width="1*" ElementStyle="{StaticResource CreditAmountTextStyle}" />
                                <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="1*" ElementStyle="{StaticResource CreditCellTextStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" Text="Chưa có phiếu hàng khách trả đã nhận phát sinh khoản giảm công nợ." Foreground="{DynamicResource TextSecondaryBrush}" Visibility="{Binding ShowEmptyCredits, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource OfficeCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Chi tiết và xử lý" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Margin="0,8,0,0" Text="{Binding DetailEmptyText}" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <StackPanel Visibility="{Binding HasSelectedCredit, Converter={StaticResource BoolToVisibility}}">
                            <Border Margin="0,8,0,0" Padding="10" Background="{DynamicResource SurfaceBrush}" CornerRadius="7">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedTitle}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,5,0,0" Text="{Binding SelectedWarehouse}" />
                                        <TextBlock Margin="0,5,0,0" Text="{Binding SelectedStatus}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                        <TextBlock Text="Giá trị ban đầu" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding SelectedOriginal}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                        <TextBlock Margin="0,5,0,0" Text="Đã sử dụng" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding SelectedAllocated}" HorizontalAlignment="Right" />
                                        <TextBlock Margin="0,5,0,0" Text="Chưa sử dụng" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding SelectedRemaining}" FontWeight="Bold" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Margin="0,14,0,0" Text="Dòng hàng đã nhận" FontSize="15" FontWeight="SemiBold" />
                            <DataGrid Margin="0,7,0,0" MinHeight="125" MaxHeight="210" Style="{StaticResource OfficeDataGridStyle}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="42" ItemsSource="{Binding Lines}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Hàng hóa" Binding="{Binding Item}" Width="1.5*" ElementStyle="{StaticResource CreditCellTextStyle}" />
                                    <DataGridTextColumn Header="Chứng từ nguồn" Binding="{Binding SourceDocument}" Width="1*" ElementStyle="{StaticResource CreditCellTextStyle}" />
                                    <DataGridTextColumn Header="SL nhận" Binding="{Binding Quantity}" Width="0.8*" ElementStyle="{StaticResource CreditAmountTextStyle}" />
                                    <DataGridTextColumn Header="Giá trị giảm" Binding="{Binding AdjustmentAmount}" Width="1*" ElementStyle="{StaticResource CreditAmountTextStyle}" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Margin="0,14,0,0" Visibility="{Binding HasRemaining, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Phân bổ khoản giảm công nợ còn lại" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Margin="0,3,0,0" Text="Chỉ hiển thị các khoản nợ cùng khách hàng, cùng tiền tệ và còn số dư." Foreground="{DynamicResource TextSecondaryBrush}" />
                                <StackPanel Margin="0,8,0,0" Width="190" HorizontalAlignment="Left">
                                    <TextBlock Text="Ngày phân bổ" FontWeight="SemiBold" />
                                    <TextBox Margin="0,5,0,0" ToolTip="yyyy-MM-dd" Text="{Binding AllocationDate, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <DataGrid Margin="0,8,0,0" MinHeight="150" MaxHeight="240" Style="{StaticResource OfficeDataGridStyle}" AutoGenerateColumns="False" RowHeight="42" ItemsSource="{Binding AllocationTargets}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Khoản nợ / Đơn bán" Binding="{Binding Reference}" IsReadOnly="True" Width="1.4*" ElementStyle="{StaticResource CreditCellTextStyle}" />
                                        <DataGridTextColumn Header="Kho" Binding="{Binding Warehouse}" IsReadOnly="True" Width="1*" ElementStyle="{StaticResource CreditCellTextStyle}" />
                                        <DataGridTextColumn Header="Còn nợ" Binding="{Binding RemainingAmount}" IsReadOnly="True" Width="1*" ElementStyle="{StaticResource CreditAmountTextStyle}" />
                                        <DataGridTextColumn Header="Số phân bổ" Binding="{Binding AmountInput, UpdateSourceTrigger=PropertyChanged}" Width="1*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Grid Margin="0,6,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding TargetEmptyText}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Margin="0,3,0,0" Text="{Binding AllocationSummary}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <Button HorizontalAlignment="Right" Style="{StaticResource OfficePrimaryButtonStyle}" IsEnabled="{Binding CanSubmitAllocation}" Click="Allocate_OnClick" Content="Phân bổ công nợ" />
                                </Grid>

                                <TextBlock Margin="0,16,0,0" Text="Hoàn tiền từ phần chưa sử dụng" FontSize="15" FontWeight="SemiBold" />
                                <WrapPanel Margin="0,8,0,0">
                                    <StackPanel Width="180" Margin="0,0,10,10"><TextBlock Text="Số tiền" FontWeight="SemiBold" /><TextBox Margin="0,5,0,0" Text="{Binding RefundAmount, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                    <StackPanel Width="180" Margin="0,0,10,10"><TextBlock Text="Ngày hoàn" FontWeight="SemiBold" /><TextBox Margin="0,5,0,0" ToolTip="yyyy-MM-dd" Text="{Binding RefundDate, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                    <StackPanel Width="190" Margin="0,0,10,10"><TextBlock Text="Phương thức" FontWeight="SemiBold" /><ComboBox Margin="0,5,0,0" ItemsSource="{Binding RefundMethods}" SelectedValue="{Binding RefundMethod}" SelectedValuePath="Id" DisplayMemberPath="Display" /></StackPanel>
                                    <StackPanel Width="280" Margin="0,0,10,10"><TextBlock Text="Nơi nhận / tài khoản nhận" FontWeight="SemiBold" /><TextBox Margin="0,5,0,0" Text="{Binding DestinationReference, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                    <StackPanel Width="250" Margin="0,0,10,10"><TextBlock Text="Tham chiếu giao dịch" FontWeight="SemiBold" /><TextBox Margin="0,5,0,0" Text="{Binding ExternalReference, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                </WrapPanel>
                                <TextBlock Text="Lý do hoàn tiền" FontWeight="SemiBold" />
                                <TextBox Margin="0,5,0,0" MinHeight="52" MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding RefundReason, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Margin="0,8,0,0" HorizontalAlignment="Right" Style="{StaticResource OfficePrimaryButtonStyle}" IsEnabled="{Binding CanSubmitRefund}" Click="Refund_OnClick" Content="Ghi nhận hoàn tiền" />
                            </StackPanel>

                            <TextBlock Margin="0,16,0,0" Text="Lịch sử hoàn tiền" FontSize="15" FontWeight="SemiBold" />
                            <DataGrid Margin="0,7,0,0" MinHeight="140" MaxHeight="240" Style="{StaticResource OfficeDataGridStyle}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="44" ItemsSource="{Binding Refunds}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Phiếu hoàn" Binding="{Binding RefundNumber}" Width="0.9*" ElementStyle="{StaticResource CreditCellTextStyle}" />
                                    <DataGridTextColumn Header="Phương thức / nơi nhận" Binding="{Binding MethodAndDestination}" Width="1.4*" ElementStyle="{StaticResource CreditCellTextStyle}" />
                                    <DataGridTextColumn Header="Tham chiếu" Binding="{Binding ExternalReference}" Width="0.9*" ElementStyle="{StaticResource CreditCellTextStyle}" />
                                    <DataGridTextColumn Header="Số tiền" Binding="{Binding Amount}" Width="0.9*" ElementStyle="{StaticResource CreditAmountTextStyle}" />
                                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="0.8*" ElementStyle="{StaticResource CreditCellTextStyle}" />
                                    <DataGridTemplateColumn Header="" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <WrapPanel>
                                                    <Button Margin="0,0,5,0" Padding="8,4" Click="PrintRefund_OnClick" Content="In / PDF" />
                                                    <Button Padding="8,4" IsEnabled="{Binding CanReverse}" Click="ReverseRefund_OnClick" Content="Đảo hoàn tiền" />
                                                </WrapPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Margin="0,5,0,0" Text="{Binding RefundEmptyText}" Foreground="{DynamicResource TextSecondaryBrush}" />

                            <TextBlock Margin="0,14,0,0" Text="Lý do đảo" FontWeight="SemiBold" />
                            <TextBox Margin="0,5,0,0" MinHeight="52" MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap" ToolTip="Bắt buộc khi đảo khoản giảm công nợ hoặc hoàn tiền" Text="{Binding ReversalReason, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Margin="0,8,0,0" HorizontalAlignment="Right" Style="{StaticResource OfficeSecondaryButtonStyle}" IsEnabled="{Binding CanUseReverseCredit}" Click="ReverseCredit_OnClick" Content="Đảo khoản giảm công nợ hàng trả" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
