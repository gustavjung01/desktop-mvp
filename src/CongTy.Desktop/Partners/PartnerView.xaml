                                <TextBox Style="{StaticResource FieldTextBoxStyle}" AcceptsReturn="True" MinHeight="70" Text="{Binding DraftDescription}" />
                                <CheckBox Margin="0,4,0,8" IsChecked="{Binding DraftDefaultOrPrimary}" Content="Điều khoản chính" />
                                <CheckBox Margin="0,4,0,8" IsChecked="{Binding DraftActive}" Content="Đang sử dụng" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                                <Button Style="{StaticResource SecondaryButtonStyle}" Click="CancelEditor_OnClick" Content="Hủy" />
                                <Button Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding IsNotBusy}" Click="SaveEditor_OnClick" Content="{Binding PartnerEditorPrimaryActionLabel}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
