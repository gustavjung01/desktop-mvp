<UserControl x:Class="CongTy.Desktop.Partners.PartnerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="800"
             MinHeight="540">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="PanelStyle" TargetType="Border" BasedOn="{StaticResource OfficeCardStyle}" />
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource OfficePrimaryButtonStyle}">
            <Setter Property="Margin" Value="4,0" />
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource OfficeSecondaryButtonStyle}">
            <Setter Property="Margin" Value="4,0" />
        </Style>
        <Style x:Key="FieldTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource OfficeTextBoxStyle}">
            <Setter Property="Margin" Value="0,3,0,8" />
        </Style>
        <Style x:Key="FieldComboStyle" TargetType="ComboBox" BasedOn="{StaticResource OfficeComboBoxStyle}">
            <Setter Property="Margin" Value="0,3,0,8" />
        </Style>
        <Style x:Key="ListGridStyle" TargetType="DataGrid" BasedOn="{StaticResource OfficeDataGridStyle}" />
        <Style x:Key="CustomerLinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MessageBorderStyle" TargetType="Border" BasedOn="{StaticResource OfficeCardStyle}">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Padding" Value="8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TabControl x:Name="PartnerTabs" Background="Transparent" BorderThickness="0">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter Content="{TemplateBinding SelectedContent}"
                                          ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
                    </ControlTemplate>
                </TabControl.Template>
                <TabItem Header="Khách hàng"
                         Visibility="{Binding CanReadCustomers, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TabControl Style="{StaticResource OfficeTabControlStyle}" x:Name="CustomerTabs"
                                Margin="0,2,0,0"
                                Background="Transparent"
                                BorderThickness="0"
                                ItemContainerStyle="{StaticResource OfficeTabItemStyle}"
                                SelectionChanged="CustomerTabs_OnSelectionChanged">
                        <TabItem Header="Khách hàng">
                            <Grid Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,8">
                                    <Border Style="{StaticResource OfficeSummaryCardStyle}" Margin="0,0,4,0">
                                        <DockPanel LastChildFill="False">
                                            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                                <TextBlock Text="Tổng khách hàng" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Text="Toàn bộ hồ sơ hiện có" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding CustomerTotal}" Margin="10,0,0,0" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource OfficeSummaryCardStyle}" Margin="2,0">
                                        <DockPanel LastChildFill="False">
                                            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                                <TextBlock Text="Đang hoạt động" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Text="Hồ sơ đang được sử dụng" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding CustomerActive}" Margin="10,0,0,0" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource OfficeSummaryCardStyle}" Margin="4,0,0,0">
                                        <DockPanel LastChildFill="False">
                                            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                                <TextBlock Text="Không hoạt động" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Text="Hồ sơ đã ngừng sử dụng" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding CustomerInactive}" Margin="10,0,0,0" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                </UniformGrid>

                                <Border Grid.Row="1" Style="{StaticResource PanelStyle}" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="210" />
                                            <ColumnDefinition Width="190" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="Tìm kiếm" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <Grid>
                                                <TextBox x:Name="CustomerSearchBox"
                                                         Style="{StaticResource FieldTextBoxStyle}"
                                                         Text="{Binding CustomerSearch, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Margin="10,0,0,8"
                                                           VerticalAlignment="Center"
                                                           IsHitTestVisible="False"
                                                           Text="Mã, tên, liên hệ…"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text, ElementName=CustomerSearchBox}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                            <TextBlock Text="Trạng thái" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <ComboBox Style="{StaticResource FieldComboStyle}"
                                                      ItemsSource="{Binding StatusOptions}"
                                                      DisplayMemberPath="Label"
                                                      SelectedValuePath="Id"
                                                      SelectedValue="{Binding CustomerStatus}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                            <TextBlock Text="Nhóm khách hàng" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <ComboBox Style="{StaticResource FieldComboStyle}"
                                                      ItemsSource="{Binding CustomerGroupFilterOptions}"
                                                      DisplayMemberPath="Label"
                                                      SelectedValuePath="Id"
                                                      SelectedValue="{Binding CustomerGroupFilter}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="Nhân viên phụ trách" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <ComboBox Style="{StaticResource FieldComboStyle}"
                                                      ItemsSource="{Binding CustomerEmployeeFilterOptions}"
                                                      DisplayMemberPath="Label"
                                                      SelectedValuePath="Id"
                                                      SelectedValue="{Binding CustomerEmployeeFilter}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="2" Style="{StaticResource PanelStyle}" Padding="0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid Margin="12,9,12,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="DANH SÁCH" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Text="Khách hàng" Margin="0,3,0,0" FontSize="17" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <Border Grid.Column="1"
                                                    Padding="9,5"
                                                    CornerRadius="7"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource SurfaceMutedBrush}">
                                                <TextBlock Text="{Binding CustomerVisibleSummary, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>

                                        <Grid Grid.Row="1">
                                            <DataGrid BorderThickness="0"
                                                      RowHeight="62"
                                                      Style="{StaticResource ListGridStyle}"
                                                      ItemsSource="{Binding CustomerRows}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="STT" Binding="{Binding Sequence}" Width="48" />

                                                    <DataGridTemplateColumn Header="Mã / tên" Width="1.35*">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Code}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                                                    <Button Style="{StaticResource CustomerLinkButtonStyle}"
                                                                            Margin="0,2,0,0"
                                                                            Tag="{Binding Id}"
                                                                            Click="CustomerName_OnClick"
                                                                            Content="{Binding Name}" />
                                                                    <TextBlock Text="{Binding TaxCode}" Margin="0,2,0,0" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>

                                                    <DataGridTemplateColumn Header="Nhóm / phụ trách" Width="1.15*">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Group}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding ResponsibleEmployee}" Margin="0,3,0,0" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>

                                                    <DataGridTemplateColumn Header="Liên hệ" Width="1.1*">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Phone}" />
                                                                    <TextBlock Text="{Binding Email}" Margin="0,3,0,0" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>

                                                    <DataGridTemplateColumn Header="Thanh toán" Width="1.2*">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding CreditLimit}" FontWeight="SemiBold" />
                                                                    <TextBlock Text="{Binding PaymentTerms}" Margin="0,3,0,0" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>

                                                    <DataGridTemplateColumn Header="Trạng thái" Width="125">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Status}"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>

                                                    <DataGridTemplateColumn Header="Hành động" Width="290">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Button Style="{StaticResource OfficeMiniButtonStyle}"
                                                                            Margin="0,0,6,0"
                                                                            Tag="{Binding Id}"
                                                                            IsEnabled="{Binding DataContext.CanWriteCustomers, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                                            Click="EditCustomer_OnClick"
                                                                            Content="Sửa" />
                                                                    <Button Style="{StaticResource OfficeMiniButtonStyle}"
                                                                            Margin="0,0,6,0"
                                                                            Tag="{Binding Id}"
                                                                            Click="CustomerAddresses_OnClick"
                                                                            Content="Địa chỉ" />
                                                                    <Button Style="{StaticResource OfficeMiniButtonStyle}"
                                                                            Tag="{Binding Id}"
                                                                            IsEnabled="{Binding DataContext.CanWriteCustomers, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                                            Click="ToggleCustomer_OnClick"
                                                                            Content="{Binding ToggleAction}" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>

                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Text="Không có khách hàng phù hợp."
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Visibility="{Binding CustomerHasNoRows, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Thiết lập nhanh">
                            <Grid Margin="0,14,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,12">
                                    <DockPanel LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Left">
                                            <TextBlock Text="Thiết lập nhanh khách hàng" FontSize="17" FontWeight="SemiBold" />
                                            <TextBlock Margin="0,4,0,0"
                                                       Text="Chọn một khách để xử lý thông tin, địa chỉ và ảnh trong cùng một không gian làm việc."
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                        <Button DockPanel.Dock="Right"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                IsEnabled="{Binding CanWriteCustomers}"
                                                Click="AddCustomer_OnClick"
                                                Content="Thêm khách hàng" />
                                    </DockPanel>
                                </Border>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="265" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource PanelStyle}" Margin="0,0,7,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Tìm khách hàng" FontWeight="SemiBold" />
                                                <TextBox Style="{StaticResource FieldTextBoxStyle}"
                                                         Text="{Binding CustomerSearch, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="Tên, mã, số điện thoại" />
                                            </StackPanel>
                                            <ListBox x:Name="QuickCustomerList"
                                                     Grid.Row="1"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     ItemsSource="{Binding CustomerRows}"
                                                     SelectedValuePath="Id"
                                                     ItemContainerStyle="{StaticResource OfficeListBoxItemStyle}"
                                                     SelectionChanged="QuickCustomerList_OnSelectionChanged">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Code}" Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            <TextBlock Text="{Binding Contact}" Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Group}" Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Status}" Margin="0,2,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Grid>
                                    </Border>

                                    <ScrollViewer Grid.Column="1" Margin="7,0,0,0" VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,12">
                                                <DockPanel LastChildFill="False">
                                                    <StackPanel DockPanel.Dock="Left">
                                                        <TextBlock Text="{Binding SelectedCustomerLabel}" FontSize="18" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding CustomerOverviewStatus}" Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </StackPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource OfficeMiniButtonStyle}" Tag="{Binding SelectedCustomerId}" IsEnabled="{Binding CanWriteCustomers}" Click="EditCustomer_OnClick" Content="Sửa thông tin" />
                                                        <Button Style="{StaticResource OfficeMiniButtonStyle}" Tag="{Binding SelectedCustomerId}" IsEnabled="{Binding CanWriteCustomers}" Click="ToggleCustomer_OnClick" Content="{Binding SelectedCustomerToggleAction}" />
                                                        <Button Style="{StaticResource PrimaryButtonStyle}" Tag="{Binding SelectedCustomerId}" Click="CustomerOverview_OnClick" Content="Hồ sơ 360°" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>

                                            <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,12">
                                                <StackPanel>
                                                    <TextBlock Text="1  Thông tin khách hàng" FontSize="17" FontWeight="SemiBold" />
                                                    <Grid Margin="0,12,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1*" />
                                                            <ColumnDefinition Width="1*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                            <TextBlock Text="Nhóm khách hàng" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            <TextBlock Text="{Binding CustomerOverviewGroup}" Margin="0,3,0,10" FontWeight="SemiBold" />
                                                            <TextBlock Text="Nhân viên phụ trách" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            <TextBlock Text="{Binding CustomerOverviewEmployee}" Margin="0,3,0,10" FontWeight="SemiBold" />
                                                            <TextBlock Text="Liên hệ" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            <TextBlock Text="{Binding CustomerOverviewContact}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                            <TextBlock Text="Hạn mức / thời hạn" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            <TextBlock Text="{Binding CustomerOverviewCredit}" Margin="0,3,0,10" FontWeight="SemiBold" />
                                                            <TextBlock Text="Lần mua gần nhất" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            <TextBlock Text="{Binding CustomerOverviewLastPurchase}" Margin="0,3,0,10" FontWeight="SemiBold" />
                                                            <TextBlock Text="Ghi chú" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            <TextBlock Text="{Binding CustomerOverviewNotes}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,12">
                                                <StackPanel>
                                                    <DockPanel LastChildFill="False">
                                                        <StackPanel DockPanel.Dock="Left">
                                                            <TextBlock Text="2  Địa chỉ" FontSize="17" FontWeight="SemiBold" />
                                                            <TextBlock Text="Chỉnh địa chỉ, đặt mặc định hoặc ngừng sử dụng ngay tại khách đang chọn." Margin="0,3,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        </StackPanel>
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding CanWriteCustomers}" Click="AddCustomerAddress_OnClick" Content="Thêm địa chỉ" />
                                                    </DockPanel>
                                                    <DataGrid Margin="0,12,0,0"
                                                              MaxHeight="285"
                                                              Style="{StaticResource ListGridStyle}"
                                                              ItemsSource="{Binding CustomerAddressRows}">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Nhãn" Binding="{Binding Label}" Width="120" />
                                                            <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Người nhận" Binding="{Binding Recipient}" Width="125" />
                                                            <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Địa chỉ" Binding="{Binding Address}" Width="*" />
                                                            <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Điện thoại" Binding="{Binding Phone}" Width="115" />
                                                            <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Mặc định" Binding="{Binding DefaultText}" Width="82" />
                                                            <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Trạng thái" Binding="{Binding Status}" Width="105" />
                                                            <DataGridTemplateColumn Header="Thao tác" Width="92">
                                                                <DataGridTemplateColumn.CellTemplate>
                                                                    <DataTemplate>
                                                                        <Button VerticalAlignment="Center" Style="{StaticResource OfficeRowActionButtonStyle}"
                                                                                Tag="{Binding Id}"
                                                                                Click="OpenCustomerAddressRowActions_OnClick"
                                                                                Content="Thao tác ▾">
                                                                            <Button.ContextMenu>
                                                                                <ContextMenu Style="{StaticResource OfficeRowContextMenuStyle}">
                                                                                    <MenuItem Style="{StaticResource OfficeRowMenuItemStyle}" Header="Sửa" CommandParameter="write" Click="EditCustomerAddress_OnClick" />
                                                                                    <MenuItem Style="{StaticResource OfficeRowMenuItemStyle}" Header="Đặt mặc định" CommandParameter="write"
                                                                                              Visibility="{Binding CanSetDefault, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                                              Click="SetDefaultCustomerAddress_OnClick" />
                                                                                    <MenuItem Style="{StaticResource OfficeRowMenuItemStyle}" Header="Mở định vị"
                                                                                              Visibility="{Binding HasLocation, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                                              Click="OpenCustomerAddressLocation_OnClick" />
                                                                                    <Separator />
                                                                                    <MenuItem Style="{StaticResource OfficeRowMenuItemStyle}" Header="{Binding ToggleAction}" CommandParameter="write" Click="ToggleCustomerAddress_OnClick" />
                                                                                </ContextMenu>
                                                                            </Button.ContextMenu>
                                                                        </Button>
                                                                    </DataTemplate>
                                                                </DataGridTemplateColumn.CellTemplate>
                                                            </DataGridTemplateColumn>
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </StackPanel>
                                            </Border>

                                            <Border Style="{StaticResource PanelStyle}">
                                                <StackPanel>
                                                    <DockPanel LastChildFill="False">
                                                        <StackPanel DockPanel.Dock="Left">
                                                            <TextBlock Text="3  Ảnh khách hàng" FontSize="17" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding CustomerMediaSummary}" Margin="0,3,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        </StackPanel>
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding CanAddCustomerMedia}" Click="AddCustomerMedia_OnClick" Content="Thêm ảnh" />
                                                    </DockPanel>
                                                    <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding CustomerMediaRows}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Width="220" Margin="0,0,10,10" Padding="9" Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9">
                                                                    <StackPanel>
                                                                        <Border Height="108" Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="7" ClipToBounds="True">
                                                                            <Image Source="{Binding Image}" Stretch="UniformToFill" />
                                                                        </Border>
                                                                        <TextBlock Text="{Binding Source}" Margin="0,7,0,0" FontWeight="SemiBold" />
