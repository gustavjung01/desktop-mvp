                                                            <TextBlock Margin="0,10,0,0" Text="Hạn mức / thời hạn" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            <TextBlock Text="{Binding CustomerOverviewCredit}" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Column="1" Style="{StaticResource PanelStyle}" Margin="7,0,0,0">
                                                        <StackPanel>
                                                            <TextBlock Text="Hoạt động gần đây" FontSize="17" FontWeight="SemiBold" />
                                                            <TextBlock Margin="0,12,0,0" Text="Lần mua gần nhất" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            <TextBlock Text="{Binding CustomerOverviewLastPurchase}" FontWeight="SemiBold" />
                                                            <TextBlock Margin="0,10,0,0" Text="Ghi chú khách hàng" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            <TextBlock Text="{Binding CustomerOverviewNotes}" TextWrapping="Wrap" />
                                                            <TextBlock Margin="0,10,0,0" Text="Địa chỉ đang sử dụng" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            <TextBlock Text="{Binding CustomerAddressRows.Count, StringFormat={}{0} địa chỉ}" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </TabItem>
                                    <TabItem Header="Hàng đã mua">
                                        <Grid Margin="0,12,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="Hàng đã mua" FontSize="17" FontWeight="SemiBold" />
                                                        <TextBlock Text="Tổng hợp sản phẩm đã mua theo khoảng thời gian đang chọn."
                                                                   Margin="0,3,0,0"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <StackPanel Margin="0,0,8,0">
                                                            <TextBlock Text="Tìm sản phẩm" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            <TextBox Width="210"
                                                                     Style="{StaticResource FieldTextBoxStyle}"
                                                                     Text="{Binding CustomerPurchasedSearch, UpdateSourceTrigger=PropertyChanged}"
                                                                     ToolTip="Tên sản phẩm hoặc SKU" />
                                                        </StackPanel>
                                                        <Button Style="{StaticResource SecondaryButtonStyle}" Click="SearchCustomerPurchased_OnClick" Content="Tìm" />
                                                        <Border Margin="10,0,0,0" Padding="9,5" CornerRadius="7" Background="{DynamicResource SurfaceMutedBrush}">
                                                            <TextBlock Text="{Binding CustomerPurchasedSummary}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <Grid Grid.Row="1">
                                                <DataGrid RowHeight="48"
                                                          Style="{StaticResource ListGridStyle}"
                                                          ItemsSource="{Binding CustomerPurchasedItemRows}">
                                                    <DataGrid.Columns>
                                                        <DataGridTemplateColumn Header="Sản phẩm" Width="1.7*">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{Binding Sku}" Margin="0,3,0,0" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                        <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="ĐVT" Binding="{Binding UnitCode}" Width="75" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Tổng SL" Binding="{Binding TotalQuantity}" Width="95" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Doanh số" Binding="{Binding Revenue}" Width="130" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Số lần mua" Binding="{Binding PurchaseCount}" Width="95" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Giá mua gần nhất" Binding="{Binding LastUnitPrice}" Width="135" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Mua gần nhất" Binding="{Binding LastPurchaseAt}" Width="145" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                                <TextBlock HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding CustomerPurchasedEmptyText}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CustomerPurchasedItemRows.Count}" Value="0">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>

                                            <DockPanel Grid.Row="2" Margin="0,10,0,0" LastChildFill="False">
                                                <TextBlock Text="{Binding CustomerPurchasedPageText}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource OfficeMiniButtonStyle}" IsEnabled="{Binding CustomerPurchasedHasPrevious}" Click="PreviousCustomerPurchased_OnClick" Content="Trang trước" />
                                                    <Button Style="{StaticResource OfficeMiniButtonStyle}" IsEnabled="{Binding CustomerPurchasedHasNext}" Click="NextCustomerPurchased_OnClick" Content="Trang sau" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Grid>
                                    </TabItem>
                                    <TabItem Header="Đơn hàng">
                                        <Grid Margin="0,12,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,10">
                                                <DockPanel LastChildFill="False">
                                                    <StackPanel DockPanel.Dock="Left">
                                                        <TextBlock Text="Đơn hàng" FontSize="17" FontWeight="SemiBold" />
                                                        <TextBlock Text="Lịch sử đơn bán của đúng khách hàng, tải theo từng trang." Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </StackPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                        <TextBox Width="220" Margin="0,0,8,0" Padding="8,6"
                                                                 Text="{Binding CustomerOrderSearch, UpdateSourceTrigger=PropertyChanged}"
                                                                 ToolTip="Tìm số đơn" />
                                                        <Button Style="{StaticResource SecondaryButtonStyle}" Click="SearchCustomerOrders_OnClick" Content="Tìm" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                            <DataGrid Grid.Row="1" Style="{StaticResource ListGridStyle}" ItemsSource="{Binding CustomerOrderRows}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Số đơn" Binding="{Binding Number}" Width="130" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Ngày" Binding="{Binding Date}" Width="145" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Tổng tiền" Binding="{Binding Total}" Width="130" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Trạng thái" Binding="{Binding Status}" Width="115" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Thanh toán" Binding="{Binding Settlement}" Width="150" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Giao hàng" Binding="{Binding Delivery}" Width="145" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Còn phải thu" Binding="{Binding Receivable}" Width="130" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <DockPanel Grid.Row="2" Margin="0,10,0,0" LastChildFill="False">
                                                <TextBlock Text="{Binding CustomerOrderPageText}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <Button Style="{StaticResource OfficeMiniButtonStyle}" IsEnabled="{Binding CustomerOrderHasPrevious}" Click="PreviousCustomerOrders_OnClick" Content="Trang trước" />
                                                    <Button Style="{StaticResource OfficeMiniButtonStyle}" IsEnabled="{Binding CustomerOrderHasNext}" Click="NextCustomerOrders_OnClick" Content="Trang sau" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Grid>
                                    </TabItem>

                                    <TabItem Header="Công nợ &amp; thanh toán">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel Margin="0,12,0,0">
                                                <UniformGrid Columns="3" Margin="0,0,0,12">
                                                    <Border Style="{StaticResource PanelStyle}" Margin="0,0,5,0"><StackPanel><TextBlock Text="Công nợ hiện tại" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Text="{Binding CustomerOverviewReceivable}" FontSize="17" FontWeight="SemiBold" /></StackPanel></Border>
                                                    <Border Style="{StaticResource PanelStyle}" Margin="3,0"><StackPanel><TextBlock Text="Còn phải thu" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Text="{Binding CustomerOverviewOpenAmount}" FontSize="17" FontWeight="SemiBold" /></StackPanel></Border>
                                                    <Border Style="{StaticResource PanelStyle}" Margin="5,0,0,0"><StackPanel><TextBlock Text="Chứng từ còn mở" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Text="{Binding CustomerOverviewOpenDocuments}" FontSize="17" FontWeight="SemiBold" /></StackPanel></Border>
                                                </UniformGrid>

                                                <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,12">
                                                    <StackPanel>
                                                        <TextBlock Text="Chứng từ công nợ" FontSize="17" FontWeight="SemiBold" />
                                                        <DataGrid Margin="0,10,0,0" MaxHeight="260" Style="{StaticResource ListGridStyle}" ItemsSource="{Binding CustomerReceivableRows}">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Chứng từ" Binding="{Binding DocumentNumber}" Width="150" />
                                                                <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Ngày" Binding="{Binding Date}" Width="140" />
                                                                <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Giá trị" Binding="{Binding OriginalAmount}" Width="130" />
                                                                <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Đã thu / phân bổ" Binding="{Binding AllocatedAmount}" Width="140" />
                                                                <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Còn phải thu" Binding="{Binding RemainingAmount}" Width="130" />
                                                                <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Trạng thái" Binding="{Binding Status}" Width="*" />
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                        <DockPanel Margin="0,8,0,0" LastChildFill="False">
                                                            <TextBlock Text="{Binding CustomerReceivablePageText}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                                <Button Style="{StaticResource OfficeMiniButtonStyle}" IsEnabled="{Binding CustomerReceivableHasPrevious}" Click="PreviousCustomerReceivables_OnClick" Content="Trang trước" />
                                                                <Button Style="{StaticResource OfficeMiniButtonStyle}" IsEnabled="{Binding CustomerReceivableHasNext}" Click="NextCustomerReceivables_OnClick" Content="Trang sau" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </StackPanel>
                                                </Border>

                                                <Border Style="{StaticResource PanelStyle}">
                                                    <StackPanel>
                                                        <TextBlock Text="Lịch sử thu tiền" FontSize="17" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding CustomerPaymentAccessText}" Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                                        <DataGrid Margin="0,10,0,0" MaxHeight="260" Style="{StaticResource ListGridStyle}" ItemsSource="{Binding CustomerPaymentRows}">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Phiếu thu" Binding="{Binding DocumentNumber}" Width="135" />
                                                                <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Ngày thu" Binding="{Binding Date}" Width="140" />
                                                                <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Hình thức" Binding="{Binding Method}" Width="120" />
                                                                <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Số tiền" Binding="{Binding OriginalAmount}" Width="125" />
                                                                <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Đã phân bổ" Binding="{Binding AllocatedAmount}" Width="125" />
                                                                <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Chưa phân bổ" Binding="{Binding RemainingAmount}" Width="125" />
                                                                <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Trạng thái" Binding="{Binding Status}" Width="*" />
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                        <DockPanel Margin="0,8,0,0" LastChildFill="False">
                                                            <TextBlock Text="{Binding CustomerPaymentPageText}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                                <Button Style="{StaticResource OfficeMiniButtonStyle}" IsEnabled="{Binding CustomerPaymentHasPrevious}" Click="PreviousCustomerPayments_OnClick" Content="Trang trước" />
                                                                <Button Style="{StaticResource OfficeMiniButtonStyle}" IsEnabled="{Binding CustomerPaymentHasNext}" Click="NextCustomerPayments_OnClick" Content="Trang sau" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </TabItem>

                                    <TabItem Header="Giao hàng / Trả hàng">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel Margin="0,12,0,0">
                                                <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,12">
                                                    <StackPanel>
                                                        <TextBlock Text="Lịch sử giao hàng" FontSize="17" FontWeight="SemiBold" />
                                                        <DataGrid Margin="0,10,0,0" MaxHeight="280" Style="{StaticResource ListGridStyle}" ItemsSource="{Binding CustomerDeliveryRows}">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Chứng từ giao" Binding="{Binding Number}" Width="130" />
                                                                <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Đơn bán" Binding="{Binding SalesOrderNumber}" Width="130" />
                                                                <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Ngày" Binding="{Binding Date}" Width="140" />
                                                                <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Hình thức" Binding="{Binding HandoverMode}" Width="125" />
                                                                <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Trạng thái" Binding="{Binding Status}" Width="130" />
                                                                <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Kết quả giao" Binding="{Binding Result}" Width="*" />
                                                                <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Số dòng hàng" Binding="{Binding LineCount}" Width="95" />
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                                            <Button Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CustomerDeliveryHasPrevious}" Click="PreviousCustomerDeliveries_OnClick" Content="Trang trước" />
                                                            <Button Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CustomerDeliveryHasNext}" Click="NextCustomerDeliveries_OnClick" Content="Trang sau" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>

                                                <Border Style="{StaticResource PanelStyle}">
                                                    <StackPanel>
                                                        <TextBlock Text="Hàng khách trả" FontSize="17" FontWeight="SemiBold" />
                                                        <DataGrid Margin="0,10,0,0" MaxHeight="280" Style="{StaticResource ListGridStyle}" ItemsSource="{Binding CustomerReturnRows}">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Phiếu trả hàng" Binding="{Binding Number}" Width="130" />
                                                                <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Ngày" Binding="{Binding Date}" Width="140" />
                                                                <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Kho" Binding="{Binding Warehouse}" Width="150" />
                                                                <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Trạng thái" Binding="{Binding Status}" Width="130" />
                                                                <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Số dòng" Binding="{Binding LineCount}" Width="85" />
                                                                <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Đã nhận" Binding="{Binding AcceptedLineCount}" Width="85" />
                                                                <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Ghi chú" Binding="{Binding Note}" Width="*" />
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                                            <Button Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CustomerReturnHasPrevious}" Click="PreviousCustomerReturns_OnClick" Content="Trang trước" />
                                                            <Button Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CustomerReturnHasNext}" Click="NextCustomerReturns_OnClick" Content="Trang sau" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </TabItem>

                                    <TabItem Header="Thông tin &amp; địa chỉ">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel Margin="0,12,0,0">
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="0.8*" />
                                                        <ColumnDefinition Width="1.2*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Style="{StaticResource PanelStyle}" Margin="0,0,7,0">
                                                        <StackPanel>
                                                            <TextBlock Text="Thông tin khách hàng" FontSize="17" FontWeight="SemiBold" />
                                                            <UniformGrid Columns="2" Margin="0,10,0,0">
                                                                <StackPanel Margin="0,0,8,8"><TextBlock Text="Tên khách hàng" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Text="{Binding CustomerOverviewName}" FontWeight="SemiBold" TextWrapping="Wrap" /></StackPanel>
                                                                <StackPanel Margin="8,0,0,8"><TextBlock Text="Mã khách hàng" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Text="{Binding CustomerOverviewCode}" FontWeight="SemiBold" /></StackPanel>
                                                                <StackPanel Margin="0,0,8,8"><TextBlock Text="Nhóm khách hàng" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Text="{Binding CustomerOverviewGroup}" FontWeight="SemiBold" TextWrapping="Wrap" /></StackPanel>
                                                                <StackPanel Margin="8,0,0,8"><TextBlock Text="Nhân viên phụ trách" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Text="{Binding CustomerOverviewEmployee}" FontWeight="SemiBold" TextWrapping="Wrap" /></StackPanel>
                                                                <StackPanel Margin="0,0,8,8"><TextBlock Text="Điện thoại" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Text="{Binding CustomerOverviewPhone}" FontWeight="SemiBold" /></StackPanel>
                                                                <StackPanel Margin="8,0,0,8"><TextBlock Text="Email" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Text="{Binding CustomerOverviewEmail}" FontWeight="SemiBold" TextWrapping="Wrap" /></StackPanel>
                                                                <StackPanel Margin="0,0,8,8"><TextBlock Text="Mã số thuế" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Text="{Binding CustomerOverviewTaxCode}" FontWeight="SemiBold" /></StackPanel>
                                                                <StackPanel Margin="8,0,0,8"><TextBlock Text="Thời hạn thanh toán" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Text="{Binding CustomerOverviewPaymentTerms}" FontWeight="SemiBold" /></StackPanel>
                                                                <StackPanel Margin="0,0,8,8"><TextBlock Text="Hạn mức tín dụng" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Text="{Binding CustomerOverviewCreditLimit}" FontWeight="SemiBold" /></StackPanel>
                                                                <StackPanel Margin="8,0,0,8"><TextBlock Text="Trạng thái" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Text="{Binding CustomerOverviewStatus}" FontWeight="SemiBold" /></StackPanel>
                                                            </UniformGrid>
                                                            <TextBlock Margin="0,4,0,0" Text="Ghi chú" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            <TextBlock Text="{Binding CustomerOverviewNotes}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Column="1" Style="{StaticResource PanelStyle}" Margin="7,0,0,0">
                                                        <StackPanel>
                                                            <DockPanel LastChildFill="False">
                                                                <TextBlock Text="Địa chỉ" FontSize="17" FontWeight="SemiBold" DockPanel.Dock="Left" />
                                                                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding CanWriteCustomers}" Click="AddCustomerAddress_OnClick" Content="Thêm địa chỉ" />
                                                            </DockPanel>
                                                            <DataGrid Margin="0,10,0,0" MaxHeight="300" Style="{StaticResource ListGridStyle}" ItemsSource="{Binding CustomerAddressRows}">
                                                                <DataGrid.Columns>
                                                                    <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Nhãn" Binding="{Binding Label}" Width="115" />
                                                                    <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Người nhận" Binding="{Binding Recipient}" Width="125" />
                                                                    <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Địa chỉ" Binding="{Binding Address}" Width="*" />
                                                                    <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Điện thoại" Binding="{Binding Phone}" Width="115" />
                                                                    <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Mặc định" Binding="{Binding DefaultText}" Width="80" />
                                                                    <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Trạng thái" Binding="{Binding Status}" Width="105" />
                                                                    <DataGridTemplateColumn Header="Thao tác" Width="92">
                                                                <DataGridTemplateColumn.CellTemplate>
                                                                    <DataTemplate>
                                                                        <Button VerticalAlignment="Center" Style="{StaticResource OfficeRowActionButtonStyle}"
                                                                                Tag="{Binding Id}"
                                                                                Click="OpenCustomerAddressRowActions_OnClick"
                                                                                Content="Thao tác ▾">
                                                                            <Button.ContextMenu>
                                                                                <ContextMenu Style="{StaticResource OfficeRowContextMenuStyle}">
                                                                                    <MenuItem Style="{StaticResource OfficeRowMenuItemStyle}" Header="Sửa" CommandParameter="write" Click="EditCustomerAddress_OnClick" />
                                                                                    <MenuItem Style="{StaticResource OfficeRowMenuItemStyle}" Header="Đặt mặc định" CommandParameter="write"
                                                                                              Visibility="{Binding CanSetDefault, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                                              Click="SetDefaultCustomerAddress_OnClick" />
                                                                                    <MenuItem Style="{StaticResource OfficeRowMenuItemStyle}" Header="Mở định vị"
                                                                                              Visibility="{Binding HasLocation, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                                              Click="OpenCustomerAddressLocation_OnClick" />
                                                                                    <Separator />
                                                                                    <MenuItem Style="{StaticResource OfficeRowMenuItemStyle}" Header="{Binding ToggleAction}" CommandParameter="write" Click="ToggleCustomerAddress_OnClick" />
                                                                                </ContextMenu>
                                                                            </Button.ContextMenu>
                                                                        </Button>
                                                                    </DataTemplate>
                                                                </DataGridTemplateColumn.CellTemplate>
                                                            </DataGridTemplateColumn>
                                                                </DataGrid.Columns>
                                                            </DataGrid>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>

                                            </StackPanel>
                                        </ScrollViewer>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </TabItem>

                <TabItem Header="Nhà cung cấp"
                         Visibility="{Binding CanReadSuppliers, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource OfficeSummaryCardStyle}" Margin="0,0,6,0">
                                <DockPanel LastChildFill="False">
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="Tổng nhà cung cấp" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding SupplierTotal}"
                                               Margin="10,0,0,0"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource OfficeSummaryCardStyle}" Margin="6,0">
                                <DockPanel LastChildFill="False">
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="Đang hoạt động" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
