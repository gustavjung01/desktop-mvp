<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="WindowBackgroundColor">#0F1311</Color>
    <Color x:Key="SurfaceColor">#181E1B</Color>
    <Color x:Key="SurfaceMutedColor">#202723</Color>
    <Color x:Key="CardFrameColor">#35403A</Color>
    <Color x:Key="CardHeaderColor">#29312D</Color>
    <Color x:Key="CardBodyColor">#181E1B</Color>
    <Color x:Key="SecondaryButtonFaceColor">#202622</Color>
    <Color x:Key="RowHoverColor">#27322D</Color>
    <Color x:Key="InputBackgroundColor">#141916</Color>
    <Color x:Key="SidebarColor">#174A38</Color>
    <Color x:Key="SidebarHoverColor">#205A43</Color>
    <Color x:Key="SidebarActiveColor">#276C50</Color>
    <Color x:Key="SidebarActiveBorderColor">#73C5A0</Color>
    <Color x:Key="SidebarTextColor">#F4FBF7</Color>
    <Color x:Key="SidebarMutedTextColor">#9EC2AF</Color>
    <Color x:Key="TextPrimaryColor">#EEF3F0</Color>
    <Color x:Key="TextSecondaryColor">#A7B2AC</Color>
    <Color x:Key="BorderColor">#35403A</Color>
    <Color x:Key="AccentColor">#63C59F</Color>
    <Color x:Key="AccentSoftColor">#1A3B31</Color>
    <Color x:Key="AccentTextColor">#0D241C</Color>
    <Color x:Key="ButtonDepthColor">#3B8E70</Color>
    <Color x:Key="SecondaryButtonDepthColor">#4A5750</Color>
    <Color x:Key="ScrollThumbColor">#5F6B65</Color>
    <Color x:Key="SuccessColor">#68CFA3</Color>
    <Color x:Key="WarningColor">#E7BE62</Color>
    <Color x:Key="DangerColor">#EF858A</Color>
    <Color x:Key="DangerDepthColor">#A94C50</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="{StaticResource SurfaceMutedColor}" />
    <SolidColorBrush x:Key="CardFrameBrush" Color="{StaticResource CardFrameColor}" />
    <SolidColorBrush x:Key="CardHeaderBrush" Color="{StaticResource CardHeaderColor}" />
    <SolidColorBrush x:Key="CardBodyBrush" Color="{StaticResource CardBodyColor}" />
    <SolidColorBrush x:Key="SecondaryButtonFaceBrush" Color="{StaticResource SecondaryButtonFaceColor}" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="{StaticResource RowHoverColor}" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="{StaticResource SidebarHoverColor}" />
    <SolidColorBrush x:Key="SidebarActiveBrush" Color="{StaticResource SidebarActiveColor}" />
    <SolidColorBrush x:Key="SidebarActiveBorderBrush" Color="{StaticResource SidebarActiveBorderColor}" />
    <SolidColorBrush x:Key="SidebarTextBrush" Color="{StaticResource SidebarTextColor}" />
    <SolidColorBrush x:Key="SidebarMutedTextBrush" Color="{StaticResource SidebarMutedTextColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />
    <SolidColorBrush x:Key="ButtonDepthBrush" Color="{StaticResource ButtonDepthColor}" />
    <SolidColorBrush x:Key="SecondaryButtonDepthBrush" Color="{StaticResource SecondaryButtonDepthColor}" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="{StaticResource ScrollThumbColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerDepthBrush" Color="{StaticResource DangerDepthColor}" />
</ResourceDictionary>
