<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="WindowBackgroundColor">#E9EDF0</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceMutedColor">#EEF1F2</Color>
    <Color x:Key="CardFrameColor">#D5DBDE</Color>
    <Color x:Key="CardHeaderColor">#E2E6E8</Color>
    <Color x:Key="CardBodyColor">#FFFFFF</Color>
    <Color x:Key="SecondaryButtonFaceColor">#FAFBFB</Color>
    <Color x:Key="RowHoverColor">#EDF4F1</Color>
    <Color x:Key="InputBackgroundColor">#FFFFFF</Color>
    <Color x:Key="SidebarColor">#B81F6047</Color>
    <Color x:Key="SidebarHoverColor">#C92A7254</Color>
    <Color x:Key="SidebarActiveColor">#D12F865F</Color>
    <Color x:Key="SidebarActiveBorderColor">#B88BD8B3</Color>
    <Color x:Key="SidebarTextColor">#F4FBF7</Color>
    <Color x:Key="SidebarMutedTextColor">#BFD8CB</Color>
    <Color x:Key="TextPrimaryColor">#202522</Color>
    <Color x:Key="TextSecondaryColor">#66706B</Color>
    <Color x:Key="BorderColor">#C8D0D3</Color>
    <Color x:Key="AccentColor">#1D7A5C</Color>
    <Color x:Key="AccentSoftColor">#E6F4EF</Color>
    <Color x:Key="AccentTextColor">#FFFFFF</Color>
    <Color x:Key="ButtonDepthColor">#155B45</Color>
    <Color x:Key="SecondaryButtonDepthColor">#AEB9BD</Color>
    <Color x:Key="ScrollThumbColor">#AEB9B4</Color>
    <Color x:Key="SuccessColor">#197A50</Color>
    <Color x:Key="WarningColor">#9B6A00</Color>
    <Color x:Key="DangerColor">#B63C43</Color>
    <Color x:Key="DangerDepthColor">#8E3036</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="{StaticResource SurfaceMutedColor}" />
    <SolidColorBrush x:Key="CardFrameBrush" Color="{StaticResource CardFrameColor}" />
    <SolidColorBrush x:Key="CardHeaderBrush" Color="{StaticResource CardHeaderColor}" />
    <SolidColorBrush x:Key="CardBodyBrush" Color="{StaticResource CardBodyColor}" />
    <SolidColorBrush x:Key="SecondaryButtonFaceBrush" Color="{StaticResource SecondaryButtonFaceColor}" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="{StaticResource RowHoverColor}" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="{StaticResource SidebarHoverColor}" />
    <SolidColorBrush x:Key="SidebarActiveBrush" Color="{StaticResource SidebarActiveColor}" />
    <SolidColorBrush x:Key="SidebarActiveBorderBrush" Color="{StaticResource SidebarActiveBorderColor}" />
    <SolidColorBrush x:Key="SidebarTextBrush" Color="{StaticResource SidebarTextColor}" />
    <SolidColorBrush x:Key="SidebarMutedTextBrush" Color="{StaticResource SidebarMutedTextColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />
    <SolidColorBrush x:Key="ButtonDepthBrush" Color="{StaticResource ButtonDepthColor}" />
    <SolidColorBrush x:Key="SecondaryButtonDepthBrush" Color="{StaticResource SecondaryButtonDepthColor}" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="{StaticResource ScrollThumbColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerDepthBrush" Color="{StaticResource DangerDepthColor}" />
</ResourceDictionary>
