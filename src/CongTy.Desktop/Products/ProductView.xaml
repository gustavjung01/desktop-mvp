<UserControl x:Class="CongTy.Desktop.Products.ProductView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:products="clr-namespace:CongTy.Desktop.Products"
             MinWidth="720"
             MinHeight="520">
    <Grid Margin="16">
        <TabControl x:Name="ProductTabs"
                    Style="{StaticResource OfficeTabControlStyle}"
                    SelectedIndex="{Binding TabIndex, Mode=TwoWay}">
            <TabItem Header="Sản phẩm">
                <products:ProductCatalogView />
            </TabItem>
            <TabItem Header="Thiết lập nhanh">
                <products:ProductQuickSetupView />
            </TabItem>
            <TabItem Header="Cập nhật SP">
                <products:ProductBulkUpdateView />
            </TabItem>
            <TabItem Header="Loại sản phẩm">
                <products:ProductCategoryView />
            </TabItem>
            <TabItem Header="Nhãn hàng">
                <products:ProductBrandView />
            </TabItem>
            <TabItem Header="Đơn vị và quy đổi">
                <products:ProductUnitWorkspaceView />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
