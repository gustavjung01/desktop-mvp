<UserControl x:Class="CongTy.Desktop.Products.ProductCategoryView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/></UserControl.Resources>
 <Grid Margin="0,10,0,0">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="Loại sản phẩm" FontSize="18" FontWeight="SemiBold"/><TextBlock Margin="0,3,0,0" Text="Phân nhóm sản phẩm để quản lý và hỗ trợ tra cứu." Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
   <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource OfficeSecondaryButtonStyle}" Click="Refresh_OnClick" Content="Làm mới"/>
   <Button Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource OfficePrimaryButtonStyle}" IsEnabled="{Binding CanWrite}" Click="Add_OnClick" Content="Thêm loại"/>
  </Grid>
  <DataGrid Grid.Row="1" Margin="0,10,0,0" Style="{StaticResource OfficeDataGridStyle}" ItemsSource="{Binding CategoryRows}" AutoGenerateColumns="False" IsReadOnly="True">
   <DataGrid.Columns>
    <DataGridTextColumn Header="STT" Binding="{Binding Stt}" Width="54"/><DataGridTextColumn Header="Mã" Binding="{Binding Code}" Width="110"/><DataGridTextColumn Header="Tên" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Loại cha" Binding="{Binding Parent}" Width="150"/><DataGridTextColumn Header="Thứ tự" Binding="{Binding SortOrder}" Width="80"/><DataGridTextColumn Header="Hiển thị bán hàng" Binding="{Binding Catalog}" Width="125"/><DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="115"/>
    <DataGridTemplateColumn Header="Thao tác" Width="190"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Style="{StaticResource OfficeMiniButtonStyle}" Tag="{Binding Id}" Click="Edit_OnClick" Content="Sửa"/><Button Style="{StaticResource OfficeMiniButtonStyle}" Tag="{Binding Id}" Click="Toggle_OnClick" Content="{Binding ToggleAction}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
   </DataGrid.Columns>
  </DataGrid>
  <Border Grid.Row="2" Margin="0,10,0,0" Style="{StaticResource OfficeCardStyle}" Visibility="{Binding IsCategoryEditor, Converter={StaticResource BooleanToVisibilityConverter}}">
   <StackPanel>
    <TextBlock Text="{Binding EditorTitle}" FontSize="16" FontWeight="SemiBold"/>
    <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,4,0"><TextBlock Text="Mã loại"/><TextBox Margin="0,4,0,0" Style="{StaticResource OfficeTextBoxStyle}" IsEnabled="{Binding IsCreateMode}" Text="{Binding DraftCode}"/></StackPanel>
     <StackPanel Grid.Column="1" Margin="4,0"><TextBlock Text="Tên loại"/><TextBox Margin="0,4,0,0" Style="{StaticResource OfficeTextBoxStyle}" Text="{Binding DraftName}"/></StackPanel>
     <StackPanel Grid.Column="2" Margin="4,0,0,0"><TextBlock Text="Loại cha"/><ComboBox Margin="0,4,0,0" Style="{StaticResource OfficeComboBoxStyle}" ItemsSource="{Binding CategoryOptions}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding DraftParentCategoryId}"/></StackPanel>
    </Grid>
    <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="Thứ tự"/><TextBox Margin="0,4,0,0" Style="{StaticResource OfficeTextBoxStyle}" Text="{Binding DraftSortOrder}"/></StackPanel>
     <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Mô tả"/><TextBox Margin="0,4,0,0" Style="{StaticResource OfficeTextBoxStyle}" Text="{Binding DraftDescription}"/></StackPanel>
    </Grid>
    <WrapPanel Margin="0,8,0,0"><CheckBox Margin="0,0,14,0" Content="Hiển thị bán hàng" IsChecked="{Binding DraftCatalogVisible}"/><CheckBox Content="Đang sử dụng" IsChecked="{Binding DraftActive}"/></WrapPanel>
    <StackPanel Margin="0,8,0,0" Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource OfficeSecondaryButtonStyle}" Click="Cancel_OnClick" Content="Hủy"/><Button Margin="8,0,0,0" Style="{StaticResource OfficePrimaryButtonStyle}" Click="Save_OnClick" Content="{Binding EditorPrimaryText}"/></StackPanel>
   </StackPanel>
  </Border>
 </Grid>
</UserControl>
