<UserControl x:Class="CongTy.Desktop.Inventory.InventoryTrackingPolicyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             Loaded="InventoryTrackingPolicyView_OnLoaded"
             PreviewKeyDown="InventoryTrackingPolicyView_OnPreviewKeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="PolicyRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource OfficeDataGridRowStyle}">
            <Setter Property="Height" Value="Auto" />
            <Setter Property="MinHeight" Value="44" />
        </Style>
        <Style x:Key="PolicyCellTextStyle" TargetType="TextBlock" BasedOn="{StaticResource OfficeGridTextStyle}">
            <Setter Property="Padding" Value="0,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16">
            <Border Style="{StaticResource OfficeCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBox x:Name="SearchBox"
                                 Width="470"
                                 HorizontalAlignment="Left"
                                 Style="{StaticResource OfficeTextBoxStyle}"
                                 Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Tìm SKU bất kỳ, SKU tồn chuẩn hoặc tên hàng" />
                        <TextBlock Margin="0,4,0,0"
                                   Text="Tìm SKU bất kỳ, SKU tồn chuẩn hoặc tên hàng"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Style="{StaticResource OfficePrimaryButtonStyle}"
                            IsEnabled="{Binding IsNotBusy}"
                            Click="Refresh_OnClick"
                            Content="{Binding RefreshText}" />
                </Grid>
            </Border>

            <Border Margin="0,10,0,0" Padding="10">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource OfficeCardStyle}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Message}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                    <Setter Property="Foreground" Value="#B91C1C" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.7*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource OfficeCardStyle}">
                    <StackPanel>
                        <TextBlock Text="SKU tồn chuẩn và chính sách"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <DataGrid Margin="0,10,0,0"
                                  ItemsSource="{Binding Rows}"
                                  Style="{StaticResource OfficeDataGridStyle}"
                                  RowStyle="{StaticResource PolicyRowStyle}"
                                  IsReadOnly="True"
                                  MaxHeight="650">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="STT"
                                                    Binding="{Binding Sequence}"
                                                    Width="52"
                                                    ElementStyle="{StaticResource PolicyCellTextStyle}" />
                                <DataGridTemplateColumn Header="SKU tồn chuẩn" Width="1.4*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,3">
                                                <TextBlock Text="{Binding Sku}" FontWeight="SemiBold" />
                                                <TextBlock Margin="0,2,0,0"
                                                           Text="{Binding Product}"
                                                           FontSize="10.5"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Trạng thái"
                                                    Binding="{Binding SetupStatus}"
                                                    Width="110"
                                                    ElementStyle="{StaticResource PolicyCellTextStyle}" />
                                <DataGridTextColumn Header="Lô"
                                                    Binding="{Binding Lot}"
                                                    Width="1.15*"
                                                    ElementStyle="{StaticResource PolicyCellTextStyle}" />
                                <DataGridTextColumn Header="Hạn dùng"
                                                    Binding="{Binding Expiry}"
                                                    Width="1.15*"
                                                    ElementStyle="{StaticResource PolicyCellTextStyle}" />
                                <DataGridTemplateColumn Header="" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource OfficeMiniButtonStyle}"
                                                    Click="Choose_OnClick"
                                                    Content="{Binding ActionText}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Margin="0,10,0,0"
                                   Text="Không có SKU tồn chuẩn phù hợp."
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource OfficeCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Thiết lập quản lý lô và hạn dùng"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,5,0,0"
                                   Text="Vị trí được quản lý tại Cơ cấu Công Ty → Kho hàng. Chính sách ở đây chỉ quyết định lô và hạn sử dụng cho SKU tồn chuẩn."
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />

                        <TextBlock Margin="0,14,0,4" Text="SKU tồn chuẩn" FontWeight="SemiBold" />
                        <ComboBox Style="{StaticResource OfficeComboBoxStyle}"
                                  ItemsSource="{Binding CandidateOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedBaseVariantId, Mode=TwoWay}" />

                        <TextBlock Margin="0,8,0,0"
                                   Text="{Binding SelectedProduct}"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,3,0,0"
                                   Text="{Binding CurrentSetupStatus}"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />

                        <TextBlock Margin="0,14,0,4" Text="Quản lý lô" FontWeight="SemiBold" />
                        <ComboBox Style="{StaticResource OfficeComboBoxStyle}"
                                  IsEnabled="{Binding CanEditPolicy}"
                                  ItemsSource="{Binding LotModeOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding LotTrackingMode, Mode=TwoWay}" />

                        <TextBlock Margin="0,14,0,4" Text="Hạn sử dụng" FontWeight="SemiBold" />
                        <ComboBox Style="{StaticResource OfficeComboBoxStyle}"
                                  IsEnabled="{Binding CanEditExpiry}"
                                  ItemsSource="{Binding ExpiryModeOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding ExpiryTrackingMode, Mode=TwoWay}" />

                        <Button Margin="0,18,0,0"
                                HorizontalAlignment="Left"
                                Style="{StaticResource OfficePrimaryButtonStyle}"
                                IsEnabled="{Binding CanSave}"
                                Click="Save_OnClick"
                                Content="{Binding SaveText}" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
