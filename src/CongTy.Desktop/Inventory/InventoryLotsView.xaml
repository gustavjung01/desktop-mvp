<UserControl x:Class="CongTy.Desktop.Inventory.InventoryLotsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             Loaded="InventoryLotsView_OnLoaded"
             PreviewKeyDown="InventoryLotsView_OnPreviewKeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="LotsRowStyle"
               TargetType="DataGridRow"
               BasedOn="{StaticResource OfficeDataGridRowStyle}">
            <Setter Property="Height" Value="Auto" />
            <Setter Property="MinHeight" Value="44" />
        </Style>
        <Style x:Key="LotsCellTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource OfficeGridTextStyle}">
            <Setter Property="Padding" Value="0,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16">
            <Border Style="{StaticResource OfficeCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SearchBox"
                             Width="470"
                             HorizontalAlignment="Left"
                             Style="{StaticResource OfficeTextBoxStyle}"
                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Tìm theo SKU, mã lô hoặc hạn dùng" />

                    <Button Grid.Column="1"
                            Style="{StaticResource OfficePrimaryButtonStyle}"
                            IsEnabled="{Binding IsNotBusy}"
                            Click="Refresh_OnClick"
                            Content="{Binding RefreshText}" />
                </Grid>
            </Border>

            <Border Margin="0,10,0,0"
                    Padding="10">
                <Border.Style>
                    <Style TargetType="Border"
                           BasedOn="{StaticResource OfficeCardStyle}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Message}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <TextBlock Text="{Binding Message}"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource TextSecondaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MessageIsError}"
                                             Value="True">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource DangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <Border Margin="0,10,0,0"
                    Style="{StaticResource OfficeCardStyle}">
                <StackPanel>
                    <DataGrid ItemsSource="{Binding Rows}"
                              Style="{StaticResource OfficeDataGridStyle}"
                              RowStyle="{StaticResource LotsRowStyle}"
                              IsReadOnly="True"
                              MaxHeight="680">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STT"
                                                Binding="{Binding Sequence}"
                                                Width="52"
                                                ElementStyle="{StaticResource LotsCellTextStyle}" />

                            <DataGridTemplateColumn Header="SKU"
                                                    Width="1.65*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,3">
                                            <TextBlock Text="{Binding Sku}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Margin="0,2,0,0"
                                                       Text="{Binding Product}"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Lô"
                                                    Width="1.2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,3">
                                            <TextBlock Text="{Binding LotCode}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Margin="0,2,0,0"
                                                       Text="{Binding NormalizedLotCode}"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Hạn dùng"
                                                Binding="{Binding ExpiryDate}"
                                                Width="115"
                                                ElementStyle="{StaticResource LotsCellTextStyle}" />

                            <DataGridTextColumn Header="Ngày SX"
                                                Binding="{Binding ManufacturedDate}"
                                                Width="115"
                                                ElementStyle="{StaticResource LotsCellTextStyle}" />

                            <DataGridTextColumn Header="Tham chiếu nhà cung cấp"
                                                Binding="{Binding SupplierReference}"
                                                Width="1.4*"
                                                ElementStyle="{StaticResource LotsCellTextStyle}" />

                            <DataGridTextColumn Header="Tạo lúc"
                                                Binding="{Binding CreatedAt}"
                                                Width="145"
                                                ElementStyle="{StaticResource LotsCellTextStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Margin="0,10,0,0"
                               HorizontalAlignment="Center"
                               Text="Chưa có lô hàng nào."
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Visibility="{Binding HasNoRows, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
