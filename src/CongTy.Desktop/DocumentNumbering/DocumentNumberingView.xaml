<UserControl x:Class="CongTy.Desktop.DocumentNumbering.DocumentNumberingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="760" MinHeight="560"
             Loaded="DocumentNumberingView_OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid Margin="16">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource OfficeCardHeaderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Thiết lập quy tắc" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Margin="0,3,0,0" Text="Quy tắc đánh số dùng chung" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Margin="0,5,0,0" Text="Mỗi loại chứng từ chỉ có một quy tắc đang sử dụng. Hệ thống tự liên kết cấu hình cần thiết." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource OfficePrimaryButtonStyle}"
                                IsEnabled="{Binding CanWrite}" Click="Create_OnClick" Content="Thêm quy tắc"/>
                    </Grid>
                </Border>

                <Border Margin="0,8,0,0" Style="{StaticResource OfficeCardBodyStyle}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="240"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource OfficeTextBoxStyle}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Tìm loại chứng từ hoặc tên quy tắc"/>
                            <ComboBox Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource OfficeComboBoxStyle}"
                                      ItemsSource="{Binding StatusFilters}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding ActiveFilter, Mode=TwoWay}"/>
                            <Button Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource OfficeSecondaryButtonStyle}"
                                    IsEnabled="{Binding IsNotBusy}" Click="Refresh_OnClick" Content="Cập nhật danh sách"/>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <DataGrid x:Name="SeriesGrid" Height="280" Style="{StaticResource OfficeDataGridStyle}" ItemsSource="{Binding Series}">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource OfficeDataGridRowStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource CardHeaderBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Quy tắc" Binding="{Binding RuleAndType}" Width="220"/>
                                    <DataGridTextColumn Header="Cấu trúc số" Binding="{Binding TemplateState}" Width="*"/>
                                    <DataGridTextColumn Header="Chu kỳ" Binding="{Binding ResetPolicy}" Width="150"/>
                                    <DataGridTextColumn Header="Số đã cấp" Binding="{Binding AllocationCount}" Width="90"/>
                                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="120"/>
                                    <DataGridTemplateColumn Header="" Width="290">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Style="{StaticResource OfficeMiniButtonStyle}" Click="Detail_OnClick" Content="Chi tiết"/>
                                                    <Button Style="{StaticResource OfficeMiniButtonStyle}" IsEnabled="{Binding DataContext.CanWrite, RelativeSource={RelativeSource AncestorType=UserControl}}" Click="Edit_OnClick" Content="Sửa"/>
                                                    <Button Style="{StaticResource OfficeMiniButtonStyle}" IsEnabled="{Binding DataContext.CanWrite, RelativeSource={RelativeSource AncestorType=UserControl}}" Click="Toggle_OnClick" Content="{Binding ToggleAction}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="Chưa có quy tắc phù hợp" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Visibility="{Binding NoSeries, Converter={StaticResource BoolToVisibility}}"/>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Margin="0,8,0,0" Visibility="{Binding HasSelected, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="0.65*"/></Grid.ColumnDefinitions>
                    <Border Margin="0,0,4,0" Style="{StaticResource OfficeCardBodyStyle}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Cấp số tham chiếu" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Margin="0,3,0,0" Text="{Binding SelectedName}" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Margin="0,2,0,0" Text="{Binding SelectedDocumentType}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedStatus}" VerticalAlignment="Top" FontWeight="SemiBold"/>
                            </Grid>

                            <Border Margin="0,12,0,0" Padding="10" Style="{StaticResource OfficeCardHeaderStyle}">
                                <TextBlock Text="Thao tác này cấp một số thật để kiểm tra quy tắc trước khi áp dụng. Số đã cấp được lưu trong lịch sử nhưng không tạo đơn hàng, phiếu kho, hóa đơn hoặc bút toán."
                                           TextWrapping="Wrap"/>
                            </Border>

                            <TextBlock Margin="0,12,0,0" Text="Ngày chứng từ" FontWeight="SemiBold"/>
                            <TextBox Width="220" HorizontalAlignment="Left" Margin="0,4,0,0" Style="{StaticResource OfficeTextBoxStyle}"
                                     Text="{Binding DocumentDate, UpdateSourceTrigger=PropertyChanged}" ToolTip="Định dạng yyyy-MM-dd"/>
                            <Button Width="180" HorizontalAlignment="Left" Margin="0,10,0,0" Style="{StaticResource OfficePrimaryButtonStyle}"
                                    IsEnabled="{Binding CanAllocate}" Click="Allocate_OnClick" Content="Cấp số tham chiếu"/>

                            <Border Margin="0,12,0,0" Style="{StaticResource OfficeSummaryCardStyle}"
                                    Visibility="{Binding HasLastAllocation, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding LastAllocationCaption}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Margin="0,4,0,0" Text="{Binding LastAllocationNumber}" FontSize="20" FontWeight="SemiBold"/>
                                    <TextBlock Margin="0,3,0,0" Text="{Binding LastAllocationDetail}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Margin="4,0,0,0" Style="{StaticResource OfficeCardBodyStyle}">
                        <StackPanel>
                            <TextBlock Text="Tiến độ đánh số" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Margin="0,3,0,8" Text="Số tiếp theo theo từng kỳ" FontSize="16" FontWeight="SemiBold"/>
                            <ItemsControl ItemsSource="{Binding Counters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6" Style="{StaticResource OfficeSummaryCardStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding PeriodKey}" FontWeight="SemiBold"/>
                                                    <TextBlock Margin="0,2,0,0" Text="Số tiếp theo" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding NextCounter}" FontSize="17" FontWeight="SemiBold"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="0,8,0,0" Text="Chưa phát sinh số trong kỳ nào." TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Visibility="{Binding NoCounters, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Margin="0,8,0,0" Style="{StaticResource OfficeCardBodyStyle}"
                        Visibility="{Binding HasSelected, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Lịch sử cấp số" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Margin="0,3,0,0" Text="Các số đã cấp" FontSize="16" FontWeight="SemiBold"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource OfficeSecondaryButtonStyle}" IsEnabled="{Binding IsNotBusy}"
                                    Click="RefreshHistory_OnClick" Content="Cập nhật lịch sử"/>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <DataGrid Height="260" Style="{StaticResource OfficeDataGridStyle}" ItemsSource="{Binding Allocations}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Số chứng từ" Binding="{Binding DocumentNumber}" Width="*"/>
                                    <DataGridTextColumn Header="Ngày chứng từ" Binding="{Binding DocumentDate}" Width="140"/>
                                    <DataGridTextColumn Header="Kỳ" Binding="{Binding PeriodKey}" Width="120"/>
                                    <DataGridTextColumn Header="Số thứ tự" Binding="{Binding CounterValue}" Width="110"/>
                                    <DataGridTextColumn Header="Thời điểm cấp" Binding="{Binding AllocatedAt}" Width="170"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="Chưa có số nào được cấp" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Visibility="{Binding NoAllocations, Converter={StaticResource BoolToVisibility}}"/>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Panel.ZIndex="100" Background="Transparent" Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Background="{DynamicResource TextPrimaryBrush}" Opacity="0.28"/>
            <Border Width="720" MaxHeight="580" Padding="16" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource OfficeCardBodyStyle}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding EditorTitle}" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,4,0,0" Text="{Binding EditorDescription}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Margin="0,8,0,0" Text="Cấu trúc số đã được cố định vì quy tắc này đã có lịch sử cấp số."
                                   TextWrapping="Wrap" FontWeight="SemiBold"
                                   Visibility="{Binding IsFormatLocked, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" Margin="0,14,0,12" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Margin="0,0,6,10">
                                <TextBlock Text="Loại chứng từ"/>
                                <ComboBox Margin="0,4,0,0" Style="{StaticResource OfficeComboBoxStyle}" IsEnabled="{Binding DocumentTypeEnabled}"
                                          ItemsSource="{Binding DocumentTypes}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding FormDocumentType, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,10">
                                <TextBlock Text="Tên quy tắc"/>
                                <TextBox Margin="0,4,0,0" Style="{StaticResource OfficeTextBoxStyle}" Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Margin="0,0,6,10">
                                <TextBlock Text="Ký hiệu đầu số"/>
                                <TextBox Margin="0,4,0,0" Style="{StaticResource OfficeTextBoxStyle}" IsEnabled="{Binding FormatFieldsEnabled}"
                                         Text="{Binding FormPrefix, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="6,0,0,10">
                                <TextBlock Text="Chu kỳ đánh lại số"/>
                                <ComboBox Margin="0,4,0,0" Style="{StaticResource OfficeComboBoxStyle}" IsEnabled="{Binding FormatFieldsEnabled}"
                                          ItemsSource="{Binding ResetPolicies}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding FormResetPolicy, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
                                <TextBlock Text="Cấu trúc số"/>
                                <TextBox Margin="0,4,0,0" Style="{StaticResource OfficeTextBoxStyle}" IsEnabled="{Binding FormatFieldsEnabled}"
                                         Text="{Binding FormTemplate, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Margin="0,4,0,0" Text="Thành phần có thể dùng: {PREFIX} {YYYY} {YY} {MM} {SEQ}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource OfficeSecondaryButtonStyle}" IsEnabled="{Binding IsNotBusy}" Click="EditorCancel_OnClick" Content="Hủy"/>
                        <Button Margin="8,0,0,0" Style="{StaticResource OfficePrimaryButtonStyle}" IsEnabled="{Binding CanSaveEditor}" Click="EditorSave_OnClick" Content="Lưu quy tắc"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
