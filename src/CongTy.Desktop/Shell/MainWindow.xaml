<Window x:Class="CongTy.Desktop.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Công Ty Desktop"
        Width="1280"
        Height="800"
        MinWidth="1024"
        MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid Visibility="{Binding IsSetup, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="620"
                    Padding="34"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <StackPanel>
                    <TextBlock Text="Thiết lập kết nối Công Ty"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Margin="0,8,0,24"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Nhập thông tin cài đặt dùng trên máy tính này. Ứng dụng chỉ chấp nhận kết nối HTTPS và không yêu cầu mật khẩu cơ sở dữ liệu." />

                    <TextBlock Text="Tên cấu hình cài đặt" FontWeight="SemiBold" />
                    <TextBox Margin="0,6,0,16"
                             Padding="10,8"
                             Text="{Binding SetupInstallationName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Tên Công Ty hiển thị" FontWeight="SemiBold" />
                    <TextBox Margin="0,6,0,16"
                             Padding="10,8"
                             Text="{Binding SetupCompanyName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Địa chỉ hệ thống (HTTPS)" FontWeight="SemiBold" />
                    <TextBox Margin="0,6,0,12"
                             Padding="10,8"
                             Text="{Binding SetupApiUrl, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock MinHeight="22"
                               Text="{Binding SetupMessage}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" />

                    <Button Margin="0,20,0,0"
                            Padding="16,9"
                            HorizontalAlignment="Right"
                            IsEnabled="{Binding IsNotBusy}"
                            Click="SetupSave_OnClick"
                            Content="Kiểm tra và lưu" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Visibility="{Binding IsLogin, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="520"
                    Padding="34"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <StackPanel>
                    <TextBlock Text="{Binding CompanyName}"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Margin="0,5,0,24"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Đăng nhập hệ thống Công Ty" />

                    <TextBlock Text="Tên đăng nhập hoặc email quản trị" FontWeight="SemiBold" />
                    <TextBox Margin="0,6,0,16"
                             Padding="10,8"
                             Text="{Binding LoginName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Mật khẩu" FontWeight="SemiBold" />
                    <PasswordBox x:Name="LoginPassword"
                                 Margin="0,6,0,16"
                                 Padding="10,8" />

                    <StackPanel Visibility="{Binding IsOwnerCodeRequired, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Mã xác minh" FontWeight="SemiBold" />
                        <TextBox Margin="0,6,0,16"
                                 Padding="10,8"
                                 MaxLength="16"
                                 Text="{Binding OwnerCode, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <TextBlock MinHeight="42"
                               Text="{Binding LoginMessage}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" />

                    <Button Margin="0,12,0,0"
                            Padding="16,10"
                            IsEnabled="{Binding IsNotBusy}"
                            Click="Login_OnClick"
                            Content="Đăng nhập" />

                    <StackPanel Margin="0,12,0,0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <Button Margin="0,0,8,0"
                                Padding="12,7"
                                IsEnabled="{Binding IsNotBusy}"
                                Click="RetrySession_OnClick"
                                Content="Kiểm tra phiên hiện tại" />
                        <Button Padding="12,7"
                                IsEnabled="{Binding IsNotBusy}"
                                Click="OpenSetup_OnClick"
                                Content="Đổi cấu hình kết nối" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Visibility="{Binding IsWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding SidebarWidth}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource SidebarActiveBorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="78" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="58" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="46" Height="46" CornerRadius="12" Background="White" BorderBrush="#28FFFFFF" BorderThickness="1" VerticalAlignment="Center">
                            <Image Source="https://retail.nguyenlieuhungphat.com/logo-transparent.png" Stretch="Uniform" Margin="3" SnapsToDevicePixels="True" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="8,0,6,0" VerticalAlignment="Center" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding CompanyName}" Foreground="{DynamicResource SidebarTextBrush}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="CÔNG TY" Margin="0,2,0,0" Foreground="{DynamicResource SidebarMutedTextBrush}" FontSize="10" FontWeight="SemiBold" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource SidebarIconButtonStyle}" Click="ToggleSidebar_OnClick" ToolTip="Thu gọn / mở rộng thanh điều hướng" Content="☰" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource NavSectionLabelStyle}" Text="ĐIỀU HÀNH" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Style="{StaticResource NavButtonStyle}" Tag="{Binding IsHomeSelected}" Click="Home_OnClick">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="▦" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="Tổng quan điều hành" FontWeight="SemiBold" />
                                        <TextBlock Text="Thông tin tổng hợp phục vụ điều hành" Style="{StaticResource NavHintTextStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <TextBlock Style="{StaticResource NavSectionLabelStyle}" Text="DANH MỤC QUẢN LÝ" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Style="{StaticResource NavButtonStyle}" Tag="{Binding IsCatalogGroupSelected}" CommandParameter="catalog" Click="NavGroup_OnClick">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="▦" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="Danh mục nghiệp vụ" FontWeight="SemiBold" />
                                        <TextBlock Text="Tổ chức, đối tác, hàng hóa, giá và chứng từ" Style="{StaticResource NavHintTextStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding CatalogChevron}" Style="{StaticResource NavChevronTextStyle}" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                            </Button>
                            <StackPanel Margin="22,2,8,7" Visibility="{Binding IsCatalogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Button Style="{StaticResource NavSubItemStyle}"
                                        Tag="{Binding IsCatalogOverviewSelected}"
                                        Visibility="{Binding CanViewInternalOrganization, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Click="CatalogOverview_OnClick"><TextBlock Text="Tổng quan cơ cấu" /></Button>
                                <Button Style="{StaticResource NavSubItemStyle}" Tag="{Binding IsCatalogBranchesSelected}" Visibility="{Binding CanViewInternalOrganization, Converter={StaticResource BooleanToVisibilityConverter}}" Click="CatalogBranches_OnClick"><TextBlock Text="Chi nhánh" /></Button>
                                <Button Style="{StaticResource NavSubItemStyle}" Tag="{Binding IsCatalogWarehousesSelected}" Visibility="{Binding CanViewInternalOrganization, Converter={StaticResource BooleanToVisibilityConverter}}" Click="CatalogWarehouses_OnClick"><TextBlock Text="Kho hàng" /></Button>
                                <Button Style="{StaticResource NavSubItemStyle}" Tag="{Binding IsCatalogCustomersSelected}" Visibility="{Binding CanViewPartners, Converter={StaticResource BooleanToVisibilityConverter}}" Click="CatalogCustomers_OnClick"><TextBlock Text="Khách hàng" /></Button>
                                <Button Style="{StaticResource NavSubItemStyle}" Tag="{Binding IsCatalogSuppliersSelected}" Visibility="{Binding CanViewPartners, Converter={StaticResource BooleanToVisibilityConverter}}" Click="CatalogSuppliers_OnClick"><TextBlock Text="Nhà cung cấp" /></Button>
                                <Button Style="{StaticResource NavSubItemStyle}" Tag="{Binding IsCatalogProductsSelected}" Visibility="{Binding CanViewProducts, Converter={StaticResource BooleanToVisibilityConverter}}" Click="CatalogProducts_OnClick"><TextBlock Text="Danh mục sản phẩm" /></Button>
                                <Button Style="{StaticResource NavSubItemStyle}" Tag="{Binding IsCatalogPricingSelected}" Visibility="{Binding CanViewPricing, Converter={StaticResource BooleanToVisibilityConverter}}" Click="CatalogPricing_OnClick"><TextBlock Text="Giá bán và khuyến mãi" /></Button>
                                <Button Style="{StaticResource NavSubItemStyle}" Tag="{Binding IsCatalogDocumentNumberingSelected}" Visibility="{Binding CanViewDocumentNumbering, Converter={StaticResource BooleanToVisibilityConverter}}" Click="CatalogDocumentNumbering_OnClick"><TextBlock Text="Số chứng từ" /></Button>
                            </StackPanel>

                            <TextBlock Style="{StaticResource NavSectionLabelStyle}" Text="TỒN KHO VÀ LÔ HÀNG" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Style="{StaticResource NavButtonStyle}" Tag="{Binding IsInventoryGroupSelected}" CommandParameter="inventory" Click="NavGroup_OnClick">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="☰" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="Tồn kho và lô hàng" FontWeight="SemiBold" />
                                        <TextBlock Text="Chuẩn bị hàng, chuyển kho, số lượng tồn, lô và hạn dùng" Style="{StaticResource NavHintTextStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding InventoryChevron}" Style="{StaticResource NavChevronTextStyle}" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                            </Button>
                            <StackPanel Margin="22,2,8,7" Visibility="{Binding IsInventoryOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Button Style="{StaticResource NavSubItemStyle}" Tag="{Binding IsInventoryReportingSelected}" Visibility="{Binding CanViewInventory, Converter={StaticResource BooleanToVisibilityConverter}}" Click="InventoryReporting_OnClick"><TextBlock Text="Báo cáo tồn kho" /></Button>
                                <Button Style="{StaticResource NavSubItemStyle}" Tag="{Binding IsInventoryFulfillmentSelected}" Visibility="{Binding CanViewFulfillment, Converter={StaticResource BooleanToVisibilityConverter}}" Click="InventoryFulfillment_OnClick"><TextBlock Text="Chuẩn bị hàng" /></Button>
                                <Button Style="{StaticResource NavSubItemStyle}"
                                        Tag="{Binding IsInventoryTransferSelected}"
                                        Visibility="{Binding CanViewInventoryTransfer, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Click="InventoryTransfer_OnClick"><TextBlock Text="Chuyển kho" /></Button>
                                <Button Style="{StaticResource NavSubItemStyle}"
                                        Tag="{Binding IsInventoryStocktakeSelected}"
                                        Visibility="{Binding CanViewInventoryStocktake, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Click="InventoryStocktake_OnClick"><TextBlock Text="Kiểm kê kho" /></Button>
                                <Button Style="{StaticResource NavSubItemStyle}"
                                        Tag="{Binding IsInventoryAdjustmentSelected}"
                                        Visibility="{Binding CanViewInventoryAdjustment, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Click="InventoryAdjustment_OnClick"><TextBlock Text="Điều chỉnh và xử lý tồn" /></Button>
                                <Button Style="{StaticResource NavSubItemStyle}"
                                        Tag="{Binding IsManualInboundSelected}"
                                        Visibility="{Binding CanViewManualInbound, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Click="ManualInbound_OnClick"><TextBlock Text="Nhập kho thủ công" /></Button>
                                <Button Style="{StaticResource NavSubItemStyle}"
                                        Tag="{Binding IsInventoryCostingSelected}"
                                        Visibility="{Binding CanViewInventoryCosting, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Click="InventoryCosting_OnClick"><TextBlock Text="Giá vốn tồn kho" /></Button>
                                <Button Style="{StaticResource NavSubItemStyle}"
                                        Tag="{Binding IsInventoryBalancesSelected}"
                                        Visibility="{Binding CanViewInventoryBalances, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Click="InventoryBalances_OnClick"><TextBlock Text="Tra cứu tồn kho" /></Button>
                                <Button Style="{StaticResource NavSubItemStyle}"
                                        Tag="{Binding IsInventoryTrackingPolicySelected}"
                                        Visibility="{Binding CanViewInventoryTrackingPolicy, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Click="InventoryTrackingPolicy_OnClick"><TextBlock Text="Chính sách lô" /></Button>
                                <Button Style="{StaticResource NavSubItemStyle}"
                                        Tag="{Binding IsInventoryLotsSelected}"
                                        Visibility="{Binding CanViewInventoryLots, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Click="InventoryLots_OnClick"><TextBlock Text="Lô hàng" /></Button>
                                <Button Style="{StaticResource NavSubItemStyle}"
                                        Tag="{Binding IsInventoryOpeningBalancesSelected}"
                                        Visibility="{Binding CanViewOpeningBalance, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Click="InventoryOpeningBalances_OnClick"><TextBlock Text="Thiết lập tồn đầu kỳ" /></Button>
                            </StackPanel>

                            <TextBlock Style="{StaticResource NavSectionLabelStyle}" Text="GIAO NHẬN VÀ ĐIỀU PHỐI" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Style="{StaticResource NavButtonStyle}" Tag="{Binding IsLogisticsGroupSelected}" CommandParameter="logistics" Click="NavGroup_OnClick">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="▣" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="Giao nhận và điều phối" FontWeight="SemiBold" />
                                        <TextBlock Text="Phiếu giao, chuyến xe, kết quả giao và đối soát" Style="{StaticResource NavHintTextStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding LogisticsChevron}" Style="{StaticResource NavChevronTextStyle}" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                            </Button>
                            <StackPanel Margin="22,2,8,7" Visibility="{Binding IsLogisticsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Button Style="{StaticResource NavSubItemStyle}"
                                        Tag="{Binding IsLogisticsReportingSelected}"
                                        Visibility="{Binding CanViewLogisticsReporting, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Click="LogisticsReporting_OnClick"><TextBlock Text="Hiệu suất giao hàng" /></Button>
                                <Button Style="{StaticResource NavSubItemStyle}"
                                        Tag="{Binding IsDeliveryOrdersSelected}"
                                        Visibility="{Binding CanViewDeliveryOrders, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Click="DeliveryOrders_OnClick"><TextBlock Text="Phiếu giao hàng" /></Button>
                                <Button Style="{StaticResource NavSubItemStyle}"
                                        Tag="{Binding IsTripPlanningSelected}"
                                        Visibility="{Binding CanViewTripPlanning, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Click="TripPlanning_OnClick"><TextBlock Text="Lập và xếp chuyến" /></Button>
                                <Button Style="{StaticResource NavSubItemStyle}"
                                        Tag="{Binding IsTripDispatchSelected}"
                                        Visibility="{Binding CanViewTripDispatch, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Click="TripDispatch_OnClick"><TextBlock Text="Bàn giao và xuất phát" /></Button>
                                <Button Style="{StaticResource NavSubItemStyle}"
                                        Tag="{Binding IsDeliveryAttemptsSelected}"
                                        Visibility="{Binding CanViewDeliveryAttempts, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Click="DeliveryAttempts_OnClick"><TextBlock Text="Kết quả lần giao" /></Button>
                                <Button Style="{StaticResource NavSubItemStyle}"
                                        Tag="{Binding IsTripReconciliationSelected}"
                                        Visibility="{Binding CanViewTripReconciliation, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Click="TripReconciliation_OnClick"><TextBlock Text="Đối soát cuối chuyến" /></Button>
                                <Button Style="{StaticResource NavSubItemStyle}"
                                        Tag="{Binding IsCustomerReturnsSelected}"
                                        Visibility="{Binding CanViewCustomerReturns, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Click="CustomerReturns_OnClick"><TextBlock Text="Hàng khách trả" /></Button>
                            </StackPanel>

                            <TextBlock Style="{StaticResource NavSectionLabelStyle}" Text="BÁN HÀNG" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Style="{StaticResource NavButtonStyle}" Tag="{Binding IsSalesGroupSelected}" CommandParameter="sales" Click="NavGroup_OnClick">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="☰" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="Bán hàng" FontWeight="SemiBold" />
                                        <TextBlock Text="Đơn nhiều nguồn, mã khách và vòng đời thương mại" Style="{StaticResource NavHintTextStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding SalesChevron}" Style="{StaticResource NavChevronTextStyle}" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                            </Button>
                            <StackPanel Margin="22,2,8,7" Visibility="{Binding IsSalesOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Button Style="{StaticResource NavSubItemStyle}"
                                        Tag="{Binding IsSalesReportingSelected}"
                                        Visibility="{Binding CanViewSalesReporting, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Click="SalesReporting_OnClick"><TextBlock Text="Báo cáo bán hàng" /></Button>
                                <Button Style="{StaticResource NavSubItemStyle}" IsEnabled="False"><TextBlock Text="Lãi gộp" /></Button>
                                <Button Style="{StaticResource NavSubItemStyle}" IsEnabled="False"><TextBlock Text="Điều hành bán hàng" /></Button>
                                <Button Style="{StaticResource NavSubItemStyle}" IsEnabled="False"><TextBlock Text="Đề xuất" /></Button>
                                <Button Style="{StaticResource NavSubItemStyle}" Tag="{Binding IsSalesOrdersSelected}" Visibility="{Binding CanViewSales, Converter={StaticResource BooleanToVisibilityConverter}}" Click="Sales_OnClick"><TextBlock Text="Đơn bán hàng" /></Button>
                                <Button Style="{StaticResource NavSubItemStyle}" IsEnabled="False"><TextBlock Text="Quản lý đơn hàng" /></Button>
                                <Button Style="{StaticResource NavSubItemStyle}" IsEnabled="False"><TextBlock Text="Mở/liên kết mã khách" /></Button>
                            </StackPanel>

                            <TextBlock Style="{StaticResource NavSectionLabelStyle}" Text="MUA HÀNG" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Style="{StaticResource NavButtonStyle}" CommandParameter="purchasing" Click="NavGroup_OnClick">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="☰" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="Mua hàng" FontWeight="SemiBold" />
                                        <TextBlock Text="Đơn mua hàng và phiếu nhận hàng" Style="{StaticResource NavHintTextStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding PurchasingChevron}" Style="{StaticResource NavChevronTextStyle}" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                            </Button>
                            <StackPanel Margin="22,2,8,7" Visibility="{Binding IsPurchasingOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Button Style="{StaticResource NavSubItemStyle}"
                                        Tag="{Binding IsPurchasingReportingSelected}"
                                        Visibility="{Binding CanViewPurchasingReporting, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Click="PurchasingReporting_OnClick"><TextBlock Text="Báo cáo mua hàng" /></Button>
                                <Button Style="{StaticResource NavSubItemStyle}"
                                        Tag="{Binding IsPurchaseOrdersSelected}"
                                        Visibility="{Binding CanViewPurchaseOrders, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Click="PurchaseOrders_OnClick"><TextBlock Text="Đơn mua hàng" /></Button>
                                <Button Style="{StaticResource NavSubItemStyle}"
                                        Tag="{Binding IsPurchasePricesSelected}"
                                        Visibility="{Binding CanViewPurchasePrices, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Click="PurchasePrices_OnClick"><TextBlock Text="Bảng giá mua" /></Button>
                                <Button Style="{StaticResource NavSubItemStyle}"
                                        Tag="{Binding IsGoodsReceiptsSelected}"
                                        Visibility="{Binding CanViewGoodsReceipts, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Click="GoodsReceipts_OnClick"><TextBlock Text="Phiếu nhận hàng" /></Button>
                                <Button Style="{StaticResource NavSubItemStyle}"
                                        Tag="{Binding IsSupplierReturnsSelected}"
                                        Visibility="{Binding CanViewSupplierReturns, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Click="SupplierReturns_OnClick"><TextBlock Text="Phiếu trả nhà cung cấp" /></Button>
                            </StackPanel>

                            <TextBlock Style="{StaticResource NavSectionLabelStyle}" Text="KẾ TOÁN VÀ CÔNG NỢ" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Style="{StaticResource NavButtonStyle}" CommandParameter="accounting" Click="NavGroup_OnClick">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="▤" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="Kế toán và công nợ" FontWeight="SemiBold" />
                                        <TextBlock Text="Tuổi nợ, thu tiền, phải thu và phải trả" Style="{StaticResource NavHintTextStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding AccountingChevron}" Style="{StaticResource NavChevronTextStyle}" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                            </Button>
                            <StackPanel Margin="22,2,8,7" Visibility="{Binding IsAccountingOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Button Style="{StaticResource NavSubItemStyle}"
                                        Tag="{Binding IsAgingSelected}"
                                        Visibility="{Binding CanViewAging, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Click="AccountingAging_OnClick"><TextBlock Text="Tuổi nợ" /></Button>
                                <Button Style="{StaticResource NavSubItemStyle}" IsEnabled="False"><TextBlock Text="COD và đối soát" /></Button>
                                <Button Style="{StaticResource NavSubItemStyle}" IsEnabled="False"><TextBlock Text="Công nợ phải thu" /></Button>
                                <Button Style="{StaticResource NavSubItemStyle}" IsEnabled="False"><TextBlock Text="Thu tiền khách hàng" /></Button>
                                <Button Style="{StaticResource NavSubItemStyle}" IsEnabled="False"><TextBlock Text="Điều chỉnh công nợ hàng trả" /></Button>
                                <Button Style="{StaticResource NavSubItemStyle}" IsEnabled="False"><TextBlock Text="Công nợ phải trả" /></Button>
                                <Button Style="{StaticResource NavSubItemStyle}" IsEnabled="False"><TextBlock Text="Thanh toán nhà cung cấp" /></Button>
                            </StackPanel>

                            <TextBlock Style="{StaticResource NavSectionLabelStyle}" Text="VẬN HÀNH HỆ THỐNG" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Style="{StaticResource NavButtonStyle}" IsEnabled="False"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="☰" HorizontalAlignment="Center" /><TextBlock Grid.Column="1" Text="Nhập/xuất dữ liệu" FontWeight="SemiBold" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" /></Grid></Button>
                            <Button Style="{StaticResource NavButtonStyle}" IsEnabled="False"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="▦" HorizontalAlignment="Center" /><TextBlock Grid.Column="1" Text="Lịch sử thay đổi" FontWeight="SemiBold" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" /></Grid></Button>
                            <Button Style="{StaticResource NavButtonStyle}" IsEnabled="False"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="☰" HorizontalAlignment="Center" /><TextBlock Grid.Column="1" Text="Lịch sử nhập/xuất" FontWeight="SemiBold" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" /></Grid></Button>

                            <TextBlock Style="{StaticResource NavSectionLabelStyle}" Text="CÀI ĐẶT CÔNG TY" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Style="{StaticResource NavButtonStyle}" CommandParameter="company-settings" Click="NavGroup_OnClick">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="☰" HorizontalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="Cài đặt Công Ty" FontWeight="SemiBold" />
                                        <TextBlock Text="Thiết lập chung và MCP, tuyến" Style="{StaticResource NavHintTextStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding CompanySettingsChevron}" Style="{StaticResource NavChevronTextStyle}" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                            </Button>
                            <StackPanel Margin="22,2,8,7" Visibility="{Binding IsCompanySettingsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Button Style="{StaticResource NavSubItemStyle}" IsEnabled="False"><TextBlock Text="Thiết lập chung" /></Button>
                                <Button Style="{StaticResource NavSubItemStyle}" IsEnabled="False"><TextBlock Text="MCP và tuyến" /></Button>
                            </StackPanel>

                            <TextBlock Style="{StaticResource NavSectionLabelStyle}" Text="QUẢN TRỊ HỆ THỐNG" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Style="{StaticResource NavButtonStyle}" CommandParameter="access" Click="NavGroup_OnClick">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="♙" HorizontalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="Nhân sự và phân quyền" FontWeight="SemiBold" />
                                        <TextBlock Text="Hồ sơ, tài khoản, vai trò và phạm vi truy cập" Style="{StaticResource NavHintTextStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding AccessChevron}" Style="{StaticResource NavChevronTextStyle}" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                            </Button>
                            <StackPanel Margin="22,2,8,7" Visibility="{Binding IsAccessOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Button Style="{StaticResource NavSubItemStyle}" IsEnabled="False"><TextBlock Text="Vai trò và phân quyền" /></Button>
                                <Button Style="{StaticResource NavSubItemStyle}" IsEnabled="False"><TextBlock Text="Danh mục nhân sự" /></Button>
                                <Button Style="{StaticResource NavSubItemStyle}" IsEnabled="False"><TextBlock Text="Người dùng" /></Button>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" BorderBrush="{DynamicResource SidebarActiveBorderBrush}" BorderThickness="0,1,0,0">
                        <Grid Margin="12,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="17" Background="White" VerticalAlignment="Center">
                                <Image Source="https://retail.nguyenlieuhungphat.com/logo-transparent.png" Stretch="Uniform" Margin="2" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding UserDisplayName}" Foreground="{DynamicResource SidebarTextBrush}" FontWeight="SemiBold" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding LoginNameText}" Margin="0,1,0,0" Foreground="{DynamicResource SidebarMutedTextBrush}" FontSize="9.5" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="2" Margin="0,0,4,0" Style="{StaticResource SidebarIconButtonStyle}" Click="Settings_OnClick" ToolTip="Cài đặt ứng dụng" Content="⚙" />
                            <Button Grid.Column="3" Style="{StaticResource SidebarIconButtonStyle}" IsEnabled="{Binding IsNotBusy}" Click="Logout_OnClick" ToolTip="Đăng xuất" Content="↪" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="98" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid Margin="28,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding HeaderKicker}"
                                       FontSize="9.5"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Margin="0,4,0,0"
                                       Text="{Binding PageTitle}"
                                       FontSize="23"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Margin="0,4,0,0"
                                       Text="{Binding PageSubtitle}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Margin="20,0,0,0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Style="{StaticResource OfficeSecondaryButtonStyle}"
                                    Visibility="{Binding IsCatalogOverviewSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Click="CatalogOverviewRefresh_OnClick"
                                    Content="Cập nhật dữ liệu" />

                            <Button Style="{StaticResource OfficeSecondaryButtonStyle}"
                                    Visibility="{Binding IsCatalogBranchesSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Click="CatalogBranchesRefresh_OnClick"
                                    Content="Cập nhật dữ liệu" />
                            <Button Margin="8,0,0,0"
                                    Style="{StaticResource OfficePrimaryButtonStyle}"
                                    Visibility="{Binding IsCatalogBranchesSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Click="CatalogBranchesAdd_OnClick"
                                    Content="Thêm chi nhánh" />
                            <Button Margin="8,0,0,0"
                                    Style="{StaticResource OfficeSecondaryButtonStyle}"
                                    Visibility="{Binding IsCatalogWarehousesSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Click="CatalogWarehousesRefresh_OnClick"
                                    Content="Cập nhật dữ liệu" />

                            <Button Margin="8,0,0,0"
                                    Style="{StaticResource OfficeSecondaryButtonStyle}"
                                    Visibility="{Binding IsCustomerCatalogWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Click="CatalogCustomersRefresh_OnClick"
                                    Content="Cập nhật dữ liệu" />
                            <Button Margin="8,0,0,0"
                                    Style="{StaticResource OfficePrimaryButtonStyle}"
                                    Visibility="{Binding CanShowCustomerTopbarCreate, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Click="CatalogCustomersCreate_OnClick"
                                    Content="{Binding CustomerTopbarCreateText}" />

                            <Button Margin="8,0,0,0"
                                    Style="{StaticResource OfficeSecondaryButtonStyle}"
                                    Visibility="{Binding IsCustomerProfileOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Click="CatalogCustomersList_OnClick"
                                    Content="Danh sách khách hàng" />
                            <Button Margin="8,0,0,0"
                                    Style="{StaticResource OfficePrimaryButtonStyle}"
                                    Visibility="{Binding IsCustomerProfileOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Click="CatalogCustomersEdit_OnClick"
                                    Content="Sửa thông tin" />

                            <Button Margin="8,0,0,0"
                                    Style="{StaticResource OfficeSecondaryButtonStyle}"
                                    Visibility="{Binding IsSalesReportingSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    IsEnabled="{Binding CanExportSalesReporting}"
                                    Click="SalesReportingExport_OnClick"
                                    Content="Xuất báo cáo" />
                            <Button Margin="8,0,0,0"
                                    Style="{StaticResource OfficeSecondaryButtonStyle}"
                                    Visibility="{Binding IsSalesReportingSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Click="SalesReportingOrders_OnClick"
                                    Content="Mở đơn bán hàng" />
                            <Button Margin="8,0,0,0"
                                    Style="{StaticResource OfficeSecondaryButtonStyle}"
                                    Visibility="{Binding IsSalesReportingSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    IsEnabled="False"
                                    ToolTip="Màn Lãi gộp sẽ được nối khi UI-5.2 hoàn thiện."
                                    Content="Xem báo cáo lãi gộp" />

                            <Button Margin="8,0,0,0"
                                    Style="{StaticResource OfficeSecondaryButtonStyle}"
                                    Visibility="{Binding IsInventoryTransferSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    IsEnabled="{Binding CanUseTransferTopbarActions}"
                                    Click="InventoryTransferRefresh_OnClick"
                                    Content="Làm mới" />
                            <Button Margin="8,0,0,0"
                                    Style="{StaticResource OfficePrimaryButtonStyle}"
                                    Visibility="{Binding CanCreateTransferTopbar, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    IsEnabled="{Binding CanUseTransferTopbarActions}"
                                    Click="InventoryTransferCreate_OnClick"
                                    Content="Tạo phiếu chuyển kho" />

                            <Button Margin="8,0,0,0"
                                    Style="{StaticResource OfficeSecondaryButtonStyle}"
                                    Visibility="{Binding IsInventoryStocktakeSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    IsEnabled="{Binding CanUseStocktakeTopbarActions}"
                                    Click="InventoryStocktakeRefresh_OnClick"
                                    Content="Làm mới" />
                            <Button Margin="8,0,0,0"
                                    Style="{StaticResource OfficePrimaryButtonStyle}"
                                    Visibility="{Binding CanCreateStocktakeTopbar, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    IsEnabled="{Binding CanUseStocktakeTopbarActions}"
                                    Click="InventoryStocktakeCreate_OnClick"
                                    Content="Tạo đợt kiểm kê" />

                            <Button Margin="8,0,0,0"
                                    Style="{StaticResource OfficeSecondaryButtonStyle}"
                                    Visibility="{Binding IsAdjustmentDocumentsTab, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    IsEnabled="{Binding CanUseAdjustmentTopbarActions}"
                                    Click="InventoryAdjustmentRefresh_OnClick"
                                    Content="Làm mới" />

                            <Button Margin="8,0,0,0"
                                    Style="{StaticResource OfficeSecondaryButtonStyle}"
                                    Visibility="{Binding IsCustomerReturnsSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Click="CustomerReturnsBack_OnClick"
                                    Content="Bàn giao giao nhận" />

                            <Button Margin="8,0,0,0"
                                    Style="{StaticResource OfficeSecondaryButtonStyle}"
                                    Visibility="{Binding IsTripReconciliationSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Click="TripReconciliationBack_OnClick"
                                    Content="Kết quả lần giao" />

                            <Button Margin="8,0,0,0"
                                    Style="{StaticResource OfficeSecondaryButtonStyle}"
                                    Visibility="{Binding IsDeliveryAttemptsSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Click="DeliveryAttemptsBack_OnClick"
                                    Content="Bàn giao chuyến" />

                            <Button Margin="8,0,0,0"
                                    Style="{StaticResource OfficeSecondaryButtonStyle}"
                                    Visibility="{Binding IsTripDispatchSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Click="TripDispatchBack_OnClick"
                                    Content="Quay lại lập kế hoạch" />

                            <Button Margin="8,0,0,0"
                                    Style="{StaticResource OfficeSecondaryButtonStyle}"
                                    Visibility="{Binding IsAgingSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    IsEnabled="False"
                                    ToolTip="Màn Công nợ phải thu sẽ được nối khi UI-7.3 hoàn thiện."
                                    Content="Công nợ phải thu" />
                            <Button Margin="8,0,0,0"
                                    Style="{StaticResource OfficeSecondaryButtonStyle}"
                                    Visibility="{Binding IsAgingSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    IsEnabled="False"
                                    ToolTip="Màn Công nợ phải trả sẽ được nối khi UI-7.6 hoàn thiện."
                                    Content="Công nợ phải trả" />

                            <Button Margin="8,0,0,0"
                                    Style="{StaticResource OfficePrimaryButtonStyle}"
                                    Visibility="{Binding IsInventoryCostingSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    IsEnabled="{Binding CanRunCostingRebuild}"
                                    Click="InventoryCostingRebuild_OnClick"
                                    Content="{Binding CostingRebuildActionText}" />
                        </StackPanel>

                        <Border Grid.Column="2"
                                MaxWidth="500"
                                Margin="20,0,0,0"
                                Padding="12,8"
                                VerticalAlignment="Center"
                                CornerRadius="8"
                                Visibility="{Binding HasActiveNotice, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveNoticeIsError}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ActiveNotice}"
                                       FontSize="10.5"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </Border>
                    </Grid>
                </Border>

                <TabControl Grid.Row="1"
                            SelectedIndex="{Binding SelectedWorkspaceIndex, Mode=OneWay}"
                            Background="Transparent"
                            BorderThickness="0">
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <ContentPresenter Content="{TemplateBinding SelectedContent}"
                                              ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
                        </ControlTemplate>
                    </TabControl.Template>

                    <TabItem>
                        <ContentControl x:Name="HomeHost" />
                    </TabItem>

                    <TabItem>
                        <ContentControl x:Name="InternalOrganizationHost" />
                    </TabItem>

                    <TabItem>
                        <ContentControl x:Name="PartnerHost" />
                    </TabItem>

                    <TabItem>
                        <ContentControl x:Name="SalesHost" />
                    </TabItem>

                    <TabItem>
                        <ContentControl x:Name="InventoryHost" />
                    </TabItem>

                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16">
                                <TabControl Style="{StaticResource OfficeTabControlStyle}"
                                            SelectedIndex="{Binding SelectedSettingsIndex, Mode=OneWay}">
                                    <TabItem Header="Tài khoản &amp; quyền">
                                        <Border Margin="0,8,0,0" Style="{StaticResource OfficeCardStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="155" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Người dùng" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding UserDisplayName}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Row="1" Margin="0,7,0,0" Text="Tên đăng nhập" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,7,0,0" Text="{Binding LoginNameText}" />
                                                <TextBlock Grid.Row="2" Margin="0,7,0,0" Text="Loại tài khoản" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,7,0,0" Text="{Binding AccountTypeText}" />
                                                <TextBlock Grid.Row="3" Margin="0,7,0,0" Text="Quyền thao tác" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,7,0,0" Text="{Binding PermissionSummary}" TextWrapping="Wrap" />
                                                <TextBlock Grid.Row="4" Margin="0,7,0,0" Text="Phạm vi làm việc" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,7,0,0" Text="{Binding ScopeSummary}" TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>
                                    </TabItem>

                                    <TabItem Header="Kết nối">
                                        <StackPanel Margin="0,8,0,0">
                                            <Border Style="{StaticResource OfficeCardStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="Kết nối hệ thống" FontSize="15" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding ConnectionText}"
                                                               Margin="0,5,0,0"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding SessionSummary}"
                                                               Margin="0,4,0,0"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextWrapping="Wrap" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                        <Button Style="{StaticResource OfficeSecondaryButtonStyle}"
                                                                IsEnabled="{Binding IsNotBusy}"
                                                                Click="RefreshConnection_OnClick"
                                                                Content="Kiểm tra lại" />
                                                        <Button Margin="6,0,0,0"
                                                                Style="{StaticResource OfficeSecondaryButtonStyle}"
                                                                IsEnabled="{Binding IsNotBusy}"
                                                                Click="OpenSetup_OnClick"
                                                                Content="Đổi cấu hình kết nối" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </TabItem>

                                    <TabItem Header="Giao diện">
                                        <Border Margin="0,8,0,0" Style="{StaticResource OfficeCardStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Giao diện ứng dụng" FontSize="15" FontWeight="SemiBold" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Foreground="{DynamicResource TextSecondaryBrush}">
                                                        <Run Text="Đang dùng: " />
                                                        <Run Text="{Binding ThemeText, Mode=OneWay}" FontWeight="SemiBold" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource OfficeSecondaryButtonStyle}"
                                                        Click="ToggleTheme_OnClick"
                                                        Content="{Binding ThemeActionText}" />
                                            </Grid>
                                        </Border>
                                    </TabItem>
                                </TabControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem>
                        <ContentControl x:Name="FulfillmentHost" />
                    </TabItem>

                    <TabItem>
                        <ContentControl x:Name="TransferHost" />
                    </TabItem>

                    <TabItem>
                        <ContentControl x:Name="StocktakeHost" />
                    </TabItem>

                    <TabItem>
                        <ContentControl x:Name="AdjustmentHost" />
                    </TabItem>

                    <TabItem>
                        <ContentControl x:Name="ManualInboundHost" />
                    </TabItem>

                    <TabItem>
                        <ContentControl x:Name="ProductHost" />
                    </TabItem>

                    <TabItem>
                        <ContentControl x:Name="InventoryCostingHost" />
                    </TabItem>

                    <TabItem>
                        <ContentControl x:Name="InventoryLookupHost" />
                    </TabItem>

                    <TabItem>
                        <ContentControl x:Name="InventoryTrackingPolicyHost" />
                    </TabItem>

                    <TabItem>
                        <ContentControl x:Name="PricingHost" />
                    </TabItem>

                    <TabItem>
                        <ContentControl x:Name="InventoryLotsHost" />
                    </TabItem>

                    <TabItem>
                        <ContentControl x:Name="DocumentNumberingHost" />
                    </TabItem>

                    <TabItem>
                        <ContentControl x:Name="OpeningBalanceHost" />
                    </TabItem>

                    <TabItem>
                        <ContentControl x:Name="LogisticsReportingHost" />
                    </TabItem>

                    <TabItem>
                        <ContentControl x:Name="PurchasingReportingHost" />
                    </TabItem>

                    <TabItem>
                        <ContentControl x:Name="DeliveryOrderHost" />
                    </TabItem>

                    <TabItem>
                        <ContentControl x:Name="PurchaseOrderHost" />
                    </TabItem>

                    <TabItem>
                        <ContentControl x:Name="TripPlanningHost" />
                    </TabItem>

                    <TabItem>
                        <ContentControl x:Name="PurchasePriceHost" />
                    </TabItem>

                    <TabItem>
                        <ContentControl x:Name="TripDispatchHost" />
                    </TabItem>

                    <TabItem>
                        <ContentControl x:Name="GoodsReceiptHost" />
                    </TabItem>

                    <TabItem>
                        <ContentControl x:Name="DeliveryAttemptHost" />
                    </TabItem>

                    <TabItem>
                        <ContentControl x:Name="SupplierReturnHost" />
                    </TabItem>

                    <TabItem>
                        <ContentControl x:Name="TripReconciliationHost" />
                    </TabItem>

                    <TabItem>
                        <ContentControl x:Name="CustomerReturnHost" />
                    </TabItem>

                    <TabItem>
                        <ContentControl x:Name="AgingReportingHost" />
                    </TabItem>

                    <TabItem>
                        <ContentControl x:Name="SalesReportingHost" />
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Grid>
</Window>
