<Window x:Class="CongTy.Desktop.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Công Ty Desktop"
        Width="1280"
        Height="800"
        MinWidth="1024"
        MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="QuickActionPillButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="15,5,6,5" />
            <Setter Property="Margin" Value="0,0,0,9" />
            <Setter Property="Background" Value="#F2FFFFFF" />
            <Setter Property="Foreground" Value="#243047" />
            <Setter Property="BorderBrush" Value="#4794A3B8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="22">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.18" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="1" />
                                <Setter Property="BorderBrush" Value="#6B6366F1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.86" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuickActionTriggerStyle" TargetType="Button">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#8CFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="28">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.28" Color="#312E81" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.94" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.78" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SidebarSubItemInteractiveStyle" TargetType="Button" BasedOn="{StaticResource NavSubItemStyle}">
            <EventSetter Event="Click" Handler="SidebarSubItem_OnClick" />
        </Style>
        <Style x:Key="SidebarInlineGroupStyle" TargetType="ContentControl">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <Border Width="1" Margin="0,2,0,3" HorizontalAlignment="Left" Background="#26FFFFFF" IsHitTestVisible="False" />
                            <ContentPresenter Margin="8,0,0,0" HorizontalAlignment="Stretch" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSidebarExpanded}" Value="True" />
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SidebarFlyoutPopupStyle" TargetType="Popup">
            <Setter Property="AllowsTransparency" Value="True" /><Setter Property="PopupAnimation" Value="Fade" />
            <Setter Property="Placement" Value="Right" /><Setter Property="HorizontalOffset" Value="8" /><Setter Property="VerticalOffset" Value="-4" />
            <Setter Property="StaysOpen" Value="False" /><Setter Property="IsOpen" Value="False" />
            <Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions>
                <Condition Binding="{Binding IsSidebarExpanded}" Value="False" />
                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True" />
            </MultiDataTrigger.Conditions><Setter Property="IsOpen" Value="True" /></MultiDataTrigger></Style.Triggers>
        </Style>
        <DataTemplate x:Key="CatalogMenuTemplate">
            <StackPanel>
                                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}"
                                        Tag="{Binding IsCatalogOverviewSelected}"
                                        Visibility="{Binding CanViewInternalOrganization, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Click="CatalogOverview_OnClick"><TextBlock Text="Tổng quan cơ cấu" /></Button>
                                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}" Tag="{Binding IsCatalogBranchesSelected}" Visibility="{Binding CanViewInternalOrganization, Converter={StaticResource BooleanToVisibilityConverter}}" Click="CatalogBranches_OnClick"><TextBlock Text="Chi nhánh" /></Button>
                                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}" Tag="{Binding IsCatalogWarehousesSelected}" Visibility="{Binding CanViewInternalOrganization, Converter={StaticResource BooleanToVisibilityConverter}}" Click="CatalogWarehouses_OnClick"><TextBlock Text="Kho hàng" /></Button>
                                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}" Tag="{Binding IsCatalogCustomersSelected}" Visibility="{Binding CanViewPartners, Converter={StaticResource BooleanToVisibilityConverter}}" Click="CatalogCustomers_OnClick"><TextBlock Text="Khách hàng" /></Button>
                                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}" Tag="{Binding IsCatalogSuppliersSelected}" Visibility="{Binding CanViewPartners, Converter={StaticResource BooleanToVisibilityConverter}}" Click="CatalogSuppliers_OnClick"><TextBlock Text="Nhà cung cấp" /></Button>
                                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}" Tag="{Binding IsCatalogProductsSelected}" Visibility="{Binding CanViewProducts, Converter={StaticResource BooleanToVisibilityConverter}}" Click="CatalogProducts_OnClick"><TextBlock Text="Danh mục sản phẩm" /></Button>
                                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}" Tag="{Binding IsCatalogPricingSelected}" Visibility="{Binding CanViewPricing, Converter={StaticResource BooleanToVisibilityConverter}}" Click="CatalogPricing_OnClick"><TextBlock Text="Giá bán và khuyến mãi" /></Button>
                                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}" Tag="{Binding IsCatalogDocumentNumberingSelected}" Visibility="{Binding CanViewDocumentNumbering, Converter={StaticResource BooleanToVisibilityConverter}}" Click="CatalogDocumentNumbering_OnClick"><TextBlock Text="Số chứng từ" /></Button>
                            
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="InventoryMenuTemplate">
            <StackPanel>
                                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}" Tag="{Binding IsInventoryReportingSelected}" Visibility="{Binding CanViewInventoryReporting, Converter={StaticResource BooleanToVisibilityConverter}}" Click="InventoryReporting_OnClick"><TextBlock Text="Báo cáo tồn kho" /></Button>
                                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}" Tag="{Binding IsInventoryFulfillmentSelected}" Visibility="{Binding CanViewFulfillment, Converter={StaticResource BooleanToVisibilityConverter}}" Click="InventoryFulfillment_OnClick"><TextBlock Text="Chuẩn bị hàng" /></Button>
                                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}"
                                        Tag="{Binding IsInventoryTransferSelected}"
                                        Visibility="{Binding CanViewInventoryTransfer, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Click="InventoryTransfer_OnClick"><TextBlock Text="Chuyển kho" /></Button>
                                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}"
                                        Tag="{Binding IsInventoryStocktakeSelected}"
                                        Visibility="{Binding CanViewInventoryStocktake, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Click="InventoryStocktake_OnClick"><TextBlock Text="Kiểm kê kho" /></Button>
                                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}"
                                        Tag="{Binding IsInventoryAdjustmentSelected}"
                                        Visibility="{Binding CanViewInventoryAdjustment, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Click="InventoryAdjustment_OnClick"><TextBlock Text="Điều chỉnh và xử lý tồn" /></Button>
                                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}"
                                        Tag="{Binding IsManualInboundSelected}"
                                        Visibility="{Binding CanViewManualInbound, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Click="ManualInbound_OnClick"><TextBlock Text="Nhập kho thủ công" /></Button>
                                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}"
                                        Tag="{Binding IsInventoryCostingSelected}"
                                        Visibility="{Binding CanViewInventoryCosting, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Click="InventoryCosting_OnClick"><TextBlock Text="Giá vốn tồn kho" /></Button>
                                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}"
                                        Tag="{Binding IsInventoryBalancesSelected}"
                                        Visibility="{Binding CanViewInventoryBalances, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Click="InventoryBalances_OnClick"><TextBlock Text="Tra cứu tồn kho" /></Button>
                                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}"
                                        Tag="{Binding IsInventoryTrackingPolicySelected}"
                                        Visibility="{Binding CanViewInventoryTrackingPolicy, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Click="InventoryTrackingPolicy_OnClick"><TextBlock Text="Chính sách lô" /></Button>
                                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}"
                                        Tag="{Binding IsInventoryLotsSelected}"
                                        Visibility="{Binding CanViewInventoryLots, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Click="InventoryLots_OnClick"><TextBlock Text="Lô hàng" /></Button>
                                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}"
                                        Tag="{Binding IsInventoryOpeningBalancesSelected}"
                                        Visibility="{Binding CanViewOpeningBalance, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Click="InventoryOpeningBalances_OnClick"><TextBlock Text="Thiết lập tồn đầu kỳ" /></Button>
                            
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="LogisticsMenuTemplate">
            <StackPanel>
                                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}"
                                        Tag="{Binding IsLogisticsReportingSelected}"
                                        Visibility="{Binding CanViewLogisticsReporting, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Click="LogisticsReporting_OnClick"><TextBlock Text="Hiệu suất giao hàng" /></Button>
                                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}"
                                        Tag="{Binding IsDeliveryOrdersSelected}"
                                        Visibility="{Binding CanViewDeliveryOrders, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Click="DeliveryOrders_OnClick"><TextBlock Text="Phiếu giao hàng" /></Button>
                                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}"
                                        Tag="{Binding IsTripPlanningSelected}"
                                        Visibility="{Binding CanViewTripPlanning, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Click="TripPlanning_OnClick"><TextBlock Text="Lập và xếp chuyến" /></Button>
                                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}"
                                        Tag="{Binding IsTripDispatchSelected}"
                                        Visibility="{Binding CanViewTripDispatch, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Click="TripDispatch_OnClick"><TextBlock Text="Bàn giao và xuất phát" /></Button>
                                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}"
                                        Tag="{Binding IsDeliveryAttemptsSelected}"
                                        Visibility="{Binding CanViewDeliveryAttempts, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Click="DeliveryAttempts_OnClick"><TextBlock Text="Kết quả lần giao" /></Button>
                                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}"
                                        Tag="{Binding IsTripReconciliationSelected}"
                                        Visibility="{Binding CanViewTripReconciliation, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Click="TripReconciliation_OnClick"><TextBlock Text="Đối soát cuối chuyến" /></Button>
                                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}"
                                        Tag="{Binding IsCustomerReturnsSelected}"
                                        Visibility="{Binding CanViewCustomerReturns, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Click="CustomerReturns_OnClick"><TextBlock Text="Hàng khách trả" /></Button>
                            
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="SalesMenuTemplate">
            <StackPanel>
                                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}"
                                        Tag="{Binding IsSalesReportingSelected}"
                                        Visibility="{Binding CanViewSalesReporting, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Click="SalesReporting_OnClick"><TextBlock Text="Báo cáo bán hàng" /></Button>
                                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}"
                                        Tag="{Binding IsGrossMarginSelected}"
                                        Visibility="{Binding CanViewGrossMargin, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Click="GrossMargin_OnClick"><TextBlock Text="Lãi gộp" /></Button>
                                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}"
                                        Tag="{Binding IsSalesOperationsSelected}"
                                        Visibility="{Binding CanViewSalesOperations, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Click="SalesOperations_OnClick"><TextBlock Text="Điều hành bán hàng" /></Button>
                                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}"
                                        Tag="{Binding IsManagementProposalsSelected}"
                                        Visibility="{Binding CanViewManagementProposals, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Click="ManagementProposals_OnClick"><TextBlock Text="Đề xuất" /></Button>
                                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}" Tag="{Binding IsSalesOrdersSelected}" Visibility="{Binding CanViewSales, Converter={StaticResource BooleanToVisibilityConverter}}" Click="Sales_OnClick"><TextBlock Text="Đơn bán hàng" /></Button>
                                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}" Tag="{Binding IsOrderManagementSelected}" Visibility="{Binding CanViewOrderManagement, Converter={StaticResource BooleanToVisibilityConverter}}" Click="OrderManagement_OnClick"><TextBlock Text="Quản lý đơn hàng" /></Button>
                                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}" Tag="{Binding IsCustomerOnboardingSelected}" Visibility="{Binding CanViewCustomerOnboarding, Converter={StaticResource BooleanToVisibilityConverter}}" Click="CustomerOnboarding_OnClick"><TextBlock Text="Mở/liên kết mã khách" /></Button>
                            
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="PurchasingMenuTemplate">
            <StackPanel>
                                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}"
                                        Tag="{Binding IsPurchasingReportingSelected}"
                                        Visibility="{Binding CanViewPurchasingReporting, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Click="PurchasingReporting_OnClick"><TextBlock Text="Báo cáo mua hàng" /></Button>
                                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}"
                                        Tag="{Binding IsPurchaseOrdersSelected}"
                                        Visibility="{Binding CanViewPurchaseOrders, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Click="PurchaseOrders_OnClick"><TextBlock Text="Đơn mua hàng" /></Button>
                                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}"
                                        Tag="{Binding IsPurchasePricesSelected}"
                                        Visibility="{Binding CanViewPurchasePrices, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Click="PurchasePrices_OnClick"><TextBlock Text="Bảng giá mua" /></Button>
                                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}"
                                        Tag="{Binding IsGoodsReceiptsSelected}"
                                        Visibility="{Binding CanViewGoodsReceipts, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Click="GoodsReceipts_OnClick"><TextBlock Text="Phiếu nhận hàng" /></Button>
                                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}"
                                        Tag="{Binding IsSupplierReturnsSelected}"
                                        Visibility="{Binding CanViewSupplierReturns, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Click="SupplierReturns_OnClick"><TextBlock Text="Phiếu trả nhà cung cấp" /></Button>
                            
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="AccountingMenuTemplate">
            <StackPanel>
                                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}"
                                        Tag="{Binding IsAgingSelected}"
                                        Visibility="{Binding CanViewAging, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Click="AccountingAging_OnClick"><TextBlock Text="Tuổi nợ" /></Button>
                                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}"
                                        Tag="{Binding IsCodAccountingSelected}"
                                        Visibility="{Binding CanViewCodAccounting, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Click="AccountingCod_OnClick"><TextBlock Text="COD và đối soát" /></Button>
                                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}"
                                         Tag="{Binding IsSalesSettlementSelected}"
                                         Visibility="{Binding CanViewSalesSettlement, Converter={StaticResource BooleanToVisibilityConverter}}"
                                         Click="AccountingSalesSettlement_OnClick"><TextBlock Text="Đối soát bán hàng &amp; COD" /></Button>
                                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}" Tag="{Binding IsReceivablesSelected}" Visibility="{Binding CanViewReceivables, Converter={StaticResource BooleanToVisibilityConverter}}" Click="Receivables_OnClick"><TextBlock Text="Công nợ phải thu" /></Button>
                                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}" Tag="{Binding IsCustomerPaymentsSelected}" Visibility="{Binding CanViewCustomerPayments, Converter={StaticResource BooleanToVisibilityConverter}}" Click="CustomerPayments_OnClick"><TextBlock Text="Thu tiền khách hàng" /></Button>
                                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}" Tag="{Binding IsCustomerReturnCreditsSelected}" Visibility="{Binding CanViewCustomerReturnCredits, Converter={StaticResource BooleanToVisibilityConverter}}" Click="CustomerReturnCredits_OnClick"><TextBlock Text="Điều chỉnh công nợ hàng trả" /></Button>
                                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}" Tag="{Binding IsPayablesSelected}" Visibility="{Binding CanViewPayables, Converter={StaticResource BooleanToVisibilityConverter}}" Click="Payables_OnClick"><TextBlock Text="Công nợ phải trả" /></Button>
                                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}" Tag="{Binding IsSupplierPaymentsSelected}" Visibility="{Binding CanViewSupplierPayments, Converter={StaticResource BooleanToVisibilityConverter}}" Click="SupplierPayments_OnClick"><TextBlock Text="Thanh toán nhà cung cấp" /></Button>
                            
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="CompanySettingsMenuTemplate">
            <StackPanel>
                                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}" Tag="{Binding IsDataBackupSelected}" Visibility="{Binding CanViewDataBackup, Converter={StaticResource BooleanToVisibilityConverter}}" Click="DataBackup_OnClick"><TextBlock Text="Thiết lập chung" /></Button>
                                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}" Tag="{Binding IsMcpRoutesSelected}" Visibility="{Binding CanViewMcpRoutes, Converter={StaticResource BooleanToVisibilityConverter}}" Click="McpRoutes_OnClick"><TextBlock Text="MCP và tuyến" /></Button>
                            
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="WorkforceMenuTemplate">
            <StackPanel>
                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}" Tag="{Binding IsAttendanceSelected}" Visibility="{Binding CanViewWorkforceAttendance, Converter={StaticResource BooleanToVisibilityConverter}}" Click="Attendance_OnClick"><TextBlock Text="Chấm công" /></Button>
                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}" Visibility="{Binding CanViewWorkforceTimesheet, Converter={StaticResource BooleanToVisibilityConverter}}" IsEnabled="False" ToolTip="Sẽ được triển khai ở Lô 4"><TextBlock Text="Bảng công" /></Button>
                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}" Tag="{Binding IsOvertimeCloseoutSelected}" Visibility="{Binding CanViewWorkforceOvertime, Converter={StaticResource BooleanToVisibilityConverter}}" Click="OvertimeCloseout_OnClick"><TextBlock Text="Tăng ca &amp; chốt công" /></Button>
                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}" Tag="{Binding IsPayrollFoundationSelected}" Visibility="{Binding CanViewWorkforcePayroll, Converter={StaticResource BooleanToVisibilityConverter}}" Click="PayrollFoundation_OnClick"><TextBlock Text="Tính lương" /></Button>
                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}" Tag="{Binding IsLeaveSelected}" Visibility="{Binding CanViewWorkforceLeave, Converter={StaticResource BooleanToVisibilityConverter}}" Click="Leave_OnClick"><TextBlock Text="Nghỉ và đơn nghỉ" /></Button>
                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}" Visibility="{Binding CanViewWorkforceViolations, Converter={StaticResource BooleanToVisibilityConverter}}" IsEnabled="False" ToolTip="Sẽ được triển khai ở Lô 4"><TextBlock Text="Xử lý vi phạm công" /></Button>
                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}" Visibility="{Binding CanViewWorkforceAdjustments, Converter={StaticResource BooleanToVisibilityConverter}}" IsEnabled="False" ToolTip="Sẽ được triển khai ở Lô 4"><TextBlock Text="Điều chỉnh công" /></Button>
                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}" Tag="{Binding IsEmployeeDirectorySelected}" Visibility="{Binding CanViewEmployeeDirectory, Converter={StaticResource BooleanToVisibilityConverter}}" Click="EmployeeDirectory_OnClick"><TextBlock Text="Danh mục nhân sự" /></Button>
                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}" Tag="{Binding IsWorkScheduleSelected}" Visibility="{Binding CanViewWorkforceSchedules, Converter={StaticResource BooleanToVisibilityConverter}}" Click="WorkSchedules_OnClick"><TextBlock Text="Ca / lịch làm việc" /></Button>
                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}" Tag="{Binding IsWorkPolicySelected}" Visibility="{Binding CanViewWorkforcePolicies, Converter={StaticResource BooleanToVisibilityConverter}}" Click="WorkPolicies_OnClick"><TextBlock Text="Chính sách làm việc" /></Button>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="AccessMenuTemplate">
            <StackPanel>
                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}" Tag="{Binding IsAccessRolesSelected}" Visibility="{Binding CanViewAccessRoles, Converter={StaticResource BooleanToVisibilityConverter}}" Click="AccessRoles_OnClick"><TextBlock Text="Vai trò và phân quyền" /></Button>
                <Button Style="{StaticResource SidebarSubItemInteractiveStyle}" Tag="{Binding IsUserDirectorySelected}" Visibility="{Binding CanViewUserDirectory, Converter={StaticResource BooleanToVisibilityConverter}}" Click="UserDirectory_OnClick"><TextBlock Text="Người dùng" /></Button>
            </StackPanel>
        </DataTemplate>

    </Window.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid Visibility="{Binding IsSetup, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="620"
                    Padding="34"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <StackPanel>
                    <TextBlock Text="Thiết lập kết nối Công Ty"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Margin="0,8,0,24"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Nhập thông tin cài đặt dùng trên máy tính này. Ứng dụng chỉ chấp nhận kết nối HTTPS và không yêu cầu mật khẩu cơ sở dữ liệu." />

                    <TextBlock Text="Tên cấu hình cài đặt" FontWeight="SemiBold" />
                    <TextBox Margin="0,6,0,16"
                             Padding="10,8"
                             Text="{Binding SetupInstallationName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Tên Công Ty hiển thị" FontWeight="SemiBold" />
                    <TextBox Margin="0,6,0,16"
                             Padding="10,8"
                             Text="{Binding SetupCompanyName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Địa chỉ hệ thống (HTTPS)" FontWeight="SemiBold" />
                    <TextBox Margin="0,6,0,12"
                             Padding="10,8"
                             Text="{Binding SetupApiUrl, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock MinHeight="22"
                               Text="{Binding SetupMessage}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" />

                    <Button Margin="0,20,0,0"
                            Padding="16,9"
                            HorizontalAlignment="Right"
                            IsEnabled="{Binding IsNotBusy}"
                            Click="SetupSave_OnClick"
                            Content="Kiểm tra và lưu" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid ClipToBounds="True"
              Visibility="{Binding IsLogin, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Image x:Name="LoginBackgroundImage"
                   Margin="-28"
                   Source="/Assets/Login/nguyen-lieu-mi-cay.png"
                   Stretch="UniformToFill"
                   Opacity="0.96"
                   IsHitTestVisible="False"
                   RenderOptions.BitmapScalingMode="HighQuality">
                <Image.Effect>
                    <BlurEffect Radius="18" />
                </Image.Effect>
            </Image>
            <Border Background="#32000000"
                    IsHitTestVisible="False" />

            <Border Width="520"
                    Padding="34"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <StackPanel>
                    <Image Width="78"
                           Height="78"
                           Margin="0,0,0,14"
                           HorizontalAlignment="Left"
                           Source="/Assets/Brand/logo.jpg"
                           Stretch="Uniform"
                           SnapsToDevicePixels="True" />
                    <TextBlock Text="{Binding CompanyName}"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Margin="0,5,0,24"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Đăng nhập hệ thống Công Ty" />

                    <TextBlock Text="Tên đăng nhập hoặc email quản trị" FontWeight="SemiBold" />
