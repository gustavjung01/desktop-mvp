                                <TextBlock VerticalAlignment="Center" Text="Sản phẩm" />
                                <Border Grid.Column="2" Width="34" Height="34" CornerRadius="17" Background="#E6F7FF" BorderBrush="#240EA5E9" BorderThickness="1">
                                    <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="M 3,7 L 10,3 L 17,7 L 10,11 Z M 3,7 L 3,14 L 10,18 L 17,14 L 17,7 M 10,11 L 10,18"
                                              Stroke="#0284C7" StrokeThickness="1.5" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Viewbox>
                                </Border>
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource QuickActionPillButtonStyle}"
                                Click="QuickActionCustomers_OnClick"
                                ToolTip="Mở Khách hàng trong cửa sổ mới">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="34" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="Khách hàng" />
                                <Border Grid.Column="2" Width="34" Height="34" CornerRadius="17" Background="#E8FAF1" BorderBrush="#2410B981" BorderThickness="1">
                                    <Canvas Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse Canvas.Left="6" Canvas.Top="1" Width="6" Height="6" Stroke="#059669" StrokeThickness="1.5" />
                                        <Path Data="M 2,17 C 2,11 16,11 16,17" Stroke="#059669" StrokeThickness="1.5" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Canvas>
                                </Border>
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource QuickActionPillButtonStyle}"
                                Foreground="White"
                                BorderBrush="#896366F1"
                                Click="QuickActionCreateSalesOrder_OnClick"
                                ToolTip="Tạo đơn bán trong cửa sổ mới">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#6366F1" Offset="0" />
                                    <GradientStop Color="#4F46E5" Offset="0.48" />
                                    <GradientStop Color="#2563EB" Offset="1" />
                                </LinearGradientBrush>
                            </Button.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="34" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="Tạo đơn bán" />
                                <Border Grid.Column="2" Width="34" Height="34" CornerRadius="17" Background="#24FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="+" FontSize="23" FontWeight="Light" />
                                </Border>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <Button x:Name="QuickActionsTrigger"
                            HorizontalAlignment="Right"
                            Style="{StaticResource QuickActionTriggerStyle}"
                            Click="QuickActionsTrigger_OnClick"
                            ToolTip="Thao tác nhanh">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#6366F1" Offset="0" />
                                <GradientStop Color="#4F46E5" Offset="0.46" />
                                <GradientStop Color="#2563EB" Offset="1" />
                            </LinearGradientBrush>
                        </Button.Background>
                        <TextBlock x:Name="QuickActionTriggerGlyph"
                                   Text="+"
                                   FontSize="28"
                                   FontWeight="Light"
                                   RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform x:Name="QuickActionTriggerRotation" Angle="0" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
