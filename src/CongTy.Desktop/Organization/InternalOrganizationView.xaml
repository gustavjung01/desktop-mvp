<UserControl x:Class="CongTy.Desktop.Organization.InternalOrganizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="760"
             MinHeight="520">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="PanelStyle" TargetType="Border" BasedOn="{StaticResource OfficeCardStyle}" />
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource OfficePrimaryButtonStyle}">
            <Setter Property="Margin" Value="3,0" />
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource OfficeSecondaryButtonStyle}">
            <Setter Property="Margin" Value="3,0" />
        </Style>
        <Style x:Key="FieldTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource OfficeTextBoxStyle}">
            <Setter Property="Margin" Value="0,3,0,8" />
        </Style>
        <Style x:Key="FieldComboStyle" TargetType="ComboBox" BasedOn="{StaticResource OfficeComboBoxStyle}">
            <Setter Property="Margin" Value="0,3,0,8" />
        </Style>
        <Style x:Key="ListGridStyle" TargetType="DataGrid" BasedOn="{StaticResource OfficeDataGridStyle}" />
        <Style x:Key="MessageBorderStyle" TargetType="Border" BasedOn="{StaticResource OfficeCardStyle}">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Padding" Value="8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OverviewSectionStyle" TargetType="Border" BasedOn="{StaticResource OfficeCardStyle}">
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="OverviewKickerStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style x:Key="OverviewQuickLinkStyle" TargetType="Button" BasedOn="{StaticResource OfficeSecondaryButtonStyle}">
            <Setter Property="MinHeight" Value="50" />
            <Setter Property="Margin" Value="0,0,0,7" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,8">
            <Border Style="{StaticResource OfficeSummaryCardStyle}" Margin="0,0,4,0">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Chi nhánh" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding BranchStatusSummary}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding BranchTotal}" Margin="10,0,0,0" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
            <Border Style="{StaticResource OfficeSummaryCardStyle}" Margin="2,0">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Kho hàng" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding WarehouseStatusSummary}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding WarehouseTotal}" Margin="10,0,0,0" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
            <Border Style="{StaticResource OfficeSummaryCardStyle}" Margin="4,0,0,0">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Vị trí kho" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding LocationStatusSummary}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding LocationTotal}" Margin="10,0,0,0" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="1">
            <TabControl x:Name="OrganizationTabs" Background="Transparent"
                        BorderThickness="0">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter Content="{TemplateBinding SelectedContent}"
                                          ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
                    </ControlTemplate>
                </TabControl.Template>

                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,8,0,0">
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.9*" />
                                    <ColumnDefinition Width="1.35*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource OverviewSectionStyle}" Margin="0,0,8,0">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="DANH MỤC NGHIỆP VỤ" Style="{StaticResource OverviewKickerStyle}" />
                                                <TextBlock Margin="0,2,0,0" Text="Truy cập nhanh" FontSize="17" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Padding="8,4" CornerRadius="6" Background="{DynamicResource SurfaceMutedBrush}">
                                                <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}">
                                                    <Run Text="{Binding OverviewRecordTotal, Mode=OneWay}" /><Run Text=" hồ sơ" />
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                        <Button Style="{StaticResource OverviewQuickLinkStyle}" Visibility="{Binding CanReadBranches, Converter={StaticResource BooleanToVisibilityConverter}}" Click="OverviewBranches_OnClick">
                                            <StackPanel><TextBlock Text="Chi nhánh" FontWeight="SemiBold" /><TextBlock FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}"><Run Text="{Binding BranchTotal, Mode=OneWay}" /><Run Text=" chi nhánh" /></TextBlock></StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource OverviewQuickLinkStyle}" Visibility="{Binding CanReadWarehouses, Converter={StaticResource BooleanToVisibilityConverter}}" Click="OverviewWarehouses_OnClick">
                                            <StackPanel><TextBlock Text="Kho hàng" FontWeight="SemiBold" /><TextBlock FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}"><Run Text="{Binding WarehouseTotal, Mode=OneWay}" /><Run Text=" kho hàng" /></TextBlock></StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource OverviewQuickLinkStyle}" Visibility="{Binding CanReadLocations, Converter={StaticResource BooleanToVisibilityConverter}}" Click="OverviewLocations_OnClick">
                                            <StackPanel><TextBlock Text="Vị trí kho" FontWeight="SemiBold" /><TextBlock FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}"><Run Text="{Binding LocationTotal, Mode=OneWay}" /><Run Text=" vị trí kho" /></TextBlock></StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource OverviewSectionStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="CƠ CẤU VẬN HÀNH" Style="{StaticResource OverviewKickerStyle}" />
                                            <TextBlock Margin="0,2,0,0" Text="Cơ cấu chi nhánh và kho" FontSize="17" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Padding="8,4" CornerRadius="6" Background="{DynamicResource SurfaceMutedBrush}" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding OverviewCheckedAt}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding OverviewHierarchyRows}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource OfficeCardStyle}" Padding="12" Margin="0,0,8,8">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Code}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                <TextBlock Margin="0,2,0,0" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                            <Border Grid.Column="1" Padding="7,3" CornerRadius="6" Background="{DynamicResource SurfaceMutedBrush}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" /><Setter Property="BorderThickness" Value="1" />
                                                                        <Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="False"><Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" /></DataTrigger></Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding Status}" FontSize="9.5" FontWeight="SemiBold">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                                            <Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="False"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /></DataTrigger></Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>
                                                        </Grid>
                                                        <TextBlock Margin="0,7,0,0" Text="{Binding Address}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                                        <WrapPanel Margin="0,9,0,0">
                                                            <Border Padding="6,3" Margin="0,0,5,0" CornerRadius="5" Background="{DynamicResource SurfaceMutedBrush}"><TextBlock FontSize="9.5"><Run Text="{Binding WarehouseCount, Mode=OneWay}" /><Run Text=" kho" /></TextBlock></Border>
                                                            <Border Padding="6,3" Margin="0,0,5,0" CornerRadius="5" Background="{DynamicResource SurfaceMutedBrush}"><TextBlock FontSize="9.5"><Run Text="{Binding ActiveWarehouseCount, Mode=OneWay}" /><Run Text=" kho đang hoạt động" /></TextBlock></Border>
                                                            <Border Padding="6,3" CornerRadius="5" Background="{DynamicResource SurfaceMutedBrush}"><TextBlock FontSize="9.5"><Run Text="{Binding LocationCount, Mode=OneWay}" /><Run Text=" vị trí" /></TextBlock></Border>
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Chưa có dữ liệu chi nhánh để hiển thị cơ cấu." Margin="0,10" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding OverviewHierarchyRows.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource OverviewSectionStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="CẬP NHẬT GẦN ĐÂY" Style="{StaticResource OverviewKickerStyle}" />
                                            <TextBlock Margin="0,2,0,0" Text="Những hồ sơ vừa thay đổi" FontSize="17" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Padding="8,4" CornerRadius="6" Background="{DynamicResource SurfaceMutedBrush}" VerticalAlignment="Top"><TextBlock Text="Cập nhật mới nhất" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" /></Border>
                                    </Grid>
                                    <DataGrid Style="{StaticResource ListGridStyle}" MaxHeight="330" ItemsSource="{Binding OverviewRecentRows}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Mã" Binding="{Binding Code}" Width="105" />
                                            <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Tên" Binding="{Binding Name}" Width="1.2*" />
                                            <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Đơn vị liên quan" Binding="{Binding Relation}" Width="1.6*" />
                                            <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Trạng thái" Binding="{Binding Status}" Width="125" />
                                            <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}" Header="Cập nhật" Binding="{Binding UpdatedAt}" Width="145" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="Chưa có hồ sơ nào." Margin="0,10" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding OverviewRecentRows.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Chi nhánh"
                         Visibility="{Binding CanReadBranches, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="Tra cứu theo mã hoặc tên"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Grid>
                                        <TextBox x:Name="BranchSearchBox"
                                                 Style="{StaticResource FieldTextBoxStyle}"
                                                 Text="{Binding BranchSearch, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Margin="10,0,0,8"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False"
                                                   Text="Nhập mã hoặc tên…"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=BranchSearchBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Text="Trạng thái"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <ComboBox Style="{StaticResource FieldComboStyle}"
                                              ItemsSource="{Binding BranchStatusOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding BranchStatus}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Bottom"
                                            Margin="0,0,0,8">
                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            IsEnabled="{Binding IsNotBusy}"
                                            Click="Refresh_OnClick"
                                            Content="Cập nhật dữ liệu" />
                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                            IsEnabled="{Binding CanWriteBranches}"
                                            Click="AddBranch_OnClick"
                                            Content="Thêm chi nhánh" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource PanelStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="DANH MỤC QUẢN LÝ"
                                                   Style="{StaticResource OverviewKickerStyle}" />
                                        <TextBlock Margin="0,2,0,0"
                                                   Text="Chi nhánh"
                                                   FontSize="17"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Padding="8,4"
                                            VerticalAlignment="Top"
                                            CornerRadius="6"
                                            Background="{DynamicResource SurfaceMutedBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1">
                                        <TextBlock Text="{Binding BranchVisibleSummary, Mode=OneWay}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                </Grid>

                                <Grid Grid.Row="1">
                                    <DataGrid Style="{StaticResource ListGridStyle}"
                                              RowHeight="54"
                                              ItemsSource="{Binding BranchRows}">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="Mã" Width="105">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Padding="6,3"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Center"
                                                                CornerRadius="5"
                                                                Background="{DynamicResource SurfaceMutedBrush}"
                                                                BorderBrush="{DynamicResource BorderBrush}"
                                                                BorderThickness="1">
                                                            <TextBlock Text="{Binding Code}"
                                                                       FontSize="10.5"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource AccentBrush}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTemplateColumn Header="Tên" Width="1.35*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Margin="0,2,0,0"
                                                                       Text="{Binding Address}"
                                                                       FontSize="10"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTemplateColumn Header="Liên hệ" Width="1.35*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Phone}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Margin="0,2,0,0"
                                                                       Text="{Binding Email}"
                                                                       FontSize="10"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTemplateColumn Header="Trạng thái" Width="130">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Status}"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}"
                                                                Header="Cập nhật"
                                                                Binding="{Binding UpdatedAt}"
                                                                Width="145" />

                                            <DataGridTemplateColumn Header="Xử lý" Width="205">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal"
                                                                    VerticalAlignment="Center">
                                                            <Button Style="{StaticResource OfficeMiniButtonStyle}"
                                                                    Margin="0,0,6,0"
                                                                    Tag="{Binding Id}"
                                                                    IsEnabled="{Binding DataContext.CanWriteBranches, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                                    Click="EditBranch_OnClick"
                                                                    Content="Chỉnh sửa" />
                                                            <Button Style="{StaticResource OfficeMiniButtonStyle}"
                                                                    Tag="{Binding Id}"
                                                                    IsEnabled="{Binding DataContext.CanWriteBranches, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                                    Click="ToggleBranch_OnClick"
                                                                    Content="{Binding StatusAction}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Text="{Binding BranchEmptyMessage, Mode=OneWay}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Visibility="{Binding BranchHasNoRows, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Kho hàng"
                         Visibility="{Binding CanViewWarehouses, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TabControl Style="{StaticResource OfficeTabControlStyle}"
                                x:Name="WarehouseTabs"
                                Margin="8,4,0,0"
                                Background="Transparent"
                                SelectionChanged="WarehouseTabs_OnSelectionChanged">
                        <TabItem Header="Kho hàng"
                                 Visibility="{Binding CanReadWarehouses, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="210" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="Tra cứu kho"
                                                       FontSize="10.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <Grid>
                                                <TextBox x:Name="WarehouseSearchBox"
                                                         Style="{StaticResource FieldTextBoxStyle}"
                                                         Text="{Binding WarehouseSearch, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Margin="10,0,0,8"
                                                           VerticalAlignment="Center"
                                                           IsHitTestVisible="False"
                                                           Text="Tên kho, mã kho hoặc chi nhánh"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text, ElementName=WarehouseSearchBox}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                            <TextBlock Text="Trạng thái"
                                                       FontSize="10.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <ComboBox Style="{StaticResource FieldComboStyle}"
                                                      ItemsSource="{Binding WarehouseStatusOptions}"
                                                      DisplayMemberPath="Label"
                                                      SelectedValuePath="Id"
                                                      SelectedValue="{Binding WarehouseStatus}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Bottom"
                                                    Margin="0,0,0,8">
                                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                                    IsEnabled="{Binding CanWriteWarehouses}"
                                                    Click="OpenQuickWarehouse_OnClick"
                                                    Content="Tạo kho nhanh" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1" Style="{StaticResource PanelStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="DANH MỤC QUẢN LÝ"
                                                           Style="{StaticResource OverviewKickerStyle}" />
                                                <TextBlock Margin="0,2,0,0"
                                                           Text="Kho hàng"
                                                           FontSize="17"
                                                           FontWeight="SemiBold" />
                                            </StackPanel>
                                            <Border Grid.Column="1"
                                                    Padding="8,4"
                                                    VerticalAlignment="Top"
                                                    CornerRadius="6"
                                                    Background="{DynamicResource SurfaceMutedBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1">
                                                <TextBlock Text="{Binding WarehouseVisibleSummary, Mode=OneWay}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </Border>
                                        </Grid>

                                        <Grid Grid.Row="1">
                                            <DataGrid Style="{StaticResource ListGridStyle}"
                                                      RowHeight="54"
                                                      ItemsSource="{Binding WarehouseRows}">
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn Header="Mã" Width="95">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Border Padding="6,3"
                                                                        HorizontalAlignment="Left"
                                                                        VerticalAlignment="Center"
                                                                        CornerRadius="5"
                                                                        Background="{DynamicResource SurfaceMutedBrush}"
                                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                                        BorderThickness="1">
                                                                    <TextBlock Text="{Binding Code}"
                                                                               FontSize="10.5"
                                                                               FontWeight="Bold"
                                                                               Foreground="{DynamicResource AccentBrush}" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>

                                                    <DataGridTemplateColumn Header="Tên" Width="1.2*">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}"
                                                                               FontWeight="SemiBold"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Margin="0,2,0,0"
                                                                               Text="{Binding UpdatedAt}"
                                                                               FontSize="10"
                                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>

                                                    <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}"
                                                                        Header="Thuộc chi nhánh"
                                                                        Binding="{Binding Branch}"
                                                                        Width="1.25*" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}"
                                                                        Header="Loại kho"
                                                                        Binding="{Binding Type}"
                                                                        Width="125" />
                                                    <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}"
                                                                        Header="Sơ đồ kho"
                                                                        Binding="{Binding LayoutMode}"
                                                                        Width="135" />

                                                    <DataGridTemplateColumn Header="Xuất vượt tồn" Width="120">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Border Padding="7,3"
                                                                        HorizontalAlignment="Left"
                                                                        VerticalAlignment="Center"
                                                                        CornerRadius="6">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                                                            <Setter Property="BorderThickness" Value="1" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding NegativeStockEnabled}" Value="True">
                                                                                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                                                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="{Binding NegativeStockStatus}"
                                                                               FontSize="10"
                                                                               FontWeight="SemiBold">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding NegativeStockEnabled}" Value="True">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Border>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>

                                                    <DataGridTemplateColumn Header="Trạng thái" Width="125">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Status}"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>

                                                    <DataGridTemplateColumn Header="Xử lý" Width="300">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal"
                                                                            VerticalAlignment="Center">
                                                                    <Button Style="{StaticResource OfficeMiniButtonStyle}"
                                                                            Margin="0,0,6,0"
                                                                            Tag="{Binding Id}"
                                                                            IsEnabled="{Binding DataContext.CanWriteWarehouses, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                                            Click="EditWarehouse_OnClick"
                                                                            Content="Chỉnh sửa" />
                                                                    <Button Style="{StaticResource OfficeMiniButtonStyle}"
                                                                            Margin="0,0,6,0"
                                                                            Tag="{Binding Id}"
                                                                            IsEnabled="{Binding DataContext.CanReadLocations, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                                            Click="SelectWarehouse_OnClick"
                                                                            Content="Quản lý sơ đồ" />
                                                                    <Button Style="{StaticResource OfficeMiniButtonStyle}"
                                                                            Tag="{Binding Id}"
                                                                            IsEnabled="{Binding DataContext.CanWriteWarehouses, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                                            Click="ToggleWarehouse_OnClick"
                                                                            Content="{Binding StatusAction}" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>

                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding WarehouseEmptyMessage, Mode=OneWay}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Visibility="{Binding WarehouseHasNoRows, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Thiết lập nhanh"
                                 Visibility="{Binding CanWriteWarehouses, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Border Style="{StaticResource PanelStyle}" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Text="THAO TÁC NHANH"
                                                   Style="{StaticResource OverviewKickerStyle}" />
                                        <TextBlock Margin="0,3,0,0"
                                                   Text="Thiết lập nhanh kho hàng"
                                                   FontSize="17"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Margin="0,5,0,16"
                                                   Text="Tạo kho mới trên dữ liệu hiện có. Sau khi tạo có thể sang tab Sơ đồ kho để chia khu vực chứa hàng."
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" />

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="1*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,10">
                                                <TextBlock Text="Chi nhánh quản lý" FontWeight="SemiBold" />
                                                <ComboBox Style="{StaticResource FieldComboStyle}"
                                                          ItemsSource="{Binding BranchOptions}"
                                                          DisplayMemberPath="Label"
                                                          SelectedValuePath="Id"
                                                          SelectedValue="{Binding QuickWarehouseBranchId}" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,10">
                                                <TextBlock Text="Loại kho" FontWeight="SemiBold" />
                                                <ComboBox Style="{StaticResource FieldComboStyle}"
                                                          ItemsSource="{Binding WarehouseTypeOptions}"
                                                          DisplayMemberPath="Label"
                                                          SelectedValuePath="Id"
                                                          SelectedValue="{Binding QuickWarehouseType}" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,10">
                                                <TextBlock Text="Mã kho" FontWeight="SemiBold" />
                                                <Grid>
                                                    <TextBox x:Name="QuickWarehouseCodeBox"
                                                             Style="{StaticResource FieldTextBoxStyle}"
                                                             MaxLength="64"
                                                             Text="{Binding QuickWarehouseCode, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Margin="10,0,0,8"
                                                               VerticalAlignment="Center"
                                                               IsHitTestVisible="False"
                                                               Text="Ví dụ: YS-003"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextSecondaryBrush}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Text, ElementName=QuickWarehouseCodeBox}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,10">
                                                <TextBlock Text="Tên kho" FontWeight="SemiBold" />
                                                <Grid>
                                                    <TextBox x:Name="QuickWarehouseNameBox"
                                                             Style="{StaticResource FieldTextBoxStyle}"
                                                             MaxLength="256"
                                                             Text="{Binding QuickWarehouseName, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Margin="10,0,0,8"
                                                               VerticalAlignment="Center"
                                                               IsHitTestVisible="False"
                                                               Text="Tên kho dễ nhận biết"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextSecondaryBrush}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Text, ElementName=QuickWarehouseNameBox}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </StackPanel>

                                            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,10">
                                                <TextBlock Text="Xuất vượt tồn" FontWeight="SemiBold" />
                                                <ComboBox Style="{StaticResource FieldComboStyle}"
                                                          ItemsSource="{Binding NegativeStockOptions}"
                                                          DisplayMemberPath="Label"
                                                          SelectedValuePath="Id"
                                                          SelectedValue="{Binding QuickWarehouseNegativeStockPolicy}" />
                                                <TextBlock Margin="0,3,0,0"
                                                           Text="Mặc định tắt. Bật chính sách không tự cấp quyền cho người dùng."
                                                           FontSize="10.5"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="3"
                                                        Grid.ColumnSpan="2"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Right">
                                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                                        IsEnabled="{Binding IsNotBusy}"
                                                        Click="SaveQuickWarehouse_OnClick"
                                                        Content="Tạo kho" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Sơ đồ kho"
                                 Visibility="{Binding CanReadLocations, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border Style="{StaticResource PanelStyle}" Margin="0,8,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                                        <TextBlock Text="BỐ TRÍ HÀNG HÓA"
                                                   Style="{StaticResource OverviewKickerStyle}" />
                                        <TextBlock Margin="0,3,0,0"
                                                   Text="Sơ đồ kho"
                                                   FontSize="17"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Margin="0,5,0,0"
                                                   Text="Chọn một kho để quản lý các khu lưu trữ, khu nhận hàng, khu xuất hàng và các khu vực đặc biệt bên trong kho."
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Grid Grid.Row="1" Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,12,0" MaxWidth="520" HorizontalAlignment="Left">
                                            <TextBlock Text="Kho" FontWeight="SemiBold" />
                                            <ComboBox MinWidth="420"
                                                      Style="{StaticResource FieldComboStyle}"
                                                      ItemsSource="{Binding WarehouseOptions}"
                                                      DisplayMemberPath="Label"
                                                      SelectedValuePath="Id"
                                                      SelectedValue="{Binding SelectedWarehouseId}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Bottom"
                                                    Margin="0,0,0,8">
                                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                                    Click="OpenLayout_OnClick"
                                                    IsEnabled="{Binding CanManageSelectedWarehouseLayout}"
                                                    Content="Thiết lập sơ đồ" />
                                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                                    Click="AddLocation_OnClick"
                                                    IsEnabled="{Binding CanAddLocationToSelectedWarehouse}"
                                                    Content="Thêm khu vực" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Grid.Row="2"
                                                Margin="0,0,0,12"
                                                Visibility="{Binding HasSelectedWarehouse, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <UniformGrid Columns="3" Margin="0,0,0,10">
                                            <Border Margin="0,0,7,0"
                                                    Padding="11,10"
                                                    CornerRadius="8"
                                                    Background="{DynamicResource SurfaceMutedBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1">
                                                <StackPanel>
                                                    <TextBlock Text="KHO"
                                                               FontSize="9.5"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Text="{Binding SelectedWarehouseLabel}"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                            <Border Margin="7,0"
                                                    Padding="11,10"
                                                    CornerRadius="8"
                                                    Background="{DynamicResource SurfaceMutedBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1">
                                                <StackPanel>
                                                    <TextBlock Text="CHẾ ĐỘ SƠ ĐỒ"
                                                               FontSize="9.5"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Text="{Binding SelectedWarehouseLayoutModeText}"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                            <Border Margin="7,0,0,0"
                                                    Padding="11,10"
                                                    CornerRadius="8"
                                                    Background="{DynamicResource SurfaceMutedBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1">
                                                <StackPanel>
                                                    <TextBlock Text="KHU VỰC"
                                                               FontSize="9.5"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Text="{Binding SelectedWarehouseLocationSummary, Mode=OneWay}"
                                                               FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>
                                        <TextBlock Text="Sơ đồ kho là cách chia khu/kệ/điểm chứa hàng bên trong kho; không phải địa chỉ vật lý của kho."
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Grid Grid.Row="3">
                                        <DataGrid Style="{StaticResource ListGridStyle}"
                                                  RowHeight="54"
                                                  ItemsSource="{Binding LocationRows}">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="Mã khu vực" Width="110">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border Padding="6,3"
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Center"
                                                                    CornerRadius="5"
                                                                    Background="{DynamicResource SurfaceMutedBrush}"
                                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                                    BorderThickness="1">
                                                                <TextBlock Text="{Binding Code}"
                                                                           FontSize="10.5"
                                                                           FontWeight="Bold"
                                                                           Foreground="{DynamicResource AccentBrush}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="Tên khu vực" Width="1.5*">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Margin="0,2,0,0"
                                                                           Text="{Binding UpdatedAt}"
                                                                           FontSize="10"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}"
                                                                    Header="Loại khu vực"
                                                                    Binding="{Binding Type}"
                                                                    Width="160" />
                                                <DataGridTemplateColumn Header="Trạng thái" Width="130">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Status}"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="Xử lý" Width="205">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Button Style="{StaticResource OfficeMiniButtonStyle}"
                                                                        Margin="0,0,6,0"
                                                                        Tag="{Binding Id}"
                                                                        IsEnabled="{Binding DataContext.CanWriteLocations, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                                        Click="EditLocation_OnClick"
                                                                        Content="Chỉnh sửa" />
                                                                <Button Style="{StaticResource OfficeMiniButtonStyle}"
                                                                        Tag="{Binding Id}"
                                                                        IsEnabled="{Binding DataContext.CanWriteLocations, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                                        Click="ToggleLocation_OnClick"
                                                                        Content="{Binding StatusAction}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding WarehouseLayoutEmptyMessage, Mode=OneWay}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasSelectedWarehouse}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedWarehouseHasNoLocations}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Grid>
                            </Border>
                        </TabItem>

                        <TabItem Header="Lịch sử"
                                 Visibility="{Binding CanWriteWarehouses, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="420" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="Kho" FontWeight="SemiBold" />
                                            <ComboBox Style="{StaticResource FieldComboStyle}"
                                                      ItemsSource="{Binding ActiveWarehouseOptions}"
                                                      DisplayMemberPath="Label"
                                                      SelectedValuePath="Id"
                                                      SelectedValue="{Binding SelectedWarehouseId}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Bottom"
                                                    Margin="0,0,0,8">
                                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                                    IsEnabled="{Binding CanManageSelectedWarehouseLayout}"
                                                    Click="LoadLayoutHistory_OnClick"
                                                    Content="Xem lịch sử" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Style="{StaticResource PanelStyle}"
                                            Margin="0,0,7,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Lịch sử sơ đồ kho"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,10" />
                                            <Grid Grid.Row="1">
                                                <DataGrid Style="{StaticResource ListGridStyle}"
                                                          RowHeight="50"
                                                          ItemsSource="{Binding LocationModeRuns}">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}"
                                                                            Header="Thời gian"
                                                                            Binding="{Binding CompletedAt}"
                                                                            Width="140" />
                                                        <DataGridTemplateColumn Header="Thay đổi" Width="1.3*">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Action}"
                                                                                   FontWeight="SemiBold"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Margin="0,2,0,0"
                                                                                   Text="{Binding CompletedBy}"
                                                                                   FontSize="10"
                                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                        <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}"
                                                                            Header="Trước → Sau"
                                                                            Binding="{Binding Transition}"
                                                                            Width="1.2*" />
                                                        <DataGridTextColumn ElementStyle="{StaticResource OfficeGridTextStyle}"
                                                                            Header="SKU"
                                                                            Binding="{Binding SkuCount}"
                                                                            Width="55" />
                                                        <DataGridTemplateColumn Header="" Width="105">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
