                                          SelectedValue="{Binding LayoutDestinationLocationId}" />
                                <TextBlock Margin="0,0,0,12"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="Chọn khu vực nhận hàng ban đầu để chuyển tồn chung vào sơ đồ. Hệ thống không tự gán khu vực." />
                            </StackPanel>

                            <Border Margin="0,6,0,12"
                                    Padding="12"
                                    CornerRadius="8"
                                    Background="{DynamicResource SurfaceMutedBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    Visibility="{Binding HasLayoutPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="KẾT QUẢ XEM TRƯỚC"
                                               Style="{StaticResource OverviewKickerStyle}" />
                                    <TextBlock Margin="0,6,0,0"
                                               Text="{Binding LayoutPreviewDestinationText, Mode=OneWay}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,6,0,0"
                                               Text="{Binding LayoutPreviewText}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,6,0,0"
                                               Text="{Binding LayoutBlockersText}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>

                            <Border Height="1"
                                    Margin="0,2,0,12"
                                    Background="{DynamicResource BorderBrush}" />

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Click="CloseLayout_OnClick"
                                        Content="Hủy" />
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        IsEnabled="{Binding IsNotBusy}"
                                        Click="PreviewLayout_OnClick"
                                        Content="Xem trước thay đổi" />
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        IsEnabled="{Binding CanConfirmLayout}"
                                        Click="ConfirmLayout_OnClick"
                                        Content="Xác nhận thay đổi" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
