<UserControl x:Class="CongTy.Desktop.Access.EmployeeDirectoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="EmployeeDirectoryView_OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="EmployeeMessageStyle" TargetType="Border" BasedOn="{StaticResource OfficeCardStyle}">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EmployeeCellTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="EmployeeStatusTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,4,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="NHÂN SỰ"
                                   FontSize="10"
                                   FontWeight="Bold" />
                        <TextBlock Margin="0,3,0,0"
                                   Text="Quản lý hồ sơ nhân sự, chức danh, thông tin liên hệ và đơn vị công tác."
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Top">
                        <Button Margin="0,0,8,0"
                                Style="{StaticResource OfficeSecondaryButtonStyle}"
                                IsEnabled="{Binding CanViewEmployees}"
                                Click="Refresh_OnClick"
                                Content="{Binding RefreshText}" />
                        <Button Style="{StaticResource OfficePrimaryButtonStyle}"
                                IsEnabled="{Binding CanOpenEditor}"
                                Click="Create_OnClick"
                                Content="THÊM NHÂN SỰ" />
                    </StackPanel>
                </Grid>

                <Border Margin="0,10,0,0"
                        Style="{StaticResource EmployeeMessageStyle}"
                        Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding Message}"
                               TextWrapping="Wrap" />
                </Border>

                <TextBlock Margin="0,14,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="Đang tải danh mục nhân sự…"
                           Visibility="{Binding ShowLoading, Converter={StaticResource BoolToVisibility}}" />

                <UniformGrid Margin="0,10,0,0" Columns="3">
                    <Border Margin="0,0,6,0" Padding="12" Style="{StaticResource OfficeCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Tổng hồ sơ" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding TotalEmployeesText}" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Margin="0,3,0,0"
                                       Text="Toàn bộ hồ sơ nhân sự đang được quản lý"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Margin="6,0" Padding="12" Style="{StaticResource OfficeCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Đang làm việc" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding ActiveEmployeesText}" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Margin="0,3,0,0"
                                       Text="{Binding InactiveEmployeesHint}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Margin="6,0,0,0" Padding="12" Style="{StaticResource OfficeCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Đã phân công" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding AssignedEmployeesText}" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Margin="0,3,0,0"
                                       Text="{Binding UnassignedEmployeesHint}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Margin="0,10,0,0" Padding="12" Style="{StaticResource OfficeCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="210" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Tìm kiếm nhân sự" FontWeight="SemiBold" />
                            <TextBox Margin="0,5,0,0"
                                     Text="{Binding SearchTerm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Ví dụ: NV001, Nguyễn Văn An, Kế toán" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="Trạng thái làm việc" FontWeight="SemiBold" />
                            <ComboBox Margin="0,5,0,0"
                                      ItemsSource="{Binding StatusFilters}"
                                      SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}"
                                      DisplayMemberPath="Label" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Đơn vị công tác" FontWeight="SemiBold" />
                            <ComboBox Margin="0,5,0,0"
                                      ItemsSource="{Binding BranchFilters}"
                                      SelectedItem="{Binding SelectedBranchFilter, Mode=TwoWay}"
                                      DisplayMemberPath="Label" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Margin="0,10,0,0" Style="{StaticResource OfficeCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="DANH MỤC NHÂN SỰ" FontSize="10" FontWeight="Bold" />
                                <TextBlock Margin="0,3,0,0" Text="Hồ sơ và đơn vị công tác" FontSize="16" FontWeight="SemiBold" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Padding="9,5"
                                    VerticalAlignment="Center"
                                    CornerRadius="12"
                                    Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock Text="{Binding VisibleEmployeeCountText}" FontWeight="SemiBold" />
                            </Border>
                        </Grid>

                        <DataGrid AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  RowHeight="68"
                                  Style="{StaticResource OfficeDataGridStyle}"
                                  ItemsSource="{Binding VisibleEmployees}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã nhân sự"
                                                    Binding="{Binding Code}"
                                                    Width="0.8*"
                                                    ElementStyle="{StaticResource EmployeeCellTextStyle}" />

                                <DataGridTemplateColumn Header="Họ và tên" Width="1.5*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,2,0,0"
                                                           Text="{Binding JobTitleText}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Đơn vị công tác"
                                                    Binding="{Binding BranchText}"
                                                    Width="1.5*"
                                                    ElementStyle="{StaticResource EmployeeCellTextStyle}" />

                                <DataGridTemplateColumn Header="Liên hệ" Width="1.5*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PhoneText}" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,2,0,0"
                                                           Text="{Binding EmailText}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Trạng thái" Width="0.9*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource EmployeeStatusTextStyle}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Cập nhật"
                                                    Binding="{Binding UpdatedAtText}"
                                                    Width="1.0*"
                                                    ElementStyle="{StaticResource EmployeeCellTextStyle}" />

                                <DataGridTemplateColumn Header="Thao tác" Width="1.5*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Padding="9,4"
                                                        Margin="0,0,6,0"
                                                        Tag="{Binding}"
                                                        IsEnabled="{Binding DataContext.CanOpenEditor, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Click="Edit_OnClick"
                                                        Content="Chỉnh sửa" />
                                                <Button Padding="9,4"
                                                        IsEnabled="False"
                                                        ToolTip="Thay đổi trạng thái sẽ được bật sau khi hoàn tất kiểm soát cập nhật hồ sơ."
                                                        Content="{Binding StatusText}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Margin="0,12,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding EmptyText}"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Background="#7F000000"
              Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Width="650"
                    MaxHeight="650"
                    Padding="18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource OfficeCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding EditorKicker}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding EditorTitle}" FontSize="19" FontWeight="SemiBold" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Padding="10,5"
                                Style="{StaticResource OfficeSecondaryButtonStyle}"
                                Click="CloseEditor_OnClick"
                                Content="ĐÓNG" />
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  Margin="0,14,0,14"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Mã nhân sự" FontWeight="SemiBold" />
                            <TextBox Margin="0,5,0,10"
                                     MaxLength="64"
                                     IsEnabled="{Binding IsCodeEditable}"
                                     Text="{Binding DraftCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Họ và tên" FontWeight="SemiBold" />
                            <TextBox Margin="0,5,0,10"
                                     MaxLength="256"
                                     Text="{Binding DraftFullName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Chức danh công việc" FontWeight="SemiBold" />
                            <TextBox Margin="0,5,0,10"
                                     MaxLength="128"
                                     Text="{Binding DraftJobTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Chi nhánh công tác" FontWeight="SemiBold" />
                            <ComboBox Margin="0,5,0,10"
                                      ItemsSource="{Binding DraftBranchOptions}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding DraftBranchId, Mode=TwoWay}" />

                            <TextBlock Text="Số điện thoại" FontWeight="SemiBold" />
                            <TextBox Margin="0,5,0,10"
                                     MaxLength="20"
                                     Text="{Binding DraftPhone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Email công việc" FontWeight="SemiBold" />
                            <TextBox Margin="0,5,0,0"
                                     MaxLength="256"
                                     Text="{Binding DraftEmail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="Mã nhân sự không thể đổi sau khi hồ sơ đã được tạo." />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Margin="0,0,8,0"
                                    Style="{StaticResource OfficeSecondaryButtonStyle}"
                                    Click="CloseEditor_OnClick"
                                    Content="HỦY" />
                            <Button Style="{StaticResource OfficePrimaryButtonStyle}"
                                    IsEnabled="{Binding CanPersist}"
                                    Content="{Binding SaveButtonText}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>