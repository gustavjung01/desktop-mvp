<UserControl x:Class="CongTy.Desktop.Access.EmployeeDirectoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="EmployeeDirectoryView_OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="EmployeeMessageStyle" TargetType="Border" BasedOn="{StaticResource OfficeCardStyle}">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EmployeeCellTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="EmployeeStatusTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,4,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="NHÂN SỰ"
                                   FontSize="10"
                                   FontWeight="Bold" />
                        <TextBlock Margin="0,3,0,0"
                                   Text="Quản lý hồ sơ nhân sự, lịch sử lao động, điều chuyển và đơn vị công tác."
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Top">
                        <Button Margin="0,0,8,0"
                                Style="{StaticResource OfficeSecondaryButtonStyle}"
                                IsEnabled="{Binding CanViewEmployees}"
                                Click="Refresh_OnClick"
                                Content="{Binding RefreshText}" />
                        <Button Margin="0,0,8,0"
                                Style="{StaticResource OfficeSecondaryButtonStyle}"
                                IsEnabled="{Binding CanOpenOrganization}"
                                Click="Organization_OnClick"
                                Content="CƠ CẤU TỔ CHỨC" />
                        <Button Style="{StaticResource OfficePrimaryButtonStyle}"
                                IsEnabled="{Binding CanOpenEditor}"
                                Click="Create_OnClick"
                                Content="THÊM NHÂN SỰ" />
                    </StackPanel>
                </Grid>

                <Border Margin="0,10,0,0"
                        Style="{StaticResource EmployeeMessageStyle}"
                        Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding Message}"
                               TextWrapping="Wrap" />
                </Border>

                <TextBlock Margin="0,14,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="Đang tải danh mục nhân sự…"
                           Visibility="{Binding ShowLoading, Converter={StaticResource BoolToVisibility}}" />

                <UniformGrid Margin="0,10,0,0" Columns="3">
                    <Border Margin="0,0,6,0" Padding="12" Style="{StaticResource OfficeCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Tổng hồ sơ" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding TotalEmployeesText}" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Margin="0,3,0,0"
                                       Text="Toàn bộ hồ sơ nhân sự đang được quản lý"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Margin="6,0" Padding="12" Style="{StaticResource OfficeCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Đang làm việc" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding ActiveEmployeesText}" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Margin="0,3,0,0"
                                       Text="{Binding InactiveEmployeesHint}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Margin="6,0,0,0" Padding="12" Style="{StaticResource OfficeCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Đã phân công" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding AssignedEmployeesText}" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Margin="0,3,0,0"
                                       Text="{Binding UnassignedEmployeesHint}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Margin="0,10,0,0" Padding="12" Style="{StaticResource OfficeCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="210" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Tìm kiếm nhân sự" FontWeight="SemiBold" />
                            <TextBox Margin="0,5,0,0"
                                     Text="{Binding SearchTerm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Ví dụ: NV001, Nguyễn Văn An, Kế toán" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="Trạng thái làm việc" FontWeight="SemiBold" />
                            <ComboBox Margin="0,5,0,0"
                                      ItemsSource="{Binding StatusFilters}"
                                      SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}"
                                      DisplayMemberPath="Label" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Đơn vị công tác" FontWeight="SemiBold" />
                            <ComboBox Margin="0,5,0,0"
                                      ItemsSource="{Binding BranchFilters}"
                                      SelectedItem="{Binding SelectedBranchFilter, Mode=TwoWay}"
                                      DisplayMemberPath="Label" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Margin="0,10,0,0" Style="{StaticResource OfficeCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="DANH MỤC NHÂN SỰ" FontSize="10" FontWeight="Bold" />
                                <TextBlock Margin="0,3,0,0" Text="Hồ sơ và đơn vị công tác" FontSize="16" FontWeight="SemiBold" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Padding="9,5"
                                    VerticalAlignment="Center"
                                    CornerRadius="12"
                                    Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock Text="{Binding VisibleEmployeeCountText}" FontWeight="SemiBold" />
                            </Border>
                        </Grid>

                        <DataGrid AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  RowHeight="68"
                                  Style="{StaticResource OfficeDataGridStyle}"
                                  ItemsSource="{Binding VisibleEmployees}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã nhân sự"
                                                    Binding="{Binding Code}"
                                                    Width="0.8*"
                                                    ElementStyle="{StaticResource EmployeeCellTextStyle}" />

                                <DataGridTemplateColumn Header="Họ và tên" Width="1.5*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,2,0,0"
                                                           Text="{Binding PositionText}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Margin="0,2,0,0"
                                                           Text="{Binding DepartmentText}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Đơn vị công tác" Width="1.8*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding BranchText}" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,2,0,0"
                                                           Text="{Binding ManagerText}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Liên hệ" Width="1.5*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PhoneText}" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,2,0,0"
                                                           Text="{Binding EmailText}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Trạng thái" Width="0.9*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource EmployeeStatusTextStyle}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Cập nhật"
                                                    Binding="{Binding UpdatedAtText}"
                                                    Width="1.0*"
                                                    ElementStyle="{StaticResource EmployeeCellTextStyle}" />

                                <DataGridTemplateColumn Header="Thao tác" Width="1.5*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Padding="9,4"
                                                        Margin="0,0,6,0"
                                                        Tag="{Binding}"
                                                        IsEnabled="{Binding DataContext.CanOpenEditor, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Click="Edit_OnClick"
                                                        Content="Chỉnh sửa" />
                                                <Button Padding="9,4"
                                                        Tag="{Binding}"
                                                        IsEnabled="{Binding DataContext.CanToggleEmployees, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Click="Toggle_OnClick"
                                                        Content="{Binding ToggleActionText}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Margin="0,12,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding EmptyText}"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Background="#7F000000"
              Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Width="940"
                    MaxHeight="720"
                    Padding="18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource OfficeCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding EditorKicker}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding EditorTitle}" FontSize="19" FontWeight="SemiBold" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Padding="10,5"
                                Style="{StaticResource OfficeSecondaryButtonStyle}"
                                Click="CloseEditor_OnClick"
                                Content="ĐÓNG" />
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  Margin="0,14,0,14"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Margin="0,0,0,10"
                                    Padding="10"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    Visibility="{Binding HasEditorMessage, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding EditorMessage}" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EditorMessageIsError}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>

                            <TextBlock Text="Mã nhân sự" FontWeight="SemiBold" />
                            <TextBox Margin="0,5,0,10"
                                     MaxLength="64"
                                     IsEnabled="{Binding IsCodeEditable}"
                                     Text="{Binding DraftCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Họ và tên" FontWeight="SemiBold" />
                            <TextBox Margin="0,5,0,10"
                                     MaxLength="256"
                                     Text="{Binding DraftFullName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Ngày bắt đầu làm việc" FontWeight="SemiBold" />
                                    <DatePicker Margin="0,5,0,0"
                                                SelectedDate="{Binding DraftEmploymentStartDate, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Hình thức lao động" FontWeight="SemiBold" />
                                    <ComboBox Margin="0,5,0,0"
                                              ItemsSource="{Binding EmploymentTypeOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Key"
                                              SelectedValue="{Binding DraftEmploymentType, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Visibility="{Binding ShowHistory, Converter={StaticResource BoolToVisibility}}">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Ngày kết thúc/nghỉ việc" FontWeight="SemiBold" />
                                        <DatePicker Margin="0,5,0,0"
                                                    SelectedDate="{Binding DraftEmploymentEndDate, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Lý do kết thúc" FontWeight="SemiBold" />
                                        <TextBox Margin="0,5,0,0"
                                                 MaxLength="256"
                                                 Text="{Binding DraftEmploymentEndReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                                <CheckBox Margin="0,0,0,10"
                                          IsChecked="{Binding DraftConfirmEmployment, Mode=TwoWay}"
                                          Content="Xác nhận lịch sử lao động theo thông tin đã kiểm tra" />
                            </StackPanel>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Phòng/Bộ phận" FontWeight="SemiBold" />
                                    <ComboBox Margin="0,5,0,0"
                                              ItemsSource="{Binding DraftDepartmentOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding DraftDepartmentId, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Vị trí công việc" FontWeight="SemiBold" />
                                    <ComboBox Margin="0,5,0,0"
                                              ItemsSource="{Binding DraftPositionOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding DraftPositionId, Mode=TwoWay}" />
                                    <TextBlock Margin="0,3,0,0"
                                               Text="{Binding LegacyJobTitleHint}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding HasLegacyJobTitleHint, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Quản lý trực tiếp" FontWeight="SemiBold" />
                                    <ComboBox Margin="0,5,0,0"
                                              ItemsSource="{Binding DraftManagerOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding DraftManagerEmployeeId, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Chi nhánh công tác" FontWeight="SemiBold" />
                            <ComboBox Margin="0,5,0,10"
                                      ItemsSource="{Binding DraftBranchOptions}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding DraftBranchId, Mode=TwoWay}" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Ngày bắt đầu đơn vị công tác" FontWeight="SemiBold" />
                                    <DatePicker Margin="0,5,0,0"
                                                SelectedDate="{Binding DraftAssignmentEffectiveFrom, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Lý do điều chuyển/xác nhận" FontWeight="SemiBold" />
                                    <TextBox Margin="0,5,0,0"
                                             MaxLength="256"
                                             Text="{Binding DraftAssignmentReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                            <CheckBox Margin="0,0,0,10"
                                      Visibility="{Binding ShowHistory, Converter={StaticResource BoolToVisibility}}"
                                      IsChecked="{Binding DraftConfirmAssignment, Mode=TwoWay}"
                                      Content="Xác nhận lịch sử điều chuyển hiện tại" />

                            <TextBlock Text="Số điện thoại" FontWeight="SemiBold" />
                            <TextBox Margin="0,5,0,10"
                                     MaxLength="20"
                                     Text="{Binding DraftPhone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Email công việc" FontWeight="SemiBold" />
                            <TextBox Margin="0,5,0,0"
                                     MaxLength="256"
                                     Text="{Binding DraftEmail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <StackPanel Margin="0,18,0,0"
                                        Visibility="{Binding ShowHistory, Converter={StaticResource BoolToVisibility}}">
                                <Border Margin="0,0,0,10"
                                        Padding="10"
                                        Background="{DynamicResource AccentSoftBrush}"
                                        Visibility="{Binding HasHistoryRequiringConfirmation, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Có dữ liệu lịch sử cũ đang ở trạng thái Cần HR xác nhận. Hãy kiểm tra ngày thực tế trước khi xác nhận."
                                               TextWrapping="Wrap" />
                                </Border>

                                <TextBlock Text="Lịch sử lao động" FontSize="16" FontWeight="SemiBold" />
                                <DataGrid Margin="0,7,0,14"
                                          Height="150"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          ItemsSource="{Binding EmploymentHistoryRows}"
                                          Style="{StaticResource OfficeDataGridStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Từ ngày" Binding="{Binding EffectiveFromText}" Width="1*" />
                                        <DataGridTextColumn Header="Đến ngày" Binding="{Binding EffectiveToText}" Width="1*" />
                                        <DataGridTextColumn Header="Hình thức" Binding="{Binding EmploymentTypeText}" Width="1.4*" />
                                        <DataGridTextColumn Header="Trạng thái dữ liệu" Binding="{Binding QualityText}" Width="1.5*" />
                                        <DataGridTextColumn Header="Lý do kết thúc" Binding="{Binding EndReasonText}" Width="1.6*" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Text="Lịch sử điều chuyển" FontSize="16" FontWeight="SemiBold" />
                                <DataGrid Margin="0,7,0,0"
                                          Height="150"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          ItemsSource="{Binding AssignmentHistoryRows}"
                                          Style="{StaticResource OfficeDataGridStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Từ ngày" Binding="{Binding EffectiveFromText}" Width="1*" />
                                        <DataGridTextColumn Header="Đến ngày" Binding="{Binding EffectiveToText}" Width="1*" />
                                        <DataGridTextColumn Header="Chi nhánh" Binding="{Binding BranchText}" Width="1.5*" />
                                        <DataGridTextColumn Header="Phòng/Bộ phận" Binding="{Binding DepartmentText}" Width="1.4*" />
                                        <DataGridTextColumn Header="Vị trí" Binding="{Binding PositionText}" Width="1.3*" />
                                        <DataGridTextColumn Header="Quản lý trực tiếp" Binding="{Binding ManagerText}" Width="1.4*" />
                                        <DataGridTextColumn Header="Trạng thái dữ liệu" Binding="{Binding QualityText}" Width="1.4*" />
                                        <DataGridTextColumn Header="Lý do" Binding="{Binding ReasonText}" Width="1.5*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="Mã nhân sự không thể đổi sau khi hồ sơ đã được tạo." />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Margin="0,0,8,0"
                                    Style="{StaticResource OfficeSecondaryButtonStyle}"
                                    Visibility="{Binding ShowReloadAfterConflict, Converter={StaticResource BoolToVisibility}}"
                                    Click="ReloadAfterConflict_OnClick"
                                    Content="TẢI LẠI DỮ LIỆU" />
                            <Button Margin="0,0,8,0"
                                    Style="{StaticResource OfficeSecondaryButtonStyle}"
                                    Click="CloseEditor_OnClick"
                                    Content="HỦY" />
                            <Button Style="{StaticResource OfficePrimaryButtonStyle}"
                                    IsEnabled="{Binding CanPersist}"
                                    Click="Save_OnClick"
                                    Content="{Binding SaveButtonText}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Background="#7F000000"
              Visibility="{Binding IsOrganizationOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Width="980"
                    MaxHeight="720"
                    Padding="18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource OfficeCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="THIẾT LẬP NHÂN SỰ" FontSize="10" FontWeight="Bold" />
                            <TextBlock Margin="0,4,0,0" Text="Cơ cấu tổ chức" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Margin="0,3,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="Quản lý Phòng/Bộ phận và Vị trí công việc dùng chung cho hồ sơ nhân sự."
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Padding="10,5"
                                Style="{StaticResource OfficeSecondaryButtonStyle}"
                                Click="CloseOrganization_OnClick"
                                Content="ĐÓNG" />
                    </Grid>

                    <Border Grid.Row="1"
                            Margin="0,12,0,0"
                            Padding="10"
                            Background="{DynamicResource AccentSoftBrush}"
                            Visibility="{Binding HasOrganizationMessage, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding OrganizationMessage}" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OrganizationMessageIsError}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <ScrollViewer Grid.Row="2"
                                  Margin="0,14,0,0"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="ĐƠN VỊ NỘI BỘ" FontSize="10" FontWeight="Bold" />
                                <TextBlock Margin="0,3,0,10" Text="Phòng/Bộ phận" FontSize="17" FontWeight="SemiBold" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Mã" FontWeight="SemiBold" />
                                        <TextBox Margin="0,5,0,8"
                                                 MaxLength="64"
                                                 Text="{Binding DepartmentDraftCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Tên Phòng/Bộ phận" FontWeight="SemiBold" />
                                        <TextBox Margin="0,5,0,8"
                                                 MaxLength="256"
                                                 Text="{Binding DepartmentDraftName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Cấp trên" FontWeight="SemiBold" />
                                <ComboBox Margin="0,5,0,8"
                                          ItemsSource="{Binding DepartmentParentOptions}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding DepartmentDraftParentId, Mode=TwoWay}" />
                                <Button HorizontalAlignment="Left"
                                        Style="{StaticResource OfficePrimaryButtonStyle}"
                                        IsEnabled="{Binding CanSaveDepartment}"
                                        Click="SaveDepartment_OnClick"
                                        Content="THÊM PHÒNG/BỘ PHẬN" />

                                <DataGrid Margin="0,12,0,0"
                                          Height="285"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          ItemsSource="{Binding DepartmentRows}"
                                          Style="{StaticResource OfficeDataGridStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Mã" Binding="{Binding Code}" Width="0.8*" />
                                        <DataGridTextColumn Header="Phòng/Bộ phận" Binding="{Binding Name}" Width="1.5*" />
                                        <DataGridTextColumn Header="Cấp trên" Binding="{Binding ParentText}" Width="1.2*" />
                                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusText}" Width="1.0*" />
                                        <DataGridTemplateColumn Header="Thao tác" Width="1.0*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Tag="{Binding}"
                                                            Padding="8,4"
                                                            IsEnabled="{Binding DataContext.CanManageOrganization, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            Click="ToggleDepartment_OnClick"
                                                            Content="{Binding ToggleActionText}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="CHỨC NĂNG CÔNG VIỆC" FontSize="10" FontWeight="Bold" />
                                <TextBlock Margin="0,3,0,10" Text="Vị trí công việc" FontSize="17" FontWeight="SemiBold" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Mã" FontWeight="SemiBold" />
                                        <TextBox Margin="0,5,0,8"
                                                 MaxLength="64"
                                                 Text="{Binding PositionDraftCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Tên Vị trí" FontWeight="SemiBold" />
                                        <TextBox Margin="0,5,0,8"
                                                 MaxLength="256"
                                                 Text="{Binding PositionDraftName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Thuộc Phòng/Bộ phận" FontWeight="SemiBold" />
                                <ComboBox Margin="0,5,0,8"
                                          ItemsSource="{Binding PositionDepartmentOptions}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding PositionDraftDepartmentId, Mode=TwoWay}" />
                                <Button HorizontalAlignment="Left"
                                        Style="{StaticResource OfficePrimaryButtonStyle}"
                                        IsEnabled="{Binding CanSavePosition}"
                                        Click="SavePosition_OnClick"
                                        Content="THÊM VỊ TRÍ" />

                                <DataGrid Margin="0,12,0,0"
                                          Height="285"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          ItemsSource="{Binding PositionRows}"
                                          Style="{StaticResource OfficeDataGridStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Mã" Binding="{Binding Code}" Width="0.8*" />
                                        <DataGridTextColumn Header="Vị trí" Binding="{Binding Name}" Width="1.5*" />
                                        <DataGridTextColumn Header="Phòng/Bộ phận" Binding="{Binding DepartmentText}" Width="1.3*" />
                                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusText}" Width="1.0*" />
                                        <DataGridTemplateColumn Header="Thao tác" Width="1.0*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Tag="{Binding}"
                                                            Padding="8,4"
                                                            IsEnabled="{Binding DataContext.CanManageOrganization, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            Click="TogglePosition_OnClick"
                                                            Content="{Binding ToggleActionText}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Grid Background="#7F000000"
              Visibility="{Binding IsToggleConfirmOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Width="520"
                    Padding="18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource OfficeCardStyle}">
                <StackPanel>
                    <TextBlock Text="XÁC NHẬN TRẠNG THÁI" FontSize="10" FontWeight="Bold" />
                    <TextBlock Margin="0,4,0,0"
                               Text="{Binding ToggleTitle}"
                               FontSize="19"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,12,0,0"
                               Text="{Binding ToggleText}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,12,0,0" Text="Ngày hiệu lực" FontWeight="SemiBold" />
                    <DatePicker Margin="0,5,0,0"
                                SelectedDate="{Binding ToggleEffectiveDate, Mode=TwoWay}" />
                    <TextBlock Margin="0,10,0,0" Text="Lý do" FontWeight="SemiBold" />
                    <TextBox Margin="0,5,0,0"
                             MaxLength="256"
                             Text="{Binding ToggleReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Margin="0,10,0,0"
                                Visibility="{Binding ShowToggleEmploymentType, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Hình thức lao động khi trở lại" FontWeight="SemiBold" />
                        <ComboBox Margin="0,5,0,0"
                                  ItemsSource="{Binding EmploymentTypeOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Key"
                                  SelectedValue="{Binding ToggleEmploymentType, Mode=TwoWay}" />
                    </StackPanel>
                    <TextBlock Margin="0,10,0,0"
                               Text="{Binding ToggleMessage}"
                               Foreground="{DynamicResource DangerBrush}"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasToggleMessage, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel Margin="0,16,0,0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Margin="0,0,8,0"
                                Style="{StaticResource OfficeSecondaryButtonStyle}"
                                Click="CancelToggle_OnClick"
                                Content="HỦY" />
                        <Button Style="{StaticResource OfficePrimaryButtonStyle}"
                                IsEnabled="{Binding CanConfirmToggle}"
                                Click="ConfirmToggle_OnClick"
                                Content="{Binding ToggleConfirmButtonText}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>