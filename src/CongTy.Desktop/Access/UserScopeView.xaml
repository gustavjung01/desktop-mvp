<UserControl x:Class="CongTy.Desktop.Access.UserScopeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserScopeView_OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,4,12">
            <StackPanel>
                <TextBlock Text="NHÂN SỰ VÀ PHÂN QUYỀN"
                           FontSize="10"
                           FontWeight="Bold" />
                <TextBlock Margin="0,3,0,0"
                           Text="Đơn mua hàng, Phiếu nhận hàng và các dữ liệu theo kho chỉ hiển thị trong phạm vi được cấp."
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Border Margin="0,10,0,0"
                    Padding="10"
                    BorderBrush="{DynamicResource DangerBrush}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource DangerBrush}"
                           TextWrapping="Wrap" />
            </Border>

            <Border Margin="0,10,0,0"
                    Padding="10"
                    Background="{DynamicResource AccentSoftBrush}"
                    CornerRadius="7"
                    Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding NoticeMessage}" TextWrapping="Wrap" />
            </Border>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Padding="12" Style="{StaticResource OfficeCardStyle}">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Tìm tài khoản" FontWeight="SemiBold" />
                            <TextBox Margin="0,5,0,10"
                                     Text="{Binding SearchTerm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Tên đăng nhập hoặc nhân sự" />
                        </StackPanel>

                        <ListBox ItemsSource="{Binding VisibleUsers}"
                                 SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,6">
                                        <TextBlock Text="{Binding PrimaryText}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,2,0,0"
                                                   Text="{Binding SecondaryText}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,2,0,0"
                                                   Text="{Binding ScopeSummary}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Margin="0,10,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding EmptyText}"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Padding="14" Style="{StaticResource OfficeCardStyle}">
                    <Grid>
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="Chọn một người dùng để quản lý phạm vi.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSelectedUser}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <StackPanel Visibility="{Binding HasSelectedUser, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Tài khoản"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Margin="0,3,0,0"
                                               Text="{Binding SelectedUserName}"
                                               FontSize="18"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,2,0,0"
                                               Text="{Binding SelectedLoginName}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding EffectiveWarehouseCountText}"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="kho hiệu lực"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Grid>

                            <Border Margin="0,14,0,0"
                                    Padding="12"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    CornerRadius="7"
                                    Visibility="{Binding OwnerFullScope, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="Tài khoản quản trị — toàn Công Ty"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,4,0,0"
                                               Text="Phạm vi được hệ thống tự áp dụng cho toàn bộ chi nhánh và kho, gồm dữ liệu lịch sử. Không cần cấp tay tại đây."
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <StackPanel Visibility="{Binding ShowEditableScopes, Converter={StaticResource BoolToVisibility}}">
                                <Border Margin="0,14,0,0"
                                        Padding="10"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="7">
                                    <TextBlock Text="{Binding ScopeWarningText}" TextWrapping="Wrap" />
                                </Border>

                                <Border Margin="0,12,0,0"
                                        Padding="12"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="7">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="Chi nhánh"
                                                       FontSize="15"
                                                       FontWeight="SemiBold" />
                                            <TextBlock HorizontalAlignment="Right"
                                                       Text="{Binding BranchSelectionCountText}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Grid>
                                        <ItemsControl Margin="0,8,0,0"
                                                      ItemsSource="{Binding BranchOptions}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="245"
                                                            MinHeight="58"
                                                            Margin="0,0,8,8"
                                                            Padding="8"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="6">
                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                  IsEnabled="{Binding DataContext.CanSaveScopes, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontWeight="SemiBold"
                                                                           TextWrapping="Wrap" />
                                                                <TextBlock Margin="0,2,0,0"
                                                                           Text="{Binding Detail}"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                           TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,12,0,0"
                                        Padding="12"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="7">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="Kho hàng"
                                                       FontSize="15"
                                                       FontWeight="SemiBold" />
                                            <TextBlock HorizontalAlignment="Right"
                                                       Text="{Binding WarehouseSelectionCountText}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Grid>
                                        <ItemsControl Margin="0,8,0,0"
                                                      ItemsSource="{Binding WarehouseOptions}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="300"
                                                            MinHeight="58"
                                                            Margin="0,0,8,8"
                                                            Padding="8"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="6">
                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                  IsEnabled="{Binding DataContext.CanSaveScopes, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontWeight="SemiBold"
                                                                           TextWrapping="Wrap" />
                                                                <TextBlock Margin="0,2,0,0"
                                                                           Text="{Binding Detail}"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                           TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <StackPanel Margin="0,14,0,0"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <Button Margin="0,0,8,0"
                                            Style="{StaticResource OfficeSecondaryButtonStyle}"
                                            IsEnabled="{Binding CanViewUsers}"
                                            Click="RefreshScopes_OnClick"
                                            Content="TẢI LẠI" />
                                    <Button Style="{StaticResource OfficePrimaryButtonStyle}"
                                            IsEnabled="{Binding CanSaveScopes}"
                                            Click="SaveScopes_OnClick"
                                            Content="{Binding SaveButtonText}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>